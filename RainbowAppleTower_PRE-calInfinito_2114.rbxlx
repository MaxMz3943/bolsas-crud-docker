			local flR
			flR = RunService.RenderStepped:Connect(function()
				if not vivoR then flR:Disconnect() return end
				local tf = os.clock() - tf0
				ico.Position = UDim2.new(0.5, 0, 0.42, math.sin(tf * 2.2) * 7)
				ico.Rotation = math.sin(tf * 1.5) * 6
			end)
		end
		-- nombre
		local nom = nuevo("TextLabel", {
			Size = UDim2.new(1, -50, 0, 40), Position = UDim2.new(0.5, 0, 1, -6),
			AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy, Text = "SPEED COIL",
			TextColor3 = Color3.fromRGB(255, 150, 150), TextScaled = true, ZIndex = 134,
		}, escR)
		nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, nom)
		-- función de cierre con degradado
		local function cerrarRet()
			if panelRet == pR then panelRet = nil end
			desvanecer(pR, 0.5)
		end
		-- botón RECLAMAR GRATIS (grande, verde, con studs)
		local btnR = nuevo("TextButton", {
			Size = UDim2.new(0, 300, 0, 62), Position = UDim2.new(0.5, 0, 1, -20),
			AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Color3.fromRGB(70, 210, 70),
			Text = "", BorderSizePixel = 0, ZIndex = 132,
		}, pR)
		esquinas(btnR, 14)
		borde(btnR, 3)
		studsVivo(btnR, Color3.fromRGB(70, 210, 70), Color3.fromRGB(70, 210, 70), 130, nil, true)
		local blR = nuevo("TextLabel", {
			Size = UDim2.new(1, -14, 1, -12), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy,
			Text = esES and "¡RECLAMAR GRATIS!" or "CLAIM FREE!",
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 133,
		}, btnR)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, blR)
		-- latido del botón para llamar la atención
		do
			local bs = Instance.new("UIScale")
			bs.Scale = 1
			bs.Parent = btnR
			TweenService:Create(bs, TweenInfo.new(0.6, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1, true), {Scale = 1.06}):Play()
		end
		btnR.MouseButton1Click:Connect(function()
			RE.Prompt:FireServer("regaloCoil")
			cerrarRet()
		end)
		-- X pequeña para descartar
		-- (el glifo "✕" no existe en LuckiestGuy y salía el botón vacío → "X")
		local xR = nuevo("TextButton", {
			Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(1, -12, 0, 12),
			AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Color3.fromRGB(200, 70, 70),
			Text = "X", Font = Enum.Font.LuckiestGuy, TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1), ZIndex = 134,
		}, pR)
		esquinas(xR, 8)
		nuevo("UIStroke", {Thickness = 2, Color = Color3.new(0, 0, 0)}, xR)
		xR.MouseButton1Click:Connect(cerrarRet)
	end)
end


-- ═══ CUARTO VIP DE LA COMUNIDAD ══════════════════════════════════════════════
-- Al ACERCARTE a la puerta se abre una ventana que invita a unirse a la
-- comunidad de Roblox (todo dentro de la plataforma — cumple políticas; no se
-- premian likes). VERIFICAR → el server consulta el grupo y sella el atributo
-- EnComunidad; con él, ESTE cliente abre su puerta localmente.
do
	local PUERTA_XZ = Vector2.new(-63.7, 73)    -- pegado a la PUERTA misma
	local function aplicarPuerta()
		local abierto = plr:GetAttribute("EnComunidad") and true or false
		local d = workspace:FindFirstChild("PuertaComunidad", true)
		if d then
			-- SIEMPRE casi invisible (se ve la skin de adentro); lo único que
			-- cambia es si CHOCAS con ella o la atraviesas
			d.CanCollide = not abierto
			d.Transparency = 0.92
		end
	end
	task.spawn(function()
		while not workspace:FindFirstChild("PuertaComunidad", true) do
			task.wait(0.5)
		end
		aplicarPuerta()
	end)
	plr:GetAttributeChangedSignal("EnComunidad"):Connect(aplicarPuerta)
	-- 🐛 FIX: con StreamingEnabled la puerta se DESCARGA al alejarte (subir la
	-- torre) y al volver REAPARECE con su CanCollide de fábrica (true = bloquea).
	-- aplicarPuerta no se re-ejecutaba (EnComunidad no cambió) → los MIEMBROS
	-- quedaban atorados tras jugar un rato. Se re-aplica al reaparecer + respaldo.
	workspace.DescendantAdded:Connect(function(obj)
		if obj.Name == "PuertaComunidad" then task.defer(aplicarPuerta) end
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			aplicarPuerta()   -- si la puerta se recargó, la corrige en ≤2 s
		end
	end)

	local panelComu = nil
	local function abrirComunidad()
		cerrarPanel()
		local dentro = plr:GetAttribute("EnComunidad") and true or false
		local MORC = Color3.fromRGB(58, 40, 96)
		local pC = nuevo("Frame", {
			Size = UDim2.new(0, 480, 0, 430),
			Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = MORC, BorderSizePixel = 0, ZIndex = 80,
		}, gui)
		esquinas(pC, 18)
		borde(pC, 5)
		studsVivo(pC, MORC, MORC, 220, nil, true)
		panelComu = pC
		panelAbierto = pC
		popIn(pC)
		local tt = nuevo("TextLabel", {
			Size = UDim2.new(1, -30, 0, 46), Position = UDim2.new(0.5, 0, 0, 20),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy, Text = "COMMUNITY",
			TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, ZIndex = 82,
		}, pC)
		nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tt)
		-- ¿soporta este cliente el prompt NATIVO de unirse al grupo?
		-- (API real: GroupService:PromptJoinAsync, dic-2025; el chequeo viejo
		-- apuntaba a SocialService.PromptGroupJoin, que NO existe → el botón
		-- UNIRME jamás aparecía)
		local GroupServiceCli = game:GetService("GroupService")
		-- el botón UNIRME sale SIEMPRE que no seas miembro. (Antes dependía de
		-- un typeof() sobre la API: si fallaba, el botón desaparecía sin dejar
		-- rastro. Ahora si el prompt no existiera, el clic simplemente no hace
		-- nada y el botón VERIFICAR de al lado sigue funcionando.)
		local nativoJoin = not dentro
		local cuerpoTxt
		if dentro then
			cuerpoTxt = esES
				and "¡Ya eres de la comunidad! 🍏\n\nLa puerta está ABIERTA para ti: entra y pisa el pad para ponerte la MANZANA RAINBOW exclusiva."
				or "You're already in the community! 🍏\n\nThe door is OPEN for you: walk in and step on the pad to wear the exclusive RAINBOW APPLE."
		else
			if nativoJoin then
				cuerpoTxt = esES
					and "Únete a la comunidad del juego y desbloquea el MORPH EXCLUSIVO de manzana RAINBOW. 🌈\n\n1) Pica UNIRME y acepta\n2) ¡La puerta se abre solita!"
					or "Join the game's community and unlock the EXCLUSIVE rainbow apple morph! 🌈\n\n1) Press JOIN and accept\n2) The door opens by itself!"
			else
				cuerpoTxt = esES
					and "Únete a la comunidad del juego y desbloquea el MORPH EXCLUSIVO de manzana RAINBOW. 🌈\n\n1) Abre la página del juego en Roblox\n2) Entra al grupo del juego y dale UNIRSE\n3) Vuelve aquí y pica VERIFICAR"
					or "Join the game's community and unlock the EXCLUSIVE rainbow apple morph! 🌈\n\n1) Open the game's page on Roblox\n2) Tap the game's group and JOIN\n3) Come back and press VERIFY"
			end
		end
		local cu = nuevo("TextLabel", {
			Size = UDim2.new(1, -50, 0, 230), Position = UDim2.new(0.5, 0, 0, 78),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne, Text = cuerpoTxt,
			TextColor3 = Color3.new(1, 1, 1), TextSize = 22, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 82,
		}, pC)
		nuevo("UIStroke", {Thickness = 2, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, cu)
		local btnC = nuevo("TextButton", {
			Size = nativoJoin and UDim2.new(0, 215, 0, 56) or UDim2.new(0, 240, 0, 56),
			Position = nativoJoin and UDim2.new(0.5, 112, 1, -18)
				or UDim2.new(0.5, 0, 1, -18),
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = Color3.fromRGB(70, 210, 70),
			Text = "", BorderSizePixel = 0, ZIndex = 82,
		}, pC)
		if nativoJoin then
			-- botón azul "UNIRME": abre el diálogo OFICIAL de Roblox del grupo
			local btnJ = nuevo("TextButton", {
				Size = UDim2.new(0, 215, 0, 56), Position = UDim2.new(0.5, -112, 1, -18),
				AnchorPoint = Vector2.new(0.5, 1),
				BackgroundColor3 = Color3.fromRGB(80, 150, 255),
				Text = "", BorderSizePixel = 0, ZIndex = 82,
			}, pC)
			esquinas(btnJ, 12)
			borde(btnJ, 3)
			studsVivo(btnJ, Color3.fromRGB(80, 150, 255), Color3.fromRGB(80, 150, 255),
				110, nil, true)
			local blJ = nuevo("TextLabel", {
				Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Font = Enum.Font.LuckiestGuy,
				Text = esES and "UNIRME" or "JOIN",
				TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 84,
			}, btnJ)
			nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
				LineJoinMode = Enum.LineJoinMode.Round}, blJ)
			btnJ.MouseButton1Click:Connect(function()
				task.spawn(function()
					-- 1) intentar el diálogo NATIVO de Roblox
					local ok = pcall(function()
						GroupServiceCli:PromptJoinAsync(Config.COMUNIDAD_ID)
					end)
					if not ok then
						-- 2) el cliente no soporta el prompt → instrucciones
						-- claras en vez de un botón muerto
						mostrarToast(esES
							and "Busca 'Mega Rainbow Games' en Roblox y dale UNIRSE, luego vuelve y pica VERIFICAR"
							or "Search 'Mega Rainbow Games' on Roblox and press JOIN, then come back and press VERIFY",
							Color3.fromRGB(255, 210, 90), 7)
					end
					-- 3) pase lo que pase, re-verificar (el server manda)
					task.wait(0.8)
					RE.Prompt:FireServer("comuVerificar")
				end)
			end)
		end
		esquinas(btnC, 12)
		borde(btnC, 3)
		studsVivo(btnC, Color3.fromRGB(70, 210, 70), Color3.fromRGB(70, 210, 70),
			110, nil, true)
		local blC = nuevo("TextLabel", {
			Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy,
			Text = dentro and "OK" or (esES and "VERIFICAR" or "VERIFY"),
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 84,
		}, btnC)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, blC)
		btnC.MouseButton1Click:Connect(function()
			if dentro then
				if panelAbierto == pC then panelAbierto = nil end
				pC:Destroy()
			else
				RE.Prompt:FireServer("comuVerificar")
			end
		end)
		local xC = nuevo("TextButton", {
			Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(1, -12, 0, 12),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundColor3 = Color3.fromRGB(200, 70, 70),
			Text = "X", Font = Enum.Font.LuckiestGuy, TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1), ZIndex = 84,
		}, pC)
		esquinas(xC, 8)
		nuevo("UIStroke", {Thickness = 2, Color = Color3.new(0, 0, 0)}, xC)
		xC.MouseButton1Click:Connect(function()
			if panelAbierto == pC then panelAbierto = nil end
			pC:Destroy()
		end)
	end
	-- si VERIFICAR triunfa con la ventana abierta → refrescarla al modo "ya eres"
	plr:GetAttributeChangedSignal("EnComunidad"):Connect(function()
		if panelComu and panelComu.Parent and panelAbierto == panelComu then
			abrirComunidad()
		end
	end)
	-- detector de cercanía: abre la ventana al ACERCARTE (una vez por visita)
	local cercaComu = false
	task.spawn(function()
		while true do
			task.wait(0.4)
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local d2 = (Vector2.new(root.Position.X, root.Position.Z) - PUERTA_XZ).Magnitude
				if d2 &lt; 5.5 and not cercaComu then      -- solo PEGADO a la puerta
					cercaComu = true
					if not panelAbierto then abrirComunidad() end
				elseif d2 &gt; 12 and cercaComu then
					cercaComu = false
					if panelComu and panelComu.Parent and panelAbierto == panelComu then
						panelAbierto = nil
						panelComu:Destroy()   -- se alejó → se cierra sola
					end
					panelComu = nil
				end
			end
		end
	end)
end


-- (INTRO cinemática del gusano ELIMINADA 2026-07-18 a pedido del usuario)


-- ═══ FAVORITO NATIVO: ELIMINADO 2026-07-25 ═══
-- Existió desde 2026-07-18: a los 150 s salía la ventana oficial de Roblox
-- "Favorite Item" (AvatarEditorService:PromptSetFavorite).
-- POR QUÉ SE QUITÓ: en los datos reales de retención (1090 jugadores nuevos) el
-- abandono sube justo en la ventana 150-180 s — 10.8% frente al 8.2% de los 30 s
-- anteriores y el 8.9% de los siguientes, o sea ~69 personas. Coincide al
-- segundo con este popup. Interrumpir a alguien a media escalada con una ventana
-- pidiéndole algo es el peor momento posible.
-- ⚠️ SI SE QUIERE RECUPERAR: no volver a ponerlo por tiempo. Dispararlo cuando
-- el jugador LOGRA algo (llega al piso 5, abre el cofre): ahí está contento y
-- además no se le corta nada.
