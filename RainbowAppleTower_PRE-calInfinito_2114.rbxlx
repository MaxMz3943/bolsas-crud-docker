-- ═══ FIN DE OBBY: botón con cuenta atrás de teletransporte ═══
local transObby = nil
RE.ObbyFin.OnClientEvent:Connect(function()
	-- TRANSICIÓN: cortina BLANCA que BAJA tapando la pantalla, se teletransporta
	-- oculto tras el blanco (server ~0.9 s) y vuelve arriba revelando el lobby. ~2 s.
	if transObby then transObby:Destroy() end
	local cortina = nuevo("Frame", {
		Size = UDim2.new(1, 0, 1, 120), Position = UDim2.new(0, 0, -1, -140),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 500,
	}, gui)
	transObby = cortina
	-- 1) baja a TAPAR todo
	TweenService:Create(cortina, TweenInfo.new(0.7, Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, -60)}):Play()
	-- 2) tras cubrir + el teletransporte, VUELVE arriba revelando el lobby
	task.delay(1.1, function()
		if cortina.Parent then
			TweenService:Create(cortina, TweenInfo.new(0.85, Enum.EasingStyle.Quad,
				Enum.EasingDirection.In), {Position = UDim2.new(0, 0, -1, -140)}):Play()
		end
	end)
	task.delay(2.05, function()
		if cortina == transObby then transObby = nil end
		if cortina.Parent then cortina:Destroy() end
	end)
end)

-- ─── Cronómetro de reclamo en el cartel del obby ──────────────────
-- El cooldown es POR JUGADOR, así que el letrero se pinta localmente:
-- cada quien ve su propio "Reclámalo en 9:59" sobre la meta que completó.
local claimFin  = {}   -- [pad] = os.clock() en que vuelve a estar listo
local claimOrig = {}   -- [pad] = {titulo=..., monto=...} textos originales

local function partesCartel(pad)
	local bg = pad:FindFirstChildOfClass("BillboardGui")
	if not bg then return end
	local titulo = bg:FindFirstChildOfClass("TextLabel")   -- "Claim!"
	local fila   = bg:FindFirstChildOfClass("Frame")
	if not (titulo and fila) then return end
	local monto = fila:FindFirstChildOfClass("TextLabel")   -- "$300"
	local icono = fila:FindFirstChildOfClass("ImageLabel")  -- 💰
	return titulo, monto, icono
end

local function mmss(seg)
	seg = math.max(0, math.floor(seg + 0.5))
	return string.format("%d:%02d", math.floor(seg / 60), seg % 60)
end

local function pintarCartel(pad, restante)
	local titulo, monto, icono = partesCartel(pad)
	if not titulo then return end
	if not claimOrig[pad] then
		claimOrig[pad] = { titulo = titulo.Text, monto = monto and monto.Text or "" }
	end
	if restante &gt; 0 then
		titulo.Text = "Claim it in:"
		titulo.TextColor3 = Color3.fromRGB(255, 255, 255)
		if icono then icono.Visible = false end
		if monto then
			monto.Text = mmss(restante)
			monto.TextColor3 = Color3.fromRGB(85, 235, 85)   -- cronómetro en verde
		end
	else
		local o = claimOrig[pad]
		titulo.Text = o.titulo
		titulo.TextColor3 = Color3.fromRGB(255, 255, 255)
		if icono then icono.Visible = true end
		if monto then
			monto.Text = o.monto
			monto.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end
end

RE.ClaimCd.OnClientEvent:Connect(function(pad, seg)
	if not pad then return end
	claimFin[pad] = os.clock() + (seg or 0)
	pintarCartel(pad, seg or 0)
end)

task.spawn(function()
	while true do
		local ahora = os.clock()
		for pad, fin in pairs(claimFin) do
			if pad and pad.Parent then
				local restante = fin - ahora
				pintarCartel(pad, restante)
				if restante &lt;= 0 then claimFin[pad] = nil end
			else
				claimFin[pad] = nil
			end
		end
		task.wait(0.5)
	end
end)

RE.Jumpscare.OnClientEvent:Connect(function(f)
	local marco = nuevo("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(120, 0, 0),
		BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 30,
	}, gui)
	local vp = nuevo("ViewportFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 31,
		Ambient = Color3.new(1, 0.6, 0.6), LightColor = Color3.new(1, 1, 1),
	}, marco)
	-- (texto "te atrapó tal gusano" ELIMINADO a pedido del usuario)
	-- clonar la cabeza del gusano al viewport
	task.spawn(function()
		local ok = pcall(function()
			local piso = workspace.Mapa.Torre:FindFirstChild("Piso_" .. f)
			local cabeza = piso and piso:FindFirstChild("Gusano")
				and piso.Gusano:FindFirstChild("Cabeza")
			if not cabeza then return end
			local clon = cabeza:Clone()
			clon.Parent = vp
			local cf, tam = clon:GetBoundingBox()
			local cam = Instance.new("Camera")
			cam.Parent = vp
			vp.CurrentCamera = cam
			local dist = math.max(tam.X, tam.Y, tam.Z) * 0.9
			for i = 1, 24 do
				local sacudida = Vector3.new(math.random(-10, 10),
					math.random(-10, 10), 0) / 30
				-- apunta un poco POR ENCIMA del centro de la cabeza → la cabeza
				-- baja en pantalla y queda centrada (antes salía muy arriba)
				local mira = cf.Position + Vector3.new(0, tam.Y * 0.16, 0)
				cam.CFrame = CFrame.lookAt(
					mira + cf.LookVector * (dist * (1.6 - i * 0.052)) + sacudida,  -- embiste más cerca
					mira)
				task.wait(0.03)
			end
		end)
		task.wait(0.22)   -- pausa corta (antes 0.6 → la cabeza se quedaba congelada)
		local tw = TweenService:Create(marco, TweenInfo.new(0.4),
			{BackgroundTransparency = 1})
		tw:Play()
		-- ¡ESTO FALTABA! el ViewportFrame (la cabeza) no se desvanecía → por eso
		-- quedaba ese pedazo de textura de la cabeza en pantalla
		TweenService:Create(vp, TweenInfo.new(0.4), {ImageTransparency = 1}):Play()
		for _, d in ipairs(marco:GetDescendants()) do
			pcall(function() d.TextTransparency = 1 end)
		end
		tw.Completed:Wait()
		marco:Destroy()
	end)
end)

-- ═══ FX ════════════════════════════════════════════════════
local function particulas(pos, color, cantidad, velocidad)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Lifetime = NumberRange.new(0.6, 1.4)
	e.Speed = NumberRange.new(velocidad * 0.5, velocidad)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rate = 0
	e.Parent = p
	p.Parent = workspace
	e:Emit(cantidad)
	task.delay(2.5, function() p:Destroy() end)
end

-- ═══ CHECKPOINT: botón verde + sonido de DINERO + "+$" en pantalla ═══
-- (2026-07-17: el chime de 3 notas y el banner "¡PISO f!" se ELIMINARON a
-- pedido del usuario — al activar un piso NUEVO ahora suena la MONEDA y sale
-- el billete con el "+$" subiendo en pantalla, como el resto de premios)
-- 🎨 color ORIGINAL de cada botón/aro de checkpoint, guardado la PRIMERA vez que
-- se pinta de verde. Sirve para despintarlos cuando el jugador reinicia la subida
-- en el pad "Return to obby": si se quedaran verdes, no se vería que ya se pueden
-- volver a pisar. Se GUARDA en vez de codificar el color a mano para que nunca se
-- desincronice de lo que genere build_rbxlx.py.
local colorOrigCP = {}

RE.Checkpoint.OnClientEvent:Connect(function(f, premio, esNuevo)
	-- 1) el botón se pone VERDE (local) con pop + aro (sin partículas)
	local btn = workspace:FindFirstChild("CheckpointBtn_" .. f, true)
	if btn then
		local orig = btn.Size
		if not colorOrigCP[f] then colorOrigCP[f] = {btn = btn.Color} end
		TweenService:Create(btn, TweenInfo.new(0.35),
			{Color = Color3.fromRGB(70, 235, 95)}):Play()
		TweenService:Create(btn, TweenInfo.new(0.12), {Size = orig * 1.3}):Play()
		task.delay(0.13, function()
			if btn.Parent then
				TweenService:Create(btn, TweenInfo.new(0.22,
					Enum.EasingStyle.Bounce), {Size = orig}):Play()
			end
		end)
		-- (2026-07-25) el CONFETI del botón se ELIMINÓ: cada checkpoint creaba una
		-- Part + ParticleEmitter con 34 partículas. Se sigue viendo el botón
		-- ponerse verde, el rebote y el aro, así que la recompensa visual queda.
		local aro = workspace:FindFirstChild("CheckpointAro_" .. f, true)
		if aro then
			if colorOrigCP[f] and not colorOrigCP[f].aro then
				colorOrigCP[f].aro = aro.Color
			end
			TweenService:Create(aro, TweenInfo.new(0.35),
				{Color = Color3.fromRGB(130, 255, 160)}):Play()
		end
	end
	-- 2) sonido de MONEDA + billete "+$X" en pantalla.
	-- No hace falta filtrar repeticiones aquí: el servidor manda este evento UNA
	-- sola vez por piso y por subida (r.pisosActivados), y no lo vuelve a mandar
	-- aunque bajes y vuelvas a cruzar el botón. El contador se limpia solo con el
	-- pad "Return to obby" de la azotea, que además dispara "reiniciarCheckpoints"
	-- para devolverles su color. esNuevo llega siempre true.
	if esNuevo and premio &gt; 0 then
		sonar("rbxassetid://90153447839250", 0.55)
		local cont = nuevo("Frame", {
			Size = UDim2.new(0, 200, 0, 48),
			Position = UDim2.new(0.5, math.random(-30, 30), 0.6, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1, ZIndex = 120,
		}, gui)
		local icoCP = nuevo("ImageLabel", {
			Size = UDim2.new(0, 44, 0, 44), Position = UDim2.new(0, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
			Image = Config.IMG_CASH, ScaleType = Enum.ScaleType.Fit, ZIndex = 121,
		}, cont)
		local tlCP = nuevo("TextLabel", {
			Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 50, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
			Text = "+$" .. Config.formatoCash(premio),
			TextColor3 = Color3.fromRGB(120, 255, 120), TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 121,
		}, cont)
		local stCP = nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tlCP)
		TweenService:Create(cont, TweenInfo.new(1.0, Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out),
			{Position = UDim2.new(0.5, cont.Position.X.Offset, 0.45, 0)}):Play()
		task.spawn(function()
			task.wait(0.4)
			for i = 0.1, 1, 0.12 do
				tlCP.TextTransparency = i
				stCP.Transparency = i
				icoCP.ImageTransparency = i
				task.wait(0.05)
			end
			cont:Destroy()
		end)
	end
end)

-- ═══ GIRO FLUIDO de la rueda física (local, 60fps) ═══
local impRueda = 0   -- acelerón que decae; sube al girar (FX "ruleta")
task.spawn(function()
	local rg
	repeat
		rg = workspace:FindFirstChild("RuedaGiratoria", true)
		task.wait(0.3)
	until rg
	local cara = rg:FindFirstChild("RuedaCara")
	local eje = CFrame.new(cara and cara.Position or rg:GetPivot().Position)
	local rel = eje:Inverse() * rg:GetPivot()
	local ang = 0
	RunService.RenderStepped:Connect(function(dt)
		ang = ang - (0.5 + impRueda) * dt          -- horario, lento en reposo
		impRueda = math.max(0, impRueda - dt * 3.5) -- el acelerón se frena
		if rg.Parent then
			rg:PivotTo(eje * CFrame.Angles(0, 0, ang) * rel)
		end
	end)
end)

-- ─── 💖 VENTANA DE DONAR (la abre el prompt E del Floppa) ───
local function abrirDonar()
	cerrarPanel()
	local ROSA = Color3.fromRGB(255, 110, 200)
	local FONDO = Color3.fromRGB(70, 22, 58)
	local pD = nuevo("Frame", {
		Size = UDim2.new(0, 480, 0, 560),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = FONDO, BorderSizePixel = 0, ZIndex = 130,
	}, gui)
	esquinas(pD, 20)
	borde(pD, 5)
	studsVivo(pD, FONDO, FONDO, 250, nil, true)
	popIn(pD)
	local vivoD = true
	pD.Destroying:Connect(function() vivoD = false end)
	local h1 = nuevo("TextLabel", {
		Size = UDim2.new(1, -30, 0, 50), Position = UDim2.new(0.5, 0, 0, 18),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy,
		Text = esES and "¡DONA! 💖" or "DONATE! 💖",
		TextColor3 = ROSA, TextScaled = true, ZIndex = 132,
	}, pD)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, h1)
	-- carita del floppa flotando
	local icoD = nuevo("ImageLabel", {
		Size = UDim2.new(0, 115, 0, 115), Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Image = "rbxassetid://6787971998", ScaleType = Enum.ScaleType.Fit,
		ZIndex = 132,
	}, pD)
	esquinas(icoD, 16)
	do
		local tf0 = os.clock()
		local flD
		flD = RunService.RenderStepped:Connect(function()
			if not vivoD then flD:Disconnect() return end
			local tf = os.clock() - tf0
			icoD.Position = UDim2.new(0.5, 0, 0, 78 + math.sin(tf * 2.2) * 5)
			icoD.Rotation = math.sin(tf * 1.5) * 5
		end)
	end
	local h2 = nuevo("TextLabel", {
		Size = UDim2.new(1, -50, 0, 28), Position = UDim2.new(0.5, 0, 0, 200),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = esES and "Apoya el juego (¡sale en la tabla!)"
			or "Support the game (you get on the board!)",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 132,
	}, pD)
	nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, h2)
	-- 6 montos en cuadrícula 2×3
	local tiers = {
		{"dona10", 10, Color3.fromRGB(110, 195, 255)},
		{"dona25", 25, Color3.fromRGB(115, 225, 135)},
		{"dona50", 50, Color3.fromRGB(255, 205, 80)},
		{"dona100", 100, Color3.fromRGB(255, 150, 90)},
		{"dona500", 500, Color3.fromRGB(255, 110, 200)},
		{"dona1000", 1000, Color3.fromRGB(200, 120, 255)},
	}
	for i, t in ipairs(tiers) do
		local colu = (i - 1) % 2
		local fila = math.floor((i - 1) / 2)
		local b = nuevo("TextButton", {
			Size = UDim2.new(0, 205, 0, 70),
			Position = UDim2.new(0.5, colu == 0 and -108 or 108, 0, 244 + fila * 82),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = t[3],
			Text = "", BorderSizePixel = 0, ZIndex = 132,
		}, pD)
		esquinas(b, 14)
		borde(b, 3)
		local bl = nuevo("TextLabel", {
			Size = UDim2.new(1, -16, 1, -18), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy,
			Text = ROBUX .. " " .. Config.formatoCash(t[2]),
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 133,
		}, b)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, bl)
		b.MouseButton1Click:Connect(function()
			-- abre el diálogo gris nativo de Roblox (server: PromptProductPurchase)
			RE.Prompt:FireServer("producto", t[1])
		end)
	end
	local xD = nuevo("TextButton", {
		Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(1, -12, 0, 12),
		AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Color3.fromRGB(200, 70, 70),
		Text = "X", Font = Enum.Font.LuckiestGuy, TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1), ZIndex = 134,
	}, pD)
	esquinas(xD, 8)
	nuevo("UIStroke", {Thickness = 2, Color = Color3.new(0, 0, 0)}, xD)
	xD.MouseButton1Click:Connect(function()
		if panelAbierto == pD then panelAbierto = nil end
		desvanecer(pD, 0.4)
	end)
	panelAbierto = pD
end

-- 🎯 FILTRO DE DISTANCIA DE LOS EFECTOS (2026-07-25)
-- El server manda estos efectos con FireAllClients (van a TODOS). Antes, un slap
-- en el piso 3 hacía que los 50 jugadores —incluido el del piso 20— crearan una
-- Part + emisor de 18 partículas + una Part con sonido, para algo que NO pueden
-- ver: los pisos son opacos. Con 20 personas cacheteando eran ~250 sistemas de
-- partículas por segundo tirados a la basura.
-- Solo se filtran los efectos POSICIONALES. Los personales (moneda, fling,
-- compras, ventanas) y los avisos globales (killAllTodos, donaTodos) NUNCA se
-- filtran: esos tienen que llegar siempre.
local FX_POSICIONAL = {
	confeti = true, slap = true, flingSonido = true, fuegos = true,
	batHit = true,
	muerteGusano = true, aciertoPuerta = true, errorPuerta = true,
}
-- ═══ CULLING DE LOS EFECTOS DE SKIN ════════════════════════
-- ⚠️ StreamingEnabled NO ayuda aquí. Descarga el MAPA por distancia (radio 320),
-- pero los PERSONAJES se replican siempre: sin esto, a 300 studs seguías
-- simulando ~32 partículas y una luz dinámica por cada jugador con la skin,
-- aunque midieran menos de un píxel en pantalla.
--
-- Mismo criterio que FX_RADIO (efectos de un disparo), pero aplicado a los
-- emisores permanentes. Se revisa cada 0,6 s, NO por frame: apagar y encender no
-- necesita precisión de fotograma y así el bucle no cuesta nada.
do
	local RADIO2 = 120 * 120        -- 120 studs = 3 pisos
	-- ⚠️ TOPE DE LUCES. El culling por distancia no salva el caso típico de una
	-- torre: quince jugadores en el MISMO piso, todos dentro del radio. Las luces
	-- dinámicas son lo caro (Roblox actualiza una rejilla de vóxeles por cada
	-- una) y el público de este juego es mayoritariamente móvil. Así que solo se
	-- encienden las MÁS CERCANAS; el resto conserva halo y chispas, que es lo que
	-- de verdad se ve, y pierde solo la luz, que a distancia no se distingue.
	local MAX_LUCES = 4
	local cerca = {}
	task.spawn(function()
		while true do
			task.wait(0.6)
			local cam = workspace.CurrentCamera
			local ref = cam and cam.CFrame.Position
			if ref then
				table.clear(cerca)
				for _, otro in ipairs(Players:GetPlayers()) do
					local ch = otro.Character
					local caja = ch and ch:FindFirstChild("SkinChispas")
					local halo = ch and ch:FindFirstChild("SkinHalo")
					-- el contorno entra en el mismo apagado por distancia: Roblox deja
					-- de dibujar los Highlights pasados unos 30 a la vez, así que si
					-- un día media torre lleva la negra hay que apagar los de lejos
					-- o los de cerca dejarían de verse
					local cont = ch and ch:FindFirstChild("SkinContorno")
					local est = ch and ch:FindFirstChild("SkinEstela")
					if caja or halo or cont or est then
						local root = ch:FindFirstChild("HumanoidRootPart")
						local d2 = math.huge
						if root then
							local v = root.Position - ref
							d2 = v.X * v.X + v.Y * v.Y + v.Z * v.Z
						end
						local visible = d2 &lt;= RADIO2
						if caja then
							local pe = caja:FindFirstChildOfClass("ParticleEmitter")
							-- Enabled=false corta las NUEVAS; las vivas se apagan solas
							if pe and pe.Enabled ~= visible then pe.Enabled = visible end
						end
						if cont and cont.Enabled ~= visible then cont.Enabled = visible end
						if est and est.Enabled ~= visible then est.Enabled = visible end
						local lz = halo and halo:FindFirstChild("SkinLuz")
						if lz then
							if visible then
								cerca[#cerca + 1] = {d = d2, luz = lz}
							elseif lz.Enabled then
								lz.Enabled = false
							end
						end
					end
				end
				-- de las visibles, encender solo las MAX_LUCES más cercanas
				table.sort(cerca, function(a, b) return a.d &lt; b.d end)
				for i, e in ipairs(cerca) do
					local on = i &lt;= MAX_LUCES
					if e.luz.Enabled ~= on then e.luz.Enabled = on end
				end
			end
		end
	end)
end

local FX_RADIO = 200          -- studs (~5 pisos de 40): más lejos es invisible
local FX_RADIO2 = FX_RADIO * FX_RADIO

RE.FX.OnClientEvent:Connect(function(tipo, a, b, c)
	-- ¿está lo bastante cerca para verlo? Se mide contra la CÁMARA, que es lo
	-- que el jugador realmente ve (con la alfombra o el zoom puede estar lejos
	-- de su personaje); si no hay cámara, se usa el personaje.
	if FX_POSICIONAL[tipo] then
		local pos = typeof(a) == "Vector3" and a
			or (typeof(a) == "Instance" and a:IsA("BasePart") and a.Position or nil)
		if pos then
			local cam = workspace.CurrentCamera
			local ref = cam and cam.CFrame.Position
			if not ref then
				local root = plr.Character
					and plr.Character:FindFirstChild("HumanoidRootPart")
				ref = root and root.Position
			end
			if ref then
				local dx, dy, dz = pos.X - ref.X, pos.Y - ref.Y, pos.Z - ref.Z
				if dx * dx + dy * dy + dz * dz &gt; FX_RADIO2 then return end
			end
		end
	end
	if tipo == "usarPase" then
		-- el SERVER confirma que YA tiene ese pase → ejecuta la acción del
		-- botón directamente. NO se vuelve a consultar S.pases a propósito:
		-- si viniera desincronizado se dispararía un ida-y-vuelta infinito.
		if a == "admin" then abrirAdmin()
		elseif a == "invisible" then RE.Toggle:FireServer("invisible")
		elseif a == "giant" or a == "god" then
			-- equipa la Tool SIN pasar por equipToggle/slotDesbloqueado: esos
			-- consultan S.pases, que es justo lo que puede venir desincronizado
			local nom = (a == "god") and "Slap" or "SlapGiant"
			local tool = buscarTool(nom)
			local hum = plr.Character
				and plr.Character:FindFirstChildOfClass("Humanoid")
			if tool and hum then
				if tool.Parent == plr.Character then hum:UnequipTools()
				else hum:EquipTool(tool) end
				pintarHotbar()
			end
		end
		return
	elseif tipo == "ruleta" then
		impRueda = 11   -- alguien giró: la rueda pega un acelerón y frena
		return
	elseif tipo == "rebote" then
		-- trampolín: YO (dueño de mi personaje) me aplico el impulso vertical.
		-- CLAVE: al ATERRIZAR, el Humanoid amortigua la velocidad (estado
		-- Landed) y se comía los rebotes 2, 3... → forzamos Freefall y
		-- reafirmamos la velocidad 3 frames seguidos = impulso SIEMPRE igual
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health &gt; 0 then
			local vy = tonumber(a) or 95
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
			task.spawn(function()
				for _ = 1, 3 do
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
					RunService.Heartbeat:Wait()
				end
			end)
		end
		return
	elseif tipo == "starCash" then
		-- +$10 del trampolín estrella: billete + "+10" verde que SUBE y se
		-- desvanece en pantalla (como cuando ganas algo) + sonido de moneda
		local monto = tonumber(a) or 10
		local cont = nuevo("Frame", {
			Size = UDim2.new(0, 170, 0, 46),
			Position = UDim2.new(0.5, math.random(-50, 50), 0.62, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1, ZIndex = 120,
		}, gui)
		local icoSC = nuevo("ImageLabel", {
			Size = UDim2.new(0, 42, 0, 42), Position = UDim2.new(0, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
			Image = Config.IMG_CASH, ScaleType = Enum.ScaleType.Fit, ZIndex = 121,
		}, cont)
		local tlSC = nuevo("TextLabel", {
			Size = UDim2.new(1, -48, 1, 0), Position = UDim2.new(0, 48, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
			Text = "+" .. monto, TextColor3 = Color3.fromRGB(120, 255, 120),
			TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 121,
		}, cont)
		local stSC = nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tlSC)
		sonar("rbxassetid://90153447839250", 0.5)
		TweenService:Create(cont, TweenInfo.new(0.9, Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out),
			{Position = UDim2.new(0.5, cont.Position.X.Offset, 0.48, 0)}):Play()
		task.spawn(function()
			task.wait(0.35)
			for i = 0.1, 1, 0.12 do
				tlSC.TextTransparency = i
				stSC.Transparency = i
				icoSC.ImageTransparency = i
				task.wait(0.05)
			end
			cont:Destroy()
		end)
		return
	elseif tipo == "premiumCaja" then
		-- 💎 REGALO PREMIUM v2 (estilo "win" de la ruleta de cajas): caja que
		-- tiembla FLUIDO (RenderStepped, 60 fps), FLASH blanco, la caja se
		-- INTERCAMBIA por la RAINBOW SLAP (pop elástico en su lugar), aura
		-- pulsante + rayos girando + destellos + confeti con física + flotación
		-- del premio. Interfaces con studs siempre.
		cerrarPanel()
		local MORP = Color3.fromRGB(58, 40, 96)
		local ORO = Color3.fromRGB(255, 190, 55)
		local pP = nuevo("Frame", {
			Size = UDim2.new(0, 540, 0, 600),
			Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = MORP, BorderSizePixel = 0, ZIndex = 80,
		}, gui)
		esquinas(pP, 18)
		borde(pP, 5)
		studsVivo(pP, MORP, MORP, 240, nil, true)
		panelAbierto = pP
		-- 🔍 sin zoom: la caja Premium salta sola al entrar y ya trae su propio
		-- espectáculo (flash, temblor, rayos). Un zoom encima sería ruido sobre ruido.
		pP:SetAttribute("SinZoom", true)
		popIn(pP)
		local vivoP = true
		pP.Destroying:Connect(function() vivoP = false end)
		local tt1 = nuevo("TextLabel", {
			Size = UDim2.new(1, -30, 0, 42), Position = UDim2.new(0.5, 0, 0, 24),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy,
			Text = esES and "POR SER USUARIO PREMIUM" or "FOR BEING PREMIUM",
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 82,
		}, pP)
		nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tt1)
		local tt2 = nuevo("TextLabel", {
			Size = UDim2.new(1, -40, 0, 30), Position = UDim2.new(0.5, 0, 0, 72),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = esES and "tenemos esta caja para ti:" or "we have this box for you:",
			TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, ZIndex = 82,
		}, pP)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tt2)
		-- escenario central
		local esc = nuevo("Frame", {
			Size = UDim2.new(1, 0, 0, 340), Position = UDim2.new(0, 0, 0, 112),
			BackgroundTransparency = 1, ZIndex = 82,
		}, pP)
		-- AURA circular pulsante (aparece al abrir)
		local glow = nuevo("Frame", {
			Size = UDim2.new(0, 330, 0, 330), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = ORO,
			BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 82,
			Visible = false,
		}, esc)
		nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, glow)
		local gsc = Instance.new("UIScale")
		gsc.Scale = 0.6
		gsc.Parent = glow
		-- RAYOS con degradado suave (aparecen al abrir)
		local rays = nuevo("Frame", {
			Size = UDim2.new(0, 640, 0, 640), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			ZIndex = 81, Visible = false,
		}, esc)
		for i = 1, 12 do
			local ray = nuevo("Frame", {
				Size = UDim2.new(0, 42, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5), Rotation = i * 15,
				BackgroundColor3 = Color3.fromHSV((i - 1) / 12, 0.6, 1),
				BackgroundTransparency = 0.78, BorderSizePixel = 0, ZIndex = 81,
			}, rays)
			nuevo("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(1, 1)})}, ray)
		end
		local raysSc = Instance.new("UIScale")
		raysSc.Scale = 0.2
		raysSc.Parent = rays
		local giroCon
		giroCon = RunService.RenderStepped:Connect(function(dt)
			if not vivoP then giroCon:Disconnect() return end
			if rays.Visible then rays.Rotation = (rays.Rotation + dt * 26) % 360 end
		end)
		-- CAJA de regalo (se INTERCAMBIA por el premio al abrir)
		local caja = nuevo("Frame", {
			Size = UDim2.new(0, 150, 0, 130), Position = UDim2.new(0.5, 0, 0.5, 24),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 84,
		}, esc)
		local cajaSc = Instance.new("UIScale")
		cajaSc.Scale = 1
		cajaSc.Parent = caja
		local cuerpo = nuevo("Frame", {
			Size = UDim2.new(0, 140, 0, 95), Position = UDim2.new(0.5, 0, 1, 0),
			AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = ORO,
			BorderSizePixel = 0, ZIndex = 84,
		}, caja)
		esquinas(cuerpo, 10)
		borde(cuerpo, 3)
		studsVivo(cuerpo, ORO, ORO, 70, nil, true)
		nuevo("Frame", {
			Size = UDim2.new(0, 22, 1, 0), Position = UDim2.new(0.5, 0, 0, 0),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(235, 60, 90),
			BorderSizePixel = 0, ZIndex = 86,
		}, cuerpo)
		local tapa = nuevo("Frame", {
			Size = UDim2.new(0, 160, 0, 34), Position = UDim2.new(0.5, 0, 0, 0),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 205, 80),
			BorderSizePixel = 0, ZIndex = 87,
		}, caja)
		esquinas(tapa, 8)
		borde(tapa, 3)
		-- 🎀 MOÑITO del hilo rojo sobre la tapa: dos lazos inclinados + colitas
		-- + nudo central (hijos de la tapa → tiembla y vuela con ella al abrir)
		local MONO = Color3.fromRGB(235, 60, 90)
		for _, mB in ipairs({
			{sx = 36, sy = 22, px = -13, rot = -26, ax = 1},   -- lazo izquierdo
			{sx = 36, sy = 22, px = 13, rot = 26, ax = 0},     -- lazo derecho
		}) do
			local lazo = nuevo("Frame", {
				Size = UDim2.new(0, mB.sx, 0, mB.sy),
				Position = UDim2.new(0.5, mB.px, 0, 2),
				AnchorPoint = Vector2.new(mB.ax, 1),
				BackgroundColor3 = MONO, BorderSizePixel = 0,
				Rotation = mB.rot, ZIndex = 88,
			}, tapa)
			esquinas(lazo, 8)
			borde(lazo, 3)
		end
		for _, mC in ipairs({
			{px = -12, rot = -14},                             -- colita izquierda
			{px = 12, rot = 14},                               -- colita derecha
		}) do
			local cola = nuevo("Frame", {
				Size = UDim2.new(0, 10, 0, 16),
				Position = UDim2.new(0.5, mC.px, 0, 12),
				AnchorPoint = Vector2.new(0.5, 0),
				Rotation = mC.rot, ZIndex = 88,
				BackgroundColor3 = MONO, BorderSizePixel = 0,
			}, tapa)
			esquinas(cola, 4)
			borde(cola, 2)
		end
		local nudo = nuevo("Frame", {
			Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0.5, 0, 0, 8),
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = Color3.fromRGB(210, 45, 75), BorderSizePixel = 0,
			ZIndex = 89,
		}, tapa)
		esquinas(nudo, 6)
		borde(nudo, 3)
		-- PREMIO (oculto; brota EN EL LUGAR de la caja)
		local premio = nuevo("ImageLabel", {
			Size = UDim2.new(0, 215, 0, 215), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Image = Config.IMG_GOD, ScaleType = Enum.ScaleType.Fit,
			ZIndex = 88, Visible = false,
		}, esc)
		local premioSc = Instance.new("UIScale")
		premioSc.Scale = 0
		premioSc.Parent = premio
		local nomP = nuevo("TextLabel", {
			Size = UDim2.new(1, -60, 0, 48), Position = UDim2.new(0.5, 0, 1, -152),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy, Text = "RAINBOW SLAP!",
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 88,
			Visible = false,
		}, pP)
		nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, nomP)
		gradRGB(nomP)
		local nomSc = Instance.new("UIScale")
		nomSc.Scale = 0
		nomSc.Parent = nomP
		-- ══ FASE 1: TIEMBLA fluido (RenderStepped, amplitud creciendo) ══
		local t0 = os.clock()
		local shakeCon
		shakeCon = RunService.RenderStepped:Connect(function()
			if not vivoP then shakeCon:Disconnect() return end
			local tS = os.clock() - t0
			if tS &gt;= 2.4 then
				caja.Rotation = 0
				shakeCon:Disconnect()
				return
			end
			local amp = math.min(11, 1 + tS * 4.2)        -- arranca suave y crece despacio
			caja.Rotation = math.sin(tS * 16) * amp
			cajaSc.Scale = 1 + math.sin(tS * 32) * 0.02   -- vibra un pelín de tamaño
		end)
		-- ══ FASE 2: ¡SE ABRE! (a los 2.4 s) ══
		task.delay(2.4, function()
			if not vivoP then return end
			-- FLASH blanco
			local flash = nuevo("Frame", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, ZIndex = 95,
			}, pP)
			esquinas(flash, 18)
			TweenService:Create(flash, TweenInfo.new(0.5, Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
			task.delay(0.55, function() if flash.Parent then flash:Destroy() end end)
			-- tapa vuela; la caja SE ENCOGE hasta desaparecer (intercambio)
			TweenService:Create(tapa, TweenInfo.new(0.45, Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -90, 0, -150),
				Rotation = -50, BackgroundTransparency = 1}):Play()
			TweenService:Create(cajaSc, TweenInfo.new(0.32, Enum.EasingStyle.Back,
				Enum.EasingDirection.In), {Scale = 0}):Play()
			task.delay(0.32, function() if caja.Parent then caja.Visible = false end end)
			-- sonido de GANAR
			sonar("rbxassetid://127039883737564", 0.7)
			-- aura + rayos (pop elástico) + destellos
			glow.Visible = true
			TweenService:Create(gsc, TweenInfo.new(1.0, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1, true), {Scale = 1.1}):Play()
			rays.Visible = true
			TweenService:Create(raysSc, TweenInfo.new(0.5, Enum.EasingStyle.Back,
				Enum.EasingDirection.Out), {Scale = 1}):Play()
			for i = 1, 7 do
				local ang = math.rad(i * (360 / 7) + math.random(-12, 12))
				local rr = math.random(140, 200)
				local sp = nuevo("TextLabel", {
					Size = UDim2.new(0, 40, 0, 40),
					Position = UDim2.new(0.5, math.cos(ang) * rr, 0.5, math.sin(ang) * rr),
					AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
					Text = "✦", Font = Enum.Font.LuckiestGuy, TextScaled = true,
					TextColor3 = Color3.fromRGB(255, 255, 205), ZIndex = 89,
				}, esc)
				nuevo("UIStroke", {Thickness = 2, Color = Color3.fromRGB(120, 90, 0)}, sp)
				local ssc = Instance.new("UIScale")
				ssc.Scale = 0.2
				ssc.Parent = sp
				TweenService:Create(ssc, TweenInfo.new(0.5 + math.random() * 0.5,
					Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true,
					math.random() * 0.4), {Scale = 1.15}):Play()
			end
			-- el PREMIO brota EN EL LUGAR de la caja con pop elástico
			task.delay(0.22, function()
				if not vivoP then return end
				premio.Visible = true
				TweenService:Create(premioSc, TweenInfo.new(0.75, Enum.EasingStyle.Back,
					Enum.EasingDirection.Out), {Scale = 1}):Play()
				nomP.Visible = true
				TweenService:Create(nomSc, TweenInfo.new(0.6, Enum.EasingStyle.Back,
					Enum.EasingDirection.Out), {Scale = 1}):Play()
				-- FLOTA suave y se ladea (fluido, RenderStepped)
				local tF0 = os.clock()
				local flotCon
				flotCon = RunService.RenderStepped:Connect(function()
					if not vivoP then flotCon:Disconnect() return end
					local tf = os.clock() - tF0
					premio.Position = UDim2.new(0.5, 0, 0.5, math.sin(tf * 2.2) * 8)
					premio.Rotation = math.sin(tf * 1.6) * 7
				end)
			end)
			-- CONFETI con física (48 piezas)
			for i = 1, 48 do
				task.delay(math.random() * 0.35, function()
					if not vivoP then return end
					local cf = nuevo("Frame", {
						Size = UDim2.new(0, math.random(6, 12), 0, math.random(6, 12)),
						Position = UDim2.new(0.5, math.random(-50, 50), 0.42, 0),
						BackgroundColor3 = Color3.fromHSV(math.random(), 0.85, 1),
						BorderSizePixel = 0, Rotation = math.random(0, 180), ZIndex = 90,
					}, pP)
					local vxC = math.random(-190, 190)
					local vyC = -math.random(150, 300)
					local x0 = cf.Position.X.Offset
					local giroC = math.random(-320, 320)
					local tC0 = os.clock()
					local conC
					conC = RunService.RenderStepped:Connect(function()
						local tc = os.clock() - tC0
						if tc &gt; 1.7 or not cf.Parent then
							conC:Disconnect()
							if cf.Parent then cf:Destroy() end
							return
						end
						cf.Position = UDim2.new(0.5, x0 + vxC * tc, 0.42,
							vyC * tc + 400 * tc * tc)
						cf.Rotation = cf.Rotation + giroC * 0.016
						cf.BackgroundTransparency = math.max(0, tc - 1.0) / 0.7
					end)
				end)
			end
			-- botón RECLAMAR (pop elástico)
			task.delay(0.8, function()
				if not vivoP then return end
				local btnP = nuevo("TextButton", {
					Size = UDim2.new(0, 240, 0, 56), Position = UDim2.new(0.5, 0, 1, -14),
					AnchorPoint = Vector2.new(0.5, 1),
					BackgroundColor3 = Color3.fromRGB(70, 210, 70),
					Text = "", BorderSizePixel = 0, ZIndex = 88,
				}, pP)
				esquinas(btnP, 12)
				borde(btnP, 3)
				studsVivo(btnP, Color3.fromRGB(70, 210, 70), Color3.fromRGB(70, 210, 70),
					110, nil, true)
				local bsc = Instance.new("UIScale")
				bsc.Scale = 0
				bsc.Parent = btnP
				TweenService:Create(bsc, TweenInfo.new(0.5, Enum.EasingStyle.Back,
					Enum.EasingDirection.Out), {Scale = 1}):Play()
				local blP = nuevo("TextLabel", {
					Size = UDim2.new(1, -10, 1, -10), Position = UDim2.new(0.5, 0, 0.5, 0),
					AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
					Font = Enum.Font.LuckiestGuy, Text = esES and "¡RECLAMAR!" or "CLAIM!",
					TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 90,
				}, btnP)
				nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
					LineJoinMode = Enum.LineJoinMode.Round}, blP)
				btnP.MouseButton1Click:Connect(function()
					sndPop.TimePosition = 0
					sndPop:Play()          -- pop de palomita (como el free slap)
					if panelAbierto == pP then panelAbierto = nil end
					-- salida en DEGRADADO: toda la interfaz se funde (textos,
					-- studs, premio, aura, rayos) mientras se encoge suavecito
					local scP = pP:FindFirstChildOfClass("UIScale")
					if scP then
						TweenService:Create(scP, TweenInfo.new(0.55,
							Enum.EasingStyle.Quad, Enum.EasingDirection.In),
							{Scale = 0.88}):Play()
					end
					desvanecer(pP, 0.55)
					-- 1 s después de cerrar el regalo premium → abre el calendario
					task.delay(1, function()
						if abrirCalendarioAuto then abrirCalendarioAuto() end
					end)
				end)
			end)
		end)
		return
	elseif tipo == "resbalon" then
		-- 🍌 pisaste una banana: ¡al suelo! FallingDown tumba al personaje
		-- (se levanta solo ~2 s) y patina hacia donde iba
		local charR = plr.Character
		local rootR = charR and charR:FindFirstChild("HumanoidRootPart")
		local humR = charR and charR:FindFirstChildOfClass("Humanoid")
		if not rootR or not humR or humR.Health &lt;= 0 then return end
		local vR = rootR.AssemblyLinearVelocity
		humR:ChangeState(Enum.HumanoidStateType.FallingDown)
		rootR.AssemblyLinearVelocity = Vector3.new(vR.X * 1.6, 12, vR.Z * 1.6)
		return
	elseif tipo == "fling" then
		-- el server me eligió como víctima del slap: YO (dueño) me aplico el
		-- impulso (a=dirección, b=fuerza). CLAVE: suelto el control con
		-- PlatformStand para que el personaje SALGA VOLANDO y SE CAIGA de verdad,
		-- en vez de que el Humanoid se auto-enderece y absorba el golpe.
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health &gt; 0 then
			hum.PlatformStand = true                       -- suelta el control → vuela y cae
			root.AssemblyLinearVelocity = a * b + Vector3.new(0, b * 0.45, 0)
			root.AssemblyAngularVelocity = Vector3.new(6, 3, 6)   -- que dé vueltas al volar
			task.delay(1.3, function()                     -- recupera el control al aterrizar
				if hum and hum.Parent and hum.Health &gt; 0 then hum.PlatformStand = false end
			end)
		end
		return
	elseif tipo == "moneda" and typeof(a) == "Instance" then
		local monto = tonumber(b) or Config.MONEDA_ORO
		a.LocalTransparencyModifier = 1
		for _, dd in ipairs(a:GetChildren()) do      -- ocultar también las caritas
			if dd:IsA("Decal") then dd.Transparency = 1 end
		end
		-- (sin reaparición: la moneda queda oculta PARA TI toda la sesión;
		--  a los demás jugadores ni les afecta — cada quien ve las suyas)
		particulas(a.Position, Color3.fromRGB(255, 220, 70), 16, 10)
		-- sonido de recoger moneda (ID del usuario)
		sonar("rbxassetid://90153447839250", 0.6)
		-- icono del dinero + texto "+$25" que suben desde la moneda y se
		-- desvanecen juntos
		local hayIco = hayImg(Config.IMG_CASH)
		local anc = Instance.new("Part")
		anc.Anchored = true
		anc.CanCollide = false
		anc.Transparency = 1
		anc.Size = Vector3.new(1, 1, 1)
		anc.CFrame = CFrame.new(a.Position + Vector3.new(0, 2.5, 0))
		anc.Parent = workspace
		local bg = Instance.new("BillboardGui")
		bg.Size = UDim2.new(0, hayIco and 150 or 110, 0, 50)
		bg.AlwaysOnTop = true
		bg.Parent = anc
		local ico
		if hayIco then
			ico = Instance.new("ImageLabel")
			ico.Size = UDim2.new(0, 46, 0, 46)
			ico.Position = UDim2.new(0, 2, 0.5, -23)
			ico.BackgroundTransparency = 1
			ico.Image = Config.IMG_CASH
			ico.ScaleType = Enum.ScaleType.Fit
			ico.Parent = bg
		end
		local tl = Instance.new("TextLabel")
		tl.Size = hayIco and UDim2.new(1, -50, 1, 0) or UDim2.new(1, 0, 1, 0)
		tl.Position = hayIco and UDim2.new(0, 50, 0, 0) or UDim2.new(0, 0, 0, 0)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.LuckiestGuy
		centrarTexto(tl)
		tl.Text = "+$" .. monto
		tl.TextColor3 = Color3.fromRGB(120, 255, 120)
		tl.TextScaled = true
		tl.TextXAlignment = hayIco and Enum.TextXAlignment.Left
			or Enum.TextXAlignment.Center
		tl.Parent = bg
		local st = Instance.new("UIStroke")
		st.Thickness = 2.8
		st.Color = Color3.new(0, 0, 0)
		st.Parent = tl
		TweenService:Create(anc, TweenInfo.new(1, Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out),
			{CFrame = anc.CFrame + Vector3.new(0, 5.5, 0)}):Play()
		task.spawn(function()
			for i = 0, 1, 0.1 do
				tl.TextTransparency = i
				st.Transparency = i
				if ico then ico.ImageTransparency = i end
				task.wait(0.085)
			end
			anc:Destroy()
		end)
	elseif tipo == "sonidoGanar" then
		-- claim del COFRE de la cima: SOLO la campanada 108875729772405 DOS
		-- VECES, bien separadas (el jingle y el ping default se quitaron a
		-- pedido del usuario)
		for _, dlG in ipairs({0.05, 1.5}) do   -- bien separados (pedido del usuario)
			task.delay(dlG, function()
				sonar("rbxassetid://108875729772405", 0.8)
			end)
		end
	elseif tipo == "trofeo" then
		-- +1 TROFEO que sube desde el cofre de la cima y se desvanece
		-- (misma animación que el dinero, pero con el ícono del trofeo)
		local pos = (typeof(a) == "Vector3" and a)
			or (typeof(a) == "Instance" and a.Position) or nil
		if pos then
			local monto = tonumber(b) or 1
			local hayIco = hayImg(Config.IMG_TROFEO)
			-- (ping default de Roblox ELIMINADO: el claim solo usa las
			--  campanadas 108875729772405 del usuario)
			local anc = Instance.new("Part")
			anc.Anchored = true
			anc.CanCollide = false
			anc.Transparency = 1
			anc.Size = Vector3.new(1, 1, 1)
			anc.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
			anc.Parent = workspace
			local bg = Instance.new("BillboardGui")
			bg.Size = UDim2.new(0, hayIco and 130 or 90, 0, 52)
			bg.AlwaysOnTop = true
			bg.Parent = anc
			local ico
			if hayIco then
				ico = Instance.new("ImageLabel")
				ico.Size = UDim2.new(0, 48, 0, 48)
				ico.Position = UDim2.new(0, 2, 0.5, -24)
				ico.BackgroundTransparency = 1
				ico.Image = Config.IMG_TROFEO
				ico.ScaleType = Enum.ScaleType.Fit
				ico.Parent = bg
			end
			local tl = Instance.new("TextLabel")
			tl.Size = hayIco and UDim2.new(1, -52, 1, 0) or UDim2.new(1, 0, 1, 0)
			tl.Position = hayIco and UDim2.new(0, 52, 0, 0) or UDim2.new(0, 0, 0, 0)
			tl.BackgroundTransparency = 1
			tl.Font = Enum.Font.LuckiestGuy
			centrarTexto(tl)
			tl.Text = "+" .. monto
			tl.TextColor3 = Color3.fromRGB(255, 215, 70)
			tl.TextScaled = true
			tl.TextXAlignment = hayIco and Enum.TextXAlignment.Left
				or Enum.TextXAlignment.Center
			tl.Parent = bg
			local st = Instance.new("UIStroke")
			st.Thickness = 2.8
			st.Color = Color3.new(0, 0, 0)
			st.Parent = tl
			TweenService:Create(anc, TweenInfo.new(1.1, Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out),
				{CFrame = anc.CFrame + Vector3.new(0, 6, 0)}):Play()
			task.spawn(function()
				for i = 0, 1, 0.1 do
					tl.TextTransparency = i
					st.Transparency = i
					if ico then ico.ImageTransparency = i end
					task.wait(0.09)
				end
				anc:Destroy()
			end)
		end
	elseif tipo == "dineroFlota" then
		-- +$X flotante con ícono de BILLETES (igual que las monedas), para el obby
		local pos = (typeof(a) == "Vector3" and a)
			or (typeof(a) == "Instance" and a.Position) or nil
		if pos then
			local monto = tonumber(b) or 0
			local txt = "+$" .. (Config.formatoCash and Config.formatoCash(monto) or tostring(monto))
			local hayIco = hayImg(Config.IMG_CASH)
			local anc = Instance.new("Part")
			anc.Anchored = true
			anc.CanCollide = false
			anc.Transparency = 1
			anc.Size = Vector3.new(1, 1, 1)
			anc.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
			anc.Parent = workspace
			local bg = Instance.new("BillboardGui")
			bg.Size = UDim2.new(0, hayIco and 190 or 140, 0, 60)
			bg.AlwaysOnTop = true
			bg.Parent = anc
			local ico
			if hayIco then
				ico = Instance.new("ImageLabel")
				ico.Size = UDim2.new(0, 54, 0, 54)
				ico.Position = UDim2.new(0, 2, 0.5, -27)
				ico.BackgroundTransparency = 1
				ico.Image = Config.IMG_CASH
				ico.ScaleType = Enum.ScaleType.Fit
				ico.Parent = bg
			end
			local tl = Instance.new("TextLabel")
			tl.Size = hayIco and UDim2.new(1, -58, 1, 0) or UDim2.new(1, 0, 1, 0)
			tl.Position = hayIco and UDim2.new(0, 58, 0, 0) or UDim2.new(0, 0, 0, 0)
			tl.BackgroundTransparency = 1
			tl.Font = Enum.Font.LuckiestGuy
			centrarTexto(tl)
			tl.Text = txt
			tl.TextColor3 = Color3.fromRGB(120, 255, 120)
			tl.TextScaled = true
			tl.TextXAlignment = hayIco and Enum.TextXAlignment.Left
				or Enum.TextXAlignment.Center
			tl.Parent = bg
			local st = Instance.new("UIStroke")
			st.Thickness = 2.8
			st.Color = Color3.new(0, 0, 0)
			st.Parent = tl
			TweenService:Create(anc, TweenInfo.new(1.2, Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out),
				{CFrame = anc.CFrame + Vector3.new(0, 6, 0)}):Play()
			task.spawn(function()
				for i = 0, 1, 0.1 do
					tl.TextTransparency = i
					st.Transparency = i
					if ico then ico.ImageTransparency = i end
					task.wait(0.075)
				end
				anc:Destroy()
			end)
		end
	elseif tipo == "confeti" and a then
		particulas(a, Color3.fromRGB(255, 210, 60), 30, 16)
	elseif tipo == "obbyCompletado" then
		-- obby exterior completado: SOLO el sonido original (se quitó el de ganar)
		sonar("rbxassetid://307631257", 0.6)
	elseif tipo == "morphOn" then
		-- te pones una manzana: el MISMO sonido de ganar premio en las cajas
		-- (2D en tu gui = solo lo oyes tú, no todo el piso)
		sonar("rbxassetid://127039883737564", 0.7)
	elseif tipo == "reiniciarCheckpoints" then
		-- 🔄 pisó el pad verde "Return to obby": la subida vuelve a empezar de
		-- cero, así que los botones recuperan su color original. Sin esto se
		-- quedarían verdes de la vuelta anterior y el niño no sabría que ya se
		-- pueden volver a pisar.
		for f, c in pairs(colorOrigCP) do
			local bCP = workspace:FindFirstChild("CheckpointBtn_" .. f, true)
			if bCP and c.btn then
				TweenService:Create(bCP, TweenInfo.new(0.3), {Color = c.btn}):Play()
			end
			local aCP = workspace:FindFirstChild("CheckpointAro_" .. f, true)
			if aCP and c.aro then
				TweenService:Create(aCP, TweenInfo.new(0.3), {Color = c.aro}):Play()
			end
		end
		table.clear(colorOrigCP)
		if cancelarVolver then cancelarVolver() end   -- y apaga ya el "BACK TO FLOOR"
	elseif tipo == "compraOk" then
		-- sonido al comprar en cualquiera de las 2 tiendas (Gears o Crates)
		sonar("rbxassetid://79392333090964", 0.6)
	elseif tipo == "fuegos" and a then
		-- 8 ráfagas visuales DISPERSAS en el tiempo (el show dura más)
		for i = 1, 8 do
			task.delay(0.1 + (i - 1) * 0.55 + math.random() * 0.3, function()
				particulas(a + Vector3.new(math.random(-14, 14), 8 + i * 4,
					math.random(-14, 14)),
					Color3.fromHSV(math.random(), 0.8, 1), 40, 26)
			end)
		end
		-- 8 sonidos de cohete DISPERSOS en ~5 s y COMBINADOS (se solapan, con tonos
		-- y volúmenes variados) → show de fuegos LARGO que acompaña al de ganar (3D)
		local ancF = Instance.new("Part")
		ancF.Anchored = true
		ancF.CanCollide = false
		ancF.Transparency = 1
		ancF.Size = Vector3.new(1, 1, 1)
		ancF.CFrame = CFrame.new(a)
		ancF.Parent = workspace
		for fi = 1, 8 do
			task.delay(fi == 1 and 0 or math.random() * 5, function()
				if not ancF.Parent then return end
				local sndF = Instance.new("Sound")
				sndF.SoundId = "rbxassetid://100559751053348"
				sndF.Volume = 0.5 + math.random() * 0.25          -- volúmenes variados = se combinan
				sndF.RollOffMaxDistance = 200
				sndF.PlaybackSpeed = 0.82 + math.random() * 0.42   -- tonos variados = cada cohete distinto
				sndF.Parent = ancF
				sndF:Play()
			end)
		end
		task.delay(15, function() ancF:Destroy() end)   -- cubre el show largo
	elseif tipo == "batHit" and a then
		-- 🏏 golpe del BATE conectado: SOLO sonido, SIN brillitos (los
		-- destellos amarillos se quitaron el 2026-07-25 a pedido del usuario).
		-- ⚠️ El sonido SOLO para los DEMÁS (b = quien golpeó): el atacante ya
		-- lo oyó en su propio Tool (BatLogic, local e instantáneo). Sin este
		-- filtro lo escucharía DOBLE. Y sin este FX, los otros jugadores no
		-- oirían nada: un Sound creado por un LocalScript NO se replica.
		-- Normalmente el atacante se salta este sonido (ya oyó el suyo local).
		-- EXCEPCIÓN: si tocó el "enrique" (c) SÍ lo oye — es un audio distinto
		-- del batazo, así que no se duplica: suena el golpe y encima el gag.
		if b ~= plr or c then
			local ancB = Instance.new("Part")
			ancB.Anchored = true
			ancB.CanCollide = false
			ancB.Transparency = 1
			ancB.Size = Vector3.new(1, 1, 1)
			ancB.CFrame = CFrame.new(a)
			ancB.Parent = workspace
			local sndB = Instance.new("Sound")
			-- c = true → suena el "enrique" (30%, lo sorteó el server) en vez del
			-- batazo normal. Va más bajito porque ese audio es muy fuerte.
			sndB.SoundId = c and "rbxassetid://129084748747846"
				or "rbxassetid://126657623386649"
			sndB.Volume = c and 0.5 or 0.8
			sndB.RollOffMaxDistance = 120
			sndB.Parent = ancB
			sndB:Play()
			task.delay(3, function() ancB:Destroy() end)
		end
	elseif tipo == "slap" and a then
		particulas(a, b and Color3.fromRGB(255, 80, 255) or Color3.new(1, 1, 1), 18, 14)
		-- sonido del cachetadón (3D, suena en el punto del golpe)
		local anc = Instance.new("Part")
		anc.Anchored = true
		anc.CanCollide = false
		anc.Transparency = 1
		anc.Size = Vector3.new(1, 1, 1)
		anc.CFrame = CFrame.new(a)
		anc.Parent = workspace
		local snd = Instance.new("Sound")
		snd.SoundId = "rbxassetid://126619107266979"
		snd.Volume = 0.7                   -- -30% (2026-07-19)
		snd.RollOffMaxDistance = 150
		snd.Parent = anc
		snd:Play()
		task.delay(4, function() anc:Destroy() end)
	elseif tipo == "muerteGusano" and a then
		-- sonido de MUERTE del gusano: 3D, lo oyen todos los cercanos (~6 pisos)
		local ancM = Instance.new("Part")
		ancM.Anchored = true
		ancM.CanCollide = false
		ancM.Transparency = 1
		ancM.Size = Vector3.new(1, 1, 1)
		ancM.CFrame = CFrame.new(a)
		ancM.Parent = workspace
		local sndM = Instance.new("Sound")
		sndM.SoundId = "rbxassetid://115878657073501"   -- nuevo (ya no es el grito)
		sndM.Volume = 0.7
		sndM.RollOffMaxDistance = 240      -- ~6 pisos (40 c/u) de alcance
		sndM.RollOffMinDistance = 12
		sndM.Parent = ancM
		sndM:Play()
		task.delay(6, function() ancM:Destroy() end)
	elseif tipo == "flingSonido" and a then
		-- sonido de FLING (te lanzan/ragdoll): 3D, todos los cercanos (~2 pisos)
		local ancFl = Instance.new("Part")
		ancFl.Anchored = true
		ancFl.CanCollide = false
		ancFl.Transparency = 1
		ancFl.Size = Vector3.new(1, 1, 1)
		ancFl.CFrame = CFrame.new(a)
		ancFl.Parent = workspace
		local sndFl = Instance.new("Sound")
		-- 'b' lo decidió el server (10%): true = sonido alterno, false = grito.
		-- Así TODOS los cercanos oyen lo mismo en esta cachetada.
		sndFl.SoundId = b
			and "rbxassetid://129084748747846"    -- alterno "enrique" (10%)
			or "rbxassetid://136680544819732"     -- grito normal (90%)
		sndFl.Volume = b and 0.50 or 1     -- el alterno ("enrique") va bajito: es muy fuerte
		sndFl.RollOffMaxDistance = 80      -- ~2 pisos (40 c/u)
		sndFl.RollOffMinDistance = 8
		sndFl.Parent = ancFl
		sndFl:Play()
		task.delay(4, function() ancFl:Destroy() end)
	elseif tipo == "aciertoPuerta" and a then
		-- sonido de ACIERTO de la puerta de mate: 3D, todos los cercanos (~6 pisos)
		local ancA = Instance.new("Part")
		ancA.Anchored = true
		ancA.CanCollide = false
		ancA.Transparency = 1
		ancA.Size = Vector3.new(1, 1, 1)
		ancA.CFrame = CFrame.new(a)
		ancA.Parent = workspace
		local sndA = Instance.new("Sound")
		sndA.SoundId = "rbxassetid://130206997868957"
		sndA.Volume = 1
		sndA.RollOffMaxDistance = 240      -- ~6 pisos (40 c/u)
		sndA.RollOffMinDistance = 12
		sndA.Parent = ancA
		sndA:Play()
		task.delay(5, function() ancA:Destroy() end)
	elseif tipo == "errorPuerta" and a then
		-- sonido de ERROR de la puerta de mate: 3D, todos los cercanos (~6 pisos)
		local ancE = Instance.new("Part")
		ancE.Anchored = true
		ancE.CanCollide = false
		ancE.Transparency = 1
		ancE.Size = Vector3.new(1, 1, 1)
		ancE.CFrame = CFrame.new(a)
		ancE.Parent = workspace
		local sndE = Instance.new("Sound")
		sndE.SoundId = "rbxassetid://2979857617"
		sndE.Volume = 1
		sndE.RollOffMaxDistance = 240      -- ~6 pisos (40 c/u)
		sndE.RollOffMinDistance = 12
		sndE.TimePosition = 0.15          -- salta el silencio inicial del audio → suena "antes"/sincronizado
		sndE.Parent = ancE
		sndE:Play()
		sndE.TimePosition = 0.15          -- (reafirma tras Play por si el asset lo reinicia)
		task.delay(5, function() ancE:Destroy() end)
	elseif tipo == "abrirRuleta" then
		abrirRuleta()
	elseif tipo == "abrirCrates" then
		abrirCrates()
	elseif tipo == "crateGira" and a then
		animarCrate(a)
	elseif tipo == "abrirDonar" then
		abrirDonar()
	elseif tipo == "killAllTodos" and a then
		-- 💀 alguien compró Kill All: TODO el server se entera
		mostrarToast((esES and "💀 ¡%s ELIMINÓ A TODOS!"
			or "💀 %s ELIMINATED EVERYONE!"):format(a),
			Color3.fromRGB(255, 80, 80), 5)
		sonar("rbxassetid://133312610824902", 0.6)
	elseif tipo == "donaTodos" and a then
		-- 💖 alguien donó: TODO el server lo celebra (llega a todos porque el
		-- server hace FireAllClients; cada cliente lo reproduce en su gui)
		mostrarToast((esES and "💖 ¡%s donó %d Robux! ¡GRACIAS!"
			or "💖 %s donated %d Robux! THANK YOU!"):format(a, b or 0),
			Color3.fromRGB(255, 120, 200), 5)
		for _, sd in ipairs({{"rbxassetid://88060724643515", 0},
				{"rbxassetid://1846942308", 0.5}}) do
			task.delay(sd[2], function()
				sonar(sd[1], 0.8)
			end)
		end
	elseif tipo == "abrirGears" then
		abrirGears()
	elseif tipo == "abrirCofre" then
		abrirCofre(a)
	end
end)

-- ═══ VUELO DE ALFOMBRA (cliente controla su propia física) ═
local volando = nil
local sentadoTrack = nil   -- pose SENTADO sobre la alfombra mientras vuelas
-- ⚡ FUGA DE ANIMACIONES (2026-07-24): antes cada vez que te subías a la alfombra
-- se creaba una Animation NUEVA y se cargaba otra pista; al bajarte solo se
-- hacía Stop() (la pista seguía cargada en el Animator). A las ~64 subidas se
-- reventaba el límite de 64 AnimationTracks y dejaban de reproducirse TODAS las
-- animaciones, incluidas las de caminar/correr por defecto de Roblox → el
-- personaje se quedaba tieso. Ahora la Animation se crea 1 vez y la pista se
-- LIBERA (Destroy) al bajarse.
local animSentado = Instance.new("Animation")
animSentado.AnimationId = "rbxassetid://2506281703"   -- sentado oficial (el de los asientos)
local function soltarSentado(suave)
	if sentadoTrack then
		pcall(function()
			sentadoTrack:Stop(suave or 0)
			sentadoTrack:Destroy()
		end)
		sentadoTrack = nil
	end
end
local function sentarse(hum, on)
	if on and hum then
		soltarSentado()
		local ok, tr = pcall(function()
			return (hum:FindFirstChildOfClass("Animator") or hum):LoadAnimation(animSentado)
		end)
		if ok and tr then
			tr.Priority = Enum.AnimationPriority.Action   -- gana a caminar/caer/idle
			tr.Looped = true
			tr:Play(0.15)
			sentadoTrack = tr
		end
	elseif not on and sentadoTrack then
		soltarSentado(0.2)
	end
end
local function actualizarVuelo()
	local quiere = S.equip.carpet
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if quiere and root and hum and hum.Health &gt; 0 then
		if not volando or volando.root ~= root then
			if volando then volando.lv:Destroy() volando.att:Destroy() end
			local att = Instance.new("Attachment")
			att.Parent = root
			local lv = Instance.new("LinearVelocity")
			lv.Attachment0 = att
			lv.MaxForce = 60000
			lv.VectorVelocity = Vector3.zero
			lv.Parent = root
			volando = {root = root, lv = lv, att = att}
			-- se SIENTA solo si HAY alfombra debajo. Volando prestado por el God
			-- Mode no hay nada donde sentarse: se va de pie, como un dios.
			-- (misma regla que el visualCarpet del server, ver refrescarGear)
			local conAlfombra = (S.pases and S.pases.carpet) or (S.flyLeft or 0) &gt; 0
				or Config.GOD_VUELO_ALFOMBRA
			sentarse(hum, conAlfombra)
		end
	elseif volando then
		volando.lv:Destroy()
		volando.att:Destroy()
		volando = nil
		sentarse(nil, false)        -- de pie al bajarse
	end
end

-- VUELO relativo a la CÁMARA: adelante = hacia donde MIRAS (con su inclinación),
-- así al mirar abajo y avanzar bajas, al mirar arriba subes, etc. (ya no Space/Shift)
RunService.RenderStepped:Connect(function()
	if not volando then return end
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local cam = workspace.CurrentCamera
	if not hum or not cam then return end
	local mv = hum.MoveDirection            -- lo que pide el jugador (horizontal, según cámara)
	if mv.Magnitude &lt; 0.05 then
		volando.lv.VectorVelocity = Vector3.zero
		return
	end
	local camcf = cam.CFrame
	local look = camcf.LookVector           -- dirección REAL de la cámara (incluye pitch)
	local right = camcf.RightVector
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	local vel
	if lookFlat.Magnitude &lt; 1e-3 then       -- cámara casi vertical → adelante = mirar directo
		vel = look
	else
		lookFlat = lookFlat.Unit
		local fwd = mv:Dot(lookFlat)        -- componente adelante(+)/atrás(-)
		local side = mv:Dot(right)          -- componente derecha(+)/izquierda(-)
		vel = look * fwd + right * side     -- adelante sigue la mirada (con altura); lados horizontales
	end
	if vel.Magnitude &gt; 0.01 then
		volando.lv.VectorVelocity = vel.Unit * Config.CARPETA_VEL
	else
		volando.lv.VectorVelocity = Vector3.zero
	end
end)

-- ═══ SYNC ══════════════════════════════════════════════════
RE.Sync.OnClientEvent:Connect(function(estado)
	if not estado then return end
	S = estado
	labelCash.Text = Config.formatoCash(S.cash)
	labelTrofeo.Text = tostring(S.trofeos)
	labelAmigos.Text = "Friend Boost: +" .. (S.boostAmigos * 10) .. "%"
	if S.pases.speed2x then
		precioSpeed.Text = "✓"
		labelSpeed.Text = "2x Speed ✓"
	end
	pintarHotbar()
	actualizarVuelo()
	actualizarRuedaUI()
	if refrescarCalendario then refrescarCalendario() end
	if pintarBotonCal then pintarBotonCal() end
	-- 🍎 la skin viene en el Sync: el botón redondo enseña la que llevas puesta
	-- y, si el menú está abierto, se repinta solo al equipar o al desbloquear
	if pintarBotonSkins then pintarBotonSkins() end
	if refrescarSkins then refrescarSkins() end
end)

-- (ocultador del prompt Push eliminado: el prompt ya no existe)

-- ═══ CALENDARIO DIARIO (7 días, textura de cuadritos) ══════════════════════
-- estado de cada día: D&lt;calDia = reclamado ✓ · D==calDia y calListo = RECLAMAR
-- · resto = candado. calDia es el PRÓXIMO día a reclamar (el server lo avanza).
local ICONO_CAL = {
	jumpcoil = Config.IMG_JUMPCOIL, speedcoil = Config.IMG_COIL,
	invisible = Config.IMG_INVISIBLE,
	giant = Config.IMG_GIANT,   -- 🖐 premio del día 4 (antes el Speed Coil)
}
function refrescarCalendario() end   -- se re-define al abrir; no-op si está cerrado

local function abrirCalendario()
	cerrarPanel()
	local VERDE  = Color3.fromRGB(55, 185, 85)
	local MORADO = Color3.fromRGB(150, 55, 235)   -- día 7 = Invisible (tono del pase)
	local AZUL   = Color3.fromRGB(55, 145, 240)   -- Gravity Coil (resorte azul)
	local ROJO   = Color3.fromRGB(230, 70, 70)    -- Speed Coil (resorte rojo)
	local p = nuevo("Frame", {
		Size = UDim2.new(0, 640, 0, 466),   -- pegado a la rejilla (sin franja vacía abajo)
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(250, 251, 255), BorderSizePixel = 0,
		BackgroundTransparency = 0.55,   -- translúcido: se ve el juego detrás (como las cajas)
		ZIndex = 200,
	}, gui)
	esquinas(p, 18)
	borde(p, 5)
	-- relieve de studs suave sobre el fondo translúcido (igual que panelTienda)
	local pimg = nuevo("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Image = Config.IMG_STUDS, ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.new(0, 210, 0, 210),
		ImageColor3 = Color3.new(1, 1, 1), ImageTransparency = 0.88,
		ZIndex = 200,
	}, p)
	nuevo("UICorner", {CornerRadius = UDim.new(0, 18)}, pimg)
	-- HEADER: banda de color con textura de studs (como Crates): título con
	-- contorno + icono de regalo que sobresale + botón X estilizado
	local COL_HD = Color3.fromRGB(245, 165, 40)   -- dorado festivo (regalos)
	local hd = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 201,
	}, p)
	esquinas(hd, 18) ; borde(hd, 4)
	studsVivo(hd, vivo(COL_HD, 1.2, 1.0), COL_HD, 190, 0)
	-- icono de regalo (sobresale por arriba-izquierda, ligeramente girado)
	nuevo("TextLabel", {
		Size = UDim2.new(0, 72, 0, 72), Position = UDim2.new(0, 10, 0, -8),
		BackgroundTransparency = 1, Text = "🎁", TextScaled = true,
		Font = Enum.Font.FredokaOne, Rotation = -10, ZIndex = 203,
	}, p)
	local tl = nuevo("TextLabel", {
		Size = UDim2.new(1, -240, 0, 44), Position = UDim2.new(0, 92, 0, 9),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
		Text = esES and "REGALOS DIARIOS" or "DAILY GIFTS",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 203,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, p)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tl)
	local xC = nuevo("TextButton", {
		Size = UDim2.new(0, 50, 0, 50), Position = UDim2.new(1, -60, 0, 6),
		BackgroundColor3 = Color3.fromRGB(238, 42, 78), Font = Enum.Font.FredokaOne,
		Text = "X", TextColor3 = Color3.new(1, 1, 1), TextSize = 28,
		BorderSizePixel = 0, ZIndex = 203,
	}, p)
	esquinas(xC, 10)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.fromRGB(255, 150, 170)}, xC)
	xC:SetAttribute("Mute", true)
	xC.MouseButton1Click:Connect(cerrarPanel)

	-- construye UNA tarjeta de día en (px,py) con tamaño (pw,ph)
	local function tarjeta(rec, px, py, pw, ph)
		local D = rec.dia
		local es7 = (D == 7)
		-- 🏁 calVisto7 = ya dio la primera vuelta (3 ago 2026). Los días de OBJETO
		-- (coil, manita, invisible) quedan grises PARA SIEMPRE — regalarlos cada
		-- semana mataría sus ventas en Robux — pero los de CASH vuelven a girar.
		-- Tiene que coincidir con el salto del servidor en la rama "calClaim".
		local esCash = (rec.tipo == "cash")
		local reclamado = (S.calVisto7 and not esCash) or D &lt; (S.calDia or 1)
		local disponible = D == (S.calDia or 1) and S.calListo
			and (esCash or not S.calVisto7)
		-- color del recuadro: día 7 dorado · Gravity Coil azul · Speed Coil rojo
		-- · dinero verde
		local base = VERDE
		if es7 then base = MORADO
		elseif rec.valor == "jumpcoil" then base = AZUL
		elseif rec.valor == "speedcoil" then base = ROJO
		elseif rec.valor == "giant" then base = ROJO end   -- 🖐 manita: rojo
		-- anclada al CENTRO (misma posición visual) para que el pulso del día
		-- disponible crezca centrado, no hacia abajo-derecha
		local card = nuevo("Frame", {
			Size = UDim2.new(0, pw, 0, ph),
			Position = UDim2.new(0, px + pw / 2, 0, py + ph / 2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = base, BorderSizePixel = 0, ZIndex = 201,
		}, p)
		esquinas(card, 12) ; borde(card, 4)
		if reclamado then
			studsVivo(card, Color3.fromRGB(150, 160, 178),
				Color3.fromRGB(120, 130, 150), 174)
			card.BackgroundTransparency = 0.12
		else
			studsVivo(card, base, base, 174)
		end
		if disponible then
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then st.Color = Color3.fromRGB(120, 255, 130) ; st.Thickness = 5 end
			local sc = nuevo("UIScale", {Scale = 1}, card)
			TweenService:Create(sc, TweenInfo.new(0.6, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1, true), {Scale = 1.05}):Play()
		end

		-- ── ZONAS verticales (px desde arriba) ──
		local tituloH = es7 and 48 or 30           -- franja del título "DAY N"
		local franjaAbajo = disponible and 44 or 0 -- espacio del botón CLAIM (solo si aplica)
		local areaTop = tituloH + 4
		local areaBot = ph - franjaAbajo - 6
		local cy = (areaTop + areaBot) / 2          -- centro del área de icono

		-- título DAY N
		nuevo("TextLabel", {
			Size = UDim2.new(1, 0, 0, tituloH - 6), Position = UDim2.new(0, 0, 0, 8),
			BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
			Text = (esES and "DÍA " or "DAY ") .. D, TextColor3 = Color3.new(1, 1, 1),
			TextSize = es7 and 42 or 26, ZIndex = 203,
		}, card)

		-- icono central (GRANDE, llena el área)
		local img = ICONO_CAL[rec.valor]
		if rec.tipo == "cash" then
			-- BILLETE + cantidad debajo, ambos dentro del área de icono
			local bs = es7 and 116 or 80
			nuevo("ImageLabel", {
				Size = UDim2.new(0, bs, 0, bs),
				Position = UDim2.new(0.5, 0, 0, cy - 14),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Image = Config.IMG_CASH, ScaleType = Enum.ScaleType.Fit, ZIndex = 203,
			}, card)
			nuevo("TextLabel", {
				Size = UDim2.new(1, -8, 0, 30),
				Position = UDim2.new(0.5, 0, 0, areaBot - 14),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Font = Enum.Font.FredokaOne, Text = rec.etiqueta,
				TextColor3 = Color3.new(1, 1, 1),   -- números en BLANCO
				TextSize = es7 and 32 or 26, ZIndex = 203,
			}, card)
		elseif hayImg(img) then
			-- coil/invisible: icono grande centrado, con su nombre debajo
			local is = es7 and 190 or 112
			-- ✦ BRILLO ESPECIAL (solo coils + invisible): RAYOS giratorios tipo
			-- sunburst detrás del icono (como la caja de premio) + aura suave.
			-- Recortados a la carta (ClipsDescendants) → sunburst contenido.
			local cxRay = cy - 10
			-- contenedor RECORTADO e inset del borde: los brillos jamas tocan
			-- ni se salen de la carta (ni chocan con el borde ni entre cartas)
			local holo = nuevo("Frame", {
				Size = UDim2.new(1, -22, 0, ph - tituloH - franjaAbajo - 44),
				Position = UDim2.new(0.5, 0, 0, cxRay),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				ClipsDescendants = true, ZIndex = 202,
			}, card)
			nuevo("UICorner", {CornerRadius = UDim.new(0, 14)}, holo)
			local rays = nuevo("Frame", {
				Size = UDim2.new(0, es7 and 300 or 180, 0, es7 and 300 or 180),
				Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1, ZIndex = 202,
			}, holo)
			for i = 1, 12 do
				local ray = nuevo("Frame", {
					Size = UDim2.new(0, es7 and 12 or 8, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
					AnchorPoint = Vector2.new(0.5, 0.5), Rotation = i * 15,
					BackgroundColor3 = Color3.fromRGB(255, 248, 205),
					BackgroundTransparency = 0.84, BorderSizePixel = 0, ZIndex = 202,
				}, rays)
				nuevo("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.4),
					NumberSequenceKeypoint.new(1, 1)})}, ray)
			end
			do   -- giro continuo; se auto-desconecta al destruir la carta
				local conn
				conn = RunService.RenderStepped:Connect(function(dt)
					if not rays.Parent then conn:Disconnect() return end
					rays.Rotation = (rays.Rotation + dt * 20) % 360
				end)
			end
			-- aura circular cálida detrás del icono (el "sol")
			local aura = nuevo("Frame", {
				Size = UDim2.new(0, math.floor(is * 0.6), 0, math.floor(is * 0.6)),
				Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.fromRGB(255, 240, 190),
				BackgroundTransparency = 0.86, BorderSizePixel = 0, ZIndex = 202,
			}, holo)
			nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, aura)
			nuevo("ImageLabel", {
				Size = UDim2.new(0, is, 0, is),
				Position = UDim2.new(0.5, 0, 0, cy - 10),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Image = img, ScaleType = Enum.ScaleType.Fit, ZIndex = 203,
			}, card)
			nuevo("TextLabel", {
				Size = UDim2.new(1, -6, 0, es7 and 26 or 20),
				Position = UDim2.new(0.5, 0, 0, areaBot - (es7 and 14 or 10)),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Font = Enum.Font.FredokaOne, Text = rec.etiqueta,
				TextColor3 = Color3.new(1, 1, 1), TextSize = es7 and 18 or 13, ZIndex = 203,
			}, card)
		end

		-- ── ESTADO (sin emojis) ──
		-- reclamado → ya está en GRIS (studsVivo) · disponible → botón CLAIM +
		-- glow verde · bloqueado → carta a color, ligeramente oscurecida
		if disponible then
			-- lógica de reclamo COMPARTIDA (botón CLAIM + toda la casilla)
			local reclamando = false
			local function reclamar()
				if reclamando then return end
				reclamando = true
				RE.Prompt:FireServer("calClaim")
				-- sonido de RECOGER DINERO/MONEDA (el mismo del obby/checkpoints)
				sonar("rbxassetid://90153447839250", 0.6)
				-- avanza estado y regenera SOLO esta carta (gris); NO reconstruye
				-- toda la ventana → sin el parpadeo/reinicio doble
				S.calListo = false
				-- misma aritmética que el server (rama "calClaim"): al reclamar el
				-- último día da la vuelta y marca calVisto7; de ahí en adelante
				-- calDia salta a la siguiente casilla de CASH. El Sync confirmará
				-- los valores enseguida; esto es solo para que la carta se repinte
				-- al instante, sin esperar el viaje.
				local NC = #Config.CALENDARIO
				if (S.calDia or 1) &gt;= NC then
					S.calVisto7 = true
					S.calDia = 1
				else
					S.calDia = (S.calDia or 1) + 1
				end
				if S.calVisto7 then
					local saltos = 0
					while saltos &lt; NC
						and (Config.CALENDARIO[S.calDia] or {}).tipo ~= "cash" do
						S.calDia = S.calDia + 1
						if S.calDia &gt; NC then S.calDia = 1 end
						saltos = saltos + 1
					end
				end
				card:Destroy()
				tarjeta(rec, px, py, pw, ph)
			end
			-- ✦ TODA LA CASILLA ES BOTÓN (dirigido a niños: pican el billete/icono
			-- y también reclama). Botón transparente que cubre la carta completa,
			-- ENCIMA de los iconos (Z 204) pero DEBAJO del CLAIM (Z 205)
			local zonaBtn = nuevo("TextButton", {
				Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0),
				BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
				ZIndex = 204,
			}, card)
			zonaBtn.MouseButton1Click:Connect(reclamar)

			local claim = nuevo("TextButton", {
				Size = UDim2.new(1, -18, 0, 34), Position = UDim2.new(0.5, 0, 1, -8),
				AnchorPoint = Vector2.new(0.5, 1),
				BackgroundColor3 = Color3.fromRGB(60, 210, 90),
				Font = Enum.Font.FredokaOne, Text = "CLAIM",
				TextColor3 = Color3.new(1, 1, 1), TextSize = 20,
				BorderSizePixel = 0, ZIndex = 205,
			}, card)
			esquinas(claim, 8) ; borde(claim, 3)
			claim.MouseButton1Click:Connect(reclamar)
		end
		-- bloqueado: carta a todo color, SIN candado ni velo (solo emojis fuera)
	end

	-- layout tipo referencia: días 1-3 arriba, 4-6 abajo (3 columnas), DÍA 7
	-- grande a la derecha ocupando las dos filas
	local MX, MY = 22, 76          -- margen izq / arriba de la rejilla
	local GW, GH = 128, 180        -- tamaño de tarjeta chica (más alta = más aire)
	local GAP = 12
	for i = 1, 6 do
		local col = (i - 1) % 3
		local fila = (i - 1) &gt;= 3 and 1 or 0
		tarjeta(Config.CALENDARIO[i],
			MX + col * (GW + GAP), MY + fila * (GH + GAP), GW, GH)
	end
	-- DÍA 7: a la derecha, alto = 2 filas
	tarjeta(Config.CALENDARIO[7],
		MX + 3 * (GW + GAP), MY, GW + 30, GH * 2 + GAP)

	panelAbierto = p
	popIn(p)
	-- NO reconstruir en cada Sync: la carta se actualiza en el acto al reclamar.
	-- Reconstruir con el Sync causaba el parpadeo/reinicio doble de la ventana.
	refrescarCalendario = function() end
	return p
end

-- ─── APERTURA AUTOMÁTICA del calendario ───
-- Premium: 1 s DESPUÉS de cerrar la caja de regalo premium (lo dispara el
-- handler de "premiumCaja"). No Premium: 4 s tras entrar al juego.
local calAutoMostrado = false
function abrirCalendarioAuto()
	if calAutoMostrado then return end
	-- solo se auto-abre si HOY hay un regalo por reclamar. Desde el 3 ago 2026 el
	-- veterano TAMBIÉN tiene premio (la 2ª vuelta de cash), así que ya no se
	-- excluye por calVisto7: recordárselo es justo el objetivo del cambio.
	if not S.calListo then return end
	calAutoMostrado = true
	abrirCalendario()
	-- 🔍 sin zoom: se abre solo a los 4 s de entrar. Con zoom, lo primero que
	-- vería el jugador nuevo es la cámara pegando un tirón sin haber tocado nada.
	-- Abierto a mano desde el botón "Daily" sí hace zoom, que ahí lo pidió él.
	if panelAbierto then panelAbierto:SetAttribute("SinZoom", true) end
end
task.delay(4, function()
	-- los Premium reciben la caja de regalo → su calendario abre al cerrarla;
	-- solo los NO Premium abren el calendario a los 4 s
	if plr.MembershipType ~= Enum.MembershipType.Premium then
		abrirCalendarioAuto()
	end
end)

-- ═══ NOTIFICACIONES DE EXPERIENCIA: QUITADO (30 jul 2026) ═══════════════════
-- Existió del 28 al 30 de julio: a los 7 min salía el diálogo oficial de Roblox
-- (ExperienceNotificationService:PromptOptIn) ofreciendo activar las
-- notificaciones de la experiencia. Se quita a petición del usuario.
--
-- ⚠️ SI SE QUIERE RECUPERAR, la lección de esta torre sigue en pie: NUNCA por
-- temporizador. El popup de favoritos a los 150 s subió el abandono de esa
-- franja del 8,2% al 10,8%. Dispararlo tras un LOGRO (abrir el cofre, llegar
-- al piso 10), que es cuando el jugador está contento.

-- ─── BOTÓN de acceso al calendario: icono + "DAILY" abajo (mismo estilo que
-- "Boost?"), a la IZQUIERDA del Boost (su borde izq en x=borde-108) ───
-- 📱 en táctiles sube arriba-derecha junto al Boost (ver BOOST_ANCLA arriba):
-- abajo estorbaba el botón de salto de Roblox
local botonCal = nuevo("TextButton", {
	Size = UDim2.new(0, 78, 0, 74),
	-- pegada a la izquierda del Boost, a su misma altura
	Position = UDim2.new(1, -116, BOOST_Y.Scale, BOOST_Y.Offset),
	AnchorPoint = BOOST_ANCLA, BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne, Text = "Daily",       -- misma capitalización que "Boost?"
	TextColor3 = Color3.new(1, 1, 1), TextSize = 20,
	TextStrokeTransparency = 0, TextYAlignment = Enum.TextYAlignment.Bottom,
}, gui)
nuevo("ImageLabel", {
	Size = UDim2.new(0, 42, 0, 42), Position = UDim2.new(0.5, 0, 0, 16),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
	Image = "rbxassetid://113945825357498", ScaleType = Enum.ScaleType.Fit, ZIndex = 41,
}, botonCal)
function pintarBotonCal() end   -- (sin puntito rojo)
botonCal.MouseButton1Click:Connect(abrirCalendario)

plr.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	actualizarVuelo()
	detectado = false
	labelVisto.Visible = false
	vineta.BackgroundTransparency = 1
end)

-- ═══ DECORACIÓN ANIMADA: globos que flotan (sube/baja) + nubes que ondean ═══
-- Puramente visual y LOCAL: se mueven los modelos anclados con PivotTo cada
-- frame. Funciona con StreamingEnabled (se registran al entrar por streaming).
-- ⚡ OPTIMIZACIÓN (2026-07-17, pedido del usuario): se animan TODOS los globos
--   de los pisos 1-2 (y ≤ lobby+2 pisos) y los de la AZOTEA. Del piso 3 para
--   arriba: ESTÁTICOS — ni se registran (costo CERO por frame).
do
	local Y_MAX_ANIM = Config.ALTURA_LOBBY + 2 * Config.ALTURA_PISO
	local Y_AZOTEA = Config.ALTURA_LOBBY + Config.N_PISOS * Config.ALTURA_PISO - 5
	local flotantes = {}   -- [model] = {cf, fase, vel, amp}
	local function registrar(m, marca, ampMin, ampVar, velBase, velVar, esGlobo)
		if flotantes[m] or not m:FindFirstChild(marca) then return end
		local cf = m:GetPivot()
		local p = cf.Position
		if esGlobo and p.Y &gt; Y_MAX_ANIM and p.Y &lt; Y_AZOTEA then
			return                       -- piso 3+ (no azotea): estático, fuera
		end
		flotantes[m] = {
			cf = cf,
			fase = (p.X * 0.17 + p.Z * 0.11) % (math.pi * 2),
			vel = velBase + (math.abs(p.X + p.Z) % 10) / 10 * velVar,
			amp = ampMin + (math.abs(p.X - p.Z) % 10) / 10 * ampVar,
		}
	end
	local function considerar(d)
		if not d:IsA("Model") then return end
		if d.Name == "GloboFlota" then
			registrar(d, "GloboCuerpo", 1.4, 1.4, 1.0, 0.7, true)   -- globos
		elseif d.Name == "Nube" then
			registrar(d, "NubePuff", 0.6, 0.8, 0.32, 0.28)    -- nubes: leve y lento
		end
	end
	task.spawn(function()
		local mapa = workspace:WaitForChild("Mapa", 20)
		if not mapa then return end
		for _, d in ipairs(mapa:GetDescendants()) do considerar(d) end
	end)
	-- registrar los que aparezcan luego (streaming): por el Model o por su parte
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("Model") then
			if d.Name == "GloboFlota" or d.Name == "Nube" then
				task.defer(considerar, d)
			end
		elseif d:IsA("BasePart")
			and (d.Name == "GloboCuerpo" or d.Name == "NubePuff") then
			local m = d.Parent
			if m then task.defer(considerar, m) end
		end
	end)
	-- ⚡ SOLO FLOTAN LOS DE CERCA (2026-07-25). De los 128 GloboFlota del mapa,
	-- 44 se animaban (el filtro Y_MAX_ANIM de arriba ya deja fuera los de los
	-- pisos intermedios: solo anima lobby + azotea). Esos 44 hacían PivotTo
	-- CADA fotograma aunque estuvieras 10 pisos lejos — y PivotTo sobre un Model
	-- es de lo más caro del cliente. Subiendo la torre ahora no se anima NINGUNO
	-- (los del lobby quedan abajo y los de la azotea arriba).
	-- Mismo patrón que las monedas: la lista de cercanos se rehace 4 veces por
	-- segundo y entre medias solo se anima esa lista.
	local FLOTA_CERCA2 = 200 * 200    -- 200 studs = 5 pisos; más lejos no se ve
	local cercaF = {}                 -- lista plana {modelo, datos, ...}
	local acumF = 1                   -- arranca "vencido": se arma en el 1er frame
	RunService.Heartbeat:Connect(function(dt)
		if not next(flotantes) then return end

		acumF = acumF + dt
		if acumF &gt;= 0.25 then
			acumF = 0
			table.clear(cercaF)
			local cam = workspace.CurrentCamera
			local ref = cam and cam.CFrame.Position
			if ref then
				for m, g in pairs(flotantes) do
					if m.Parent then
						local p = g.cf.Position
						local dx, dy, dz = p.X - ref.X, p.Y - ref.Y, p.Z - ref.Z
						if dx * dx + dy * dy + dz * dz &lt; FLOTA_CERCA2 then
							cercaF[#cercaF + 1] = m
							cercaF[#cercaF + 1] = g
						end
					else
						flotantes[m] = nil
					end
				end
			end
		end

		local n = #cercaF
		if n == 0 then return end
		local t = os.clock()
		for i = 1, n, 2 do
			local m = cercaF[i]
			if m.Parent then
				local g = cercaF[i + 1]
				local dy = math.sin(t * g.vel + g.fase) * g.amp
				m:PivotTo(g.cf + Vector3.new(0, dy, 0))
			end
		end
	end)
end

-- ═══ CÁMARA: que NO atraviese los muros TRANSLÚCIDOS de la torre ═══
-- La cámara default de Roblox ignora partes con Transparency ≥ 0.25 al calcular
-- oclusión (por eso atraviesa los muros a 0.35, pero NO los sólidos a 0). Aquí
-- añadimos oclusión SOLO contra los muros translúcidos (los sólidos ya los tapa
-- la default): cada frame, raycast del sujeto a la cámara y, si hay un muro en
-- medio, acercamos la cámara justo delante conservando su rotación.
do
	local muros = {}
	local paramsCam = RaycastParams.new()
	paramsCam.FilterType = Enum.RaycastFilterType.Include
	paramsCam.FilterDescendantsInstances = muros
	paramsCam.IgnoreWater = true
	-- reconstruye la lista de muros translúcidos cada 1 s (streaming-safe)
	task.spawn(function()
		while true do
			local mapa = workspace:FindFirstChild("Mapa")
			if mapa then
				local nuevos = {}
				for _, d in ipairs(mapa:GetDescendants()) do
					if d:IsA("BasePart") and d.Name == "Muro"
						and d.Transparency &gt; 0.1 then
						nuevos[#nuevos + 1] = d
					end
				end
				muros = nuevos
				paramsCam.FilterDescendantsInstances = muros
			end
			task.wait(1)
		end
	end)
	RunService:BindToRenderStep("MuroCamOcclusion",
		Enum.RenderPriority.Camera.Value + 1, function()
		if #muros == 0 then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local camCF = cam.CFrame
		local origen = cam.Focus.Position          -- ≈ el personaje (sujeto)
		local dir = camCF.Position - origen
		if dir.Magnitude &lt; 0.6 then return end      -- 1ª persona: nada que hacer
		local hit = workspace:Raycast(origen, dir, paramsCam)
		if hit then
			local pos = hit.Position - dir.Unit * 0.6   -- justo delante del muro
			cam.CFrame = CFrame.new(pos) * (camCF - camCF.Position)
		end
	end)
end

-- ═══ MANO SLAP ARCOÍRIS: cicla el COLOR del mesh (SOLO color, no cambia la
-- forma). Es visual y LOCAL en cada cliente, pero como TODOS lo animan igual,
-- todos ven la mano arcoíris. Si hay que rebobinar, borra este bloque y la mano
-- vuelve a blanca sola (el color base blanco sigue en el build). ═══
do
	local manos = {}
	-- SPARKLES arcoíris en la mano GOD (creados por Lua = 100% fiable, a diferencia
	-- del ParticleEmitter en XML). Se ven flotando/brillando alrededor de la mano.
	local function ponerBrillos(h)
		if h:FindFirstChild("Brillos") then return end
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "Brillos"
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 45, 45)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 170, 40)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 240, 60)),
			ColorSequenceKeypoint.new(0.7, Color3.fromRGB(70, 230, 100)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 120, 255)),
		})
		pe.LightEmission = 1
		pe.LightInfluence = 0
		pe.Rate = 28
		pe.Lifetime = NumberRange.new(0.4, 0.9)
		pe.Speed = NumberRange.new(1, 3)
		pe.RotSpeed = NumberRange.new(-160, 160)
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.5, 1.0),
			NumberSequenceKeypoint.new(1, 0.1),
		})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(0.4, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Parent = h
	end
	local function considerar(d)
		if not d:IsA("BasePart") then return end
		if (d.Name == "Handle" and d.Parent and d.Parent:IsA("Tool")
				and d.Parent.Name == "Slap")
			or d.Name == "SlapDisplay" then       -- manita: brillos + color arcoíris
			manos[d] = true
			ponerBrillos(d)
		elseif d.Name == "CoilDisplay" or d.Name == "CarpetaDisplay" then
			ponerBrillos(d)                        -- coils/alfombra: SOLO brillos
		end
	end
	task.spawn(function()
		for _, d in ipairs(workspace:GetDescendants()) do considerar(d) end
	end)
	workspace.DescendantAdded:Connect(considerar)
	RunService.RenderStepped:Connect(function()
		if not next(manos) then return end   -- sin manos a la vista: ni calcular
		local col = Color3.fromHSV((os.clock() * 0.35) % 1, 1, 1)  -- fluye como los botones
		for h in pairs(manos) do
			if h.Parent then h.Color = col else manos[h] = nil end
		end
	end)
end

-- (las FLECHAS DE GUÍA del lobby se eliminaron a pedido del usuario)

-- ═══ 🖼 ANIMACIÓN DEL CUADRO (2026-08-17) ══════════════════════
-- Antes la hacía el SERVER, tuneando el C0 del Weld. Se veía "muy trabado", y con
-- razón: un tween de servidor NO manda un valor por frame — manda cambios de
-- propiedad que se replican a unas 20 veces por segundo, así que medio segundo de
-- animación llegaba al jugador en una docena de escalones.
--
-- Aquí la reproduce cada cliente en LOCAL, a los fps que tenga cada uno. Escribir
-- el C0 desde el cliente no se replica, pero da igual: no hace falta que se
-- replique, porque TODOS los clientes corren esta misma animación sobre el mismo
-- cuadro y con los mismos números de Config.
--
-- El server ya deja el Weld en la pose FINAL. Si este bloque no llegara a correr
-- (entras a mitad, llega tarde el replicado), el cuadro sale puesto sin animación
-- en vez de quedarse tirado abajo para siempre.
-- ⚠️ Todo dentro de do…end: MainClient ya reventó una vez el límite de 200 locales
-- por función al añadir cosas sueltas arriba del todo.
-- ⚠️ 2026-08-18: ESTO YA NO USA TweenService. Al añadir el vaivén al caminar hubo
-- que juntarlo todo en UN SOLO sitio que escriba el C0: un Tween escribe la
-- propiedad entera cada frame, así que el balanceo y la animación de sacarlo se
-- pisaban el uno al otro y ganaba el último en escribir. Ahora un único bucle
-- calcula pose = (entrada/salida) × (vaivén) y escribe el resultado una vez.
-- La curva de la animación se sigue respetando con TweenService:GetValue, que da
-- el mismo easing sin necesidad de crear un Tween.
do
	local activos = {}   -- [Part] = estado de su animación
	local DIST_Q = Config.CUADRO_DIST or 2.3
	local DIST_M = Config.CUADRO_DIST_MOV or DIST_Q
	local DINAMICO = math.abs(DIST_M - DIST_Q) &gt; 0.001
	local C0_INI = Config.cuadroC0(0, DIST_Q)

	local function considerar(d)
		if not (d:IsA("BasePart") and d.Name == "CuadroPuesto") then return end
		-- ⚠️ 2026-08-17, ESTO ES LO QUE DEJÓ LA ANIMACIÓN MUERTA EN EL PRIMER
		-- INTENTO: aquí había un FindFirstChildOfClass("Weld") a secas. Roblox
		-- replica las instancias DE UNA EN UNA, así que cuando DescendantAdded
		-- avisa de la Part, su Weld todavía no ha llegado: devolvía nil, la función
		-- se salía y el cuadro aparecía de la nada, sin gesto ninguno.
		local w = d:FindFirstChild("CuadroWeld") or d:WaitForChild("CuadroWeld", 3)
		if not w or not d.Parent then return end
		w.C0 = C0_INI                  -- de golpe abajo y tumbado…
		activos[d] = {w = w, a = 0, obj = 1, yaw = nil, mov = 0,
			vel = 1 / math.max(Config.CUADRO_ANIM_SEG or 0.2, 0.01)}
		-- …y al guardarlo el server levanta esta bandera en vez de animar él
		d:GetAttributeChangedSignal("Guardando"):Connect(function()
			if not d:GetAttribute("Guardando") then return end
			local e = activos[d]
			if not e then
				-- se había APARCADO por estar quieto (ver el bucle): se revive en la
				-- pose de puesto para poder bajarlo
				e = {w = w, a = 1, obj = 1, yaw = nil, mov = 0, vel = 1}
				activos[d] = e
			end
			e.obj = 0                  -- ahora el destino es la pose de abajo
			e.vel = 1 / math.max(Config.CUADRO_ANIM_BAJAR or 0.15, 0.01)
		end)
	end

	RunService.RenderStepped:Connect(function(dt)
		if not next(activos) then return end        -- nadie con el cuadro: ni calcular
		local estilo = Config.cuadroEstilo()
		local ang = math.rad(Config.CUADRO_VAIVEN_ANG or 0)
		local subeMax = Config.CUADRO_VAIVEN_Y or 0
		local ref = Config.CUADRO_VAIVEN_REF or 16
		local reloj = os.clock() * (Config.CUADRO_VAIVEN_VEL or 7)
		local inercia = Config.CUADRO_INERCIA or 0
		local topeIner = math.rad(Config.CUADRO_INERCIA_MAX or 55)
		local umbralMov = math.max(Config.CUADRO_DIST_UMBRAL or 4, 0.1)
		local suaveMov = Config.CUADRO_DIST_SUAVE or 6
		for d, e in pairs(activos) do
			if not (d.Parent and e.w.Parent) then
				activos[d] = nil
			else
				-- 1) avanzar hacia el destino (1 = puesto arriba · 0 = guardado)
				if e.a &lt; e.obj then e.a = math.min(e.obj, e.a + dt * e.vel)
				elseif e.a &gt; e.obj then e.a = math.max(e.obj, e.a - dt * e.vel) end
				local root = e.w.Part0
				-- 🎚 DISTANCIA VARIABLE: pegado al cuerpo cuando está quieto, separado
				-- cuando anda o corre. El brazo solo se balancea al moverse, así que el
				-- hueco solo hace falta entonces. Se persigue con suavizado para que no
				-- pegue un salto en el primer paso.
				local dist = DIST_Q
				if DINAMICO and root then
					local v = root.AssemblyLinearVelocity
					local rap = Vector3.new(v.X, 0, v.Z).Magnitude
					local objetivo = math.clamp(rap / umbralMov, 0, 1)
					e.mov = e.mov + (objetivo - e.mov) * math.min(dt * suaveMov, 1)
					dist = DIST_Q + (DIST_M - DIST_Q) * e.mov
				end
				local dir = (e.obj &gt;= 1) and Enum.EasingDirection.Out or Enum.EasingDirection.In
				local base = Config.cuadroC0(0, dist)
					:Lerp(Config.cuadroC0(1, dist), TweenService:GetValue(e.a, estilo, dir))
				if root and e.a &gt; 0.99 then
					-- 2) INERCIA: el cartel persigue la orientación del cuerpo CON
					--    RETRASO. Es lo que se ve en el juego de referencia: giras y el
					--    cartel llega tarde, como si pesara. Se guarda un yaw propio que
					--    corre detrás del yaw real y se aplica la diferencia.
					if inercia &gt; 0 then
						local lv = root.CFrame.LookVector
						local yaw = math.atan2(-lv.X, -lv.Z)
						if not e.yaw then e.yaw = yaw end
						-- diferencia por el camino corto: sin esto, al cruzar de +180° a
						-- −180° el cartel daría una vuelta entera de golpe
						local dy = yaw - e.yaw
						while dy &gt; math.pi do dy = dy - 2 * math.pi end
						while dy &lt; -math.pi do dy = dy + 2 * math.pi end
						e.yaw = e.yaw + dy * math.min(dt * inercia, 1)
						local atraso = math.clamp(e.yaw - yaw, -topeIner, topeIner)
						base = base * CFrame.Angles(0, atraso, 0)
					end
					-- 3) vaivén del paso, proporcional a lo rápido que va: parado = quieto
					if ang &gt; 0 or subeMax &gt; 0 then
						local v = root.AssemblyLinearVelocity
						local f = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude / ref, 0, 1)
						if f &gt; 0.01 then
							-- el rebote va al DOBLE de frecuencia que el balanceo: en un
							-- paso real el cuerpo sube y baja dos veces por cada bamboleo
							base = base
								* CFrame.new(0, math.sin(reloj * 2) * subeMax * f, 0)
								* CFrame.Angles(0, 0, math.sin(reloj) * ang * f)
						end
					end
				end
				e.w.C0 = base
				-- 🅿️ APARCAR: si ya llegó arriba y NADA depende del frame, el C0 sería
				-- idéntico una vez y otra. Se saca de la lista y el bucle deja de
				-- tocarlo hasta que lo guarden.
				-- ⚠️ Con DINAMICO no se aparca nunca: la distancia depende de si el
				-- jugador anda, así que hay que seguir mirándola cada frame.
				if e.a &gt;= 1 and e.obj &gt;= 1 and not DINAMICO
					and inercia &lt;= 0 and ang &lt;= 0 and subeMax &lt;= 0 then
					activos[d] = nil
				end
			end
		end
	end)

	workspace.DescendantAdded:Connect(considerar)
	task.spawn(function()
		for _, d in ipairs(workspace:GetDescendants()) do considerar(d) end
	end)
end

-- ═══ MONEDAS VIVAS: giran sobre su propio eje y flotan suavecito (client-side,
-- costo ~cero; aguanta el streaming con el patrón DescendantAdded) ═══
do
	local monedas = {}   -- [part] = CFrame original
	local function considerar(d)
		if d:IsA("BasePart") and d.Name == "MonedaOro" then
			monedas[d] = d.CFrame
		end
	end
	task.spawn(function()
		for _, d in ipairs(workspace:GetDescendants()) do considerar(d) end
	end)
	workspace.DescendantAdded:Connect(considerar)

	-- ⚡ SOLO GIRAN LAS DE CERCA (2026-07-25). Antes se recalculaba el CFrame de
	-- las 61 monedas CADA fotograma (~7,400 CFrames nuevos por segundo), aunque
	-- 58 estuvieran 15 pisos abajo y no se vieran: los pisos son opacos.
	-- Se mide por DISTANCIA, no por número de piso fijo: así, conforme subes, las
	-- de arriba empiezan a girar y las de abajo se paran solas. Siempre ves
	-- monedas girando y nunca gastas en las invisibles.
	-- La lista de "cercanas" se rehace 4 veces por segundo (no cada fotograma):
	-- el jugador no se mueve 120 studs en 0.25 s, así que nunca se nota.
	local CERCA = 120                 -- studs (~3 pisos de 40)
	local CERCA2 = CERCA * CERCA
	local cerca = {}                  -- lista plana {parte, CFrame base, ...}
	local acumC = 1                   -- arranca "vencido": la lista se arma en el
	                                  -- PRIMER fotograma (si empezara en 0, las
	                                  -- monedas se quedarían quietas 0.25 s al entrar)
	RunService.RenderStepped:Connect(function(dt)
		if not next(monedas) then return end

		acumC = acumC + dt
		if acumC &gt;= 0.25 then         -- rehacer la lista de cercanas
			acumC = 0
			table.clear(cerca)
			local cam = workspace.CurrentCamera
			local ref = cam and cam.CFrame.Position
			if ref then
				for pr, base in pairs(monedas) do
					if pr.Parent then
						local p = pr.Position
						local dx, dy, dz = p.X - ref.X, p.Y - ref.Y, p.Z - ref.Z
						if dx * dx + dy * dy + dz * dz &lt; CERCA2 then
							cerca[#cerca + 1] = pr
							cerca[#cerca + 1] = base
						end
					else
						monedas[pr] = nil   -- recogida/borrada: fuera de la tabla
					end
				end
			end
		end

		local n = #cerca
		if n == 0 then return end
		local t = os.clock()
		local giro = CFrame.Angles(0, t * 2.4, 0)          -- vuelta cada ~2.6 s
		-- ⚠️ FUERA del bucle: es el MISMO valor para todas las monedas de este
		-- fotograma; antes se creaba uno por moneda (61 CFrames tirados)
		local flote = CFrame.new(0, math.sin(t * 2) * 0.22, 0)
		local mov = flote * giro                            -- y esto también
		for i = 1, n, 2 do
			local pr = cerca[i]
			if pr.Parent then pr.CFrame = cerca[i + 1] * mov end
		end
	end)
end

-- ═══ MARCOS DE MORPH: los marcos NEON de las bases de morph ("MorphMarco")
-- fluyen con un GRADIENTE de los MORADOS de la alfombra + SECCIONES BLANCAS
-- (brillan como los segmentos del gusano), con onda espacial. Costo ~cero. ═══
do
	-- paleta cíclica: morado oscuro → vivo → lavanda → BLANCO → lavanda → vivo
	local PAL = {
		Color3.fromRGB(46, 8, 125),     -- morado oscuro (alfombra)
		Color3.fromRGB(122, 40, 240),   -- morado vivo (alfombra)
		Color3.fromRGB(205, 170, 255),  -- lavanda claro
		Color3.fromRGB(255, 255, 255),  -- BLANCO (sección brillante)
		Color3.fromRGB(205, 170, 255),  -- lavanda
		Color3.fromRGB(122, 40, 240),   -- morado vivo
	}
	local NP = #PAL
	local function moradoRGB(fase)
		fase = fase % 1
		local x = fase * NP
		local i = math.floor(x) % NP
		return PAL[i + 1]:Lerp(PAL[(i + 1) % NP + 1], x - math.floor(x))
	end
	local marcos = {}   -- [part] = offset de fase (por posición)
	local function considerar(d)
		if d:IsA("BasePart") and d.Name == "MorphMarco" then
			marcos[d] = (d.Position.X + d.Position.Z) * 0.015
		end
	end
	task.spawn(function()
		for _, d in ipairs(workspace:GetDescendants()) do considerar(d) end
	end)
	workspace.DescendantAdded:Connect(considerar)
	RunService.RenderStepped:Connect(function()
		if not next(marcos) then return end
		local t = os.clock() * 0.35             -- vuelta al ciclo cada ~2.8 s
		for pr, off in pairs(marcos) do
			if pr.Parent then
				pr.Color = moradoRGB(t + off)
			else
				marcos[pr] = nil
			end
		end
	end)
end

-- ═══ CARTEL "$10,000" DEL COFRE: zoom pulsante SUAVE. Escalamos la PARTE
-- "CartelCofrePulso" (SurfaceGui de lienzo fijo) → el texto se estira por GPU,
-- sin re-rasterizarse cada frame (nada de tirones). Local por cliente, 60 fps. ═══
do
	local partes = {}
	local function considerar(d)
		if d:IsA("BasePart") and d.Name == "CartelCofrePulso" then
			partes[d] = d:GetAttribute("BaseSize") or d.Size
		end
	end
	task.spawn(function()
		for _, d in ipairs(workspace:GetDescendants()) do considerar(d) end
	end)
	workspace.DescendantAdded:Connect(considerar)
	RunService.RenderStepped:Connect(function()
		if not next(partes) then return end
		local s = 1 + math.sin(os.clock() * 3) * 0.15      -- ±15% suave y lento (zoom más/menos)
		for p, base in pairs(partes) do
			if p.Parent then p.Size = base * s else partes[p] = nil end
		end
	end)
end

-- ═══ TEXTO "FLYING CARPET" ARCOÍRIS ANIMADO: los gradientes "ArcoirisAnim" de
-- los carteles del mundo (VentaCarpet) fluyen de color como los botones. Local
-- por cliente pero todos lo animan → todos lo ven fluir. ═══
do
	local grads = {}
	local function considerar(d)
		if d:IsA("UIGradient") and d.Name == "ArcoirisAnim" then
			grads[d] = true
		end
	end
	task.spawn(function()
		for _, d in ipairs(workspace:GetDescendants()) do considerar(d) end
	end)
	workspace.DescendantAdded:Connect(considerar)
	RunService.RenderStepped:Connect(function()
		if not next(grads) then return end
		local seq = arcoActual()   -- 🌈 tabla precalculada: 0 asignaciones por frame
		for g in pairs(grads) do
			if g.Parent then g.Color = seq else grads[g] = nil end
		end
	end)
end

-- ═══ VITRINA "INVISIBLE" PERSONALIZADA: cada jugador ve SU PROPIO avatar (con su
-- skin puesta) parado en la vitrina, semi-transparente. Es un CLON local del
-- personaje: anclado, sin colisión, sin scripts, cara/ropa al 50% de transparencia.
-- Se rehace en cada respawn. Solo lo ve cada cliente (vitrina personalizada). ═══
do
	-- el ancla está DENTRO del modelo "Lobby" → búsqueda RECURSIVA (no WaitForChild)
	local anclaPose = workspace:FindFirstChild("ManiquiInvisAncla", true)
	for _ = 1, 30 do
		if anclaPose then break end
		task.wait(1)
		anclaPose = workspace:FindFirstChild("ManiquiInvisAncla", true)
	end
	if anclaPose then
		local clonActual
		local function montar(char)
			if not char or not char.Parent then return end
			-- CLON del avatar VIVO (se ve offline en Studio, a diferencia de
			-- CreateHumanoidModelFromDescription que aquí no cargaba el avatar). La
			-- pose rara congelada se arregla reseteando los Motor6D a REPOSO y
			-- anclando SOLO el root, para que los miembros se acomoden a pose de pie.
			char.Archivable = true
			local ok, rig = pcall(function() return char:Clone() end)
			if not ok or not rig then return end
			if clonActual then clonActual:Destroy() end
			clonActual = rig
			rig.Name = "ManiquiInvisVitrina"
			pcall(function() rig:ScaleTo(1.5) end)   -- 1.5x más grande que el jugador
			local hrp = rig:FindFirstChild("HumanoidRootPart")
			for _, d in ipairs(rig:GetDescendants()) do
				if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ForceField") then
					d:Destroy()
				elseif d:IsA("Motor6D") then
					d.Transform = CFrame.identity        -- pose de REPOSO (borra el pose de animación)
				elseif d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.Massless = true
					d.Anchored = (d == hrp)              -- solo el root; los miembros los sostienen los Motor6D
					if d.Transparency &lt; 0.95 then d.Transparency = 0.5 end
				elseif d:IsA("Decal") or d:IsA("Texture") then
					if d.Transparency &lt; 0.95 then d.Transparency = 0.5 end
				end
			end
			local h2 = rig:FindFirstChildOfClass("Humanoid")
			if h2 then
				h2.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				h2.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end
			-- brillos arcoíris alrededor (igual que las otras vitrinas)
			local raiz = hrp or rig:FindFirstChild("UpperTorso") or rig:FindFirstChild("Torso")
			if raiz then
				local pe = Instance.new("ParticleEmitter")
				pe.Name = "Brillos"
				pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				pe.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 45, 45)),
					ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 170, 40)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 240, 60)),
					ColorSequenceKeypoint.new(0.7, Color3.fromRGB(70, 230, 100)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 120, 255)),
				})
				pe.LightEmission = 1
				pe.LightInfluence = 0
				pe.Rate = 36
				pe.Lifetime = NumberRange.new(0.5, 1.1)
				pe.Speed = NumberRange.new(1.5, 4.5)          -- más dispersos: cubren el maniquí 1.5x
				pe.RotSpeed = NumberRange.new(-160, 160)
				pe.Size = NumberSequence.new({                -- brillos MÁS GRANDES
					NumberSequenceKeypoint.new(0, 0.7),
					NumberSequenceKeypoint.new(0.5, 1.9),
					NumberSequenceKeypoint.new(1, 0.2),
				})
				pe.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(0.4, 0),
					NumberSequenceKeypoint.new(1, 1),
				})
				pe.SpreadAngle = Vector2.new(180, 180)
				pe.Parent = raiz
			end
			-- orientar (mirando al centro del lobby) y parar los pies en el pedestal
			local ap = anclaPose.Position
			local function colocar()
				local dir = Vector3.new(-ap.X, 0, -ap.Z)
				dir = (dir.Magnitude &gt; 0.01) and dir.Unit or Vector3.new(0, 0, -1)
				rig:PivotTo(CFrame.lookAt(Vector3.new(0, 0, 0), dir))
				local bcf, size = rig:GetBoundingBox()
				rig:PivotTo(rig:GetPivot() + (Vector3.new(ap.X, ap.Y + size.Y / 2, ap.Z) - bcf.Position))
			end
			colocar()                        -- posición aproximada (pose aún sin asentar)
			rig.Parent = workspace
			task.wait()                      -- deja que los Motor6D acomoden los miembros a la pose de reposo
			if not rig.Parent then return end
			for _, d in ipairs(rig:GetDescendants()) do   -- congela TODO en la pose de reposo
				if d:IsA("BasePart") then d.Anchored = true end
			end
			colocar()                        -- reposición precisa (ya asentada la pose)
		end
		if plr.Character then
			task.delay(2, montar, plr.Character)     -- por si la skin ya cargó
		end
		plr.CharacterAppearanceLoaded:Connect(function(char)
			task.wait(0.3)                           -- deja soldar accesorios/ropa
			montar(char)
		end)
	end
end

sonidoHUD = false   -- de aquí en adelante los botones de paneles nacen mudos
print("[RainbowApple] Cliente listo ✅")

-- ═══ Cartel del maniquí INVISIBLE: oclusión manual ═════════════════════════
-- El billboard va con AlwaysOnTop (si no, el sorting de transparencias hace que
-- la pared TRANSLÚCIDA de atrás "se lo coma" según el ángulo). Para que las
-- paredes OPACAS sí lo tapen, el cliente lo APAGA cuando algo sólido bloquea la
-- línea cámara→cartel (raycast saltándose translúcidos/decoración sin colisión).
task.spawn(function()
	local venta
	while not venta do
		venta = workspace:FindFirstChild("VentaInvisible", true)
		if not venta then task.wait(1) end
	end
	local bg
	while not bg do
		bg = venta:FindFirstChildOfClass("BillboardGui")
		if not bg then task.wait(1) end
	end
	local acum = 0
	RunService.Heartbeat:Connect(function(dt)
		acum = acum + dt
		if acum &lt; 0.12 then return end   -- ~8 chequeos/s (barato)
		acum = 0
		local cam = workspace.CurrentCamera
		if not cam or not bg.Parent then return end
		local objetivo = venta.Position + Vector3.new(0, 4.8, 0)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local excl = { venta }
		if plr.Character then table.insert(excl, plr.Character) end
		params.FilterDescendantsInstances = excl
		local visible = true
		local desde = cam.CFrame.Position
		for _ = 1, 8 do
			local dirv = objetivo - desde
			if dirv.Magnitude &lt; 1 then break end
			local rc = workspace:Raycast(desde, dirv, params)
			if not rc then break end
			local p = rc.Instance
			if p:IsA("BasePart") and p.Transparency &lt; 0.3 and p.CanCollide then
				visible = false   -- algo OPACO y sólido en medio → tapado
				break
			end
			-- translúcido o decoración: mirar detrás de él
			table.insert(excl, p)
			params.FilterDescendantsInstances = excl
			desde = rc.Position + dirv.Unit * 0.05
		end
		bg.Enabled = visible
	end)
end)

-- ═══ ESTRELLA GIGANTE: rebote INSTANTÁNEO (100% cliente) ════════════════════
-- Raycast continuo hacia abajo: si estás sobre un "TrampolinStar", aplica el
-- impulso AL INSTANTE (cero viaje al server). Los valores globales SALTO/VEL
-- los publica el server como atributos de workspace (los botones los cambian).
-- VEL&gt;1 = misma altura pero cae/sube más rápido (impulso ×√vel + fuerza extra
-- de gravedad ×vel mientras estás en el aire).
do
	local ultimoStar = 0
	RunService.Heartbeat:Connect(function()
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health &lt;= 0 then return end
		local t = os.clock()
		if t - ultimoStar &lt; 0.25 then return end
		if root.AssemblyLinearVelocity.Y &gt; 8 then return end   -- ya vas subiendo
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		local rc = workspace:Raycast(root.Position, Vector3.new(0, -6.5, 0), params)
		if not (rc and rc.Instance and (rc.Instance.Name == "TrampolinStar"
			or rc.Instance.Name == "ParqueHalo")) then return end   -- el FILO brillante también rebota
		ultimoStar = t
		RE.Prompt:FireServer("starSalto")   -- avisa el rebote → el server paga +$10 SIEMPRE
		local imp = tonumber(workspace:GetAttribute("EstrellaImpulso")) or 95
		local mult = tonumber(workspace:GetAttribute("EstrellaVel")) or 1
		local vy = imp * math.sqrt(mult)
		if char:FindFirstChild("Gravity Coil") then
			vy = vy * 1.414   -- resorte AZUL equipado → salto al DOBLE de altura (√2 en velocidad)
		end
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		task.spawn(function()
			for _ = 1, 3 do
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
				RunService.Heartbeat:Wait()
			end
		end)
		local viejoF = root:FindFirstChild("FuerzaEstrella")
		if viejoF then viejoF:Destroy() end
		local viejoA = root:FindFirstChild("FuerzaEstrellaAtt")
		if viejoA then viejoA:Destroy() end
		if mult &gt; 1 then
			local att = Instance.new("Attachment")
			att.Name = "FuerzaEstrellaAtt"
			att.Parent = root
			local vf = Instance.new("VectorForce")
			vf.Name = "FuerzaEstrella"
			vf.Attachment0 = att
			vf.RelativeTo = Enum.ActuatorRelativeTo.World
			vf.Force = Vector3.new(0,
				-workspace.Gravity * root.AssemblyMass * (mult - 1), 0)
			vf.Parent = root
			task.spawn(function()
				task.wait(0.25)              -- deja despegar primero
				local t0 = os.clock()
				while root.Parent and hum.Parent and hum.Health &gt; 0
					and hum.FloorMaterial == Enum.Material.Air
					and os.clock() - t0 &lt; 6 do
					task.wait(0.05)
				end
				if vf.Parent then vf:Destroy() end
				if att.Parent then att:Destroy() end
			end)
		end
	end)
end

-- ═══ ESTRELLA GIGANTE: color ARCOÍRIS LENTO ═════════════════════════════════
-- El pad NEON y su halo recorren el arcoíris DESPACIO y SIN PARAR: cada salto
-- entre colores vecinos (azul→morado, morado→rojo, …) tarda 10 s — 6 tramos =
-- ciclo completo en 60 s — con el cambio corriendo continuo (nunca se detiene,
-- aunque sea súper lento). Hora del SERVER → todos ven el mismo color. Los
-- marcos oscuros (material GRANITO) no se tocan.
do
	local piezasStar = {}
	local function regStar(d)
		if not d:IsA("BasePart") then return end
		if (d.Name == "TrampolinStar" and d.Material ~= Enum.Material.Granite)
			or d.Name == "ParqueHalo" then   -- pads (plástico c/studs) + halo; los marcos GRANITO no
			piezasStar[d] = true
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do regStar(d) end
	workspace.DescendantAdded:Connect(function(d) task.defer(regStar, d) end)
	RunService.Heartbeat:Connect(function()
		local col = Color3.fromHSV((workspace:GetServerTimeNow() / 60) % 1, 0.72, 1)
		for d in pairs(piezasStar) do
			if d.Parent then d.Color = col else piezasStar[d] = nil end
		end
	end)
end


-- ═══ REGALO DE RETENCIÓN: al abrir el menú de SALIR, ofrecer el SPEED COIL ══
-- gratis (GuiService.MenuOpened = "va a salir/pausa"). Panel con studs y visuales
-- bonitos → cuando cierra la pausa lo ve y lo reclama para seguir jugando. Una
-- sola vez por sesión y solo si NO tiene ya el coil.
do
	local yaMostrado = false
	local panelRet = nil
	GuiService.MenuOpened:Connect(function()
		if yaMostrado then return end
		if S and S.coils and S.coils.speed then return end   -- ya lo tiene
		if panelRet then return end
		yaMostrado = true
		local ROJO = Color3.fromRGB(235, 70, 70)
		local FONDO = Color3.fromRGB(92, 30, 34)
		local pR = nuevo("Frame", {
			Size = UDim2.new(0, 500, 0, 540),
			Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = FONDO, BorderSizePixel = 0, ZIndex = 130,
		}, gui)
		panelRet = pR
		esquinas(pR, 20)
		borde(pR, 5)
		studsVivo(pR, FONDO, FONDO, 250, nil, true)
		popIn(pR)
		-- sonido de aparición (pedido del usuario)
		sonar("rbxassetid://8486683243", 0.7)
		local vivoR = true
		pR.Destroying:Connect(function() vivoR = false end)
		-- encabezado: ¡ESPERA!
		local h1 = nuevo("TextLabel", {
			Size = UDim2.new(1, -30, 0, 54), Position = UDim2.new(0.5, 0, 0, 22),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy,
			Text = esES and "¡ESPERA! 🎁" or "WAIT! 🎁",
			TextColor3 = Color3.fromRGB(255, 225, 90), TextScaled = true, ZIndex = 132,
		}, pR)
		nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, h1)
		local h2 = nuevo("TextLabel", {
			Size = UDim2.new(1, -40, 0, 30), Position = UDim2.new(0.5, 0, 0, 80),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = esES and "No te vayas todavía, te regalamos:" or "Don't leave yet, a gift for you:",
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 132,
		}, pR)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, h2)
		-- escenario del premio
		local escR = nuevo("Frame", {
			Size = UDim2.new(1, 0, 0, 280), Position = UDim2.new(0, 0, 0, 120),
			BackgroundTransparency = 1, ZIndex = 132,
		}, pR)
		-- aura circular pulsante
		local glowR = nuevo("Frame", {
			Size = UDim2.new(0, 250, 0, 250), Position = UDim2.new(0.5, 0, 0.42, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 120, 120),
			BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 132,
		}, escR)
		nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, glowR)
		do
			local gs = Instance.new("UIScale")
			gs.Scale = 0.7
			gs.Parent = glowR
			TweenService:Create(gs, TweenInfo.new(1.0, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1, true), {Scale = 1.08}):Play()
		end
		-- rayos girando
		local raysR = nuevo("Frame", {
			Size = UDim2.new(0, 460, 0, 460), Position = UDim2.new(0.5, 0, 0.42, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 131,
		}, escR)
		for i = 1, 12 do
			local ray = nuevo("Frame", {
				Size = UDim2.new(0, 36, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5), Rotation = i * 15,
				BackgroundColor3 = Color3.fromRGB(255, 150, 150),
				BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = 131,
			}, raysR)
			nuevo("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35),
				NumberSequenceKeypoint.new(1, 1)})}, ray)
		end
		local giroR
		giroR = RunService.RenderStepped:Connect(function(dt)
			if not vivoR then giroR:Disconnect() return end
			raysR.Rotation = (raysR.Rotation + dt * 20) % 360
		end)
		-- destellos
		for i = 1, 6 do
			local ang = math.rad(i * 60 + math.random(-14, 14))
