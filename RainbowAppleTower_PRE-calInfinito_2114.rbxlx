		<Item class="ModuleScript" referent="RBX502782c5325e43d0bc6314c2e7dae8d8">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[return {
  DATA_STORE              = "TopTimePlayed" , --< Name of the Data store values will be saved in
  SCORE_UPDATE            = 3 , --< How often you want the score to be sent to datastore in minutes (no less than 1)
  -- 2026-08-04 (Klozz): era 1. Cada jugador generaba UNA escritura ordenada por
  -- minuto y esta tabla es el mayor consumidor prescindible de la cola de
  -- DataStore del servidor. Con el DAU x9 del 3-4 ago aparecieron a la vez
  -- OrderedWriteGameServerThrottled (14 casos) y "DataStore request was added to
  -- queue" (23 -> 311 en tres dias), y los guardados de perfil empezaron a fallar
  -- al primer intento. A 3 minutos se escribe un TERCIO. La aritmetica se corrige
  -- sola: el incremento es _scoreUpdateDelay/60, o sea +3 min cada 3 min.
  -- Unico coste: quien se va pierde hasta 3 min de credito en el ranking en vez
  -- de 1. Barato a cambio de dejar cola libre para que se guarde la partida.
  LEADERBOARD_UPDATE      = 1 , --< How often you want the leaderboard to update in minutes (no less than 1) 
  NAME_OF_STAT            = "TimePlayed" , --< Stat name to save in the database
  USE_LEADERSTATS         = false , --< Should use the Roblox built-in Leaderboard system too? More info: https://create.roblox.com/docs/building-and-visuals/ui/leaderboard-system
  NAME_LEADERSTATS        = "Time Played" , --< What the name of the Leaderboard to use?
  SHOW_1ST_PLACE_AVATAR   = true ,
  DO_DEBUG                = false , --< Should it debug (print) messages to the console?
}
]]></ProtectedString>
