-- ═══ RESETEO DE PERFIL (herramienta de pruebas) ═══════════
-- UserIds cuyo progreso se BORRA la próxima vez que entren. Es de UN SOLO USO:
-- al resetear se les graba el SELLO actual, así que aunque su id siga en la
-- lista NO se vuelve a borrar. ¿Quieres resetear otra vez? Cambia el SELLO.
Config.RESET_PERFIL = {260901083}      -- maxipoolmz (dueño) — limpia lo de Studio
Config.RESET_SELLO = "2026-07-18b"

Config.GRUPO_ID = 0                -- TODO: grupo real → regalo por unirse
Config.BADGE_CIMA = 0              -- TODO: badge "Llegué al cofre"

-- ═══ NOTIFICACIONES DE EXPERIENCIA ═════════════════════════
-- QUITADO el 30 jul 2026 a petición del usuario. La constante ya no la lee
-- nadie; se deja anotado el valor por si se recupera: eran 420 s (7 min).

-- ═══ MANIQUÍ DE LA AZOTEA ══════════════════════════════════
-- Textura de la manzana AZUL del maniquí que está junto al cofre.
-- ⚠️ HAY QUE SUBIRLA: el PNG está en ~/Desktop/ManzanaAzul_textura.png y
-- Roblox necesita el asset. Súbela (Creations → Decals, o el Asset Manager de
-- Studio), copia el ID y ponlo aquí. Mientras esté en //0 el maniquí sale con
-- el mesh SIN textura (blanco), NO con la verde.
-- Usa el MISMO modelo 3D que los gusanos (GUSANO_MESH_ID); lo único que
-- cambia es esta textura.
Config.MANIQUI_AZUL_TEXTURE = "rbxassetid://107294537635674"
-- 🌌 GALAXIA (30 jul 2026): sustituye a la manzana MORADA en el maniquí de la
-- azotea. La morada sigue subida a Roblox (137421051946215) por si se quiere
-- recuperar, pero ya no la usa nadie.
-- ⚠️ v6 (30 jul 2026). Historial por si hace falta volver atrás:
--   70700776472919  v1: nubes grandes, se veían los cortes de las islas del UV
--   137616488608445 v2: grano fino, sin cortes pero oscura y monótona
