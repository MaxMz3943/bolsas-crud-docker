	invisible = {id=1918929165, precio=149, nombre="🧥 Invisible", tag=""},
	-- 5 Robux (era 29, 2026-07-25): el pase YA EXISTÍA y estaba DESACTIVADO,
	-- así que se reusa bajándole el precio en vez de crear otro. Un solo pase
	-- = mismo precio en la tienda y en la oferta del botón redondo.
	giant     = {id=1917543204, precio=9,   nombre="🖐 GIANT", tag="OFERTA!"},
	god       = {id=1917993128, precio=120, nombre="🖐 GOD!", tag="x300!"},
	speed2x   = {id=1919205089, precio=5,   nombre="⚡ 2x Speed", tag=""},
	carpet    = {id=1918239122, precio=67,  nombre="🟥 Flying Carpet", tag=""},
}
Config.PRODUCTOS = {
	killall  = {id=3610600581, precio=49,  nombre="💀 Kill All"},
	-- ⚠️ el nombre de aquí es SOLO el del botón/tienda dentro del juego. El del
