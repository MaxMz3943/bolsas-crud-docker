	god60    = {id=3610600509, precio=25,  nombre="🛡 God Mode 5 min"},
	skipend  = {id=3610600678, precio=99,  nombre="⏭ Skip to End"},
	-- 💥 EXPLOTAR JUGADOR (2026-08-04). Consumible: se recompra tantas veces
