		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr then return end
			if enCooldown(plr, "btn" .. d.Name, 0.7) then return end
			if esVel then
				estrellaVel = math.clamp(estrellaVel + (esMas and 0.5 or -0.5), 0.5, 3)
			else
				estrellaImpulso = math.clamp(estrellaImpulso + (esMas and 15 or -15), 50, 170)
			end
			estrellaCartel()
		end)
