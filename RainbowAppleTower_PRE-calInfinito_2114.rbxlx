accionesPase.admin = function()
	if S.pases.admin
		or (RunService:IsStudio() and Config.ADMIN_GRATIS_STUDIO) then
		abrirAdmin()
	else RE.Prompt:FireServer("pase", "admin") end
end
accionesPase.invisible = function()
