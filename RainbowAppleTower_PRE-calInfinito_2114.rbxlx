-- ═══ HELPERS COMPARTIDOS (server y cliente) ════════════════
function Config.yLosa(f) -- Y del tope de la losa del piso f (1..N_PISOS+1; N+1 = techo)
	return Config.ALTURA_LOBBY + (f - 1) * Config.ALTURA_PISO
end

function Config.yTecho() -- Y de la azotea (donde vive el cofre)
	return Config.yLosa(Config.N_PISOS + 1)
end

function Config.pisoDe(y) -- 0 = lobby/exterior, 1..N piso de gusano, N+1 azotea
	if y &lt; Config.ALTURA_LOBBY - 2 then return 0 end
	if y &gt;= Config.yTecho() - 2 then return Config.N_PISOS + 1 end
	return math.clamp(math.floor((y - Config.ALTURA_LOBBY) / Config.ALTURA_PISO) + 1, 1, Config.N_PISOS)
end

-- 🖼 C0 del Weld del cuadro. t = 0 → pose de ARRANQUE (abajo, pegado y tumbado)
-- · t = 1 → pose FINAL (derecho delante del pecho).
-- ⚠️ Vive aquí porque lo usan LOS DOS LADOS: el server para dejar el cuadro en su
-- sitio nada más crearlo, y el cliente para animarlo. Si se duplicara, el día que
-- se toque un número la animación acabaría en un sitio distinto del que el server
-- da por bueno, y el cuadro pegaría un salto al terminar.
-- `dist` es opcional: el cliente le pasa una distancia VARIABLE (más pegada al
-- estar quieto, más separada al andar). Sin ella se usa la de Config, que es lo
-- que hace el server para dejar una pose de reposo sensata.
function Config.cuadroC0(t, dist)
	dist = dist or Config.CUADRO_DIST or 2.3
	local subir = Config.CUADRO_ALTURA or 0.8
	if t &gt;= 1 then return CFrame.new(0, subir, -dist) end
	return CFrame.new(0, subir - (Config.CUADRO_ANIM_BAJA_Y or 4.5),
			-(dist - (Config.CUADRO_ANIM_ACERCA or 0.8)))
		* CFrame.Angles(math.rad(Config.CUADRO_ANIM_TUMBE or -75), 0, 0)
end

-- ⚠️ indexar un Enum con un nombre que no existe LANZA ERROR, no devuelve nil:
-- una errata en CUADRO_ANIM_ESTILO reventaría el equipado entero. De ahí el pcall.
function Config.cuadroEstilo()
	local ok, e = pcall(function()
		return Enum.EasingStyle[Config.CUADRO_ANIM_ESTILO or "Quint"]
	end)
	return (ok and e) or Enum.EasingStyle.Quint
end

function Config.color3(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function Config.formatoCash(n)
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end

return Config
</ProtectedString></Properties></Item><Item class="Tool" referent="RBX6223"><Properties><bool name="CanBeDropped">false</bool><string name="Name">Banana</string><bool name="RequiresHandle">true</bool><string name="ToolTip">Banana trampa (cada 20s)</string></Properties><Item class="Part" referent="RBX6222"><Properties><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><Color3uint8 name="Color3uint8">4294958160</Color3uint8><token name="Material">272</token><string name="Name">Handle</string><Vector3 name="size"><X>0.9</X><Y>0.9</Y><Z>0.9</Z></Vector3><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="SpecialMesh" referent="RBX6221"><Properties><token name="MeshType">5</token><Content name="MeshId"><url>rbxassetid://13270142186</url></Content><Vector3 name="Scale"><X>1.2</X><Y>1.2</Y><Z>1.2</Z></Vector3><string name="Name">Mesh</string></Properties></Item></Item></Item><Item class="Tool" referent="RBX6226"><Properties><string name="Name">Bat</string><bool name="RequiresHandle">true</bool><bool name="CanBeDropped">false</bool><Content name="TextureId"><url>rbxassetid://116402259404908</url></Content><CoordinateFrame name="Grip"><X>1.1118</X><Y>-0.2</Y><Z>-0.0011</Z><R00>0.000000</R00><R01>-1.000000</R01><R02>0.000000</R02><R10>-1.000000</R10><R11>0.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>-1.000000</R22></CoordinateFrame><string name="ToolTip">Bat</string></Properties><Item class="Part" referent="RBX6225"><Properties><string name="Name">Handle</string><Vector3 name="size"><X>6</X><Y>1.5</Y><Z>1.5</Z></Vector3></Properties><Item class="SpecialMesh" referent="RBX6224"><Properties><string name="Name">Mesh</string><token name="MeshType">5</token><Content name="MeshId"><url>rbxassetid://3094726515</url></Content><Content name="TextureId"><url>rbxassetid://3094726692</url></Content><Vector3 name="Scale"><X>1.5</X><Y>1.5</Y><Z>1.5</Z></Vector3></Properties></Item></Item><Item class="LocalScript" referent="RBX6227"><Properties><string name="Name">BatLogic</string><ProtectedString name="Source">local Tool = script.Parent
local RS = game:GetService("RunService")
local RE = game:GetService("ReplicatedStorage"):WaitForChild("Remotos"):WaitForChild("Slap")
local baseGrip = Tool.Grip
local busy = false
-- sonido del batazo PRECARGADO y reutilizado: suena AL INSTANTE en
-- CADA swing (2026-07-25). Antes solo sonaba si el golpe CONECTABA
-- con otro jugador, asi que probando solo parecia roto. Va en el
-- Handle = 3D: los de al lado tambien lo oyen.
local golpe = Instance.new("Sound")
golpe.SoundId = "rbxassetid://126657623386649"
golpe.Volume = 0.8
golpe.RollOffMaxDistance = 120
golpe.Parent = Tool:FindFirstChild("Handle") or Tool
task.spawn(function() pcall(function()
	game:GetService("ContentProvider"):PreloadAsync({golpe}) end) end)
Tool.Equipped:Connect(function() baseGrip = Tool.Grip end)
Tool.Activated:Connect(function()
	if busy then return end
	busy = true
	RE:FireServer("bat")
	golpe.TimePosition = 0
	golpe:Play()   -- precargado: suena JUNTO con el swing
	local dur, t0 = 0.2, os.clock()
	local conn
	conn = RS.RenderStepped:Connect(function()
		local a = (os.clock() - t0) / dur
		if a &gt;= 1 then Tool.Grip = baseGrip conn:Disconnect() return end
		-- HACHAZO VERTICAL (pedido 2026-07-25): el bate parte VERTICAL
		-- (90 grados, reposo), BAJA hasta quedar HORIZONTAL (0) y vuelve a
		-- subir. Bajada rapida (45%% del tiempo), subida mas suave (55%%).
		-- EJES probados (2026-07-25): Y = gira sobre si mismo, Z = baja
		-- de LADO, -X = hacia ATRAS (se pegaba a si mismo). +X = ENFRENTE.
		local ang
		if a &lt; 0.45 then ang = (a / 0.45) * (math.pi / 2)
		else ang = (1 - (a - 0.45) / 0.55) * (math.pi / 2) end
		Tool.Grip = baseGrip * CFrame.Angles(ang, 0, 0)
	end)
	-- COOLDOWN de 3 s: sin spam. ESPEJO de Config.BAT_COOLDOWN
	task.delay(3, function() busy = false end)
end)
