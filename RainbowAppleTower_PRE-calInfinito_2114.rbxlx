			Size = UDim2.new(0, 170, 0, 170), Position = UDim2.new(0.5, 0, 0.42, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Image = Config.IMG_COIL, ScaleType = Enum.ScaleType.Fit, ZIndex = 134,
		}, escR)
		do
