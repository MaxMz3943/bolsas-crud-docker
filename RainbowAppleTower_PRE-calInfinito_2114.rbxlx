			local ss = Instance.new("UIScale")
			ss.Scale = 0.2
			ss.Parent = sp
			TweenService:Create(ss, TweenInfo.new(0.5 + math.random() * 0.5,
				Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true,
				math.random() * 0.4), {Scale = 1.15}):Play()
		end
		-- icono del GRAVITY COIL flotando
