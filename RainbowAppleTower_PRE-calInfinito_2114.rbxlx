	LineJoinMode = Enum.LineJoinMode.Round}, labelSpeed)
-- ═══ FREE SLAP: botón REDONDO con temporizador, arriba del 2x Speed. Cada
-- 5 min se ilumina y al clickearlo el server te da la slap GIANT gratis un
-- rato. Mientras carga muestra la cuenta regresiva (m:ss) en gris. ═══
local FREESLAP_CD = Config.FREESLAP_CD or 300
-- ⚠️ el tiempo lo manda el SERVER (atributo "FreeSlapEn" en hora absoluta de
-- servidor). Antes se contaba con os.clock() local y el botón se encendía
-- antes de tiempo → el server rechazaba en silencio y el reclamo se perdía.
local function freeFalta()
	local en = tonumber(plr:GetAttribute("FreeSlapEn"))
	if not en then return FREESLAP_CD end
	return en - workspace:GetServerTimeNow()
end
-- contenedor: círculo (solo el icono) + "FREE BAT" abajo + cronómetro abajo
-- centrado respecto al botón 2x Speed (su centro queda a -109 del borde) y
-- pegadito encima de él; más chico para no robar atención
local marcoFree = nuevo("Frame", {
	-- alto 137: cabe el icono (98), el título y el PRECIO de la oferta (26 px;
	-- el cronómetro sigue a 16)
	Size = UDim2.new(0, 96, 0, 137), Position = UDim2.new(1, -109, 0.5, -42),
	AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1,
}, gui)
local botonFree = nuevo("ImageButton", {
	Size = UDim2.new(0, 62, 0, 62), Position = UDim2.new(0.5, 0, 0, 0),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundColor3 = Color3.fromRGB(66, 66, 96),
	BackgroundTransparency = 0.15, BorderSizePixel = 0, Image = "",
}, marcoFree)
nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, botonFree)
local strokeFree = nuevo("UIStroke", {
	Thickness = 3, Color = Color3.fromRGB(150, 150, 175),
}, botonFree)
local icoFree = nuevo("ImageLabel", {        -- SOLO el icono, colores originales
	-- 🏏 98 = casi el doble del botón redondo (62): el icono SOBRESALE a
	-- propósito para que llame la atención (123 → 98, −20% el 2026-07-25).
	-- El botón no recorta, así que se ve entero.
	Size = UDim2.new(0, 98, 0, 98), Position = UDim2.new(0.5, 0, 0.5, 0),
	AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
	Image = Config.IMG_BAT, ScaleType = Enum.ScaleType.Fit, ZIndex = 3,
}, botonFree)
local lblFreeTitulo = nuevo("TextLabel", {
	-- 84: el icono (98 px) baja hasta y=80, así no se le encima el texto
	Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0.5, 0, 0, 84),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
	Font = Enum.Font.LuckiestGuy, Text = "FREE BAT",
	TextColor3 = Color3.new(1, 1, 1), TextScaled = true,
}, marcoFree)
nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
	LineJoinMode = Enum.LineJoinMode.Round}, lblFreeTitulo)
local lblFreeTimer = nuevo("TextLabel", {
	Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0.5, 0, 0, 105),   -- baja con el título
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne, Text = "5:00",
	TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true,
}, marcoFree)
nuevo("UIStroke", {Thickness = 2.4, Color = Color3.new(0, 0, 0)}, lblFreeTimer)
-- "reclamada" lo decide el SERVER (atributo SlapGratis), no el clic: así el
-- botón nunca miente ni se queda trabado si el reclamo no entró.
local freeAutoAbierta = false   -- la ventana ya salió sola esta sesión
local function freeReclamadaFn()
	return plr:GetAttribute("SlapGratis") == true
end
-- ventana de regalo (mismo estilo que el del Gravity Coil): aura + rayos +
-- destellos + guante flotando + botón RECLAMAR. El reclamo REAL lo dispara
-- ese botón; el server confirma con el atributo SlapGratis.
local abrirRegaloSlap, autoAbrirSlap
botonFree.MouseButton1Click:Connect(function()
	if freeReclamadaFn() then
		-- 🖐 ya tiene el BATE: el círculo pasó a ser la OFERTA de la SLAP normal
		-- a 5 Robux. Se pide al server (él abre el prompt de compra de Roblox).
		if not (S.pases and S.pases.giant) then
			RE.Prompt:FireServer("pase", "giant")
		end
		return
	end
	if freeFalta() &gt; 0 then return end         -- aún no está lista
	abrirRegaloSlap()
end)

task.spawn(function()
	while true do
		if freeReclamadaFn() then
			-- 🖐 BATE ya reclamado → el mismo círculo promociona la SLAP normal
			-- a 5 Robux (o dice "ACTIVE!" si el jugador ya la tiene).
			if S.pases and S.pases.giant then
				icoFree.Image = Config.IMG_GIANT
				lblFreeTitulo.Text = "GIANT SLAP"
				lblFreeTimer.Size = UDim2.new(1, 0, 0, 16)
				lblFreeTimer.Text = "ACTIVE!"
				lblFreeTimer.TextColor3 = Color3.fromRGB(120, 255, 150)
				strokeFree.Color = Color3.fromRGB(110, 235, 140)
			else
				icoFree.Image = Config.IMG_GIANT
				lblFreeTitulo.Text = "GIANT SLAP"
				lblFreeTimer.Text = Config.GAMEPASSES.giant.precio .. " " .. ROBUX
				-- el PRECIO va más grande que el cronómetro (26 vs 16): con
				-- TextScaled manda el alto (32 → 26, −20% el 2026-07-25)
				lblFreeTimer.Size = UDim2.new(1, 0, 0, 26)
				lblFreeTimer.TextColor3 = Color3.fromRGB(90, 230, 90)   -- VERDE
				local p2 = 0.5 + 0.5 * math.sin(os.clock() * 5)
				strokeFree.Color = Color3.fromRGB(90 + 60 * p2, 255, 130 + 40 * p2)
			end
		else
			local falta = freeFalta()
			if falta &gt; 0 then
				lblFreeTimer.Size = UDim2.new(1, 0, 0, 16)
			lblFreeTimer.Text = string.format("%d:%02d",
					math.floor(falta / 60), math.floor(falta % 60))
				lblFreeTimer.TextColor3 = Color3.fromRGB(255, 220, 90)
				strokeFree.Color = Color3.fromRGB(150, 150, 175)
			else
				lblFreeTimer.Size = UDim2.new(1, 0, 0, 16)
				lblFreeTimer.Text = "READY!"
				lblFreeTimer.TextColor3 = Color3.fromRGB(120, 255, 150)
				-- borde verde pulsante cuando está lista para reclamar
				local p = 0.5 + 0.5 * math.sin(os.clock() * 5)
				strokeFree.Color = Color3.fromRGB(90 + 60 * p, 255, 130 + 40 * p)
				-- AUTO-ABRIR (2026-07-18): al cumplirse el tiempo la ventana
				-- sale SOLA, una vez. Si la cierran, el botón sigue ahí para
				-- volver a abrirla cuando quieran.
				if not freeAutoAbierta and autoAbrirSlap and autoAbrirSlap() then
					freeAutoAbierta = true
				end
			end
		end
		task.wait(0.2)
	end
end)

botonSpeed.MouseButton1Click:Connect(function()
	RE.Prompt:FireServer("pase", "speed2x")
end)

