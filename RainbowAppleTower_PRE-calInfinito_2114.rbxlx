		end)
	elseif d.Name == "PadLobby" then
		-- letrero FLOTANDO encima del pad (BillboardGui con la tipografía
		-- llamativa de siempre: LuckiestGuy + contorno negro grueso)
		local bgP = Instance.new("BillboardGui")
		bgP.Size = UDim2.new(13, 0, 3.2, 0)
		-- offset 6.2: el texto flota POR ENCIMA del barandal traslúcido de la
		-- azotea (que sube 4) → ya no se entierra en él como el viejo bug de
		-- los textos en paredes transparentes
		bgP.StudsOffset = Vector3.new(0, 6.2, 0)
		bgP.MaxDistance = 140
		bgP.Parent = d
		local tlP = Instance.new("TextLabel")
		tlP.Size = UDim2.new(1, 0, 1, 0)
		tlP.BackgroundTransparency = 1
		tlP.Font = Enum.Font.LuckiestGuy
		tlP.TextScaled = true
		tlP.Text = "Return to obby"
		tlP.TextColor3 = Color3.new(1, 1, 1)
		local stP = Instance.new("UIStroke")
		stP.Thickness = 4
		stP.Color = Color3.new(0, 0, 0)
		stP.LineJoinMode = Enum.LineJoinMode.Round
		stP.Parent = tlP
		tlP.Parent = bgP
		-- circulito verde con palomita blanca DEBAJO del texto (2026-07-19):
		-- va en su propio billboard más abajo (offset menor) para no deformar
		-- el texto, que sigue ocupando su billboard completo
		-- tamaño en STUDS (mundo): se ve del mismo tamaño FÍSICO siempre,
		-- como un objeto real. TRUCO anti-pixeleado: el billboard es GRANDE
		-- (8 studs = lienzo de alta resolución) y el círculo se dibuja al 20%
		-- adentro → círculo de 1.6 studs con 5× más resolución de dibujo.
		local bgOk = Instance.new("BillboardGui")
		bgOk.Size = UDim2.new(8, 0, 8, 0)
		bgOk.StudsOffset = Vector3.new(0, 3.9, 0)
		bgOk.MaxDistance = 140
		bgOk.LightInfluence = 0            -- colores VIVOS: la luz no lo apaga
		bgOk.Parent = d
		local cir = Instance.new("Frame")
		cir.Size = UDim2.new(0.2, 0, 0.2, 0)
		cir.Position = UDim2.new(0.5, 0, 0.5, 0)
		cir.AnchorPoint = Vector2.new(0.5, 0.5)
		cir.BackgroundColor3 = Color3.fromRGB(62, 232, 92)
		cir.BorderSizePixel = 0
		cir.Parent = bgOk
		local escOk = Instance.new("UICorner")
		escOk.CornerRadius = UDim.new(0.5, 0)
		escOk.Parent = cir
		local brOk = Instance.new("UIStroke")
		brOk.Thickness = 3
		brOk.Color = Color3.new(0, 0, 0)
		brOk.Parent = cir
		local pal = Instance.new("TextLabel")
		pal.Size = UDim2.new(0.78, 0, 0.78, 0)
		pal.Position = UDim2.new(0.5, 0, 0.5, 0)
		pal.AnchorPoint = Vector2.new(0.5, 0.5)
		pal.BackgroundTransparency = 1
		pal.Font = Enum.Font.GothamBlack
		pal.TextScaled = true
		pal.Text = "✓"
		pal.TextColor3 = Color3.new(1, 1, 1)
		pal.Parent = cir
		local palGrosor = Instance.new("UIStroke")
		palGrosor.Thickness = 2.4          -- contorno BLANCO = palomita gorda
		palGrosor.Color = Color3.new(1, 1, 1)
		palGrosor.LineJoinMode = Enum.LineJoinMode.Round
		palGrosor.Parent = pal
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if plr and plr.Character then
				-- 🔄 REINICIO DE LA SUBIDA (2026-07-24): bajarse por aquí es
				-- EMPEZAR DE NUEVO, así que se borran los checkpoints. De paso
				-- esto apaga solo el botón "BACK TO FLOOR": sin checkpoint no hay
				-- a dónde volver. Si no, al caer en el lobby le saldría
				-- ofreciéndole regresar a la azotea que acaba de dejar a propósito.
				-- ⚠️ hay que borrar pisosActivados TAMBIÉN, no solo el checkpoint:
				-- ese set marca cada piso "ya activado esta sesión" y NUNCA se
				-- limpiaba, así que en la 2ª subida los botones no respondían, el
				-- jugador se quedaba sin checkpoint para siempre y el botón
				-- "BACK TO FLOOR" ya no le salía nunca.
				-- 💰 QUE VUELVA A PAGAR ES A PROPÓSITO (decidido 2026-07-24): cada
				-- vuelta completa a la torre paga otra vez los ~21,000 $ de bonos
				-- de piso. NO es un hueco de economía: es el premio por rejugar,
				-- y solo se cobra completando los 20 pisos y pisando este pad.
				-- Si algún día estorba, se separa en dos listas (una para el
				-- checkpoint que se reinicia y otra para el dinero que no).
				-- 🔒 Touched se dispara VARIAS veces seguidas (el cuerpo rebota en
				-- el pad). Sin este candado el reinicio corría 3-4 veces y cada
				-- uno volvía a habilitar el cobro de la azotea.
				if enCooldown(plr, "padLobby", 3) then return end
				local r = rt[plr]
				if r then
					r.checkpointPiso = 0
					r.pisosActivados = {}   -- los botones se vuelven a poder pisar
					r.reinicioT = os.clock()   -- ⏱ ventana de gracia (ver CheckpointBtn_)
					marcar(plr)             -- que el cliente se entere (sync cada 0.4 s)
					RE.FX:FireClient(plr, "reiniciarCheckpoints")   -- y que se despinten
				end
				plr.Character:PivotTo(cframeEntrada(0))
			end
		end)
	elseif d.Name == "PremioCristal" then
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr or not perfiles[plr] then return end
			finObby(plr)   -- llegaste a la meta → teletransporte en 3 s
			local resta = enCooldown(plr, "cristal", 900)
			if resta then
				RE.ClaimCd:FireClient(plr, d, resta)   -- re-sincroniza su cronómetro local
				if not enCooldown(plr, "cristalAviso", 5) then
					toast(plr, "claimCd", math.ceil(resta / 60))
				end
				return
			end
			darCash(plr, 750)
			toast(plr, "claim", 750)
			RE.ClaimCd:FireClient(plr, d, 900)   -- arranca su cronómetro
			RE.FX:FireAllClients("confeti", d.Position)
			RE.FX:FireClient(plr, "obbyCompletado")   -- sonido de obby completado (solo tu)
			RE.FX:FireClient(plr, "dineroFlota", d.Position, 750)   -- +$X flotante con billetes
		end)
	elseif SKIN_DE_PAD[d.Name] then
		-- ═══ PADS DE SKIN ═══════════════════════════════════════
		-- Pisar el pad te pone su manzana, y si YA la llevas te la quita.
		-- Los cinco pads hacían exactamente esto con ~35 líneas cada uno, y cada
		-- copia repetía a mano el bloque de "destruye las otras cinco". Ahora
		-- comparten handler: el de la comunidad ya no necesita su propio chequeo
		-- de EnComunidad y el de la azotea respeta el desbloqueo igual que el
		-- menú, porque de eso se encarga equiparSkin.
		local id = SKIN_DE_PAD[d.Name]
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr or not rt[plr] then return end
			if enCooldown(plr, "skinPad", 1.5) then return end
			if equiparSkin(plr, id, true) then
				RE.FX:FireClient(plr, "morphOn")
				RE.FX:FireAllClients("confeti", d.Position)
			end
		end)
