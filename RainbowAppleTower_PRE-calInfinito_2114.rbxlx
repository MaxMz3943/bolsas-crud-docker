                                   -- Se deja porque algún sitio viejo aún lo lee.

-- ⚡ ESPACIADO DE GUSANOS POR TRAMOS (2026-07-25)
-- Antes era 1 gusano cada 2 pisos en TODA la torre, así que el piso 1 tenía la
-- misma presión que el 20. Con los datos de retención (el 38% se va en los
-- primeros 100 s) el arranque tenía que ser más suave: en los 9 primeros pisos
-- ahora hay 1 gusano cada 3, o sea el bicho pasa el 33% del tiempo en tu piso en
-- vez del 50%. Del 10 en adelante se mantiene el ritmo de siempre.
-- ⚠️ Lo leen el SERVER y build_rbxlx.py: cambiar aquí cambia las dos cosas.
Config.GUSANO_TRAMOS = {
	{desde = 1,  hasta = 9,  cada = 3},   -- arranque suave: gusanos en 1, 4, 7
	{desde = 10, hasta = 25, cada = 2},   -- resto: en 10, 12, 14, 16, 18, 20, 22, 24
}

-- lista {piso = dónde vive, cubre = cuántos pisos patrulla}. La usan igual el
-- server (para crear los gusanos) y el build (para colocar los modelos).
function Config.gusanos()
	local out = {}
	for _, t in ipairs(Config.GUSANO_TRAMOS) do
		local tope = math.min(t.hasta, Config.N_PISOS)
		local f = t.desde
		while f &lt;= tope do
			out[#out + 1] = {piso = f, cubre = math.min(t.cada, tope - f + 1)}
			f = f + t.cada
		end
	end
	return out
end
