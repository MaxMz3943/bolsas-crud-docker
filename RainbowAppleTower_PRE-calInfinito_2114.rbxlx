4278979598</Color3uint8><token name="Material">272</token><string name="Name">Palo</string><Vector3 name="size"><X>0.2681</X><Y>0.203</Y><Z>1.1599</Z></Vector3><token name="shape">1</token></Properties></Item><Item class="Weld" referent="RBX6319"><Properties><string name="Name">ManoWeld</string><Ref name="Part0">RBX6317</Ref><Ref name="Part1">RBX6318</Ref><CoordinateFrame name="C0"><X>-0.0896</X><Y>1.6016</Y><Z>0.0112</Z><R00>0.000000</R00><R01>1.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>0.000000</R11><R12>1.000000</R12><R20>1.000000</R20><R21>0.000000</R21><R22>0.000000</R22></CoordinateFrame><CoordinateFrame name="C1"><X>0</X><Y>0</Y><Z>0</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame></Properties></Item><Item class="LocalScript" referent="RBX6321"><Properties><string name="Name">SlapLogic</string><ProtectedString name="Source">local Tool = script.Parent
local RS = game:GetService("RunService")
local RE = game:GetService("ReplicatedStorage"):WaitForChild("Remotos"):WaitForChild("Slap")
local baseGrip = Tool.Grip
local busy = false
-- sonido del cachetazo PRECARGADO y reutilizado: suena AL INSTANTE en
-- cada golpe (antes creaba+cargaba uno nuevo por click = ~ms de retraso)
local golpe = Instance.new("Sound")
golpe.SoundId = "rbxassetid://126619107266979"
golpe.Volume = 0.5
golpe.RollOffMaxDistance = 120
golpe.Parent = Tool:FindFirstChild("Handle") or Tool
task.spawn(function() pcall(function()
	game:GetService("ContentProvider"):PreloadAsync({golpe}) end) end)
Tool.Equipped:Connect(function()
	baseGrip = Tool.Grip
	RE:FireServer("equipar_giant")   -- el server valida la compra
end)
Tool.Activated:Connect(function()
	if busy then return end
	busy = true
	RE:FireServer("giant")
	golpe.TimePosition = 0.05   -- salta el arranque del audio: entra un pelín antes
	golpe:Play()   -- precargado → suena JUNTO con el swing, sin retraso
	local dur, t0 = 0.34, os.clock()
	local conn
	conn = RS.RenderStepped:Connect(function()
		local a = (os.clock() - t0) / dur
		if a &gt;= 1 then Tool.Grip = baseGrip conn:Disconnect() return end
		local ang
		if a &lt; 0.28 then ang = -(a / 0.28) * 0.6
		elseif a &lt; 0.6 then ang = -0.6 + ((a - 0.28) / 0.32) * 2.4
		else ang = 1.8 - ((a - 0.6) / 0.4) * 1.8 end
		Tool.Grip = baseGrip * CFrame.Angles(0, -ang, 0)
	end)
	-- COOLDOWN de 2 s: sin spam (ni animación, ni sonido, ni golpe).
	-- ⚠️ ESPEJO de Config.SLAP_COOLDOWN en el server: si cambias uno,
	-- cambia el otro, o el jugador ve el golpe y el server lo ignora.
	-- La barra de recarga del inventario la pinta MainClient.
	task.delay(2, function() busy = false end)
end)
</ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX6322"><Properties><string name="Name">StarterGui</string></Properties></Item><Item class="SoundService" referent="RBX6323"><Properties><string name="Name">SoundService</string></Properties></Item><Item class="Teams" referent="RBX6324"><Properties><string name="Name">Teams</string></Properties></Item><SharedStrings><SharedString md5="yuZpQdnvvUBOTYh1jqZ2cA=="></SharedString><SharedString md5="djjOY2VbBE7RPkqG0/bmrw==">TGl2ZURvbmF0aW9uQm9hcmQ=</SharedString><SharedString md5="iAq3OiyRK328kFwW2gc6SQ==">VGhyZWVEVGV4dE9iamVjdA==</SharedString><SharedString md5="jjMBC8RPnGW3CHUpGCUdhA==">VGhyZWVEVGV4dE9iamVjdEJvdW5kaW5nQm94</SharedString><SharedString md5="+qv2o0HSW+htH+ALwYQpiw==">Q1NHUEhTAAAAAEJMT0NL</SharedString></SharedStrings></roblox>