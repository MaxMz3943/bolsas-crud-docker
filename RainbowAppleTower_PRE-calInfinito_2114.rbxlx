		end)
	elseif d.Name == "CoilSpeedVitrina" or d.Name == "CoilJumpVitrina" then
		-- E para COMPRAR el coil de ESTA vitrina (cada coil tiene la suya)
		local esSpeed = d.Name == "CoilSpeedVitrina"
		local clave = esSpeed and "speedcoil" or "jumpcoil"
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Buy"
		prompt.ObjectText = esSpeed and "Speed Coil" or "Gravity Coil"
		prompt.MaxActivationDistance = 14
		prompt.HoldDuration = 0.2
		prompt.RequiresLineOfSight = false
		prompt.Parent = d
		prompt.Triggered:Connect(function(plr)
			local perfil = perfiles[plr]
			if not perfil then return end
			local tiene = esSpeed and perfil.coils.speed or
				(not esSpeed and perfil.coils.jump)
			if tiene then
				-- "gearOk" tambien significa COMPRA EXITOSA en otras 4 llamadas;
				-- aqui el sentido es "ya lo tienes" → llave propia para no
				-- despertar aquellas notificaciones
				toast(plr, "yaObjeto")           -- ya lo tienes
				return
			end
			local info = Config.PRODUCTOS[clave]
			if info.id &gt; 0 then
				MarketplaceService:PromptProductPurchase(plr, info.id)
			elseif ES_STUDIO then
				otorgarProducto(plr, clave)      -- en Studio se otorga gratis
			else
				toast(plr, "sinId")
			end
		end)
	elseif d.Name == "CartelGrupo" then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Claim gift"
		prompt.ObjectText = "Like 👍 + Group"
		prompt.MaxActivationDistance = 12
		prompt.Parent = d
		prompt.Triggered:Connect(function(plr)
			local perfil = perfiles[plr]
			if not perfil then return end
			if perfil.regaloGrupo then toast(plr, "grupoYa") return end
			-- ⚠️ ESTE ERA EL QUE TIRABA LA CUOTA. Un ProximityPrompt se puede
			-- machacar sin límite y aquí no había ningún freno, así que cada
			-- pulsación de la E salía a la web. Un solo jugador dándole sin parar
			-- dejaba sin cuota de IsInGroup al servidor entero — a los otros 69.
			if not limitar(plr, "grupo", 1) then return end
			local dentro = esDelGrupo(plr)
			if dentro == nil then toast(plr, "grupoError") return end
			if dentro then
				perfil.regaloGrupo = true
				darCash(plr, 500)
				toast(plr, "grupo")
				RE.FX:FireAllClients("confeti", d.Position)
			else
				toast(plr, "grupoNo")
			end
			marcar(plr)
		end)
	end
end

-- ⚡ RECOLECCIÓN CONFIABLE DE MONEDAS por DISTANCIA (server-authoritative).
-- El d.Touched del SERVER se saltaba ~90% de las monedas porque el personaje es
-- propiedad de red del CLIENTE (Roblox no manda esos touches al server de forma
-- confiable, sobre todo al correr/saltar). Este loop revisa a 10 Hz la distancia
-- jugador↔moneda y recoge la que esté cerca, con el MISMO cooldown por moneda
-- (el .Touched se queda de respaldo; el cooldown evita doble pago).
do
	local RADIO2 = 6 * 6   -- 6 studs de alcance (al cuadrado, sin sacar raíz)
	-- ⚡ OPTIMIZACIÓN 2026-07-24: antes cada jugador revisaba las 61 monedas cada
	-- 0.1 s (30 jugadores = 1,830 revisiones por tick, 18,300/s → subía el ms del
	-- server y no dejaba recoger monedas). Ahora las monedas se agrupan POR PISO
	-- y cada jugador revisa SOLO las de su piso (unas 3) + el de arriba y abajo
	-- por si está en el borde. Pasa de O(jugadores × 61) a O(jugadores × ~9).
	local monedasPorPiso = {}
	for _, m in ipairs(monedas) do
		local f = m.piso or 0
		monedasPorPiso[f] = monedasPorPiso[f] or {}
		local b = monedasPorPiso[f]
		b[#b + 1] = m
	end
	local acumMon = 0
	RunService.Heartbeat:Connect(function(dt)
		acumMon = acumMon + dt
		if acumMon &lt; 0.1 then return end
		acumMon = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and perfiles[plr] then
				local rp = root.Position
				local pf = Config.pisoDe(rp.Y)
				-- solo los cubos de su piso y los vecinos (borde entre pisos)
				for f = pf - 1, pf + 1 do
					local cubo = monedasPorPiso[f]
					if cubo then
						for _, m in ipairs(cubo) do
							local d = m.part
							if d.Parent then
								local dx = d.Position.X - rp.X
								local dy = d.Position.Y - rp.Y
								local dz = d.Position.Z - rp.Z
								if dx * dx + dy * dy + dz * dz &lt; RADIO2
										and not enCooldown(plr, m.clave, Config.MONEDA_RESPAWN) then
									darCash(plr, Config.MONEDA_ORO)
									RE.FX:FireClient(plr, "moneda", d, Config.MONEDA_ORO)
								end
							end
						end
					end
				end
			end
		end
	end)
end

-- ─── CARTELES / BILLBOARDS del mundo ───────────────────────
-- tamaño en STUDS (componente scale): el texto es parte del mundo y NO se
-- agranda/achica con la distancia de la cámara
-- fuente bonita muy usada en Roblox + contorno negro grueso y limpio
local FUENTE = Enum.Font.LuckiestGuy
local function estilar(tl, grosor, colorContorno)
	tl.Font = FUENTE
	tl.RichText = true
	tl.TextStrokeTransparency = 1        -- apagamos el fino; usamos UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = grosor or 3.5
	s.Color = colorContorno or Color3.new(0, 0, 0)
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = tl
	return tl
end

local function billboard(parte, texto, color, ancho, offsetY, alto)
	ancho = (ancho or 12) * 1.25         -- textos más grandes
	local bg = Instance.new("BillboardGui")
	bg.Size = UDim2.new(ancho, 0, alto and alto * 1.25 or ancho * 0.3, 0)
	bg.StudsOffset = Vector3.new(0, offsetY or 3, 0)
	bg.AlwaysOnTop = false
	bg.MaxDistance = 300
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.Text = texto
	tl.TextColor3 = color
	estilar(tl, 4)
	tl.Parent = bg
	bg.Parent = parte
	return bg
end

-- cartel de CLAIM (estilo referencia): "Claim!" dorado grande y debajo el
-- billete (IMG_CASH) + la cantidad EXACTA que da el pad, en verde con contorno
local function cartelClaim(parte, cantidad)
	local bg = Instance.new("BillboardGui")
	bg.Size = UDim2.new(10, 0, 5.5, 0)
	bg.StudsOffset = Vector3.new(0, 3.6, 0)
	bg.MaxDistance = 300
	local titulo = Instance.new("TextLabel")
	titulo.Size = UDim2.new(1, 0, 0.56, 0)
	titulo.BackgroundTransparency = 1
	titulo.TextScaled = true
	titulo.Text = "Claim!"
	titulo.TextColor3 = Color3.fromRGB(255, 255, 255)
	estilar(titulo, 2.5)
	titulo.Parent = bg
	local fila = Instance.new("Frame")
	fila.Size = UDim2.new(1, 0, 0.38, 0)
	fila.Position = UDim2.new(0, 0, 0.6, 0)
	fila.BackgroundTransparency = 1
	fila.Parent = bg
	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Horizontal
	lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lay.VerticalAlignment = Enum.VerticalAlignment.Center
	lay.Padding = UDim.new(0.02, 0)
	lay.Parent = fila
	local icono = Instance.new("ImageLabel")
	icono.BackgroundTransparency = 1
	icono.Image = Config.IMG_CASH
	icono.Size = UDim2.new(0.16, 0, 0.9, 0)
	local cuadrado = Instance.new("UIAspectRatioConstraint")
	cuadrado.AspectRatio = 1
	cuadrado.Parent = icono
	icono.Parent = fila
	local monto = Instance.new("TextLabel")
	monto.BackgroundTransparency = 1
	monto.Size = UDim2.new(0.45, 0, 1, 0)
	monto.TextScaled = true
	monto.Text = "$" .. tostring(cantidad)
	monto.TextColor3 = Color3.fromRGB(120, 255, 120)   -- SOLO el monto en verde (dinero); "Claim!" queda blanco
	estilar(monto, 2.5)
	monto.Parent = fila
	bg.Parent = parte
	return bg
end

-- arcoíris para pintar texto con UIGradient (carteles llamativos)
local ARCOIRIS_TXT = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 160, 40)),
	ColorSequenceKeypoint.new(0.34, Color3.fromRGB(255, 235, 45)),
	ColorSequenceKeypoint.new(0.50, Color3.fromRGB(70, 220, 90)),
	ColorSequenceKeypoint.new(0.67, Color3.fromRGB(60, 150, 255)),
	ColorSequenceKeypoint.new(0.84, Color3.fromRGB(160, 80, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 70, 205)),
})

-- cartel BONITO de 2 líneas: la 1ª blanca, la 2ª ARCOÍRIS, ambas con contorno
-- negro grueso y fuente gruesa (estilo de la referencia de la alfombra)
local function cartelDosLineas(parte, linea1, linea2, ancho, alto, offsetY)
	local bg = Instance.new("BillboardGui")
	bg.Size = UDim2.new(ancho, 0, alto, 0)
	bg.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	bg.MaxDistance = 300
	bg.Parent = parte
	local function linea(txt, y, escY, arcoiris)
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, 0, escY, 0)
		tl.Position = UDim2.new(0, 0, y, 0)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.LuckiestGuy
		tl.TextScaled = true
		tl.Text = txt
		tl.TextColor3 = Color3.new(1, 1, 1)
		local st = Instance.new("UIStroke")
		st.Thickness = 4.5
		st.Color = Color3.new(0, 0, 0)
		st.LineJoinMode = Enum.LineJoinMode.Round
		st.Parent = tl
		if arcoiris then
			local g = Instance.new("UIGradient")
			g.Name = "ArcoirisAnim"   -- el cliente lo anima (colores fluyen)
			g.Color = ARCOIRIS_TXT
			g.Parent = tl
		end
		tl.Parent = bg
		return tl
	end
	linea(linea1, 0, 0.52, false)      -- FLY AROUND (blanca, un pelín más grande)
	linea(linea2, 0.5, 0.5, true)      -- Flying Carpet (arcoíris)
	return bg
end

-- cartel de VITRINA estilo referencia: NOMBRE del ítem (blanco, LuckiestGuy con
-- contorno negro) y DEBAJO el precio en Robux (verde + icono, glifo 0xE002)
local ICONO_ROBUX = utf8.char(0xE002)
local function cartelPrecio(parte, nombre, precio, onTop, subir, escala)
	escala = escala or 1
	local bg = Instance.new("BillboardGui")
	bg.Size = UDim2.new(6 * escala, 0, 3.6 * escala, 0)      -- 'escala' agranda las letras
	bg.StudsOffset = Vector3.new(0, 2.3 + (subir or 0), 0)   -- 'subir' extra para ítems altos (maniquí 1.5x)
	bg.MaxDistance = 300
	bg.AlwaysOnTop = onTop == true             -- encima de todo → texto NÍTIDO (ni pared translúcida ni maniquí lo atraviesan)
	bg.Parent = parte
	-- nombre (blanco con contorno negro), arriba
	local nom = Instance.new("TextLabel")
	nom.Size = UDim2.new(1, 0, 0.56, 0)
	nom.BackgroundTransparency = 1
	nom.Font = Enum.Font.LuckiestGuy
	nom.TextScaled = true
	-- espacio IRROMPIBLE: TextScaled re-parte el texto en líneas según los
	-- píxeles en pantalla (de cerca 2 líneas, de lejos 1 → "bailaba" al mover
	-- la cámara). Con NBSP nunca puede partirse: SIEMPRE una sola línea.
	nom.Text = (nombre:gsub(" ", utf8.char(0x00A0)))
	nom.TextColor3 = Color3.new(1, 1, 1)
	local s1 = Instance.new("UIStroke")
	s1.Thickness = 4
	s1.Color = Color3.new(0, 0, 0)
	s1.LineJoinMode = Enum.LineJoinMode.Round
	s1.Parent = nom
	nom.Parent = bg
	-- precio + icono de Robux (verde), abajo
	local pr = Instance.new("TextLabel")
	pr.Size = UDim2.new(1, 0, 0.4, 0)
	pr.Position = UDim2.new(0, 0, 0.6, 0)
	pr.BackgroundTransparency = 1
	pr.Font = Enum.Font.FredokaOne
	pr.TextScaled = true
	pr.Text = tostring(precio) .. " " .. ICONO_ROBUX
	pr.TextColor3 = Color3.fromRGB(90, 230, 90)
	local s2 = Instance.new("UIStroke")
	s2.Thickness = 3
	s2.Color = Color3.new(0, 0, 0)
	s2.LineJoinMode = Enum.LineJoinMode.Round
	s2.Parent = pr
	pr.Parent = bg
	return bg
end


local function cartelSuperficie(parte, texto, colorTexto, colorFondo, cara)
	local sg = Instance.new("SurfaceGui")
	sg.Face = cara or Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(800, 300)
	local fondo = Instance.new("Frame")
	fondo.Size = UDim2.new(1, 0, 1, 0)
	fondo.BackgroundColor3 = colorFondo or Color3.new(0, 0, 0)
	fondo.BackgroundTransparency = colorFondo and 0 or 1   -- sin colorFondo = SOLO letras (sin letrero)
	fondo.BorderSizePixel = 0
	fondo.Parent = sg
	local tl = Instance.new("TextLabel")
	tl.AnchorPoint = Vector2.new(0.5, 0.5)                  -- CENTRADO en el cartel
	tl.Position = UDim2.new(0.5, 0, 0.5, 0)
	tl.Size = UDim2.new(0.92, 0, 0.86, 0)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.TextXAlignment = Enum.TextXAlignment.Center
	tl.TextYAlignment = Enum.TextYAlignment.Center
	tl.Text = texto
	tl.TextColor3 = colorTexto
	estilar(tl, 6)
	tl.RichText = false                                    -- MISMA tipografía que FLYING CARPET (sin RichText)
	tl.Parent = fondo
	sg.Parent = parte
end

-- letrero de TIENDA estilo referencia del usuario: letras GRANDES con DEGRADADO
-- vertical (claro arriba → fuerte abajo) y contorno NEGRO redondeado bien
-- notable, full-bright, centradas sobre la placa gris con studs del build
local function cartelTienda(parte, texto, colArriba, colAbajo, cara)
	local sg = Instance.new("SurfaceGui")
	sg.Face = cara or Enum.NormalId.Front
	sg.LightInfluence = 0
	-- MÍNIMO estándar: una TextLabel que LLENA la placa con TextScaled. En la placa
	-- ALTA (aspecto ~2.1), "CRATES"/"GEARS" se limitan por el ANCHO → letras grandes.
	local tl = Instance.new("TextLabel")
	tl.AnchorPoint = Vector2.new(0.5, 0.5)
	tl.Position = UDim2.new(0.5, 0, 0.5, 0)
	-- llena la placa: en la placa alta (aspecto 2.5) el texto se limita por el ANCHO
	-- → letras GRANDES que llenan todo el ancho, centradas y FIJAS sobre el cartel.
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = texto
	tl.TextColor3 = Color3.new(1, 1, 1)
	local s = Instance.new("UIStroke")
	s.Thickness = 13                             -- contorno negro NOTABLE
	s.Color = Color3.new(0, 0, 0)
	s.LineJoinMode = Enum.LineJoinMode.Round     -- redondeado
	s.Parent = tl
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(colArriba, colAbajo)
	g.Parent = tl
	tl.Parent = sg
	sg.Parent = parte
end

-- letras GRANDES y FIJAS (no siguen la cámara) — MISMO método que el "$10,000"
-- del cofre: una PARTE dedicada delgada enfrente del cartel + SurfaceGui con
-- CanvasSize del MISMO aspecto que la cara (clave para que no se achique/deforme).
local function cartelPegado(parte, texto, color)
	local cartel = Instance.new("Part")
	cartel.Name = "CartelTexto"
	cartel.Size = Vector3.new(0.4, 3.3, 13)             -- cara Right (+X) = 13×3.3 (aspecto ~3.94)
	cartel.CFrame = CFrame.new(parte.Position + Vector3.new(0.55, -0.3, 0))  -- enfrente del cartel + un pelín abajo
	cartel.Anchored = true
	cartel.CanCollide = false
	cartel.CanQuery = false
	cartel.CastShadow = false
	cartel.Transparency = 1
	cartel.Parent = parte
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Right
	sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(1300, 330)              -- MISMO aspecto que la cara (13:3.3) → grande, sin deformar
	sg.Parent = cartel
	local tl = Instance.new("TextLabel")
	tl.AnchorPoint = Vector2.new(0.5, 0.5)
	tl.Position = UDim2.new(0.5, 0, 0.5, 0)
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = texto
	tl.TextColor3 = color
	estilar(tl, 32)   -- mismo contorno que "MEGA TRAMPOLIN"   -- contorno negro aún más grueso (~50% más que 9)
	tl.Parent = sg
end

-- etiqueta de premio de la rueda física: texto sin fondo sobre placa
-- invisible que GIRA con la rueda (va dentro de RuedaGiratoria)
local function etiquetaRueda(parte, texto)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(340, 140)
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.Text = texto
	tl.TextColor3 = Color3.new(1, 1, 1)
	estilar(tl, 4)
	tl.Parent = sg
	sg.Parent = parte
end

-- texto ESTÁTICO de verdad (SurfaceGui en placa invisible, ambas caras):
-- no gira con la cámara ni cambia de tamaño
-- escala: fracción de la cara que ocupa el texto (1 = toda, como antes).
-- Con TextScaled, achicar la etiqueta achica la letra proporcionalmente.
local function letreroPuerta(parte, texto, color, escala)
	local caras = parte.Size.X &lt; 1
		and {Enum.NormalId.Left, Enum.NormalId.Right}
		or {Enum.NormalId.Front, Enum.NormalId.Back}
	for _, cara in ipairs(caras) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = cara
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 52
		sg.LightInfluence = 0
		local tl = Instance.new("TextLabel")
		local e = escala or 1
		tl.Size = UDim2.new(e, 0, e, 0)
		tl.Position = UDim2.new(0.5, 0, 0.5, 0)   -- centrado al achicarse
		tl.AnchorPoint = Vector2.new(0.5, 0.5)
		tl.BackgroundTransparency = 1
		tl.TextScaled = true
		tl.Text = texto
		tl.TextColor3 = color
		estilar(tl, 4.5)
		tl.Parent = sg
		sg.Parent = parte
	end
end

local AMAR = Color3.fromRGB(255, 220, 60)
local ANIMOS = {
	"DON'T GIVE UP! 💪", "YOU CAN DO IT! 🔥", "KEEP CLIMBING! 🪜",
	"ALMOST THERE! ⬆️", "THE CHEST AWAITS! 💰", "DON'T LOOK DOWN! 👀",
	"YOU'RE DOING GREAT! ⚡", "YOU'RE A LEGEND! 🏆",
}
for _, d in ipairs(Mapa:GetDescendants()) do
	if not d:IsA("BasePart") then continue end
	local n = d.Name
	if n == "SafeZoneSign" then
		letreroPuerta(d, "🛡 SAFE ZONE", AMAR, 0.5)   -- 50% (se veía enorme)
	elseif n == "ClaimPad" then
		cartelClaim(d, Config.CLAIM_PREMIO)
	elseif n == "CofreMeta" then
		-- Cartel "$10,000" ESTÁTICO (no sigue a la cámara) y GRANDE. Para que el
		-- zoom sea SUAVE (sin re-rasterizar el texto cada frame → nada de tirones),
		-- el SurfaceGui usa lienzo FIJO y el cliente escala la PARTE entera: el
		-- texto se estira por GPU. Lienzo ancho → "$10,000" cabe en UNA línea. Se
		-- dibuja en las dos caras (Front/Back) para verse desde cualquier lado.
		local cartel = Instance.new("Part")
		cartel.Name = "CartelCofrePulso"
		cartel.Size = Vector3.new(52, 9, 0.4)
		cartel.CFrame = CFrame.new(d.Position + Vector3.new(0, 12, 0))
		cartel.Anchored = true
		cartel.CanCollide = false
		cartel.CanQuery = false
		cartel.CastShadow = false
		cartel.Transparency = 1
		cartel:SetAttribute("BaseSize", cartel.Size)   -- tamaño base para el pulso
		cartel.Parent = d
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local sg = Instance.new("SurfaceGui")
			sg.Face = face
			sg.LightInfluence = 0                       -- full-bright, como el billboard
			sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize   -- lienzo fijo → escalar la parte NO re-rasteriza
			sg.CanvasSize = Vector2.new(2600, 450)      -- mismo aspecto que la parte (52:9)
			sg.Parent = cartel
			local tl = Instance.new("TextLabel")
			tl.AnchorPoint = Vector2.new(0.5, 0.5)
			tl.Position = UDim2.new(0.5, 0, 0.5, 0)
			tl.Size = UDim2.new(1, 0, 1, 0)
			tl.BackgroundTransparency = 1
			tl.TextScaled = true
			tl.Text = "$10,000"
			tl.TextColor3 = AMAR
			estilar(tl, 12)   -- contorno negro TRIPLE de grueso (antes 4)
			tl.Parent = sg
		end
	elseif n == "VentaCarpet" then
		cartelPrecio(d, "Flying Carpet", Config.GAMEPASSES.carpet.precio)
	elseif n == "VentaInvisible" then
		cartelPrecio(d, "Become Invisible", Config.GAMEPASSES.invisible.precio, true, 2.5, 1.2)   -- AlwaysOnTop (nada se lo come); el CLIENTE lo oculta si algo OPACO lo tapa
	elseif n == "VentaSlapGod" then
		cartelPrecio(d, "God Slap", Config.GAMEPASSES.god.precio)
	elseif n == "VentaCoilSpeed" then
		cartelPrecio(d, "Speed Coil", Config.PRODUCTOS.speedcoil.precio)
	elseif n == "VentaCoilJump" then
		cartelPrecio(d, "Gravity Coil", Config.PRODUCTOS.jumpcoil.precio)
	elseif n == "PuertaMisterio" then
		billboard(d, "❓", Color3.new(1, 1, 1), 4, 4, 4)
	elseif n == "CartelCrates" then
		cartelPegado(d, "CRATES", Color3.fromRGB(255, 95, 205))
	elseif n == "CartelGears" then
		cartelPegado(d, "GEARS", Color3.fromRGB(80, 175, 255))
	elseif n == "VendedorNombre" then
		billboard(d, "Aisha", Color3.new(1, 1, 1), 6, 0, 1.6)
	elseif n == "CartelMorphsZona" then
		-- MISMO estilo que los carteles de las vitrinas (billboard GRANDE que
		-- siempre te mira de frente): FREE blanca + MORPHS arcoíris animado,
		-- fuente gruesa LuckiestGuy con contorno negro
		cartelDosLineas(d, "FREE", "MORPHS", 15, 6.8, 3)   -- un poco más chico
	elseif n == "CartelMegaTrampolin" then
		-- letrero FIJO (no sigue la cámara) sobre la puerta secreta: lienzo fijo
		-- del mismo aspecto que la placa (16:5 → 1600x500), MEGA blanca arriba y
		-- TRAMPOLIN abajo con arcoíris ANIMADO (gradiente "ArcoirisAnim")
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Left
		sg.LightInfluence = 0
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(1600, 500)
		sg.Parent = d
		local l1 = Instance.new("TextLabel")
		l1.Size = UDim2.new(1, 0, 0.46, 0)
		l1.BackgroundTransparency = 1
		l1.Font = Enum.Font.LuckiestGuy
		l1.TextScaled = true
		l1.Text = "MEGA"
		l1.TextColor3 = Color3.new(1, 1, 1)
		estilar(l1, 32)   -- contorno x4 (antes 8)
		l1.Parent = sg
		local l2 = Instance.new("TextLabel")
		l2.Size = UDim2.new(1, 0, 0.5, 0)
		l2.Position = UDim2.new(0, 0, 0.48, 0)
		l2.BackgroundTransparency = 1
		l2.Font = Enum.Font.LuckiestGuy
		l2.TextScaled = true
		l2.Text = "TRAMPOLINE"
		l2.TextColor3 = Color3.new(1, 1, 1)
		estilar(l2, 32)   -- contorno x4 (antes 8)
		local gr = Instance.new("UIGradient")
		gr.Name = "ArcoirisAnim"
		gr.Color = ARCOIRIS_TXT
		gr.Parent = l2
		l2.Parent = sg
	elseif n == "CartelEntrada" then
		-- "ENTRADA" FIJO por FUERA de la puerta secreta — mismo estilo que MEGA
		-- TRAMPOLIN: lienzo fijo (aspecto 12:4), contorno 32 y arcoíris ANIMADO
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Right
		sg.LightInfluence = 0
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(1200, 400)
		sg.Parent = d
		local lE = Instance.new("TextLabel")
		lE.Size = UDim2.new(1, 0, 1, 0)
		lE.BackgroundTransparency = 1
		lE.Font = Enum.Font.LuckiestGuy
		lE.TextScaled = true
		lE.Text = "ENTRANCE"
		lE.TextColor3 = Color3.new(1, 1, 1)
		estilar(lE, 32)
		local grE = Instance.new("UIGradient")
		grE.Name = "ArcoirisAnim"
		grE.Color = ARCOIRIS_TXT
		grE.Parent = lE
		lE.Parent = sg
	elseif n == "CartelComunidad" then
		-- "JOIN THE / COMMUNITY!" fijo sobre la puerta del cuarto VIP (mismo
		-- método del $10,000: lienzo fijo, blanco + arcoíris animado). Pide
		-- UNIRSE (verificable) — NO likes a cambio de premio (política Roblox).
		-- Cara Right (+X): cuarto en la esquina NW con la puerta al ESTE
		-- (de frente al salir de la entrada principal de la torre).
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Right
		sg.LightInfluence = 0
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(1400, 450)
		sg.Parent = d
		local l1 = Instance.new("TextLabel")
		l1.Size = UDim2.new(1, 0, 0.44, 0)
		l1.BackgroundTransparency = 1
		l1.Font = Enum.Font.LuckiestGuy
		l1.TextScaled = true
		l1.Text = "JOIN THE"
		l1.TextColor3 = Color3.new(1, 1, 1)
		estilar(l1, 26)
		l1.Parent = sg
		local l2 = Instance.new("TextLabel")
		l2.Size = UDim2.new(1, 0, 0.52, 0)
		l2.Position = UDim2.new(0, 0, 0.46, 0)
		l2.BackgroundTransparency = 1
		l2.Font = Enum.Font.LuckiestGuy
		l2.TextScaled = true
		l2.Text = "COMMUNITY!"
		l2.TextColor3 = Color3.new(1, 1, 1)
		estilar(l2, 26)
		local grC = Instance.new("UIGradient")
		grC.Name = "ArcoirisAnim"
		grC.Color = ARCOIRIS_TXT
		grC.Parent = l2
		l2.Parent = sg
	elseif n == "CartelSpin" then
		cartelDosLineas(d, "SPIN", "WHEEL", 15, 6.8, 0)   -- mismo diseño que FREE MORPHS: blanca + arcoíris animado, sin letrero
	elseif n:match("^EtiquetaPremio%d+$") then
		local kPremio = tonumber(n:match("%d+"))
		local premioRueda = kPremio and Config.RULETA[kPremio]
		if premioRueda then
			etiquetaRueda(d, premioRueda.etiqueta)
		end
	elseif n == "CartelGrupo" then
		cartelSuperficie(d, "Like 👍 the game and\njoin the group to unlock!",
			Color3.new(1, 1, 1), Color3.fromRGB(70, 120, 255))
	elseif n == "CartelSubir" then
		-- SOLO texto (sin placa de fondo), pegado a la pared este junto a la
		-- escalera; blanco con contorno, cara Left (-X, mira al centro del lobby)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Left
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 52
		sg.LightInfluence = 0
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, 0, 1, 0)
		tl.BackgroundTransparency = 1
		tl.TextScaled = true
		tl.Text = "CLIMB THE TOWER!"
		tl.TextColor3 = Color3.new(1, 1, 1)
		estilar(tl, 4.5)
		tl.Parent = sg
		sg.Parent = d
	elseif n:match("^CheckpointSign_") then
		local nf = tonumber(n:match("%d+"))
		local infoPiso = nf and Config.PISOS[nf]
		if infoPiso then
			letreroPuerta(d, "🏁 FLOOR " .. nf, Color3.new(1, 1, 1))   -- estático (no sigue la cámara), blanco
		end
	elseif n == "VentaSpeedCoil" then
		billboard(d, "Speed Coil 🟢" .. Config.PRODUCTOS.speedcoil.precio,
			Color3.new(1, 1, 1), 11, 3)
	elseif n == "VentaJumpCoil" then
		billboard(d, "Gravity Coil 🟢" .. Config.PRODUCTOS.jumpcoil.precio,
			Color3.new(1, 1, 1), 11, 3)
	elseif n == "RuletaImg_fly" or n == "RuletaImg_slap"
			or n == "RuletaImg_cash" or n == "RuletaImg_speed"
				or n == "RuletaImg_jump" then
		-- pega tu imagen (Config.IMG_*) en las dos caras del panel del gajo
		local id = (n == "RuletaImg_fly" and Config.IMG_CARPET)
			or (n == "RuletaImg_cash" and Config.IMG_CASH)
			or (n == "RuletaImg_speed" and Config.IMG_COIL)
			or (n == "RuletaImg_jump" and Config.IMG_JUMPCOIL)
			or Config.IMG_GIANT
		if id and not id:match("//0$") then
			for _, cara in ipairs({Enum.NormalId.Back, Enum.NormalId.Front}) do
				local dec = Instance.new("Decal")
				dec.Face = cara
				dec.Texture = id
				dec.Parent = d
			end
		end
	elseif n == "PremioCristal" then
		cartelClaim(d, 750)
	elseif n == "CartelCristal" then
		billboard(d, "GLASS BRIDGE 💎", Color3.fromRGB(150, 230, 255), 16, 1)
	elseif n == "CartelMonedas" then
		billboard(d, "COIN ROUTE 🪙", AMAR, 14, 1)
	elseif n == "CartelSaltos" then
		billboard(d, "JUMP ZONE 🦘", Color3.fromRGB(140, 255, 140), 14, 1)
	elseif n == "CartelCuerda" then
		billboard(d, "COLOR OBBY 🌈", Color3.fromRGB(255, 150, 210), 18, 1)
	elseif n:match("^CartelAnimo") then
		local k = tonumber(n:match("%d+")) or 1
		billboard(d, ANIMOS[(k - 1) % #ANIMOS + 1],
			Color3.fromRGB(130, 255, 170), 15, 0)
	end
end

-- (sin nombre flotante en los gusanos: lo quitó el usuario)

-- ─── PUERTA MATEMÁTICA: cada minuto una operación nueva en el cartel; se
-- teclea el resultado en el teclado de la pared y, si es correcto, la puerta
-- se abre (fantasma verde) 7 segundos. El "?" rojo vive en la puerta. ───
do
	local puerta = Mapa:FindFirstChild("PuertaMate", true)
	local cartel = Mapa:FindFirstChild("PuertaMateCartel", true)
	local pantalla = Mapa:FindFirstChild("TecladoPantalla", true)
	if puerta and cartel and pantalla then
		local function textoCara(pieza, grosor, color)
			local sg = Instance.new("SurfaceGui")
			sg.Face = Enum.NormalId.Back          -- mira al interior del lobby (+Z)
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 60
			sg.LightInfluence = 0
			local tl = Instance.new("TextLabel")
			tl.Size = UDim2.new(1, 0, 1, 0)
			tl.BackgroundTransparency = 1
			tl.TextScaled = true
			tl.Text = ""
			tl.TextColor3 = color
			estilar(tl, grosor)
			tl.Parent = sg
			sg.Parent = pieza
			return tl
		end
		local lblOp = textoCara(cartel, 4, Color3.new(1, 1, 1))
		local lblPant = textoCara(pantalla, 1.2, Color3.fromRGB(30, 34, 44))
		local lblQ = textoCara(puerta, 7, Color3.fromRGB(235, 45, 45))
		lblQ.Text = "?"
		-- "?" centrado DENTRO del marco (con margen, no pegado a los bordes)
		lblQ.Size = UDim2.new(0.72, 0, 0.78, 0)
		lblQ.AnchorPoint = Vector2.new(0.5, 0.5)
		lblQ.Position = UDim2.new(0.5, 0, 0.52, 0)
		local op, resp, entrada = "", 0, ""
		local fin, abiertaHasta = 0, 0
		local colPuerta = puerta.Color
		-- desvanecer/aparecer SUAVE (tween de 0.7 s): muro + "?" + contorno
		local TS = game:GetService("TweenService")
		local function fundirPuerta(visible)
			local ti = TweenInfo.new(0.7, Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out)
			local meta = visible and 0 or 1
			TS:Create(puerta, ti, {Transparency = meta}):Play()
			TS:Create(lblQ, ti, {TextTransparency = meta}):Play()
			local s = lblQ:FindFirstChildOfClass("UIStroke")
			if s then TS:Create(s, ti, {Transparency = meta}):Play() end
		end
		local function nuevaOp()
			local t = math.random(3)
			local a, b
			if t == 1 then
				a, b = math.random(2, 9), math.random(2, 9)
				op, resp = a .. "*" .. b, a * b
			elseif t == 2 then
				a, b = math.random(11, 59), math.random(11, 39)
				op, resp = a .. "+" .. b, a + b
			else
				a = math.random(20, 90)
				b = math.random(2, 19)
				op, resp = a .. "-" .. b, a - b
			end
			entrada = ""
			fin = os.clock() + 60
		end
		local function pinta()
			lblOp.Text = op .. " (" .. math.max(0, math.ceil(fin - os.clock())) .. ")"
			lblPant.Text = entrada
		end
		nuevaOp()
		task.spawn(function()
			while true do
				if os.clock() &gt;= fin then nuevaOp() end
				if abiertaHasta &gt; 0 and os.clock() &gt;= abiertaHasta then
					abiertaHasta = 0
					puerta.CanCollide = true
					puerta.Color = colPuerta
					fundirPuerta(true)          -- reaparece desvaneciéndose
				end
				pinta()
				task.wait(0.5)
			end
		end)
		for _, d in ipairs(Mapa:GetDescendants()) do
			local tecla = d.Name:match("^TecladoBtn_(%w+)$")
			if tecla and d:IsA("BasePart") then
				local lb = textoCara(d, 1.6, Color3.new(1, 1, 1))
				lb.Text = (tecla == "OK" and "✓") or tecla
				local cd = Instance.new("ClickDetector")
				cd.MaxActivationDistance = 18
				cd.Parent = d
				cd.MouseClick:Connect(function()
					if tecla == "X" then
						entrada = ""
					elseif tecla == "OK" then
						if entrada ~= "" and tonumber(entrada) == resp then
							abiertaHasta = os.clock() + 7   -- ¡correcto! puerta abierta 7 s
							puerta.CanCollide = false
							fundirPuerta(false)             -- se DESVANECE suave
							RE.FX:FireAllClients("confeti", puerta.Position)
							-- sonido de ACIERTO para todos los cercanos (~6 pisos)
							RE.FX:FireAllClients("aciertoPuerta", puerta.Position)
							nuevaOp()                        -- y reto nuevo de una vez
						else
							entrada = ""                     -- incorrecto: se borra
						-- sonido de error para todos los cercanos (~6 pisos)
						RE.FX:FireAllClients("errorPuerta", puerta.Position)
						end
					elseif #entrada &lt; 4 then
						entrada = entrada .. tecla
					end
					pinta()
				end)
			end
		end
	end
end

-- ─── JUGADORES ─────────────────────────────────────────────
local function contarAmigos(plr)
	local n = 0
	for _, otro in ipairs(Players:GetPlayers()) do
		if otro ~= plr then
			local ok, son = pcall(function() return plr:IsFriendsWith(otro.UserId) end)
			if ok and son then n = n + 1 end
		end
	end
	return n
end

local function refrescarAmigos()
	for _, plr in ipairs(Players:GetPlayers()) do
		if rt[plr] then
			rt[plr].boostAmigos = contarAmigos(plr)
			marcar(plr)
		end
	end
end

local function cframeRespawn(f)
	-- al reaparecer tras morir: DENTRO de la zona segura este (a un lado del botón),
	-- NO sobre el botón → los gusanos no te matan al instante al reaparecer
	if f &lt;= 0 or f &gt; NP then return cframeEntrada(f) end
	local HALFC = Config.TAM_INTERIOR / 2
	local pos = Vector3.new(HALFC + 6, Config.yLosa(f) + 3, EZBC)   -- adentro de la alcoba
	return CFrame.new(pos, Vector3.new(ESQC, pos.Y, EZBC))          -- mirando al botón/salida
end

-- ⬆️ BOTÓN "BACK TO FLOOR" (2026-07-24): el cliente lo enseña 13 s cuando te
-- caes por debajo de tu checkpoint (te empujaron, te tiró un gusano, lo que
-- sea). Aquí se hace el regreso REAL. Te deja en el MISMO sitio que la muerte,
-- así que no te salta nada que no hubieras ganado ya: es para que un niño al
-- que tiran del piso 15 no sienta que perdió todo y cierre el juego.
RE.Volver.OnServerEvent:Connect(function(plr)
	if not limitar(plr, "volver", 2) then return end
	local r = rt[plr]
	if not r or (r.checkpointPiso or 0) &lt; 1 then return end   -- sin checkpoint no hay a dónde
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health &lt;= 0 then return end
	-- el SERVER revalida que de verdad esté DEBAJO de su checkpoint: si no, un
	-- cliente trucado lo usaría como teletransporte gratis desde donde quisiera
	if Config.pisoDe(root.Position.Y) &gt;= r.checkpointPiso then return end
	-- ⚠️ MISMO anti-exploit que morir (hum.Died): regresar arriba INVALIDA el
	-- descenso. Si no, se podría bajar a la base, apretar el botón y reabrir el
	-- cofre sin haber RE-SUBIDO, que es justo lo que cierra r.bajoALaBase.
	r.bajoALaBase = false
	r.spawnT = os.clock()   -- que no cuente como "acaba de bajar" al re-armado
	char:PivotTo(cframeRespawn(r.checkpointPiso))
	root.AssemblyLinearVelocity = Vector3.zero   -- corta la caída (el cliente también la corta)
end)

local function alSpawnear(plr, char)
	local r = rt[plr]
	if not r then return end
	r.spawnT = os.clock()   -- marca el respawn: el cofre no se re-arma en el instante
	                        -- en que reapareces en la base antes del teleport al checkpoint
	local hum = char:WaitForChild("Humanoid", 5)
	local root = char:WaitForChild("HumanoidRootPart", 5)
	if not hum or not root then return end
	task.wait(0.1)
	if not r.yaEntro then
		-- PRIMER spawn = ENTRAR al juego → uno de los 3 spawns de ADENTRO (Z=-18),
		-- mirando enfrente. La MUERTE no se toca: sigue usando el checkpoint.
		r.yaEntro = true
		char:PivotTo(CFrame.new(({-11, 0, 11})[math.random(3)], 5, -18)
			* CFrame.Angles(0, math.pi, 0))
	else
		char:PivotTo(cframeRespawn(r.checkpointPiso))
	end
	r.correr = false            -- el sprint no sobrevive al respawn
	r.stamina = Config.CORRER_MAX
	r.staminaT = os.clock()
	aplicarStats(plr)
	refrescarGear(plr)
	if r.invisible then ponerInvisible(char, true) end
	darBate(plr)   -- 🏏 si ya lo reclamó, vuelve a su mochila tras morir/reaparecer
	-- la skin sobrevive al respawn Y a cerrar el juego (viene del perfil).
	-- ⚠️ Se revalida: si la llevaba puesta y perdió el requisito —salirse de la
	-- comunidad es el caso real— deja de aparecer en vez de quedarse pegada.
	if r.skin then
		local s = Config.SKIN_POR_ID[r.skin]
		if s and skinDesbloqueada(plr, s) then
			ponerSkin(char, r.skin)
		else
			r.skin, perfiles[plr].skin = nil, false
			marcar(plr)
		end
	end
	aplicarAuraDona(plr, char)   -- brillitos de donador (persisten de por vida)
	if r.godUntil == math.huge then -- inmunidad admin persiste al respawnear
		local ff = Instance.new("ForceField")
		ff.Parent = char
	elseif r.godUntil &gt; os.clock() then
		-- 🛡 morir NO te quita el God Mode que pagaste: al reaparecer se le
		-- devuelve la burbuja por los segundos QUE LE QUEDABAN (antes el
		-- ForceField moría con el personaje y parecía que se había perdido).
		forcefield(char, r.godUntil - os.clock())
	end
	-- 🛡 el grupo de colisión NO sobrevive al respawn (el personaje es nuevo):
	-- se vuelve a poner aquí según le quede o no God Mode.
	grupoChar(char, r.godUntil &gt; os.clock() and GRUPO_DIOS or GRUPO_JUG)
	-- (el prompt "Push" con la E se ELIMINÓ 2026-07-19: el empujón gratis
	-- competía con las slaps de pago; ahora solo se empuja con las manitas)
	hum.Died:Connect(function()
		quitarMarca(char)
		RE.Detectado:FireClient(plr, false, "")
		-- morir INVALIDA el descenso: subir muriéndote (respawn en el checkpoint alto)
		-- NO cuenta. Para reabrir el cofre hay que bajar a la base y RE-SUBIR VIVO.
		r.bajoALaBase = false
	end)
end

Players.PlayerAdded:Connect(function(plr)
	revisarPolitica(plr)
	perfiles[plr] = cargarPerfil(plr)
	-- ⚠️ cargarPerfil CEDE: entre reintentos espera, y con el backoff eso puede
	-- llegar a ~15 s. Si el jugador se va durante esa espera, PlayerRemoving YA
	-- corrió y limpió sus tablas — y luego esta función sigue desde aquí y las
	-- vuelve a crear para alguien que ya no existe: perfiles[plr] y rt[plr] se
	-- quedan colgando para siempre. Además `ls.Parent = plr` de más abajo lanza
	-- sobre un Player destruido.
	if not plr.Parent then perfiles[plr] = nil return end
	rt[plr] = {
		pases = {}, equip = {carpet = false, speed = false, jump = false},
		boostAmigos = 0, invisible = false, checkpointPiso = 0,
		yaEntro = false,   -- false hasta el primer spawn (entrar) → 3 spawns de adentro
		speedUntil = 0, jumpUntil = 0, flyUntil = 0, slapUntil = 0, godUntil = 0,
		ultimoSlap = 0, ultimoPush = 0, ultimoGiro = 0,
		velAdmin = 1, saltoAdmin = false,
		correr = false, stamina = Config.CORRER_MAX, staminaT = os.clock(),
		pisosActivados = {},   -- pisos ya notificados/pagados ESTA sesión
		reinicioT = 0,         -- os.clock() del último reinicio en el pad "Return to obby"
		cofreArmado = true,    -- cofre de la cima reclamable
		bajoALaBase = false,   -- etapa 1 del re-armado: ya bajó a la base (falta re-subir vivo)
		funnel = {},           -- pasos del embudo ya reportados
		-- la manzana con la que se fue la última vez; alSpawnear la revalida y
		-- la vuelve a poner en cuanto aparece el personaje
		skin = perfiles[plr] and perfiles[plr].skin or nil,
		-- 🖼 el cuadro se recupera del perfil (si CUADRO_PERSISTE). El CharacterAdded
		-- de más abajo llama a darCuadro en cada spawn, así que con esto puesto ya
		-- le aparece el slot en la hotbar al entrar, sin volver a subir a por él.
		cuadro = (Config.CUADRO_PERSISTE and perfiles[plr]
			and perfiles[plr].cuadro) and true or false,
	}
	funnel(plr, 1)             -- 📊 paso 1: entró al juego
	-- FREE SLAP: temporizador AUTORITATIVO del server en tiempo ABSOLUTO
	-- (GetServerTimeNow es el mismo reloj en server y clientes). Antes cada
	-- lado contaba con su propio os.clock() → el botón se encendía en el
	-- cliente ANTES de que el server lo aceptara y el reclamo se perdía.
	plr:SetAttribute("FreeSlapEn",
		workspace:GetServerTimeNow() + (Config.FREESLAP_CD or 300))
	-- si ya la reclamó en una sesión anterior (o la compró con cash), el botón
	-- sale directamente como "¡ACTIVA!" y no vuelve a arrancar la cuenta atrás
	local pfSlap = perfiles[plr]
	-- ⚠️ 2026-07-25: comprueba gears.BAT, no gears.giant. El regalo del botón
	-- redondo cambió de la manita GIANT al BATE; con la comprobación vieja,
	-- CUALQUIERA que ya tuviera la GIANT (comprada o del regalo antiguo)
	-- quedaba marcado como "ya reclamado" y NUNCA habría recibido el bate.
	plr:SetAttribute("SlapGratis",
		(pfSlap and pfSlap.gears and pfSlap.gears.bat) and true or false)
	-- 💎 PREMIUM: regalo de bienvenida — al unirse un usuario Premium se le
	-- otorga la RAINBOW SLAP (pase god, toda la sesión) y el cliente abre la
	-- caja-regalo animada ("premiumCaja")
	-- SOLO Premium real (modo prueba de Studio RETIRADO 2026-07-18 para
	-- publicar: en el juego publicado MembershipType sí es confiable)
	if plr.MembershipType == Enum.MembershipType.Premium then
		task.delay(4, function()
			if not plr.Parent or not rt[plr] then return end
			otorgarPase(plr, "god")
			RE.FX:FireClient(plr, "premiumCaja")
		end)
	end
	-- banana: si ya la desbloqueó, re-entregarla en cada respawn
	plr.CharacterAdded:Connect(function()
		-- 🖼 al morir/reaparecer el Tool se desequipa solo, pero el cuadro que
		-- había plantado se queda huérfano en el mundo: hay que barrerlo
		quitarCuadro(plr)
		task.delay(0.5, function()
			if plr.Parent then
				darBanana(plr)
				darToyGun(plr)
				darCuadro(plr)
			end
		end)
	end)
	-- comunidad: sella el atributo (la puerta VIP la abre el cliente al verlo)
	plr:SetAttribute("EnComunidad", false)
	task.spawn(function()
		plr:SetAttribute("EnComunidad", enComunidadFresco(plr))
	end)
	-- leaderstats
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local c = Instance.new("IntValue")
	c.Name = "Cash"
	c.Value = perfiles[plr].cash
	c.Parent = ls
	local t = Instance.new("IntValue")
	t.Name = "Trophies"
	t.Value = perfiles[plr].trofeos
	t.Parent = ls
	ls.Parent = plr

	plr.CharacterAdded:Connect(function(char) alSpawnear(plr, char) end)
	if plr.Character then alSpawnear(plr, plr.Character) end

	task.spawn(cargarPases, plr)
	task.spawn(refrescarAmigos)
	-- (toast de bienvenida QUITADO 2026-07-19: el usuario no lo quiere)
	marcar(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
	quitarCuadro(plr)   -- 🖼 si se va con el cuadro puesto, no dejarlo en el mundo
	-- soltar objetivos de gusanos que lo cazaban
	for _, g in ipairs(gusanos) do
		if g.objetivo == plr then
			g.objetivo = nil
			g.estado = "patrulla"
		end
	end
	guardarPerfil(plr, true)   -- FORZADO: al salir sí o sí se guarda
	perfiles[plr] = nil
	rt[plr] = nil
	sucios[plr] = nil
	pendGuardar[plr] = nil
	ultGuardado[plr] = nil
	tpPend[plr] = nil     -- (2026-07-26) faltaba en esta lista: ver finObby
	-- 🧹 FUGA LENTA (2026-07-25): cooldowns y cubos se llenaban de claves
	-- "uid|algo" que NUNCA se borraban. Como las monedas no reaparecen
	-- (MONEDA_RESPAWN enorme), cada jugador dejaba ~61 claves eternas + las de
	-- pads, morphs y compras. En un server de muchas horas con el churn de los
	-- anuncios eso son decenas de miles de entradas muertas. Al salir se borran
	-- las SUYAS. Esto NO cambia nada del juego: el que se fue ya no las usa, y
	-- si vuelve a entrar sus monedas se reinician igual que siempre.
	local pref = plr.UserId .. "|"
	local n = #pref
	for k in pairs(cooldowns) do
		if k:sub(1, n) == pref then cooldowns[k] = nil end
	end
	for k in pairs(cubos) do
		if k:sub(1, n) == pref then cubos[k] = nil end
	end
	task.spawn(refrescarAmigos)
end)

game:BindToClose(function()
	-- ⚠️ ESTO IBA EN SERIE Y NO CABÍA EN EL TIEMPO (arreglado el 1 ago 2026, tras
	-- ver "Script has run for over 30.120 seconds" en el reporte de producción).
	--
	-- Roblox da **30 segundos exactos** a BindToClose y luego apaga pase lo que
	-- pase. guardarPerfil reintenta 3 veces con esperas de 2 s y 4 s (:195-238),
	-- así que bastan 4-5 jugadores cuyo DataStore falle para que la SUMA se pase
	-- de 30 s: los ÚLTIMOS de la lista se apagaban SIN GUARDAR. Con 70 jugadores
	-- dentro, eso es pérdida de progreso en masa en cada reinicio de servidor.
	--
	-- En paralelo, el total deja de ser la suma y pasa a ser el guardado MÁS LENTO.
	--
	-- ⚠️ EL task.wait DEL BUCLE DE ESPERA NO ES OPCIONAL: ceder es exactamente lo
	-- que hace que Roblox espere en vez de apagar. Un bucle ocupado no sirve.
	local pendientes = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		pendientes = pendientes + 1
		task.spawn(function()
			pcall(guardarPerfil, plr, true)   -- FORZADO: el server se apaga
			pendientes = pendientes - 1
		end)
	end
	-- tope de 25 s: deja margen dentro de los 30 y evita que un guardado colgado
	-- mantenga el servidor esperando hasta que Roblox lo mate de todos modos
	local t0 = os.clock()
	while pendientes &gt; 0 and os.clock() - t0 &lt; 25 do
		task.wait(0.1)
	end
	if pendientes &gt; 0 then
		warn("[RainbowApple] apagado: " .. pendientes .. " guardados sin terminar a los 25 s")
	end
end)

-- autosave + caída al vacío + expiración de temporales
task.spawn(function()
	while true do
		task.wait(Config.AUTOSAVE_SEG)
		-- 2026-08-04: ESPACIADO. Antes esto lanzaba un UpdateAsync por CADA
		-- jugador en el mismo instante: con 40 personas, 40 escrituras de golpe
		-- cada 2 minutos. Es lo que llenaba la cola de DataStore ("request was
		-- added to queue" pasó de 23 a 311 entre el 31 jul y el 3 ago, al
		-- multiplicarse el DAU) y lo que hacía fallar el primer intento de
		-- guardado con 502. Mismo parche que ya llevaba la tabla de tiempo.
		-- 0.5 s reparte 40 guardados en 20 s dentro de un ciclo de 120: sobra
		-- margen, y harían falta 240 jugadores para que dos vueltas se solapen.
		-- ⚠️ NO tocar el BindToClose: ahí el paralelo es correcto y deliberado,
		-- porque Roblox da 30 s exactos al apagar y no hay tiempo de espaciar.
		for _, plr in ipairs(Players:GetPlayers()) do
			task.spawn(guardarPerfil, plr)
			task.wait(0.5)
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.7)
		local ahora = os.clock()
		for _, plr in ipairs(Players:GetPlayers()) do
			local r = rt[plr]
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if root and root.Position.Y &lt; Config.Y_MUERTE then
				plr.Character:PivotTo(cframeEntrada(0))
			end
			-- expiran boosts temporales equipados
			if r then
				actualizarStamina(plr)   -- corta el sprint a los 7 s (anti-hack)
				if r.equip.speed and not perfiles[plr].coils.speed
					and r.speedUntil &gt; 0 and r.speedUntil &lt; ahora then
					r.equip.speed = false
					r.speedUntil = 0
					refrescarGear(plr)
					marcar(plr)
				end
				if r.equip.jump and not perfiles[plr].coils.jump
					and r.jumpUntil &gt; 0 and r.jumpUntil &lt; ahora then
					r.equip.jump = false
					r.jumpUntil = 0
					refrescarGear(plr)
					marcar(plr)
				end
				if r.equip.carpet and not r.pases.carpet
					and r.flyUntil &gt; 0 and r.flyUntil &lt; ahora then
					r.equip.carpet = false
					r.flyUntil = 0
					refrescarGear(plr)
					marcar(plr)
				end
				-- 🛡 GOD MODE caducado (2026-08-05): vuelve al grupo normal (ya se
				-- le puede empujar) y, si volaba SOLO gracias a él, se baja.
				-- ⚠️ math.huge = inmunidad de admin, esa NO caduca nunca.
				if r.godUntil &gt; 0 and r.godUntil ~= math.huge and r.godUntil &lt; ahora then
					r.godUntil = 0
					grupoChar(plr.Character, GRUPO_JUG)
					if r.equip.carpet and not (r.pases.carpet or r.flyUntil &gt; ahora) then
						r.equip.carpet = false
					end
					refrescarGear(plr)
					marcar(plr)
				end
			end
		end
	end
end)

-- (el giro fluido de la rueda física lo hace cada cliente a 60fps con
--  RenderStepped; el acelerón al girar llega vía RE.FX "ruleta")

-- ─── MANIQUÍES DE MORPH = NOOB REAL: clona el modelo "Noob" (baked de la
-- toolbox, sin scripts) sobre cada pad de morph. Cabeza del noob INVISIBLE (la
-- manzana la pone el build a la altura del cuello), anclado, sin colisión,
-- mirando al frente de su estación y con los pies exactos sobre el pad. ───
task.spawn(function()
	local plantilla
	for _, m in ipairs(workspace:GetDescendants()) do
		if m:IsA("Model") and m.Name == "Noob"
				and m:FindFirstChildOfClass("Humanoid") then
			plantilla = m
			break
		end
	end
	if not plantilla then return end
	plantilla.Archivable = true
	for _, pad in ipairs(workspace:GetDescendants()) do
		if pad:IsA("BasePart")
				and (pad.Name == "MorphPad" or pad.Name == "MorphPadRosa"
					or pad.Name == "MorphPadVerde"
					or pad.Name == "ManiquiPadAzul") then   -- azotea
			local clon = plantilla:Clone()
			clon.Name = "ManiquiNoob"
			for _, d in ipairs(clon:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
				end
			end
			local head = clon:FindFirstChild("Head", true)
			if head then
				head.Transparency = 1          -- la manzana del build es la cabeza
				for _, dd in ipairs(head:GetDescendants()) do
					if dd:IsA("Decal") then dd.Transparency = 1 end
				end
			end
			pcall(function() clon:ScaleTo(1.6) end)   -- tamaño de las estaciones
			-- estaciones del brazo oeste (z&lt;30) miran +X; las del norte, -Z.
			-- El pad VERDE (casita VIP, z=73) es la excepción: SIEMPRE mira a
			-- la puerta de la casita (+X), como su cabeza de manzana.
			local mira
			if pad.Name == "MorphPadVerde" then
				mira = Vector3.new(1, 0, 0)
			elseif pad.Name == "ManiquiPadAzul" then
				-- azotea: de cara al que llega del centro (el cofre está detrás)
				mira = Vector3.new(0, 0, -1)
			else
				mira = (pad.Position.Z &gt; 30) and Vector3.new(0, 0, -1)
					or Vector3.new(1, 0, 0)
			end
			clon:PivotTo(CFrame.lookAt(Vector3.zero, mira))
			local bcf, size = clon:GetBoundingBox()
			local top = pad.Position.Y + pad.Size.Y / 2
			clon:PivotTo(clon:GetPivot()
				+ (Vector3.new(pad.Position.X, top + size.Y / 2, pad.Position.Z)
					- bcf.Position))
			clon.Parent = pad.Parent
		end
	end
end)

-- ═══ SPAWNS INVISIBLES POR ZONA (2026-07-17): si caes al VACÍO en los obbys
-- exteriores, REAPARECES al borde de la base del lado donde estabas (este/
-- trampolín estrella, norte/obbys del frente, oeste/monedas, sur/desafío) en
-- vez de morir y volver al lobby. Sin muerte ni pantalla de respawn: se detecta
-- la caída (y &lt; -30, solo pasa en el vacío exterior) y se teletransporta al
-- punto invisible de esa zona, listo para reintegrarse al obby. ═══
local ZONA_VACIO = {
	este = Vector3.new(70, 5, 0),       -- área blanca, frente a la estrella
	oeste = Vector3.new(-70, 5, 0),     -- borde oeste (obby de monedas)
	norte = Vector3.new(0, 5, 64),      -- borde norte / FRENTE: caer aquí → (0,64), unos studs atrás de la tabla (antes 76, pegado)
	sur = Vector3.new(0, 5, -76),       -- borde sur (desafío)
}
task.spawn(function()
	while true do
		task.wait(0.25)
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health &gt; 0 and root.Position.Y &lt; -30 then
				local px, pz = root.Position.X, root.Position.Z
				local destino
				if math.abs(px) &gt;= math.abs(pz) then
					destino = px &gt; 0 and ZONA_VACIO.este or ZONA_VACIO.oeste
				else
					destino = pz &gt; 0 and ZONA_VACIO.norte or ZONA_VACIO.sur
				end
				root.AssemblyLinearVelocity = Vector3.zero
				char:PivotTo(CFrame.new(destino, destino + Vector3.new(
					destino.X == 0 and 0 or (destino.X &gt; 0 and 1 or -1), 0,
					destino.X == 0 and (destino.Z &gt; 0 and 1 or -1) or 0)))
			end
		end
	end
end)

-- 🔎 SELLO DE VERSIÓN: dice en la consola (F9) si este server corre el código
-- con las IDs de compra conectadas. Sirve para confirmar que la publicación
-- sí llegó (los servers viejos siguen con el código anterior hasta reiniciar).
do
	local faltan = {}
	for clave, info in pairs(Config.GAMEPASSES) do
		if (info.id or 0) &lt;= 0 then table.insert(faltan, "pase:" .. clave) end
	end
	for clave, info in pairs(Config.PRODUCTOS) do
		if (info.id or 0) &lt;= 0 then table.insert(faltan, "producto:" .. clave) end
	end
	if #faltan == 0 then
		print("[RainbowApple] BUILD 2026-07-18b — IDs de compra: TODAS OK ✅")
	else
		print("[RainbowApple] BUILD 2026-07-18b — SIN ID (" .. #faltan .. "): "
			.. table.concat(faltan, ", "))
	end
end
print("[RainbowApple] Servidor listo ✅")
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX6300"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX6301"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX6302"><Properties><string name="Name">MainClient</string><ProtectedString name="Source">-- ═══════════════════════════════════════════════════════════════════════
-- StarterPlayerScripts/MainClient  (LocalScript)
-- Rainbow Apple Tower — TODA la interfaz (réplica del juego de referencia):
-- barra de progreso con avatares, Kill All/God Mode/Skip, guantes, hotbar,
-- ruleta, jumpscare, "Worm Sees You!", vuelo de alfombra, boosts.
-- ═══════════════════════════════════════════════════════════════════════
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local SocialService = game:GetService("SocialService")
local LocalizationService = game:GetService("LocalizationService")
local GuiService = game:GetService("GuiService")

local plr = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Config"))
-- imagen personalizada de la alfombra (Config.IMG_CARPET); "//0" = sin imagen
local IMG_CARPET = Config.IMG_CARPET or "rbxassetid://0"
local function hayImgCarpet()
	return IMG_CARPET ~= "" and not IMG_CARPET:match("//0$")
end
local Remotos = ReplicatedStorage:WaitForChild("Remotos")
-- carga perezosa: espera cada remoto la primera vez que se usa
local RE = setmetatable({}, {__index = function(t, k)
	local r = Remotos:WaitForChild(k)
	rawset(t, k, r)
	return r
end})

local ROBUX = utf8.char(0xE002)
-- JUEGO FORZADO A INGLÉS (barrido 2026-07-23): esto vuelve inglés toda la tabla
-- Config.TEXTOS y los ~35 textos bilingües inline de golpe. Para volver a
-- bilingüe (según idioma del jugador), restaurar:
--   local esES = (LocalizationService.RobloxLocaleId or "en"):sub(1, 2) == "es"
local esES = false
local T = esES and Config.TEXTOS.ES or Config.TEXTOS.EN
local function txt(clave, args)
	local plantilla = T[clave] or clave
	if args and #args &gt; 0 then
		local ok, res = pcall(string.format, plantilla, table.unpack(args))
		return ok and res or plantilla
	end
	return plantilla
end

pcall(function()
	-- mochila nativa OCULTA: usamos una hotbar propia con cuadros GRANDES que
	-- equipa los MISMOS Tools (los slots nativos no se pueden agrandar)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

-- estado sincronizado desde el server
local S = {
	cash = 0, trofeos = 0, pisoMax = 0, coils = {speed = false, jump = false},
	spinsExtra = 0, spinGratis = true, boostAmigos = 0, pases = {},
	equip = {carpet = false, speed = false, jump = false},
	speedLeft = 0, flyLeft = 0, slapLeft = 0, godLeft = 0, checkpoint = 0,
	calDia = 1, calListo = true, calVisto7 = false,   -- calendario: día a reclamar, si hoy hay premio, y si ya completó los 7
}

-- ═══════════════ helpers de UI ═════════════════════════════
local gui = Instance.new("ScreenGui")
gui.Name = "RainbowAppleHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets   -- usa TODO el ancho (solo respeta notch/isla)
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
-- 🌐 SIN TRADUCCIÓN AUTOMÁTICA (2026-07-25): Roblox traduce solo los textos
-- de la interfaz al idioma del jugador, y con nuestras fuentes y botones de
-- ancho fijo el español salía cortado/desbordado ("horrible"). AutoLocalize
-- = false se HEREDA a todos los hijos, así que apagarlo aquí cubre TODO el
-- HUD. Nuestro propio sistema bilingüe (esES + Config.TEXTOS) no se ve
-- afectado: ese lo controlamos nosotros y está redactado a mano.
gui.AutoLocalize = false
gui.Parent = plr:WaitForChild("PlayerGui")

-- ═══ ESCALA RESPONSIVA (celular/tablet/pantallas chicas): los paneles miden
-- hasta 580x600 px y en un teléfono (~390 pt de alto) no caben → un UIScale en
-- la RAÍZ encoge TODA la UI proporcionalmente según el viewport (el truco
-- clásico de canvas virtual; las posiciones en Scale no cambian). En PC/consola
-- (viewport grande) queda en 1 = idéntico a hoy. ═══
-- 🎮 CONSOLA (Xbox/PS): experiencia "ten-foot" — el jugador está LEJOS de la TV
-- y a 1920x1080 la UI se ve chiquita → TODO un 45% más grande (botones,
-- ventanas, HUD). IsTenFootInterface es la detección oficial.
-- ⚠️ VA AQUÍ FUERA, NO DENTRO DEL do...end (corregido 2026-07-29). Estaba
-- declarada como local ADENTRO, así que la columna izquierda de pases —que la
-- consulta bastante más abajo— leía un GLOBAL sin definir, o sea nil: su
-- `esConsola and 0.75 or 1` daba SIEMPRE 1 y el achique del 25% en consola no se
-- aplicó nunca desde que se escribió.
--
-- ⚠️ Y es GLOBAL (sin `local`) a propósito: este chunk está JUSTO en el tope de
-- Lua de 200 variables locales simultáneas, y declararla local revienta la
-- compilación con "too many local variables". Si hace falta añadir más estado
-- suelto aquí arriba, o va global o se mete en un do...end (como SkinsUI).
esConsola = GuiService:IsTenFootInterface()
do
	local escGui = Instance.new("UIScale")
	escGui.Parent = gui
	local function ajustarEscala()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local v = cam.ViewportSize
		-- lienzo de DISEÑO ~700 de alto / 1000 de ancho. SIN tope en 1: en
		-- monitores HD/1080p+ la UI CRECE proporcional (a 1080p ≈ 1.5x) en vez
		-- de quedarse chiquita (2026-07-17). Pantallas chicas siguen encogiendo.
		local s
		if math.min(v.X, v.Y) &lt; 500 then
			-- 📱 CELULAR: lienzo más compacto (640) → UI ~10% más grande que
			-- antes (los paneles de 600 siguen cabiendo con margen)
			s = math.max(0.55, math.min(v.Y / 640, v.X / 950))
		else
			s = math.max(0.5, math.min(v.Y / 700, v.X / 1000))
			s = math.min(s, 1.6)        -- tope: en 1440p/4K no se pasa de rosca
			if esConsola then
				-- consola: plus por jugar LEJOS de la TV (ten-foot)
				s = math.min(s * 1.15, 1.85)
			end
		end
		escGui.Scale = s
	end
	ajustarEscala()
	task.spawn(function()
		local cam = workspace.CurrentCamera
		while not cam do task.wait(0.2) cam = workspace.CurrentCamera end
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(ajustarEscala)
		ajustarEscala()
	end)
end

local animarBoton  -- se define abajo; se aplica solo a botones
-- SOLO los botones de la interfaz INICIAL (HUD) suenan. Este flag está en true
-- mientras se construye el HUD (arriba); al final se pone false, así los botones
-- creados DESPUÉS (paneles: admin, tiendas, ruleta, cofre...) nacen muteados.
local sonidoHUD = true

-- LuckiestGuy dibuja las letras ALTAS dentro de su caja (la fuente reserva
-- espacio de descendentes abajo) → los textos de los botones se veían subidos.
-- Este padding desplaza el texto ~9% hacia ABAJO sin encogerlo (top+ / bottom−)
-- = queda bien CENTRADO en el botón.
local function centrarTexto(o)
	if o:FindFirstChild("CentradoLucky") then return end
	local pad = Instance.new("UIPadding")
	pad.Name = "CentradoLucky"
	pad.PaddingTop = UDim.new(0.09, 0)
	pad.PaddingBottom = UDim.new(-0.09, 0)
	pad.Parent = o
end

local function nuevo(clase, props, padre)
	local o = Instance.new(clase)
	for k, v in pairs(props) do o[k] = v end
	if (clase == "TextButton" or clase == "TextLabel")
			and o.Font == Enum.Font.LuckiestGuy then
		centrarTexto(o)          -- corrige el texto "subido" de LuckiestGuy
	end
	if padre then o.Parent = padre end
	if animarBoton and (clase == "TextButton" or clase == "ImageButton") then
		animarBoton(o)
	end
	return o
end

-- ─── sonido + animación de hover/clic para TODOS los botones ───
-- rbxasset:// = sonidos incluidos en Roblox (no requieren subir nada)
local sndHover = Instance.new("Sound")
sndHover.SoundId = "rbxassetid://127105730240202"   -- el click que no sirvió para la ruleta rápida
sndHover.Volume = 0.35
sndHover.PlaybackSpeed = 1
sndHover.Parent = gui
local sndClick = Instance.new("Sound")
sndClick.SoundId = "rbxassetid://127105730240202"   -- mismo click (uno por clic)
sndClick.Volume = 0.55
sndClick.PlaybackSpeed = 1
sndClick.Parent = gui
-- pop al ABRIR cualquier ventana (local: cada jugador oye solo el suyo)
local sndPop = Instance.new("Sound")
sndPop.SoundId = "rbxassetid://140323850218372"
sndPop.Volume = 0.6
sndPop.Parent = gui
-- 🎵 MÚSICA DE FONDO: en loop infinito por todo el juego, muy bajita (10%)
-- para no opacar efectos/screamer/donaciones. Local en el gui = 2D, suena
-- igual en el lobby, la torre o la azotea.
local musicaFondo = Instance.new("Sound")
musicaFondo.SoundId = "rbxassetid://112264709514001"
musicaFondo.Volume = 0.1
musicaFondo.Looped = true
musicaFondo.Parent = gui
-- ⚠️ NO SE REPRODUCE AQUÍ (arreglado 2026-07-31). Este :Play() estaba en el
-- instante 0, o sea que pedía el archivo MÁS PESADO del juego justo mientras
-- bajaban el mapa, el avatar y los ~20 iconos del HUD. En el reporte de errores
-- era el asset que más fallaba con diferencia: 8 líneas y SIETE modos de fallo
-- distintos (429, NetFail, Timedout, DnsResolve, ConnectFail, SslConnectFail,
-- ServerProtocolError). Y un Sound cuyo asset falló se queda MUDO para siempre,
-- igual que pasaba con las imágenes en blanco.
-- Ahora arranca abajo, en la precarga, cuando ya no compite con nada.

-- ⚡ ANTI-429 DE SONIDOS (2026-07-24): antes CADA evento hacía
-- Instance.new("Sound") + SoundId + Play + Destroy. Con 30 jugadores eso son
-- cientos de peticiones de asset por minuto → Roblox responde HTTP 429 (Too Many
-- Requests) → el sonido NO carga y el jugador no oye NADA (por eso las monedas
-- "ni suenan"). Ahora cada id se crea UNA sola vez y se reutiliza: 0 peticiones
-- extra, y si el sonido ya estaba sonando se reinicia en vez de encimarse.
local cacheSnd = {}
local function sonar(id, vol, vel)
	if not id or id == "" then return end
	local s = cacheSnd[id]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Parent = gui
		cacheSnd[id] = s
	end
	s.Volume = vol or 0.6
	s.PlaybackSpeed = vel or 1
	s.TimePosition = 0
	s:Play()
	return s
end

-- 📦 PRECARGA: pedimos TODOS los sonidos del juego una vez al entrar, en tandas
-- de 3 y con pausa, para no provocar el 429 nosotros mismos. Después de esto ya
-- están en caché local del jugador y sonar() responde al instante.
task.spawn(function()
	local ids = {
		-- 2026-08-04: sonido del 💥 Explode Player. Va aquí desde el primer día
		-- justo para NO repetir el error de julio, cuando 5 sonidos se quedaron
		-- fuera de esta lista y salían con "HTTP 429 (Too Many Requests)" en el
		-- Error Report — 473 casos en una semana, sin sonar la primera vez.
		"rbxassetid://140278004623742",
		"rbxassetid://127105730240202", "rbxassetid://140323850218372",
		"rbxassetid://128187340772806", "rbxassetid://8486683243",
		"rbxassetid://127039883737564", "rbxassetid://90153447839250",
		"rbxassetid://108875729772405", "rbxassetid://307631257",
		"rbxassetid://79392333090964", "rbxassetid://133312610824902",
		"rbxassetid://126619107266979", "rbxassetid://115878657073501",
		"rbxassetid://130206997868957", "rbxassetid://2979857617",
		"rbxassetid://100559751053348",
		-- añadidos 2026-07-24 tras cruzar el reporte de errores: estos 5 se
		-- habían quedado FUERA y son justo varios de los que salían con 429.
		-- (la música de fondo ya NO va en esta lista: se precarga ella sola y
		--  ANTES que todo lo demás, ver justo debajo del task.wait)
		"rbxassetid://117960405302487",   -- sndCaza (persecución del gusano)
		"rbxassetid://71197035645816",    -- sndGiro (ruleta)
		"rbxassetid://1884211021",        -- lo toca el SERVER (jumpscare)
		"rbxassetid://136774133309136",   -- lo toca el SERVER
		"rbxassetid://126657623386649",   -- 🏏 golpe del bate (batHit)
		"rbxassetid://129084748747846",   -- 😱 "enrique" (30% del bate, 10% del slap)
		-- añadidos 2026-08-07, EL MISMO FALLO POR TERCERA VEZ: estos 3 se quedaron
		-- fuera de la lista y salen en el Error Report con 429, Timedout, NetFail
		-- y ConnectFail.
		-- El primero es el peor de todos: es el grito del 90% de los flings, o sea
		-- el sonido MÁS FRECUENTE del juego. Su pareja (129084748747846, el 10%
		-- "enrique") sí estaba precargada desde julio; el que suena nueve de cada
		-- diez veces, no.
		-- ⚠️ POR QUÉ SE ESCAPAN SIEMPRE ESTOS TRES: son sonidos 3D posicionales. Se
		-- crean con Instance.new("Sound") sobre una Part del mundo y por eso NO
		-- pasan por sonar()/cacheSnd, que solo cubre los 2D colgados del gui. La
		-- caché no los protege. Precargarlos aquí sí, porque el 429 lo provoca la
		-- DESCARGA del asset y no crear la instancia: una vez está en la caché
		-- local del jugador, Instance.new("Sound") ya no le pide nada a Roblox.
		-- 👉 Al añadir CUALQUIER sonido 3D nuevo, hay que meterlo también aquí.
		"rbxassetid://136680544819732",   -- 😱 grito del fling/slap (90%) ← el frecuente
		"rbxassetid://88060724643515",    -- 💖 donación, golpe 1
		"rbxassetid://1846942308",        -- 💖 donación, golpe 2 (a los 0,5 s)
	}
	-- 🖼 2026-08-16: LA CANCIÓN DEL CUADRO SE AÑADE SOLA. Config lleva un aviso de
	-- "acuérdate de meterla también en la precarga"… y ese aviso ya se incumplió
	-- TRES veces, que son los 429 del Error Report. Un aviso que falla tres veces
	-- no es un aviso, es un bug esperando. Leyéndola de Config no hay nada que
	-- recordar: el día que pongas CUADRO_MUSICA queda precargada sin tocar esto.
	-- Es sonido 3D creado por el server sobre una Part, o sea de los que NO pasan
	-- por sonar()/cacheSnd — exactamente el perfil de los tres de arriba.
	if (Config.CUADRO_MUSICA or "") ~= "" then
		ids[#ids + 1] = Config.CUADRO_MUSICA
	end
	task.wait(5)   -- deja que primero cargue el mapa y el avatar

	-- 🎵 LA MÚSICA VA LA PRIMERA Y APARTE. Es el archivo más grande, así que se
	-- baja sola —sin competir con las tandas de iconos ni de efectos— y solo
	-- cuando ya está en caché se reproduce. Si PreloadAsync falla igualmente, el
	-- :Play() se lanza de todas formas: peor es no tener música nunca.
	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync({musicaFondo})
	end)
	musicaFondo:Play()

	-- 🖼️ SEGUNDA PASADA DE LAS IMÁGENES DEL HUD (2026-07-24). Todos los iconos
	-- se piden de golpe al construir la interfaz; si en ese momento la conexión
	-- falla (NetFail) o Roblox contesta 429, el ImageLabel se queda EN BLANCO
	-- para siempre — de ahí el "no me cargaban varias imágenes e interfaces".
	-- Aquí se vuelven a pedir. Se pasan los PROPIOS ImageLabel en vez de una
	-- lista de ids escrita a mano, para que nunca se quede ninguno fuera aunque
	-- después se añadan botones o ventanas nuevas.
	-- ⚠️ UNO POR ASSET, NO UNO POR ETIQUETA (arreglado 2026-07-25). Antes esto
	-- metía TODOS los ImageLabel del HUD, y el mismo icono aparece en muchos
	-- sitios (IMG_CASH sale 8 veces, IMG_STUDS 5, la hotbar y el calendario los
	-- crean en bucle...), así que se pedía el MISMO archivo una y otra vez.
	-- Eran ~4x más peticiones de las necesarias, en tandas rápidas, y es justo
	-- lo que dispara los 429 (rate limit) que ya salían en el reporte de
	-- errores. Con el asset ya en caché, TODAS las etiquetas que lo usan se ven.
	local imgs, vistos = {}, {}
	for _, o in ipairs(gui:GetDescendants()) do
		if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= ""
			and not vistos[o.Image] then
			vistos[o.Image] = true
			imgs[#imgs + 1] = o
		end
	end
	for i = 1, #imgs, 6 do
		local tanda = {}
		for j = i, math.min(i + 5, #imgs) do tanda[#tanda + 1] = imgs[j] end
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(tanda) end)
		task.wait(0.5)
	end

	for i = 1, #ids, 3 do
		local tanda = {}
		for j = i, math.min(i + 2, #ids) do
			local id = ids[j]
			local s = cacheSnd[id]
			if not s then
				s = Instance.new("Sound")
				s.SoundId = id
				s.Parent = gui
				cacheSnd[id] = s
			end
			tanda[#tanda + 1] = s
		end
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(tanda) end)
		task.wait(1)
	end

	-- 🍎 TERCERA PASADA: EL MUNDO 3D (2026-07-31). Las dos pasadas de arriba
	-- cubren iconos del HUD y sonidos, pero NADIE volvía a pedir lo que de
	-- verdad se ve feo cuando falla: las MALLAS y las TEXTURAS del mapa — la
	-- manzana (mesh), las 25 cabezas de gusano, los maniquíes, las skins.
	-- El reporte de errores lo dice a gritos: la categoría nº1 es
	-- "MeshContentProvider failed ... could not fetch" con 3.415 casos, y las
	-- texturas que el CDN corta con 429 se quedan EN LA MIPMAP BAJA para
	-- siempre = "la manzana se ve borrosa/horrible".
	-- El mapa tiene 88 assets únicos de contenido; se piden despacio (tandas de
	-- 4 cada 0,8 s ≈ 18 s en total) para no provocar nosotros el mismo 429.
	--
	-- ⚠️ DECALS/MALLAS SUELTOS, NUNCA LAS INSTANCIAS DEL MUNDO. PreloadAsync
	-- acepta instancias del workspace, pero pasárselas obliga a recorrerlas de
	-- una en una y el MISMO asset aparece cientos de veces (IMG_STUDS solo ya
	-- está en ~500 piezas: 536 referencias para 88 archivos). Se crea UNA
	-- instancia suelta por asset único y se destruye al acabar.
	local function repasarMundo()
		local vistosM, sueltos = {}, {}
		local function texto(id)
			return id and id ~= "" and not id:match("//0$")
		end
		local function decal(id)
			if not texto(id) or vistosM[id] then return end
			vistosM[id] = true
			local d = Instance.new("Decal")
			d.Texture = id
			sueltos[#sueltos + 1] = d
		end
		local function malla(id)
			if not texto(id) or vistosM[id] then return end
			vistosM[id] = true
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.FileMesh
			m.MeshId = id
			sueltos[#sueltos + 1] = m
		end
		-- las texturas de TODAS las skins del catálogo (equipadas o no: el menú
		-- las enseña todas) y el mesh de la manzana/gusano
		malla(Config.GUSANO_MESH_ID)
		for _, s in ipairs(Config.SKINS) do decal(s.textura) end
		-- todo el contenido ya replicado del mapa: mallas de gusanos, texturas
		-- de maniquíes, calcomanías de los carteles...
		for _, o in ipairs(workspace:GetDescendants()) do
			if o:IsA("SpecialMesh") then
				malla(o.MeshId)
				decal(o.TextureId)
			elseif o:IsA("Decal") or o:IsA("Texture") then
				decal(o.Texture)
			end
		end
		for i = 1, #sueltos, 4 do
			local t = {}
			for j = i, math.min(i + 3, #sueltos) do t[#t + 1] = sueltos[j] end
			pcall(function() game:GetService("ContentProvider"):PreloadAsync(t) end)
			task.wait(0.8)
		end
		for _, o in ipairs(sueltos) do o:Destroy() end
	end
	repasarMundo()

	-- 🔁 REPESCA FINAL (≈60 s tras entrar): a estas alturas la avalancha del
	-- join ya pasó y la red está tranquila. Se repite TODO — mundo, iconos y
	-- sonidos. Lo que ya está en caché vuelve al instante y no gasta red; solo
	-- se re-descarga lo que falló con 429/NetFail en las pasadas anteriores,
	-- que es exactamente lo que buscamos. (También pesca lo que haya aparecido
	-- tarde: skins de otros jugadores, pisos lejanos del streaming...)
	task.wait(30)
	repasarMundo()
	for i = 1, #imgs, 6 do
		local t = {}
		for j = i, math.min(i + 5, #imgs) do t[#t + 1] = imgs[j] end
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(t) end)
		task.wait(0.5)
	end
end)

-- ═══ CALIDAD ADAPTATIVA: ELIMINADA (2026-07-25) ════════════════════════════
-- ⛔ NO VOLVER A ESCRIBIR EN UserGameSettings.SavedQualityLevel. NUNCA.
--
-- Aquí había un bloque que medía los FPS 12 s después de entrar y, si iban por
-- debajo de 25, bajaba la calidad gráfica 3 escalones. Tenía DOS fallos graves:
--
-- 1) EL CÁLCULO ESTABA MAL. Hacía:
--        math.max(1, (tonumber(actual.Value) or 10) - 3)
--    dando por hecho que en modo automático el valor sería nil y usaría 10.
--    Pero Enum.SavedQualitySetting.Automatic.Value ES 0, no nil, así que el
--    "or 10" jamás se activaba: 0 - 3 = -3 → math.max(1, -3) = 1. A TODO el que
--    tuviera la calidad en Automático (o sea, casi todos: es el valor por
--    defecto de Roblox) lo mandaba al nivel 1, el MÍNIMO absoluto. De ahí las
--    texturas borrosas y la manzana con el LOD más burdo, como "a medio cargar".
--
-- 2) SavedQualityLevel NO ES UNA OPCIÓN DEL JUEGO: es el ajuste GLOBAL de la
--    cuenta del jugador (el mismo del menú Esc). Se guarda y afecta a TODOS los
--    juegos de Roblox, para siempre. El síntoma clásico era exactamente este:
--    "no subí ninguna versión y hace una hora se veía bien" — el juego no había
--    cambiado, había cambiado la configuración de Roblox del jugador.
--
-- Además la medición caía en la peor ventana posible: a los 12 s el mapa aún
-- está haciendo streaming, así que los FPS están bajos por definición y el
-- recorte saltaba en gente cuyo dispositivo iba perfectamente bien.
--
-- El problema de memoria que esto pretendía resolver YA está resuelto por
-- StreamingTargetRadius=320 en build_rbxlx.py (Android: 1400 MB → 956 MB
-- confirmado). Este bloque no hacía falta.
--
-- Si algún día hace falta adaptar la calidad, hay que degradar SOLO cosas
-- NUESTRAS y locales (partículas, bucles decorativos, Lighting desde el
-- cliente), nunca los ajustes de la cuenta del jugador.

-- ─── "pop": una ventana crece de chiquita a grande con rebote ───
local function popIn(frame, desde, mudo)
	local sc = Instance.new("UIScale")
	sc.Scale = desde or 0.35
	sc.Parent = frame
	TweenService:Create(sc, TweenInfo.new(0.34, Enum.EasingStyle.Back,
		Enum.EasingDirection.Out), {Scale = 1}):Play()
	if not mudo then                     -- mudo=true → ventana silenciosa
		sndPop.TimePosition = 0
		sndPop:Play()
	end
end

-- desvanece una ventana COMPLETA a la vez (fondo, textos, contornos, imágenes)
local function desvanecer(frame, dur, alTerminar)
	dur = dur or 0.4
	local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(frame, info, {BackgroundTransparency = 1}):Play()
	for _, o in ipairs(frame:GetDescendants()) do
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			TweenService:Create(o, info, {TextTransparency = 1,
				TextStrokeTransparency = 1, BackgroundTransparency = 1}):Play()
		elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
			TweenService:Create(o, info, {ImageTransparency = 1,
				BackgroundTransparency = 1}):Play()
		elseif o:IsA("Frame") then
			TweenService:Create(o, info, {BackgroundTransparency = 1}):Play()
		elseif o:IsA("UIStroke") then
			TweenService:Create(o, info, {Transparency = 1}):Play()
		end
	end
	task.delay(dur + 0.05, function()
		if frame then frame:Destroy() end
		if alTerminar then alTerminar() end
	end)
end

function animarBoton(btn)
	if not sonidoHUD then btn:SetAttribute("Mute", true) end
	local uiscale = Instance.new("UIScale")
	uiscale.Scale = 1
	uiscale.Parent = btn
	local function a(destino, estilo, dir)
		TweenService:Create(uiscale, TweenInfo.new(0.13, estilo
			or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
			{Scale = destino}):Play()
	end
	btn.MouseEnter:Connect(function()
		if not btn:GetAttribute("NoZoom") then a(1.08, Enum.EasingStyle.Back) end
		-- Mute=true → no suena nada. NoHoverSound=true → SÍ suena el click pero NO
		-- el hover (para los pases: en Android la palanca de movimiento queda encima
		-- y disparaba el hover sin parar).
		if not btn:GetAttribute("Mute") and not btn:GetAttribute("NoHoverSound") then
			sndHover.TimePosition = 0
			sndHover:Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if not btn:GetAttribute("NoZoom") then a(1) end
	end)
	btn.MouseButton1Down:Connect(function()
		if not btn:GetAttribute("NoZoom") then uiscale.Scale = 0.94 end
		if not btn:GetAttribute("Mute") then
			sndClick.TimePosition = 0
			sndClick:Play()
		end
	end)
	btn.MouseButton1Up:Connect(function()
		if not btn:GetAttribute("NoZoom") then a(1.08, Enum.EasingStyle.Back) end
	end)
end

local function esquinas(o, r)
	nuevo("UICorner", {CornerRadius = UDim.new(0, 0)}, o)   -- TODO cuadrado (sin esquinas redondeadas)
end

-- redondea SOLO elementos puntuales (el resto sigue cuadrado por esquinas())
local function redondear(o, r)
	local uc = o:FindFirstChildOfClass("UICorner")
	if uc then uc.CornerRadius = UDim.new(0, r)
	else nuevo("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
end
local function borde(o, grosor, color)
	nuevo("UIStroke", {Thickness = grosor or 2.5,
		Color = color or Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Miter,   -- esquinas AFILADAS (100% cuadradas)
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end

-- aclara/oscurece POR HSV manteniendo la saturación (Lerp hacia blanco/negro
-- LAVA el color y todo se veía café/gris sucio): dv = brillo, ds = saturación
local function vivo(col, dv, ds)
	local h, sa, v = col:ToHSV()
	return Color3.fromHSV(h, math.clamp(sa * (ds or 1), 0, 1),
		math.clamp(v * dv, 0, 1))
end

-- SUPERFICIE de studs COLOREADA (como la referencia): la textura de studs se
-- TIÑE con un degradado del color VIVO → plástico de color con relieve. (El
-- método anterior ponía la textura BLANCA semitransparente ENCIMA del color y
-- lo lavaba → todo se veía café/gris por más que saturara los colores.)
local function studsVivo(o, cA, cB, tile, rot, sinBrillo)
	-- BRILLANTE: el fondo es el color MÁS CLARO (cA) subido de brillo (no cB, que
	-- lo dejaba al 72% y oscuro); los studs van muy tenues con tinte claro (dan
	-- relieve/brillo, no gris) + un shine blanco arriba. Antes la textura grisácea
	-- al mezclarse apagaba TODOS los apartados.
	local uc = o:FindFirstChildOfClass("UICorner")
	local rad = uc and uc.CornerRadius or UDim.new(0, 0)
	o.ClipsDescendants = true                          -- recorta studs/brillo a la esquina redonda (no más esquinas mochadas)
	o.BackgroundColor3 = vivo(cA, 1.2, 2.2)            -- fondo SUPER vivo (satura a tope)
	local img = nuevo("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Image = Config.IMG_STUDS, ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.new(0, tile or 80, 0, tile or 80),
		ImageColor3 = vivo(cA, 2.0, 0.5), ImageTransparency = 0.8,   -- cuadritos SUTILES (se ven menos) sin apagar el color
		ZIndex = o.ZIndex,
	}, o)
	nuevo("UICorner", {CornerRadius = rad}, img)
	if not sinBrillo then
		local shf = nuevo("Frame", {
			Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0, ZIndex = o.ZIndex,
		}, o)
		nuevo("UICorner", {CornerRadius = rad}, shf)
		nuevo("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(1, 1)})}, shf)
	end
	return img
end

local ARCOIRIS = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.18, Color3.fromRGB(255, 160, 40)),
	ColorSequenceKeypoint.new(0.36, Color3.fromRGB(255, 230, 40)),
	ColorSequenceKeypoint.new(0.54, Color3.fromRGB(70, 220, 90)),
	ColorSequenceKeypoint.new(0.72, Color3.fromRGB(60, 140, 255)),
	ColorSequenceKeypoint.new(0.88, Color3.fromRGB(150, 70, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 200)),
})

local function gradiente(o, seq, rot)
	return nuevo("UIGradient", {Color = seq, Rotation = rot or 0}, o)
end

-- gradientes cuyo arcoíris se ANIMA (colores RGB fluyendo). Agrega uno con
-- gradRGB(objeto) y un solo bucle los actualiza a todos cada frame.
local gradsRGB = {}
local function gradRGB(o)
	local g = gradiente(o, ARCOIRIS)
	table.insert(gradsRGB, g)
	return g
end
-- 🌈 ARCOÍRIS PRECALCULADO (2026-07-25)
-- Antes, CADA fotograma y en DOS bucles distintos se creaban 1 tabla + 9
-- ColorSequenceKeypoint + 1 ColorSequence = ~1,320 objetos de basura por segundo,
-- solo para animar un degradado DECORATIVO. Como la secuencia depende únicamente
-- de t%1 (el resto del ciclo se repite igual), se calculan los pasos del ciclo
-- UNA sola vez al entrar y después cada fotograma es solo un índice a la tabla:
-- CERO asignaciones. Se ve exactamente igual y sigue a 60 fps.
local ARCO_PASOS = 120        -- pasos del ciclo (~42 cambios/s: la vista no distingue más)
local ARCO_SEQ = table.create(ARCO_PASOS)
for p = 0, ARCO_PASOS - 1 do
	local t = p / ARCO_PASOS
	local kps = table.create(9)
	for i = 0, 8 do
		kps[i + 1] = ColorSequenceKeypoint.new(i / 8,
			Color3.fromHSV((i / 8 - t) % 1, 1, 1))
	end
	ARCO_SEQ[p + 1] = ColorSequence.new(kps)
end
-- secuencia que toca AHORA (misma velocidad de flujo de siempre: os.clock()*0.35)
local function arcoActual()
	local t = (os.clock() * 0.35) % 1
	return ARCO_SEQ[math.floor(t * ARCO_PASOS) % ARCO_PASOS + 1]
end

local arcoUlt = nil
RunService.RenderStepped:Connect(function()
	if #gradsRGB == 0 then return end
	local seq = arcoActual()
	-- ⚡ 2026-07-26: arcoActual() solo tiene 42 valores distintos por segundo
	-- (ARCO_PASOS 120 ÷ 2,86 s de ciclo) pero esto corre a 60 fps, así que 1 de
	-- cada 3 frames pedía escribir EXACTAMENTE la misma ColorSequence. Como son
	-- los mismos objetos de la tabla precalculada, basta compararlos por
	-- identidad. El arcoíris fluye IGUAL de suave —son los mismos 42 cambios—,
	-- solo se dejan de mandar los duplicados. NO bajar ARCO_PASOS para "ir a 30
	-- fps": eso sí se notaría, y ahorra menos que esto.
	if seq == arcoUlt then return end
	arcoUlt = seq
	for _, g in ipairs(gradsRGB) do
		if g.Parent then g.Color = seq end
	end
end)

-- "ladrillitos" translúcidos encima de un frame (look de bloque Roblox)
-- TEXTURA DE STUDS clásica de Roblox: rejilla DENSA que llena todo el botón
-- (los studs blancos semitransparentes toman el color del botón → cada uno
-- con su textura en su color). Va bajo el texto (ZIndex del botón, el texto
-- va +1). Se recorta a la forma del botón.
-- STUDS: tamaño de UNA copia de la textura (más grande = studs más grandes) y
-- qué tan SUTIL va encima (más alto = menos gris, color más vivo).
local STUDS_TILE = 150
local STUDS_TRANSP = 0.76
local function ladrillos(f, color, rainbow, tile, transp)
	-- TEXTURA DE STUDS como OVERLAY SUTIL (semitransparente, sin teñir) ENCIMA
	-- del color/arcoíris del botón: así el color se ve VIVO y los studs solo dan
	-- relieve, sin la "sombra gris" que salía al teñir la textura completa.
	local ids = Config.IMG_STUDS
	if ids and ids ~= "" and not ids:match("//0$") then
		tile = tile or STUDS_TILE
		local img = nuevo("ImageLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Image = ids, ScaleType = Enum.ScaleType.Tile,
			TileSize = UDim2.new(0, tile, 0, tile),
			ImageColor3 = Color3.new(1, 1, 1), ImageTransparency = transp or STUDS_TRANSP,
			ZIndex = f.ZIndex or 1,
		}, f)
		nuevo("UICorner", {CornerRadius = UDim.new(0, 0)}, img)
		return
	end
	local z = f.ZIndex or 1
	local cont = nuevo("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		ClipsDescendants = true, ZIndex = z, Active = false,
	}, f)
	nuevo("UICorner", {CornerRadius = UDim.new(0, 0)}, cont)
	nuevo("UIPadding", {
		PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3),
		PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3),
	}, cont)
	nuevo("UIGridLayout", {
		CellSize = UDim2.new(0, 9, 0, 9),
		CellPadding = UDim2.new(0, 5, 0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, cont)
	for i = 1, 96 do
		local s = nuevo("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = z,
		}, cont)
		nuevo("UICorner", {CornerRadius = UDim.new(0, 2)}, s)
	end
end

local function botonBloque(padre, texto, color, tam, pos, colorTexto)
	local b = nuevo("TextButton", {
		Size = tam, Position = pos, BackgroundColor3 = color,
		Text = "", BorderSizePixel = 0, AutoButtonColor = true,
	}, padre)
	esquinas(b, 6)
	borde(b, 3)
	ladrillos(b, color)   -- textura de studs teñida con el color del botón
	local tl = nuevo("TextLabel", {
		Size = UDim2.new(1, -16, 1, -8), Position = UDim2.new(0, 8, 0, 4),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = texto,
		TextColor3 = colorTexto or Color3.new(1, 1, 1), TextScaled = true,
		ZIndex = (b.ZIndex or 1) + 1,
	}, b)
	nuevo("UITextSizeConstraint", {MaxTextSize = 22}, tl)
	nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tl)
	return b
end

