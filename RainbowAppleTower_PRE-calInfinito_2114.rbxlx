Config.SKIN_NARANJA_TEXTURE = "rbxassetid://93087883341653"

-- ═══ SKINS DE MANZANA ══════════════════════════════════════
-- Catálogo ÚNICO de las manzanas que se pueden llevar en la cabeza. Lo leen el
-- servidor (para ponerlas y para validar el desbloqueo) y el cliente (para
-- dibujar el menú), así que añadir una skin nueva es añadir una fila aquí y
-- nada más: no hay que tocar ninguno de los dos scripts.
--
-- Todas usan el MISMO mesh (GUSANO_MESH_ID); lo único que cambia es la textura.
--
--   id       clave interna y nombre de la Part que se suelda a la cabeza
--   req      "libre"     siempre desbloqueada
--            "comunidad" hay que estar en el grupo (atributo EnComunidad)
--            "torre"     hay que completar la torre `veces` veces (perfil.trofeos)
--   oculta   true = NO sale en el menú de skins. Se usa para la galaxia, que se
--            sigue consiguiendo solo pisando el pad de su maniquí en la azotea,
--            como antes de que existiera este menú.
--   color    color plano de respaldo por si la textura no carga o está en //0
-- 🧪 ¿TODAS LAS SKINS DESBLOQUEADAS AL PROBAR EN STUDIO?
-- true  = en Studio se pueden equipar todas sin cumplir el requisito, para no
--         tener que subir la torre 10 o 25 veces solo para ver cómo quedan.
-- false = exige el requisito SIEMPRE (así compruebas lo que ve un jugador real).
--
-- ⚠️ NO HAY QUE ACORDARSE DE APAGARLO ANTES DE PUBLICAR. El interruptor va
-- SIEMPRE acompañado de ES_STUDIO (RunService:IsStudio()), que en el juego
-- publicado es false. O sea que en Roblox los requisitos de Config.SKINS de aquí
-- abajo se aplican enteros, esté esto en true o en false. Es el mismo patrón que
-- Config.ADMIN_GRATIS_STUDIO.
Config.SKINS_LIBRES_STUDIO = false

