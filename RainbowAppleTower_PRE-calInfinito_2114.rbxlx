-- id -&gt; fila, para no recorrer la lista en cada consulta
Config.SKIN_POR_ID = {}
for _, s in ipairs(Config.SKINS) do Config.SKIN_POR_ID[s.id] = s end

-- Texto de "cómo se desbloquea", en un solo sitio para que el menú y cualquier
-- aviso digan exactamente lo mismo. `es` = true para español.
function Config.skinRequisito(s, es)
	if s.req == "comunidad" then
		return es and "Únete a la comunidad" or "Join the community"
	end
	if s.req == "torre" then
		local n = s.veces or 1
		if es then
			return n == 1 and "Completa la torre 1 vez"
				or ("Completa la torre " .. n .. " veces")
		end
		return n == 1 and "Beat the tower once"
			or ("Beat the tower " .. n .. " times")
	end
	if s.req == "pase" then
		local g = Config.GAMEPASSES[s.pase]
		local n = g and g.nombre or s.pase
		return es and ("Necesitas el pase " .. n) or ("Requires the " .. n .. " pass")
	end
	return es and "Desbloqueada" or "Unlocked"
end

