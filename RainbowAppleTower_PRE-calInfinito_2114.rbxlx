-- ServerScriptService/MainServer  (Script)
-- Rainbow Apple Tower — TODO el lado servidor: gusanos IA, detección y caza,
-- zonas seguras, datos, ruleta, tiendas, slap/push, monetización.
-- Server-authoritative: NUNCA se confía en el cliente.
-- ═══════════════════════════════════════════════════════════════════════
print("[RainbowApple] Servidor arrancando...")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local BadgeService = game:GetService("BadgeService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local ES_STUDIO = RunService:IsStudio()
local NP = Config.N_PISOS

-- ─── 🛡 GRUPOS DE COLISIÓN (God Mode = nadie te empuja) ─────
-- Dos grupos: "Jugadores" (todo el mundo) y "Dios" (God Mode activo).
--   Dios ↔ Jugadores = false  → ningún cuerpo puede empujarte
--   Dios ↔ Dios      = false  → dos dioses se atraviesan
--   Dios ↔ Default   = true   → SIGUES pisando suelo, escalones y torre
-- Si el registro fallara (límite de 32 grupos del motor), gruposOk queda en
-- false y todo lo demás funciona igual: solo se pierde el anti-empuje FÍSICO.
-- El anti-empuje de las slaps/bate NO depende de esto (va en flingear).
local PhysicsService = game:GetService("PhysicsService")
local GRUPO_JUG, GRUPO_DIOS = "Jugadores", "Dios"
local function registrarGrupo(nombre)
	local ok = pcall(function() PhysicsService:RegisterCollisionGroup(nombre) end)
	if ok then return true end
	-- ya existía (se reinició el script) = igual de válido
	local ok2, existe = pcall(function()
		return PhysicsService:IsCollisionGroupRegistered(nombre)
	end)
	return ok2 and existe or false
end
local gruposOk = registrarGrupo(GRUPO_JUG) and registrarGrupo(GRUPO_DIOS)
if gruposOk then
	gruposOk = pcall(function()
		PhysicsService:CollisionGroupSetCollidable(GRUPO_DIOS, GRUPO_JUG, false)
		PhysicsService:CollisionGroupSetCollidable(GRUPO_DIOS, GRUPO_DIOS, false)
	end)
end
print("[RainbowApple] grupos de colisión:", gruposOk and "OK" or "NO (empuje físico normal)")

-- pone TODAS las piezas del personaje en un grupo. Barato y sin estado: se
-- llama al comprar el God Mode, al caducar y en cada respawn.
local function grupoChar(char, grupo)
	if not (gruposOk and Config.GOD_ANTIEMPUJE and char) then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then d.CollisionGroup = grupo end
	end
end

-- ─── Remotos ───────────────────────────────────────────────
local Remotos = Instance.new("Folder")
Remotos.Name = "Remotos"
Remotos.Parent = ReplicatedStorage
local RE = {}
for _, nombre in ipairs({"Sync", "Toast", "FX", "Detectado", "Jumpscare",
		"Ruleta", "Girar", "ComprarCrate", "ComprarGear", "Slap", "Hotbar",
		"Prompt", "Toggle", "Admin", "ObbyFin", "Checkpoint", "Correr", "ClaimCd",
		"Volver", "Skin"}) do
	local r = Instance.new("RemoteEvent")
	r.Name = nombre
	r.Parent = Remotos
	RE[nombre] = r
end

-- ─── Referencias al mapa ───────────────────────────────────
local Mapa = workspace:WaitForChild("Mapa")
local TorreF = Mapa:WaitForChild("Torre")
local LobbyF = Mapa:WaitForChild("Lobby")
local AzoteaF = Mapa:WaitForChild("Azotea")
local ParkourF = Mapa:WaitForChild("Parkour")

-- geometría derivada del Config (igual que build_rbxlx.py)
local HALFC = Config.TAM_INTERIOR / 2
local EXTC = Config.PASOS_POR_TRAMO * Config.LARGO_PASO / 2
local LANDC = HALFC - 0.3 - EXTC
local ESQC = EXTC + LANDC / 2                    -- centro descansos/plataforma SE
local EZBC = -(Config.TAM_INTERIOR - 20.3) / 2   -- centro z plataforma SE

local function entradaPiso(f) -- punto seguro junto al hueco SE del piso f
	if f &lt;= 0 then
		-- 3 puntos LADO A LADO (2026-07-19): cada llegada al lobby (entrar,
		-- morir, "regresar al obby", tp) cae al azar en uno de los tres →
		-- los jugadores ya no se amontonan en un solo punto
		return Vector3.new(({-11, 0, 11})[math.random(3)], 5, -18)   -- lobby (entrar/morir/regresar): 3 puntos adentro
	end
	if f &gt; NP then return Vector3.new(0, Config.yTecho() + 4, 2) end
	-- torre hueca: se reaparece sobre la plataforma SE del piso
	return Vector3.new(ESQC, Config.yLosa(f) + 3, EZBC)
end

-- CFrame de reaparición: el spawn de AFUERA (f&lt;=0) mira hacia +Z (enfrente);
-- el resto conserva su orientación por defecto.
local function cframeEntrada(f)
	local pos = entradaPiso(f)
	if f &lt;= 0 then
		return CFrame.new(pos) * CFrame.Angles(0, math.pi, 0)   -- voltea 180° → mira enfrente
	end
	return CFrame.new(pos)
end

-- ─── Estado ────────────────────────────────────────────────
local perfiles = {}   -- [plr] = perfil persistente
local rt = {}         -- [plr] = estado de sesión

-- ═══ EMBUDO DE ONBOARDING (2026-07-25) ═══════════════════════════════════════
-- SOLO MIDE, no cambia nada del juego. Responde la pregunta que las métricas
-- actuales no pueden: el 38% que se va en los primeros 100 s, ¿se va SIN haber
-- empezado a subir (problema de "no sé a dónde ir") o sube y no puede pasar del
-- piso 1 (problema de dificultad)? Son arreglos distintos.
-- Se ve en: create.roblox.com → el juego → Analytics → Funnels (tarda ~24 h).
-- ⚠️ Solo cuenta desde el SERVER y en el juego PUBLICADO: en Studio no registra.
local AnalyticsService = game:GetService("AnalyticsService")
local FUNNEL_PASOS = {
	"Joined",            -- 1: entró al juego
	"Started Climbing",  -- 2: se despegó del lobby (EL PASO CLAVE)
	"Floor 1",           -- 3: primer checkpoint
	"Floor 3",           -- 4
	"Floor 5",           -- 5
	"Floor 10",          -- 6: mitad de la torre
	"Reached Roof",      -- 7: llegó al cofre
}
-- registra el paso n una sola vez por jugador. Roblox ya ignora los repetidos,
-- pero filtrarlos aquí evita gastar cuota de eventos.
local function funnel(plr, n)
	local r = rt[plr]
	if not r then return end
	r.funnel = r.funnel or {}
	if r.funnel[n] then return end
	r.funnel[n] = true
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(plr, n, FUNNEL_PASOS[n])
	end)
end
-- piso alcanzado → número de paso (los saltados los completa Roblox solo)
local function funnelPiso(plr, f)
	if f &gt;= Config.N_PISOS + 1 then funnel(plr, 7)
	elseif f &gt;= 10 then funnel(plr, 6)
	elseif f &gt;= 5 then funnel(plr, 5)
	elseif f &gt;= 3 then funnel(plr, 4)
	elseif f &gt;= 1 then funnel(plr, 3) end
end
-- ⚠️ En Studio sin "API Services" GetDataStore LANZA error: no debe tumbar
-- todo el servidor (gusanos, carteles, prompts). Sin store = sin persistir.
local store
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE)
	end)
	if ok then
		store = ds
	else
		warn("[RainbowApple] Sin DataStore (activa Studio Access to API Services "
			.. "para guardar progreso): " .. tostring(ds))
	end
end

local function perfilNuevo()
	return {
		cash = Config.CASH_INICIAL, trofeos = 0, victorias = 0,
		pisoMax = 0, coils = {speed = false, jump = false},
		gears = {},   -- elementos PERMANENTES comprados con cash en la tienda Gears
		spinsExtra = 0, fechaSpin = "", fechaMisterio = "",
		regaloGrupo = false, recibos = {}, donado = 0, resetSello = "",
		cuadro = false,              -- 🖼 cogió el cuadro del piso 1 (Config.CUADRO_PERSISTE)
		calDia = 1, calFecha = "",   -- calendario diario: día actual (1..7) y última fecha reclamada
		calVisto7 = false,           -- true tras reclamar el día 7 → deja de abrirse solo
		skin = false,                -- id de la manzana puesta (false = ninguna).
		                             -- Los desbloqueos NO se guardan aquí: se
		                             -- deducen de trofeos/pisoMax y de estar en la
		                             -- comunidad, así que no hay nada que migrar.
	}
end

-- "hoy" según la hora de MÉXICO (UTC-6): el "día" del juego (calendario diario,
-- giro gratis y cofre misterio) reinicia a la MEDIANOCHE de México, no a las 6pm
-- (que era cuando cambiaba la fecha UTC). Así, si juegas en la tarde/noche y
-- vuelves a la mañana siguiente, YA es un día nuevo y sí reclamas.
-- México no usa horario de verano desde 2022 → -6 es fijo todo el año.
local function hoyMX() return os.date("!%Y-%m-%d", os.time() - 6 * 3600) end

local function toast(plr, clave, ...)
	RE.Toast:FireClient(plr, clave, {...})
end
-- 300 → "5 min" · 90 → "1:30" · 45 → "45 s". Así el toast del God Mode no dice
-- "¡Modo Dios 300s!" si algún día se toca Config.GOD_PRODUCTO_SEG.
local function duracionTexto(seg)
	seg = math.floor(seg + 0.5)
	if seg &lt; 60 then return seg .. " s" end
	local m, s = math.floor(seg / 60), seg % 60
	if s == 0 then return m .. " min" end
	return string.format("%d:%02d", m, s)
end
local function toastTodos(clave, ...)
	RE.Toast:FireAllClients(clave, {...})
end

-- ─── Rate limiting ─────────────────────────────────────────
local cubos = {}
local function limitar(plr, clave, porSeg)
	-- separador "|" (2026-07-25): antes era uid..clave SIN separador, así que
	-- "123".."slap" y "12".."3slap" daban la MISMA clave. Además hace falta para
	-- poder borrar por prefijo al salir el jugador (limpiarTablas, abajo) sin
	-- llevarse por delante las claves de otro (el 123 borraría las del 1234).
	local k = plr.UserId .. "|" .. clave
	local c = cubos[k]
	local ahora = os.clock()
	if not c or ahora - c.t &gt; 1 then
		cubos[k] = {t = ahora, n = 1}
		return true
	end
	c.n = c.n + 1
	return c.n &lt;= porSeg
end

-- ─── Guardado ──────────────────────────────────────────────
-- ⚡ ANTI-COLA DE DATASTORE (2026-07-24): antes guardaba a TODOS cada 90 s sin
-- importar si algo había cambiado. Con el churn del anuncio (mucha gente
-- entrando y saliendo) la cola se llenaba → "requests will be dropped" → los
-- jugadores PERDÍAN su progreso → no volvían. Ahora solo guarda si el perfil
-- CAMBIÓ y máximo 1 vez cada 25 s por jugador; al SALIR se fuerza (forzar=true).
local pendGuardar = {}   -- [plr] = true si su perfil cambió desde el último guardado
local ultGuardado = {}   -- [plr] = os.clock() del último guardado
local function guardarPerfil(plr, forzar)
	local perfil = perfiles[plr]
	if not perfil or not store then return end
	if perfil._noGuardar then return end   -- su carga falló: NO pisar sus datos reales
	if not forzar then
		if not pendGuardar[plr] then return end            -- nada cambió → no gastar request
		local ult = ultGuardado[plr]
		if ult and os.clock() - ult &lt; 25 then return end   -- throttle por jugador
	end
	pendGuardar[plr] = nil
	ultGuardado[plr] = os.clock()
	local clave = "jugador_" .. plr.UserId
	for i = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(clave, function(guardado)
				-- 🔒 SELLO DE SESIÓN (2026-07-26)
				-- Antes esto era `function() return perfil end`: ignoraba el
				-- valor que había en disco y escribía la copia en memoria pasara
				-- lo que pasara. UpdateAsync existe precisamente para mirar lo
				-- guardado antes de pisarlo, y no se estaba usando para nada.
				--
				-- EL CASO QUE ROMPÍA: el guardado forzado del PlayerRemoving
				-- captura `perfil` y sigue REINTENTANDO con backoff (2 s, 4 s).
				-- Si el DataStore falla —y los 502 salen en el reporte de
				-- errores— ese reintento puede aterrizar hasta ~20 s después. Si
				-- para entonces el jugador ya volvió a entrar en OTRO servidor,
				-- la escritura tardía del servidor viejo le borraba lo que
				-- acabara de hacer en el nuevo.
				--
				-- Ahora cada carga incrementa _sesion (ver cargarPerfil), así
				-- que un servidor viejo ve un sello MAYOR que el suyo y se
				-- aparta. Devolver nil desde aquí CANCELA la escritura.
				--
				-- Es un contador y no un os.time() a propósito: un sello por
				-- reloj depende de que dos servidores estén sincronizados; el
				-- contador solo depende del propio DataStore.
				--
				-- ⚠️ Lo que esto NO hace: impedir que dos servidores tengan al
				-- mismo jugador a la vez. Solo evita que el viejo pise al nuevo.
				-- Para lo primero haría falta bloqueo de verdad (ProfileService).
				if guardado and guardado._sesion and perfil._sesion
					and guardado._sesion &gt; perfil._sesion then
					warn("[RainbowApple] guardado ABORTADO para " .. plr.Name
						.. ": en disco hay una sesión más nueva ("
						.. tostring(guardado._sesion) .. " &gt; "
						.. tostring(perfil._sesion) .. ")")
					return nil
				end
				return perfil
			end)
		end)
		if ok then return true end
		warn("[RainbowApple] guardado falló (" .. i .. "): " .. tostring(err))
		if i &lt; 3 then task.wait(2 ^ i) end
	end
end

-- ¿a este jugador le toca reseteo? (lista + sello de un solo uso)
local function tocaResetear(plr, perfil)
	local sello = Config.RESET_SELLO
	if not sello or sello == "" then return false end
	if perfil and perfil.resetSello == sello then return false end   -- ya se hizo
	for _, uid in ipairs(Config.RESET_PERFIL or {}) do
		if uid == plr.UserId then return true end
	end
	return false
end

local function cargarPerfil(plr)
	if not store then return perfilNuevo() end
	local clave = "jugador_" .. plr.UserId
	-- 🔁 5 INTENTOS CON BACKOFF (antes: 3 con task.wait(1.5) fijo = 4,5 s y a la calle).
	-- El guardado (:196-238) ya usaba backoff exponencial y la carga no: era la
	-- incoherencia que dejaba a gente jugando sin guardado por un bache de 5 segundos
	-- del DataStore. Ahora la ventana es de ~15 s.
	-- ⚠️ EL JITTER NO ES ADORNO: sin él, un fallo del DataStore hace que TODOS los
	-- jugadores que están entrando reintenten exactamente a la vez, se sincronizan
	-- contra el mismo límite de peticiones y se vuelven a estrellar juntos.
	for i = 1, 5 do
		local ok, datos = pcall(function() return store:GetAsync(clave) end)
		if ok then
			-- 🔒 se lee ANTES de cualquier cosa: hasta un perfil reseteado tiene
			-- que llevar un sello mayor que el que había, o su guardado se
			-- abortaría a sí mismo por parecer más viejo.
			local sesionPrevia = (datos and tonumber(datos._sesion)) or 0
			local p = datos or perfilNuevo()
			for k, v in pairs(perfilNuevo()) do -- migrar campos nuevos
				if p[k] == nil then p[k] = v end
			end
			if tocaResetear(plr, p) then
				p = perfilNuevo()                      -- ← borrón y cuenta nueva
				p.resetSello = Config.RESET_SELLO      -- sello: no se repite
				warn("[RainbowApple] PERFIL RESETEADO: " .. plr.Name)
			end
			-- cada carga reclama un número mayor: quien cargó DESPUÉS manda.
			-- Los perfiles viejos no tienen _sesion → empiezan en 1 y todo
			-- sigue funcionando igual (guardado sin _sesion = no se bloquea).
			p._sesion = sesionPrevia + 1
			return p
		end
		-- sin espera después del último intento: era 1,5 s que se tiraban a la basura
		if i &lt; 5 then task.wait((2 ^ (i - 1)) * (0.9 + math.random() * 0.2)) end
	end
	-- ⚠️ DataStore caído: dar perfil temporal SIN GUARDADO (si lo guardáramos,
	-- pisaría el progreso REAL del jugador con un perfil vacío)
	local p = perfilNuevo()
	p._noGuardar = true
	warn("[RainbowApple] carga falló 5 veces: " .. plr.Name .. " juega SIN guardado")
	return p
end

-- ─── Sync al cliente ───────────────────────────────────────
local sucios = {}
local function marcar(plr) sucios[plr] = true pendGuardar[plr] = true end

-- ⚖️ POLÍTICA DE OBJETOS ALEATORIOS DE PAGO (ArePaidRandomItemsRestricted):
-- hay países/edades donde las cajas sorpresa pagadas están PROHIBIDAS. Roblox
-- lo dice por jugador vía PolicyService; si está restringido, a ESE jugador no
-- se le vende ninguna caja ni giros (el resto del juego funciona igual).
local PolicyService = game:GetService("PolicyService")
local function revisarPolitica(plr)
	task.spawn(function()
		-- 3 intentos: la consulta a veces falla por red, no por política
		local ok, info
		for _ = 1, 3 do
			ok, info = pcall(function()
				return PolicyService:GetPolicyInfoForPlayerAsync(plr)
			end)
			if ok and info then break end
			task.wait(1)
		end
		-- ⚠️ Si NO hay respuesta clara se PERMITE (antes se bloqueaba, y una
		-- falla de red dejaba al jugador sin poder abrir NINGUNA caja).
		-- El bloqueo real solo se aplica cuando Roblox lo dice explícitamente.
		local restringido, origen = false, "sin respuesta -&gt; permitido"
		if ok and info and info.ArePaidRandomItemsRestricted ~= nil then
			restringido = info.ArePaidRandomItemsRestricted and true or false
			origen = "PolicyService"
		end
		if plr.Parent then
			plr:SetAttribute("SinAzarPagado", restringido)
			print(("[RainbowApple] politica %s -&gt; azar restringido=%s (%s)")
				:format(plr.Name, tostring(restringido), origen))
		end
	end)
end
local function azarBloqueado(plr)
	if ES_STUDIO then return false end   -- en Studio SIEMPRE se puede probar
	return plr:GetAttribute("SinAzarPagado") and true or false
end


local function estadoDe(plr)
	local perfil, r = perfiles[plr], rt[plr]
	if not perfil or not r then return nil end
	local ahora = os.clock()
	return {
		cash = perfil.cash, trofeos = perfil.trofeos,
		victorias = perfil.victorias, pisoMax = perfil.pisoMax,
		coils = perfil.coils, spinsExtra = perfil.spinsExtra,
		spinGratis = perfil.fechaSpin ~= hoyMX(),
		calDia = perfil.calDia or 1,                 -- día del calendario a reclamar
		calListo = (perfil.calFecha or "") ~= hoyMX(),  -- ¿hoy aún no se reclama?
		calVisto7 = perfil.calVisto7 or false,       -- ¿ya completó los 7? → no auto-abrir
		boostAmigos = r.boostAmigos, pases = r.pases, equip = r.equip,
		speedLeft = math.max(0, r.speedUntil - ahora),
		jumpLeft = math.max(0, r.jumpUntil - ahora),
		flyLeft = math.max(0, r.flyUntil - ahora),
		slapLeft = math.max(0, r.slapUntil - ahora),
		godLeft = math.max(0, r.godUntil - ahora),
		checkpoint = r.checkpointPiso,
		skin = r.skin or false,   -- id de la manzana puesta, para pintar el menú
	}
end

task.spawn(function()
	while true do
		task.wait(0.4)
		for plr in pairs(sucios) do
			sucios[plr] = nil
			if plr.Parent and rt[plr] then
				RE.Sync:FireClient(plr, estadoDe(plr))
			end
		end
	end
end)

-- ─── Cash / premios ────────────────────────────────────────
-- 🤝 EL BOOST DE AMIGOS SE APLICA A TODO EL CASH (2026-08-18, a petición).
-- Antes había un tercer parámetro `conBoost` y cada llamada decidía: de las 16,
-- seis lo tenían en false (calendario diario, compra de Cash con Robux, regalo de
-- grupo, devolución de caja repetida, premios sueltos). Se quitó el parámetro y
-- se limpiaron las 16 llamadas, en vez de cambiarlas a `true` una por una: así
-- una fuente de cash NUEVA no puede quedarse fuera por olvidarse de ponerlo.
-- 👉 Nota: esto incluye el producto de Robux. Quien compre "5.500 Cash" con un
--    amigo al lado recibirá 6.050. Es dar de más, no de menos, y es lo pedido.
local function darCash(plr, monto)
	local perfil, r = perfiles[plr], rt[plr]
	if not perfil then return end
	if r then
		monto = math.floor(monto * (1 + r.boostAmigos * Config.BOOST_AMIGO))
	end
	perfil.cash = perfil.cash + monto
	if plr:FindFirstChild("leaderstats") then
		plr.leaderstats.Cash.Value = perfil.cash
	end
	marcar(plr)
end

local function cobrar(plr, monto)
	local perfil = perfiles[plr]
	if not perfil or perfil.cash &lt; monto then return false end
	perfil.cash = perfil.cash - monto
	if plr:FindFirstChild("leaderstats") then
		plr.leaderstats.Cash.Value = perfil.cash
	end
	marcar(plr)
	return true
end

-- ─── Velocidad / salto ─────────────────────────────────────
local function aplicarStats(plr)
	local r = rt[plr]
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not r or not hum then return end
	local ahora = os.clock()
	local vel = Config.VEL_BASE
	if r.equip.speed and (perfiles[plr].coils.speed or r.speedUntil &gt; ahora) then
		vel = vel + Config.VEL_COIL
	end
	if r.pases.speed2x then vel = vel * 2 end
	if r.correr and (r.stamina or 0) &gt; 0 then vel = vel + Config.CORRER_PLUS end
	local tope = Config.VEL_MAX
	if (r.velAdmin or 1) &gt; 1 then -- multiplicador del panel admin (testeo)
		vel = vel * r.velAdmin
		tope = 150
	end
	hum.WalkSpeed = math.min(vel, tope)
	hum.UseJumpPower = true
	local salto = 50
	if r.equip.jump and (perfiles[plr].coils.jump or r.jumpUntil &gt; ahora) then
		salto = salto + Config.SALTO_COIL
	end
	if r.saltoAdmin then salto = 130 end
	hum.JumpPower = salto
end

-- ─── CORRER (sprint): stamina server-authoritative ─────────
-- El cliente pide on/off; el server lleva SU propia stamina con la misma
-- matemática que el cliente (drena 1/s corriendo, regen CORRER_REGEN/s):
-- nadie puede correr más de CORRER_MAX seguidos aunque hackee el cliente.
local function actualizarStamina(plr)
	local r = rt[plr]
	if not r then return end
	local ahora = os.clock()
	local dt = ahora - (r.staminaT or ahora)
	r.staminaT = ahora
	if r.correr then
		r.stamina = r.stamina - dt
		if r.stamina &lt;= 0 then
			r.stamina = 0
			r.correr = false
			aplicarStats(plr)
		end
	elseif r.stamina &lt; Config.CORRER_MAX then
		r.stamina = math.min(Config.CORRER_MAX,
			r.stamina + dt * Config.CORRER_REGEN)
	end
end

RE.Correr.OnServerEvent:Connect(function(plr, on)
	if not limitar(plr, "correr", 10) then return end
	local r = rt[plr]
	if not r then return end
	actualizarStamina(plr)
	r.correr = (on and true or false) and r.stamina &gt; 0.2
	aplicarStats(plr)
end)

-- ─── Visual de coils / alfombra en el personaje ────────────
local function limpiarGear(char)
	for _, n in ipairs({"VisualSpeedCoil", "VisualJumpCoil", "VisualCarpet"}) do
		local v = char:FindFirstChild(n)
		if v then v:Destroy() end
	end
end

local function visualCoil(char, nombre, color)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local p = Instance.new("Part")
	p.Name = nombre
	p.Size = Vector3.new(0.6, 2.6, 0.6)
	p.Color = color
	p.Material = Enum.Material.Neon
	p.CanCollide = false
	p.Massless = true
	local w = Instance.new("Weld")
	w.Part0 = root
	w.Part1 = p
	w.C0 = CFrame.new(0, 0.4, 0.9) * CFrame.Angles(0, 0, math.rad(14))
	w.Parent = p
	p.Parent = char
end

-- Gravity Coil EN LA MANO (mesh real de la Toolbox, id 4698264808): el resorte
-- enrollado en la mano derecha como el gear clásico de Roblox, no en la espalda
local function visualCoilMano(char, nombre, color)
	local mano = char:FindFirstChild("RightHand")          -- R15
		or char:FindFirstChild("Right Arm")                 -- R6
		or char:FindFirstChild("HumanoidRootPart")
	if not mano then return end
	local p = Instance.new("Part")
	p.Name = nombre
	p.Size = Vector3.new(1, 1, 1)
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://4698264808"
	mesh.Parent = p
	local w = Instance.new("Weld")
	w.Part0 = mano
	w.Part1 = p
	-- el mesh viene acostado (eje X): girado 90° queda VERTICAL, agarrado
	-- por arriba con el resorte colgando bajo la mano
	w.C0 = CFrame.new(0, -0.7, 0) * CFrame.Angles(0, 0, math.rad(90))
	w.Parent = p
	p.Parent = char
end

-- ═══ SKINS DE MANZANA 🍎 ═══════════════════════════════════
-- Antes esto eran SEIS funciones de 28 líneas que solo se diferenciaban en la
-- textura, más cinco handlers de pad de 35 líneas que repetían cada uno el mismo
-- bloque de "quítale las otras cinco": ~315 líneas para lo que en realidad es una
-- tabla (Config.SKINS) y estas cuatro funciones.
--
-- La Part de la cabeza ahora se llama "Skin_&lt;id&gt;" en vez de "MorphRosa",
-- "MorphAzul"... Es seguro renombrarlas: nada más en el juego busca esos nombres
-- (ponerInvisible, que es lo único que recorre el personaje, va por clase y no
-- por nombre).

-- ✨ ESTELA: rastro de color detrás del jugador + chispas sobre la manzana, para
-- las skins que declaran `estela` en Config. Va por DATOS y no por un `if id ==
-- "galaxia"`, así que darle efecto a la dorada o a la negra es añadir tres
-- colores a su fila y nada más.
-- Mismo sitio y misma forma de limpiar que el aura de donador (AuraDona): todo
-- cuelga del HumanoidRootPart y se destruye por nombre.
-- ⚠️ LA ESTELA AL CAMINAR SE QUITÓ (30 jul 2026, a petición del usuario). Era un
-- Trail entre dos attachments del HumanoidRootPart. Los dos efectos que quedan
-- van los DOS en la cabeza: el halo de galaxia y las chispas blancas.
local BRILLO_PIEZAS = {"SkinHalo", "SkinChispas", "SkinContorno", "SkinEstela"}

local function quitarEfectos(char)
	if not char then return end
	for _, n in ipairs(BRILLO_PIEZAS) do
		local o = char:FindFirstChild(n)
		if o then o:Destroy() end
	end
	-- ⚠️ Los anclajes de la estela viven en el TORSO, no colgando de char, así que
	-- el bucle de arriba no los ve. Y como el torso NO se destruye al quitarse la
	-- skin (a diferencia de la manzana), sin esto se quedarían pegados para siempre
	-- y al reequipar se irían acumulando.
	local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if t then
		for _, n in ipairs({"SkinEstelaA", "SkinEstelaB"}) do
			local a = t:FindFirstChild(n)
			if a then a:Destroy() end
		end
	end
end

-- ✨ BRILLO: aura de color sobre la manzana + una luz que tiñe al personaje y lo
-- que tiene alrededor. El halo es OTRA COPIA DEL MISMO MESH, un poco más grande,
-- en NEON y semitransparente: así el resplandor sigue exactamente la silueta de
-- la manzana. Es el mismo truco del contorno blanco de la skin de misterio.
local function ponerBrillo(char, s, cabeza)
	local b = s and s.brillo
	local head = char and char:FindFirstChild("Head")
	if not b or not head then return end
	-- 🌑 EL AURA ES OPCIONAL: solo se pone si la skin trae `color`.
	-- ⚠️ El aura NO ilumina la manzana, la TAPA: es una copia del mesh un 9-13% más
	-- grande puesta encima. En la dorada y la galaxia eso funciona porque el aura es
	-- del mismo tono que la manzana y se lee como resplandor; en la NEGRA, con un
	-- aura casi blanca, lo que se veía era una bola blanca y la manzana desaparecía
	-- (30 jul 2026). Por eso la negra no lleva `color`: se queda solo con chispas.
	-- La luz va dentro de este bloque a propósito: sin aura tampoco hay PointLight,
	-- que era la otra mitad de lo que emblanquecía al personaje.
	if b.color then
		local col = Color3.fromRGB(b.color[1], b.color[2], b.color[3])
		local p = Instance.new("Part")
		p.Name = BRILLO_PIEZAS[1]
		p.Size = Vector3.new(1, 1, 1)
		p.Color = col
		p.Material = Enum.Material.Neon      -- ignora la luz: el aura brilla sola
		p.Transparency = b.halo or 0.75
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		p.Massless = true
		p.CastShadow = false
		p:SetAttribute("TranspFija", true)   -- el aura conserva SU transparencia
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.FileMesh
		m.MeshId = Config.GUSANO_MESH_ID
		local e = (2.4 / 50) * (b.escala or 1.12)
		m.Scale = Vector3.new(e, e, e)
		m.Parent = p
		local w = Instance.new("Weld")
		w.Part0, w.Part1 = head, p
		w.C0 = CFrame.new(0, 0.4, 0)         -- mismo sitio que la manzana
		w.Parent = p
		local luz = Instance.new("PointLight")
		luz.Name = "SkinLuz"          -- con nombre: el culling del cliente la busca
		luz.Color = col
		luz.Brightness = b.luz or 1.6
		luz.Range = b.alcance or 10
		luz.Shadows = false                  -- sombras dinámicas por jugador: caro
		luz.Parent = p                -- cuelga del HALO, no de la manzana
		p.Parent = char
	end
	-- 🌗 CONTORNO: la forma CORRECTA de ponerle aura a una skin oscura.
	-- El aura de arriba es GEOMETRÍA encima (una copia del mesh más grande), y por
	-- eso tapaba la manzana negra. Un Highlight no añade geometría: Roblox lo pinta
	-- como un borde que sigue la silueta de lo que ya se dibuja, así que la manzana
	-- —textura, ojos y todo— se sigue viendo entera y solo se le añade el filo.
	--   color   = color del borde
	--   transp  = 0 borde macizo · 1 invisible
	--   relleno = transparencia del RELLENO; 1 = ninguno (deja la manzana intacta).
	--             Bajarlo tiñe la manzana entera, que es justo lo que NO queremos
	--             en la negra, pero puede servir para otra skin.
	-- 🌑 ESTELA: la cinta que deja al moverse. Va en la ESPALDA (31 jul 2026), como
	-- una capa; antes salía de la manzana y parecía que se le escapaba humo de la
	-- cabeza. Nace de dos Attachment en el torso, separados en vertical para que la
	-- cinta tenga altura, y empujados hacia atrás.
	-- ⚠️ La espalda es +Z. El personaje mira hacia -Z (por eso los maniquíes se
	-- colocan con mira = (0,0,-1) y la carita de la manzana apunta a -Z).
	-- ⚠️ R15 usa UpperTorso y R6 usa Torso; los dos miden 1 stud de fondo, así que
	-- el mismo desplazamiento de 0,55 sirve para ambos.
	-- ⚠️ El Trail cuelga del CHAR, no del torso, para que el culling del cliente lo
	-- encuentre con un FindFirstChild directo en vez de una búsqueda recursiva por
	-- jugador. Los Attachment sí van en el torso, y los borra quitarEfectos.
	-- ⚠️ LightInfluence = 0: sin esto la luz del mapa aclara el negro y la estela
	-- se vuelve gris. A 0 el color se usa tal cual y el negro es negro de verdad.
	local es = b.estela
	local torso = char and (char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso"))
	if es and torso then
		local w, dz = es.ancho or 0.9, es.atras or 0.55
		local a0 = Instance.new("Attachment")
		a0.Name, a0.Position, a0.Parent = "SkinEstelaA", Vector3.new(0, w, dz), torso
		local a1 = Instance.new("Attachment")
		a1.Name, a1.Position, a1.Parent = "SkinEstelaB", Vector3.new(0, -w, dz), torso
		local tr = Instance.new("Trail")
		tr.Name = "SkinEstela"
		tr.Attachment0, tr.Attachment1 = a0, a1
		local ks = {}
		for i, c in ipairs(es.colores) do
			ks[i] = ColorSequenceKeypoint.new(c[4] or ((i - 1) / (#es.colores - 1)),
				Color3.fromRGB(c[1], c[2], c[3]))
		end
		tr.Color = ColorSequence.new(ks)
		-- opaca al nacer y desvanecida en la cola
		tr.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, es.transp or 0.1),
			NumberSequenceKeypoint.new(0.55, (es.transp or 0.1) + 0.25),
			NumberSequenceKeypoint.new(1, 1)})
		-- se afila hacia la cola: una cinta de ancho constante parece una tabla
		tr.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.6, 0.55),
			NumberSequenceKeypoint.new(1, 0.08)})
		tr.Lifetime = es.vida or 0.85
		tr.LightInfluence = 0
		tr.FaceCamera = true         -- siempre de canto a la cámara
		tr.MinLength = 0.05
		tr.Parent = char
	end
	local ct = b.contorno
	if ct and cabeza then
		local hl = Instance.new("Highlight")
		hl.Name = "SkinContorno"
		hl.Adornee = cabeza           -- la manzana; el Highlight cuelga del char
		hl.FillTransparency = ct.relleno or 1
		hl.FillColor = Color3.fromRGB(ct.color[1], ct.color[2], ct.color[3])
		hl.OutlineColor = Color3.fromRGB(ct.color[1], ct.color[2], ct.color[3])
		hl.OutlineTransparency = ct.transp or 0
		-- ⚠️ Occluded, NO el AlwaysOnTop que trae por defecto. El marcado rojo de los
		-- gusanos sí lo deja por defecto porque interesa verlo A TRAVÉS DE PAREDES;
		-- un cosmético que se viera desde el otro lado de la torre sería absurdo.
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = char
	end
	-- ✨ SEGUNDO EFECTO: chispas BLANCAS flotando ALREDEDOR de la manzana.
	--
	-- ⚠️ POR QUÉ HACE FALTA UNA PIEZA APARTE (corregido 30 jul 2026): un
	-- ParticleEmitter reparte las partículas dentro del VOLUMEN DE SU PIEZA, y la
	-- de la skin mide 1x1x1 mientras que la manzana mide 2,4 studs (el tamaño lo
	-- pone la escala del mesh, no la Part). O sea que TODAS las chispas nacían
	-- dentro de la manzana y quedaban tapadas. Empujarlas con velocidad tampoco
	-- servía: con vel 1,6 y arrastre 8 recorrían 1,6/8 = 0,2 studs y morían dentro.
	--
	-- La solución es una pieza INVISIBLE del tamaño de la manzana y emitir desde
	-- la SUPERFICIE de su esfera: nacen ya fuera, justo sobre la cáscara.
	local ch = b.chispas
	if ch then
		local r = ch.radio or 1.45
		local caja = Instance.new("Part")
		caja.Name = "SkinChispas"
		caja.Size = Vector3.new(r * 2, r * 2, r * 2)
		caja.Transparency = 1
		caja.CanCollide, caja.CanQuery, caja.CanTouch = false, false, false
		caja.Massless = true
		caja.CastShadow = false
		-- ⚠️ ESTA MARCA ES OBLIGATORIA. Es un cubo de 2,9 studs que solo existe
		-- para emitir; se ve porque la transparencia es 1. ponerInvisible recorre
		-- TODAS las piezas del personaje y les fuerza la transparencia, así que
		-- sin esto al usar el pase Invisible aparecía un cubo gris en la cabeza
		-- —y al quitarlo se quedaba OPACO— (bug encontrado el 30 jul 2026).
		caja:SetAttribute("TranspFija", true)
		local wc = Instance.new("Weld")
		wc.Part0, wc.Part1 = head, caja
		wc.C0 = CFrame.new(0, 0.4, 0)          -- centrada en la manzana
		wc.Parent = caja
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "SkinChispas"
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(ch.color[1], ch.color[2], ch.color[3]))
		pe.LightEmission = 1
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, ch.tam or 0.35),
			NumberSequenceKeypoint.new(1, 0)})
		pe.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.05),
			NumberSequenceKeypoint.new(1, 1)})
		pe.Rate = ch.rate or 21
		pe.Lifetime = NumberRange.new(1.1, 1.9)
		pe.Speed = NumberRange.new(0.3, 1.0)   -- salen despacio: ya nacen fuera
		pe.Acceleration = Vector3.new(0, 0.9, 0)
		pe.Rotation = NumberRange.new(0, 360)
		pe.RotSpeed = NumberRange.new(-45, 45)
		pe.SpreadAngle = Vector2.new(35, 35)
		-- emitir desde la SUPERFICIE de la esfera y hacia FUERA. En pcall porque
		-- son propiedades relativamente nuevas; si el motor no las tiene, el
		-- emisor sigue funcionando repartiendo por el volumen de la caja, que ya
		-- es del tamaño de la manzana y sigue siendo mucho mejor que 1x1x1.
		pcall(function()
			pe.Shape = Enum.ParticleEmitterShape.Sphere
			pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			pe.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		end)
		pe.Parent = caja
		caja.Parent = char
	end
end

-- Se lleva UNA a la vez: todas se sueldan a la cabeza.
local function quitarSkin(char)
	if not char then return end
	quitarEfectos(char)
	for _, s in ipairs(Config.SKINS) do
		local p = char:FindFirstChild("Skin_" .. s.id)
		if p then p:Destroy() end
	end
end

local function ponerSkin(char, id)
	local s = Config.SKIN_POR_ID[id]
	if not s or not char then return end
	local head = char:FindFirstChild("Head")
	if not head or char:FindFirstChild("Skin_" .. id) then return end
	quitarSkin(char)
	local p = Instance.new("Part")
	p.Name = "Skin_" .. id
	p.Size = Vector3.new(1, 1, 1)
	p.Color = Color3.fromRGB(s.color[1], s.color[2], s.color[3])  -- si la textura no carga
	p.CanCollide = false
	p.Massless = true
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.FileMesh
	m.MeshId = Config.GUSANO_MESH_ID
	local tex = s.textura or ""
	if tex ~= "" and not tex:match("//0$") then m.TextureId = tex end
	local esc = 2.4 / 50           -- manzana de ~2.4 studs (cubre la cabeza justo)
	m.Scale = Vector3.new(esc, esc, esc)
	m.Parent = p
	local w = Instance.new("Weld")
	w.Part0 = head
	w.Part1 = p
	w.C0 = CFrame.new(0, 0.4, 0)   -- centrada sobre la cabeza, carita al frente
	w.Parent = p
	p.Parent = char
	ponerBrillo(char, s, p)
end

-- Qué skin da cada pad del mapa.
local SKIN_DE_PAD = {
	MorphPad = "verde",            -- lobby: la manzana clásica
	MorphPadRosa = "rosa",         -- lobby
	MorphPadVerde = "comunidad",   -- casita de la comunidad. El NOMBRE es histórico:
	                               -- ese pad da la ARCOÍRIS, no la verde.
	ManiquiPadAzul = "azul",       -- azotea, junto al cofre
	-- ⚠️ ManiquiPadGalaxia se quitó el 31 jul 2026 junto con su maniquí. La skin
	-- "galaxia" sigue existiendo en Config y quien ya la tenía la conserva, pero
	-- YA NO HAY FORMA DE CONSEGUIRLA: es `oculta`, así que tampoco sale en el menú.
}

-- Cuántas veces ha completado la torre, para los requisitos "torre".
-- ⚠️ LLEGAR A LA AZOTEA YA CUENTA COMO UNA, aunque no haya reclamado el cofre.
-- perfil.trofeos solo sube al reclamarlo, y el maniquí azul está EN la azotea a
-- dos pasos del cofre: sin esto, quien pisara su pad en los segundos que van de
-- llegar arriba a darle a Claim se encontraría la skin bloqueada estando
-- literalmente encima de ella.
local function vecesCompletadas(pf)
	if not pf then return 0 end
	local n = pf.trofeos or 0
	if (pf.pisoMax or 0) &gt; Config.N_PISOS and n &lt; 1 then n = 1 end
	return n
end

-- ⚠️ EL DESBLOQUEO SE DECIDE AQUÍ Y SOLO AQUÍ. El cliente calcula lo mismo para
-- pintar los candados del menú, pero eso es decoración: un cliente trucado que
-- pida la dorada sin haber subido la torre choca contra esta función.
local function skinDesbloqueada(plr, s)
	if not s then return false end
	-- 🧪 atajo SOLO DE STUDIO para probar las skins sin subir la torre 10 o 25
	-- veces. ES_STUDIO es false en el juego publicado, así que allí esta línea no
	-- existe y los requisitos de abajo se aplican enteros.
	if ES_STUDIO and Config.SKINS_LIBRES_STUDIO then return true end
	if s.req == "comunidad" then
		return plr:GetAttribute("EnComunidad") == true
	elseif s.req == "torre" then
		return vecesCompletadas(perfiles[plr]) &gt;= (s.veces or 1)
	elseif s.req == "pase" then
		-- r.pases es la tabla que ya usan el resto de los pases; incluye tanto los
		-- comprados de verdad como los REGALOS de Config.REGALOS, porque los gears
		-- del perfil se vuelcan ahí al entrar.
		local r = rt[plr]
		return (r and r.pases and r.pases[s.pase]) == true
	end
	return true
end

if ES_STUDIO and Config.SKINS_LIBRES_STUDIO then
	warn("🍎 SKINS_LIBRES_STUDIO = true → todas las skins desbloqueadas. "
		.. "Esto SOLO pasa en Studio; al publicar vuelven sus requisitos solos.")
end

-- Devuelve true si algo cambió. `alterna` = pisar el pad de una skin que YA
-- llevas puesta te la quita, que es como se han portado siempre los pads.
local function equiparSkin(plr, id, alterna)
	local r, pf = rt[plr], perfiles[plr]
	if not r or not pf then return false end
	local char = plr.Character
	if not char then return false end
	if id and r.skin == id and alterna then id = nil end
	if id then
		local s = Config.SKIN_POR_ID[id]
		if not s then return false end
		if not skinDesbloqueada(plr, s) then
			toast(plr, s.req == "comunidad" and "comuNo" or "skinBloq")
			return false
		end
		ponerSkin(char, id)
	else
		quitarSkin(char)
	end
	r.skin = id
	pf.skin = id or false   -- ⚠️ la skin puesta SOBREVIVE a cerrar el juego. Antes
	                        -- los morphs vivían solo en rt (la sesión), así que al
	                        -- volver a entrar todo el mundo aparecía sin manzana.
	marcar(plr)
	return true
end

-- 🍎 MENÚ DE SKINS: el cliente pide equipar (id) o quitar (nil). No hace falta
-- mandarle qué tiene desbloqueado: lo calcula solo con trofeos/pisoMax y el
-- atributo EnComunidad, que ya viajan en el Sync. Aquí solo se valida.
RE.Skin.OnServerEvent:Connect(function(plr, id)
	if not limitar(plr, "skin", 4) then return end
	if id ~= nil and type(id) ~= "string" then return end
	if id and not Config.SKIN_POR_ID[id] then return end
	if equiparSkin(plr, id, false) then
		RE.FX:FireClient(plr, "morphOn")
	end
end)

-- Alfombra voladora = mesh REAL de la Toolbox ("FlyingCarpet"): un Part plano con
-- SpecialMesh (MeshId + textura del patrón), soldado bajo los pies al volar.
local function visualCarpet(char)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local p = Instance.new("Part")
	p.Name = "VisualCarpet"
	p.Size = Vector3.new(3, 0.5, 6.5)
	p.Color = Color3.new(1, 1, 1)          -- blanco: la textura muestra sus colores
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = Config.CARPET_MESH_ID
	if Config.CARPET_TEXTURE_ID and not Config.CARPET_TEXTURE_ID:match("//0$") then
		mesh.TextureId = Config.CARPET_TEXTURE_ID
	end
	local e = Config.CARPET_ESCALA or 1
	mesh.Scale = Vector3.new(e, e, e)
	mesh.Parent = p
	local w = Instance.new("Weld")
	w.Part0 = root
	w.Part1 = p
	w.C0 = CFrame.new(0, Config.CARPET_OFFSET_Y or -3.1, 0)  -- bajo los pies
	w.Parent = p
	-- ✨ EFECTOS: estela ARCOÍRIS detrás + chispas de colores + brillo (llamativa)
	local RB = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 45, 45)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 170, 40)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 240, 60)),
		ColorSequenceKeypoint.new(0.7, Color3.fromRGB(70, 230, 100)),
		ColorSequenceKeypoint.new(0.85, Color3.fromRGB(60, 140, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 70, 255)),
	})
	local a0 = Instance.new("Attachment")     -- esquina trasera izquierda
	a0.Position = Vector3.new(-1.4, 0, 3)
	a0.Parent = p
	local a1 = Instance.new("Attachment")     -- esquina trasera derecha
	a1.Position = Vector3.new(1.4, 0, 3)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = RB
	trail.Lifetime = 2.6          -- estela LARGA: el rastro tarda en desvanecerse
	trail.LightEmission = 1
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.7, 0.35),
		NumberSequenceKeypoint.new(1, 1)})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.4)})
	trail.Parent = p
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Chispas"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = RB
	pe.LightEmission = 1
	pe.Rate = 26
	pe.Lifetime = NumberRange.new(0.5, 1)
	pe.Speed = NumberRange.new(1, 4)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(1, 0.1)})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(0.4, 0),
		NumberSequenceKeypoint.new(1, 1)})
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = p
	local light = Instance.new("PointLight")   -- brillo suave bajo la alfombra
	light.Color = Color3.fromRGB(150, 130, 255)
	light.Brightness = 2.5
	light.Range = 14
	light.Parent = p
	p.Parent = char
end

local function refrescarGear(plr)
	local r = rt[plr]
	local char = plr.Character
	if not r or not char then return end
	limpiarGear(char)
	local ahora = os.clock()
	-- (Speed Coil: sin visual del server — su Tool ahora tiene Handle con el
	--  mesh del resorte rojo enrollado en el brazo, igual que el Gravity)
	-- (Gravity Coil: sin visual del server — el Tool ahora tiene Handle con el
	--  mesh del resorte, Roblox lo pone en la mano y levanta el brazo solo)
	-- 🕊 alfombra VISIBLE solo si el vuelo es SUYO (pase o premio de ruleta). Si
	-- vuela prestado por el God Mode va A PELO — salvo que se pida lo contrario
	-- con Config.GOD_VUELO_ALFOMBRA.
	if r.equip.carpet then
		local propia = r.pases.carpet or r.flyUntil &gt; ahora
		local porDios = Config.GOD_VUELO and r.godUntil &gt; ahora
		if propia or (porDios and Config.GOD_VUELO_ALFOMBRA) then
			visualCarpet(char)
		end
	end
	aplicarStats(plr)
end

-- ─── ZONAS SEGURAS ─────────────────────────────────────────
local zonasSeguras = {} -- {cf, mitad}
for _, d in ipairs(Mapa:GetDescendants()) do
	if d.Name == "SafeZoneVol" and d:IsA("BasePart") then
		table.insert(zonasSeguras, {cf = d.CFrame, mitad = d.Size / 2 + Vector3.new(1, 1, 1)})
	end
end
print("[RainbowApple] zonas seguras:", #zonasSeguras)

local function enZonaSegura(pos)
	for _, z in ipairs(zonasSeguras) do
		local o = z.cf:PointToObjectSpace(pos)
		if math.abs(o.X) &lt;= z.mitad.X and math.abs(o.Y) &lt;= z.mitad.Y
			and math.abs(o.Z) &lt;= z.mitad.Z then
			return true
		end
	end
	return false
end

-- ─── GUSANOS: setup ────────────────────────────────────────
-- El gusano se ARRASTRA por la escalera: su ruta son waypoints que siguen
-- los 4 tramos de la espiral (con esquinas) de TODO SU TERRITORIO: su piso
-- y el siguiente (2 vueltas completas de espiral, una ruta continua).
-- Patrulla en ping-pong y también PERSIGUE por esta misma ruta.
-- cubre = cuántos pisos patrulla ESTE gusano (3 en los 9 primeros, 2 arriba).
-- Antes era el global Config.GUSANO_CADA para todos.
local function rutaGusano(f, cubre)
	local fija = HALFC - 0.3 - Config.ANCHO_ESCALERA / 2
	local hover = Config.GUSANO_ALTURA_VUELO
	local sube = Config.ALTURA_PISO / 4
	local runs = {
		{eje = "z", fijo = fija, de = -EXTC, a = EXTC},
		{eje = "x", fijo = fija, de = EXTC, a = -EXTC},
		{eje = "z", fijo = -fija, de = EXTC, a = -EXTC},
		{eje = "x", fijo = -fija, de = -EXTC, a = EXTC},
	}
	local esquinas = {
		Vector3.new(ESQC, 0, ESQC), Vector3.new(-ESQC, 0, ESQC),
		Vector3.new(-ESQC, 0, -ESQC),
	}
	local wps = {}
	for piso = f, math.min(f + (cubre or 2) - 1, NP) do
		local yl = Config.yLosa(piso)
		for r, run in ipairs(runs) do
			local y0 = yl + (r - 1) * sube + hover
			for i = 0, 9 do
				local t = run.de + (run.a - run.de) * i / 9
				local y = y0 + sube * i / 9
				if run.eje == "z" then
					table.insert(wps, Vector3.new(run.fijo, y, t))
				else
					table.insert(wps, Vector3.new(t, y, run.fijo))
				end
			end
			if r &lt; 4 then
				local e = esquinas[r]
				table.insert(wps, Vector3.new(e.X, yl + sube * r + hover, e.Z))
			end
		end
	end
	return wps
end

local function wpMasCercano(g, pos)
	local mejor, mejorDist = 1, math.huge
	for i, wp in ipairs(g.wps) do
		local d = (wp - pos).Magnitude
		if d &lt; mejorDist then mejor, mejorDist = i, d end
	end
	return mejor
end

-- ⚡ radio a partir del cual se considera que NADIE ve al gusano y puede moverse
-- a 5 Hz. 200 studs = 5 pisos de 40; los pisos son opacos, así que a esa
-- distancia es imposible verlo. Es GENEROSO a propósito: más vale gastar de
-- más en un gusano que quizá se ve, que ver uno moverse a tirones.
local GUSANO_VISTA2 = 200 * 200
local gusanos = {}
-- ⚡ 2026-07-25: antes recorría TODOS los pisos buscando un modelo "Gusano".
-- Ahora la lista sale de Config.gusanos(), la MISMA que usa build_rbxlx.py para
-- colocarlos, así que server y mapa no se pueden desincronizar.
for _, gDef in ipairs(Config.gusanos()) do
	local f, cubre = gDef.piso, gDef.cubre
	local pisoM = TorreF:WaitForChild("Piso_" .. f)
	local gM = pisoM:FindFirstChild("Gusano")
	if gM then
		local cabeza = gM:FindFirstChild("Cabeza")
		local segs = {}
		for i = 1, Config.GUSANO_SEGMENTOS do
			segs[i] = gM:FindFirstChild("Seg" .. i)
		end
		local yLosa = Config.yLosa(f)
		local wps = rutaGusano(f, cubre)
		local pos0 = wps[1]
		local posSegs = {}
		for i = 1, #segs do
			posSegs[i] = pos0 - Vector3.new(0, 0,
				(Config.GUSANO_ESPACIO_CABEZA or Config.GUSANO_ESPACIO)
				+ (i - 1) * Config.GUSANO_ESPACIO)
		end
		-- vigila EXACTAMENTE los pisos que patrulla (cubre), ni uno más.
		-- ⚠️ BUG ARREGLADO 2026-07-25: esto estaba fijo en "2 * ALTURA_PISO"
		-- mientras la ruta ya usaba el espaciado configurable. Con gusanos que
		-- cubren 3 pisos, el bicho patrullaba 3 pero solo podía matar en 2: el
		-- tercer piso tenía un gusano paseándose que no te podía tocar.
		-- La azotea queda siempre fuera de su alcance.
		local alto = math.min(cubre * Config.ALTURA_PISO,
			Config.yTecho() - 2 - yLosa)
		table.insert(gusanos, {
			f = f, cfg = Config.PISOS[f], cabeza = cabeza, segs = segs,
			yLosa = yLosa, alto = alto, wps = wps, idx = 2, dir = 1,
			pos = pos0, posSegs = posSegs, mira = Vector3.new(0, 0, -1),
			estado = "patrulla", objetivo = nil, cazaIdx = nil,
		})
	end
end
print("[RainbowApple] gusanos activos:", #gusanos)

-- highlight rojo con contorno blanco al ser detectado
local function ponerMarca(char)
	if char:FindFirstChild("WormVisto") then return end
	local h = Instance.new("Highlight")
	h.Name = "WormVisto"
	h.FillColor = Color3.fromRGB(255, 30, 30)
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.FillTransparency = 0.35
	h.OutlineTransparency = 0
	h.Parent = char
end

local function quitarMarca(char)
	local h = char and char:FindFirstChild("WormVisto")
	if h then h:Destroy() end
end

local function esCazable(plr, g)
	local r = rt[plr]
	if not r then return nil end
	-- (sin gate del botón/checkpoint: dependía de PISARLO y si lo esquivabas
	--  eras invisible para siempre. El check de los PIES de abajo ya evita que
	--  te cacen mientras subes las escaleras por debajo del piso.)
	if r.invisible or r.godUntil &gt; os.clock() then return nil end
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health &lt;= 0 then return nil end
	local y = root.Position.Y
	-- solo te detecta cuando tus PIES ya están sobre la plataforma de su piso (o
	-- arriba), no mientras subes las escaleras por debajo. Uso la posición real de
	-- los pies (root − HipHeight − medio root) para que sea igual en cualquier avatar
	local pies = y - (hum.HipHeight or 2) - root.Size.Y / 2
	if pies &lt; g.yLosa - 0.3 or y &gt; g.yLosa + g.alto - 1 then return nil end
	-- FUERA de la torre (p.ej. volando pegado a los muros) = NO cazable: los
	-- gusanos solo matan DENTRO. Así, aunque asomen un poco por la pared, no
	-- pegan a los que están afuera en el parkour.
	local pos = root.Position
	if math.abs(pos.X) &gt; HALFC or math.abs(pos.Z) &gt; HALFC then return nil end
	if enZonaSegura(pos) then return nil end
	return root
end

local function soltarObjetivo(g, motivo)
	local plr = g.objetivo
	g.objetivo = nil
	g.estado = "patrulla"
	g.cazaIdx = nil
	-- volver al waypoint de la escalera más cercano
	g.idx = wpMasCercano(g, g.pos)
	if plr and plr.Parent then
		quitarMarca(plr.Character)
		RE.Detectado:FireClient(plr, false, g.cfg.gusano)
		-- (sin toast "safe": el usuario quitó ese aviso de zona segura)
	end
end

-- escaneo de jugadores — MÁS CERCANO SIEMPRE (cambiado 2026-07-19 a pedido
-- del usuario; antes había FIJACIÓN hasta matar/perder): 1) patrulla; 2) al
-- detectar elige al MÁS CERCANO cazable del radio; 3) durante la cacería
-- RE-EVALÚA: si otro jugador cazable está claramente más cerca (5 studs o
-- 20% menos de distancia — histéresis para no parpadear entre dos presas
-- igual de cerca), CAMBIA de objetivo en caliente; 4) tras matar/perder,
-- el siguiente escaneo (0.25 s) re-adquiere al más cercano del radio.
task.spawn(function()
	while true do
		task.wait(Config.SCAN_CADA)
		-- ⚡ ¿ALGUIEN VE A ESTE GUSANO? (2026-07-25) Marca g.cerca si hay algún
		-- jugador dentro del radio de visión. Los que NO lo tienen se mueven a
		-- 5 Hz en vez de 60 (ver el loop de movimiento): nadie los ve, los pisos
		-- son opacos. Se calcula aquí (4 veces/s) y no en el loop de movimiento
		-- para no pagar gusanos×jugadores 60 veces por segundo.
		local jugadores = Players:GetPlayers()
		for _, g in ipairs(gusanos) do
			local visto = false
			for _, plr in ipairs(jugadores) do
				local char = plr.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local p = root.Position
					local dx, dy, dz = p.X - g.pos.X, p.Y - g.pos.Y, p.Z - g.pos.Z
					if dx * dx + dy * dy + dz * dz &lt; GUSANO_VISTA2 then
						visto = true
						break
					end
				end
			end
			g.cerca = visto
		end
		for _, g in ipairs(gusanos) do
			if g.estado == "patrulla" then
				local mejor, mejorDist = nil, g.cfg.radio
				for _, plr in ipairs(Players:GetPlayers()) do
					local root = esCazable(plr, g)
					if root then
						local d = (root.Position - g.pos).Magnitude
						if d &lt; mejorDist then mejor, mejorDist = plr, d end
					end
				end
				if mejor then
					g.estado = "caza"
					g.objetivo = mejor
					local root = mejor.Character
						and mejor.Character:FindFirstChild("HumanoidRootPart")
					g.cazaIdx = root and wpMasCercano(g, root.Position) or g.idx
					ponerMarca(mejor.Character)
					RE.Detectado:FireClient(mejor, true, g.cfg.gusano)
				end
			else
				local plr = g.objetivo
				if not (plr and plr.Parent) then
					soltarObjetivo(g)
				else
					local cazable = esCazable(plr, g)
					if not cazable then
						local root = plr.Character
							and plr.Character:FindFirstChild("HumanoidRootPart")
						local motivo = root and enZonaSegura(root.Position)
							and "safe" or nil
						soltarObjetivo(g, motivo)
					elseif (cazable.Position - g.pos).Magnitude &gt;
						g.cfg.radio + Config.GUSANO_PIERDE_DIST then
						soltarObjetivo(g)
					else
						-- refrescar hacia qué punto de la escalera perseguir
						g.cazaIdx = wpMasCercano(g, cazable.Position)
						-- ¿hay OTRO jugador MÁS CERCA? → cambiar. Reglas:
						-- (a) debe estar DENTRO de la zona de visión (radio):
						--     nadie fuera de ella entra a la cacería jamás;
						-- (b) basta con estar 3 studs más cerca que la presa
						--     actual (margen mínimo anti-parpadeo).
						local dAct = (cazable.Position - g.pos).Magnitude
						local mejor = nil
						local mejorDist = dAct - 3
						for _, otro in ipairs(Players:GetPlayers()) do
							if otro ~= plr then
								local rootO = esCazable(otro, g)
								if rootO then
									local dO = (rootO.Position - g.pos).Magnitude
									if dO &lt; mejorDist and dO &lt;= g.cfg.radio then
										mejor, mejorDist = otro, dO
									end
								end
							end
						end
						if mejor then
							-- cambio EN CALIENTE (sin pausa de patrulla)
							quitarMarca(plr.Character)
							RE.Detectado:FireClient(plr, false, g.cfg.gusano)
							g.objetivo = mejor
							local rootM = mejor.Character
								and mejor.Character:FindFirstChild("HumanoidRootPart")
							g.cazaIdx = rootM and wpMasCercano(g, rootM.Position)
								or g.idx
							ponerMarca(mejor.Character)
							RE.Detectado:FireClient(mejor, true, g.cfg.gusano)
						end
					end
				end
			end
		end
	end
end)

-- movimiento: 60 Hz los que alguien ve, 5 Hz los lejanos (ver g.cerca)
local acumG = 0
RunService.Heartbeat:Connect(function(dt)
	acumG = acumG + dt
	if acumG &lt; 1 / 60 then return end   -- 60 Hz (antes 30): movimiento más fluido
	local paso = acumG
	acumG = 0
	for _, g in ipairs(gusanos) do
		-- ⚡ GUSANO QUE NADIE VE → 5 Hz (2026-07-25). Mover sus 7 partes 60 veces
		-- por segundo se replicaba a los 50 clientes aunque estuviera 20 pisos
		-- abajo. Al acumular el tiempo en pasoG, avanza EXACTAMENTE lo mismo por
		-- segundo: la ruta y las distancias no cambian, solo da pasos más largos.
		-- ⚠️ Un gusano CAZANDO nunca se ralentiza: su presa está pegada a él y la
		-- mordida vive en esa misma rama.
		local pasoG = paso
		if g.estado ~= "caza" and not g.cerca then
			g.acumLejos = (g.acumLejos or 0) + paso
			if g.acumLejos &lt; 0.2 then continue end   -- 0.2 s = 5 Hz
			pasoG = g.acumLejos
			g.acumLejos = 0
		else
			g.acumLejos = 0
		end
		if g.estado == "caza" and g.objetivo then
			local char = g.objetivo.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
				local dJugador = (root.Position - g.pos).Magnitude
				if dJugador &lt; Config.GUSANO_EMBESTIDA then
					-- ya lo tiene al lado: embestida directa
					local dir = root.Position + Vector3.new(0, 2, 0) - g.pos
					if dir.Magnitude &gt; 0.1 then
						g.pos = g.pos + dir.Unit
							* math.min(g.cfg.caza * Config.GUSANO_CAZA_MULT * pasoG, dir.Magnitude)
						g.mira = dir.Unit
					end
				else
					-- perseguir POR LA ESCALERA: avanzar por los waypoints
					-- hacia el punto de la ruta más cercano al jugador
					local objetivoIdx = g.cazaIdx or g.idx
					local wp = g.wps[g.idx]
					local dir = wp - g.pos
					local dist = dir.Magnitude
					if dist &lt; 3 then
						if g.idx &lt; objetivoIdx then
							g.idx = g.idx + 1
						elseif g.idx &gt; objetivoIdx then
							g.idx = g.idx - 1
						end
					else
						g.pos = g.pos + dir.Unit
							* math.min(g.cfg.caza * Config.GUSANO_CAZA_MULT * pasoG, dist)
						g.mira = dir.Unit
					end
				end
				-- mordida
				if dJugador &lt; Config.GUSANO_MATA_DIST then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health &gt; 0 and esCazable(g.objetivo, g) then
						local victima = g.objetivo
						-- SCREAMER ELIMINADO (2026-07-19, pedido del usuario):
						-- ya no hay pantalla roja con la cabeza ni el sonido de
						-- grito; el gusano simplemente te mata al alcanzarte.
						hum.Health = 0
						toast(victima, "atrapado", g.cfg.gusano)
						-- sonido de muerte NUEVO (2026-07-19): 3D, lo oyen los
						-- cercanos (~6 pisos), reemplaza al grito eliminado
						RE.FX:FireAllClients("muerteGusano", root.Position)
						soltarObjetivo(g)
					end
				end
			end
		else
			-- patrulla: arrastrarse waypoint a waypoint (ping-pong) con
			-- 🐛 PATRULLA CONTINUA (2026-07-25). Antes se paraba
			-- Config.GUSANO_PAUSA segundos cada cierto rato a "olfatear" y al
			-- reanudar tenía un 50% de darse la vuelta. Eso lo hacía impredecible
			-- de la forma mala: podías estar esperando a que se alejara y de
			-- pronto se giraba encima de ti sin motivo. Ahora recorre su ruta sin
			-- parar y SOLO se desvía cuando ve a alguien; al perderlo (lo maneja
			-- soltarObjetivo) vuelve al waypoint más cercano y sigue patrullando.
			local wp = g.wps[g.idx]
			local dir = wp - g.pos
			local dist = dir.Magnitude
			if dist &lt; 2 then
				g.idx = g.idx + g.dir
				if g.idx &gt; #g.wps then
					g.idx = #g.wps - 1
					g.dir = -1          -- llegó al final de su territorio: da la vuelta
				elseif g.idx &lt; 1 then
					g.idx = 2
					g.dir = 1           -- llegó al principio: da la vuelta
				end
			else
				g.pos = g.pos + dir.Unit
					* math.min(g.cfg.patrulla * pasoG, dist)
				g.mira = dir.Unit
			end
		end
		-- aplicar cabeza + cuerpo (cadena)
		if g.cabeza then
			-- giro SUAVE: la mirada se interpola hacia la dirección nueva en vez
			-- de chasquear instantáneo en las curvas (movimiento fluido)
			local suave = (g.miraSuave or g.mira):Lerp(g.mira, math.min(1, pasoG * 18))
			g.miraSuave = suave.Magnitude &gt; 0.05 and suave.Unit or g.mira
			g.cabeza:PivotTo(CFrame.lookAt(g.pos, g.pos + g.miraSuave))
		end
		local lider = g.pos
		for i, seg in ipairs(g.segs) do
			-- la 1ª bolita va MÁS separada (si no queda incrustada en la manzana)
			local esp = (i == 1) and (Config.GUSANO_ESPACIO_CABEZA
				or Config.GUSANO_ESPACIO) or Config.GUSANO_ESPACIO
			local d = lider - g.posSegs[i]
			if d.Magnitude &gt; esp then
				g.posSegs[i] = lider - d.Unit * esp
			end
			if seg then seg.CFrame = CFrame.new(g.posSegs[i]) end
			lider = g.posSegs[i]
		end
	end
end)

-- ─── PASES ─────────────────────────────────────────────────
local function tienePase(plr, clave)
	local r = rt[plr]
	return r and r.pases[clave] or false
end

local function otorgarPase(plr, clave)
	local r = rt[plr]
	if not r then return end
	r.pases[clave] = true
	if clave == "speed2x" then aplicarStats(plr) end
	marcar(plr)
	toast(plr, "compraOk")
end

-- Abre la VENTANA de compra de un pase (en vez de mostrar "necesitas X"): si el
-- pase tiene ID, sale el diálogo nativo de Roblox; en Studio se otorga gratis.
local function promptPase(plr, clave)
	local info = Config.GAMEPASSES[clave]
	if not info then return end
	if info.id &gt; 0 then
		MarketplaceService:PromptGamePassPurchase(plr, info.id)
	elseif ES_STUDIO then
		otorgarPase(plr, clave)
		toast(plr, "pruebaGratis")
	else
		toast(plr, "sinId")
	end
end

-- prompt de COMPRA con Robux (producto): el aviso gris clásico de Roblox
local function promptProducto(plr, clave)
	local info = Config.PRODUCTOS[clave]
	if not info then return end
	if info.id &gt; 0 then
		MarketplaceService:PromptProductPurchase(plr, info.id)
	elseif ES_STUDIO then
		-- en Studio sin id real: se otorga gratis para poder probar
		local perfil = perfiles[plr]
		if clave == "speedcoil" then perfil.coils.speed = true
		elseif clave == "jumpcoil" then perfil.coils.jump = true end
		marcar(plr)
	else
		toast(plr, "sinId")   -- publicado sin ID: avisar (no fallar en silencio)
	end
end

-- desequipar a la fuerza (cuando intentan usar un objeto que no han comprado)
local function desequipar(plr)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum:UnequipTools() end
end

-- declarado antes de cargarPases (que lo llama) y definido más abajo
local darBate

local function cargarPases(plr)
	local r = rt[plr]
	for clave, info in pairs(Config.GAMEPASSES) do
		if info.id &gt; 0 then
			local ok, tiene = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, info.id)
			end)
			if ok and tiene then r.pases[clave] = true end
		end
	end
	-- 🎁 REGALOS POR USERID (Config.REGALOS): se escriben en perfil.gears ANTES
	-- de volcar los gears a r.pases, así que entran por el mismo camino que un
	-- elemento comprado y quedan guardados de por vida. Solo hace algo la primera
	-- vez: después ya están en el perfil y el `not perfil.gears[clave]` lo salta.
	local perfil = perfiles[plr]
	if perfil and perfil.gears and Config.REGALOS then
		local dados = {}
		for _, clave in ipairs(Config.REGALOS[plr.UserId] or {}) do
			if Config.GAMEPASSES[clave] and not perfil.gears[clave] then
				perfil.gears[clave] = true
				dados[#dados + 1] = Config.GAMEPASSES[clave].nombre or clave
			end
		end
		if #dados &gt; 0 then
			marcar(plr)   -- fuerza el guardado del perfil con el regalo dentro
			toast(plr, "regalo", table.concat(dados, ", "))
			print("[RainbowApple] REGALO a " .. plr.Name .. " (" .. plr.UserId
				.. "): " .. table.concat(dados, ", "))
		end
	end
	-- elementos comprados con CASH en la tienda Gears (persistidos en el perfil)
	if perfil and perfil.gears then
		for clave in pairs(perfil.gears) do r.pases[clave] = true end
	end
	marcar(plr)
	-- ⚡ RE-APLICAR STATS: la carga de pases es ASÍNCRONA y termina DESPUÉS del
	-- primer spawn, así que cuando alSpawnear llamó aplicarStats las pases aún
	-- estaban vacías (la x2 Speed no se aplicaba hasta el primer sprint). Ahora
	-- que speed2x ya está en r.pases, reafirmamos la velocidad al instante.
	aplicarStats(plr)
	-- 🏏 MISMO MOTIVO (bug 2026-07-25): alSpawnear ya llamó a darBate, pero
	-- entonces r.pases.bat aún era false y se salía sin dar nada → el jugador
	-- que YA había reclamado el bate reentraba sin él. Ahora que gears.bat
	-- está cargado, se le entrega aquí.
	if darBate then darBate(plr) end
end

-- ─── TOP DONADORES: cada Robux gastado se suma al OrderedDataStore
-- "TopDonated" (el que lee la tabla de donadores; llave "Donated"..UserId) ───
local donadoresStore
pcall(function()
	donadoresStore = DataStoreService:GetOrderedDataStore("TopDonated")
end)
-- ─── 💖 AURA DE DONADOR: brillitos PERMANENTES según el TOTAL donado ───
-- (perfil.donado se guarda en el DataStore → sobrevive salir del server).
-- ParticleEmitter creado por Lua en el server = lo ven TODOS los jugadores.
local AURA_NIVELES = {   -- rate ×3 + colores SATURADOS (2026-07-18)
	{min = 1000, rainbow = true, rate = 48},                       -- 🌈 arcoíris
	{min = 500, color = Color3.fromRGB(255, 0, 170), rate = 39},   -- 💖 rosa chicle
	{min = 100, color = Color3.fromRGB(255, 185, 0), rate = 30},   -- 💛 oro puro
	{min = 50, color = Color3.fromRGB(0, 255, 70), rate = 24},     -- 💚 verde neón
	{min = 10, color = Color3.fromRGB(0, 160, 255), rate = 18},    -- 💙 azul eléctrico
}
local function aplicarAuraDona(plr, char)
	char = char or plr.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local viejoA = root:FindFirstChild("AuraDona")
	if viejoA then viejoA:Destroy() end
	local viejaL = root:FindFirstChild("AuraDonaLuz")
	if viejaL then viejaL:Destroy() end
	local perfil = perfiles[plr]
	local total = perfil and (perfil.donado or 0) or 0
	local nivel
	for _, n in ipairs(AURA_NIVELES) do
		if total &gt;= n.min then nivel = n break end
	end
	if not nivel then return end
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "AuraDona"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	if nivel.rainbow then
		pe.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 60)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 130, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(230, 0, 255)),
		})
	else
		pe.Color = ColorSequence.new(nivel.color)
	end
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(1, 0)})
	pe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1)})
	pe.Rate = nivel.rate
	pe.Lifetime = NumberRange.new(0.8, 1.5)
	pe.Speed = NumberRange.new(0.6, 1.6)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.RotSpeed = NumberRange.new(-90, 90)
	pe.Acceleration = Vector3.new(0, 1.6, 0)   -- los brillitos FLOTAN hacia arriba
	pe.Parent = root
	local pl = Instance.new("PointLight")
	pl.Name = "AuraDonaLuz"
	pl.Color = nivel.color or Color3.fromRGB(255, 190, 250)
	pl.Brightness = 0.6
	pl.Range = 7
	pl.Parent = root
end

local function registrarDonacion(plr, robux)
	if not robux or robux &lt;= 0 then return end
	local perfil = perfiles[plr]
	if perfil then
		perfil.donado = (perfil.donado or 0) + robux
		marcar(plr)
		aplicarAuraDona(plr)   -- el brillo aparece/sube de nivel al instante
	end
	if not donadoresStore then return end
	task.spawn(function()
		pcall(function()
			donadoresStore:IncrementAsync("Donated" .. plr.UserId, robux)
		end)
	end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, passId, comprado)
	if not comprado then return end
	for clave, info in pairs(Config.GAMEPASSES) do
		if info.id == passId then
			otorgarPase(plr, clave)
			registrarDonacion(plr, info.precio or 0)
		end
	end
end)

-- ─── PRODUCTOS ─────────────────────────────────────────────
local function forcefield(char, seg)
	local ff = Instance.new("ForceField")
	ff.Parent = char
	task.delay(seg, function() ff:Destroy() end)
end

-- sortea y ENTREGA el premio de una caja (SIN cobrar; el cobro se hace aparte,
-- con cash o con Robux). Dispara la ruleta en el cliente (FX "crateGira").
local function entregarCaja(plr, def, fxRetraso)
	local r, perfil = rt[plr], perfiles[plr]
	if not r or not perfil then return end
	-- GALACTIC = objeto NUEVO garantizado (2026-07-19, pedido del usuario):
	-- el sorteo se hace SOLO entre los premios que el jugador NO tiene
	-- (conservando sus pesos → el god sigue siendo el más raro de lo que
	-- falte). Si ya tiene LOS 5, se sortea normal y la rama de "repetido"
	-- le entrega el dinero ($25,000) caiga donde caiga la ruleta.
	local candidatos = def.premios
	if def.id == "galactic" then
		-- GALACTIC: objeto NUEVO garantizado (sorteo directo entre lo que NO
		-- tienes, con sus pesos). Con TODO comprado: sorteo normal → la rama
		-- de repetido entrega los $25,000. (El "teatro" de re-giros visibles
		-- se retiró 2026-07-19: rompía la animación y se priorizó estabilidad.)
		local faltan = {}
		for _, pr in ipairs(def.premios) do
			local ya
			if pr.clave == "speed" or pr.clave == "jump" then
				ya = perfil.coils[pr.clave]
			else
				ya = r.pases[pr.clave]
			end
			if not ya then table.insert(faltan, pr) end
		end
		if #faltan &gt; 0 then candidatos = faltan end
	end
	local total = 0
	for _, pr in ipairs(candidatos) do total = total + pr.peso end
	local rr = math.random() * total
	local premio = candidatos[#candidatos]
	for _, pr in ipairs(candidatos) do
		rr = rr - pr.peso
		if rr &lt;= 0 then premio = pr break end
	end
	-- índice REAL dentro de def.premios (la ruleta del cliente frena ahí)
	local idx = #def.premios
	for i, pr in ipairs(def.premios) do
		if pr == premio then idx = i break end
	end
	local dupe = false
	if premio.tipo == "cash" then
		darCash(plr, premio.valor)
	else
		local clave = premio.clave
		local ya
		if clave == "speed" or clave == "jump" then ya = perfil.coils[clave]
		else ya = r.pases[clave] end
		if ya then
			dupe = true
			darCash(plr, def.precio)   -- repetido: te regresa el precio de la caja
		elseif clave == "speed" or clave == "jump" then
			perfil.coils[clave] = true
		else
			perfil.gears = perfil.gears or {}
			perfil.gears[clave] = true
			otorgarPase(plr, clave)
		end
	end
	marcar(plr)
	local cargaFX = {id = def.id, idx = idx, dupe = dupe}
	if fxRetraso and fxRetraso &gt; 0 then
		-- compra con ROBUX: la ventana de Roblox tarda en cerrarse y chocaba
		-- con la ruleta → la animación espera; el premio ya es tuyo desde ya
		task.delay(fxRetraso, function()
			if plr.Parent then RE.FX:FireClient(plr, "crateGira", cargaFX) end
		end)
	else
		RE.FX:FireClient(plr, "crateGira", cargaFX)
	end
end


-- 💥 EXPLOTAR: a quién quiere reventar cada comprador. Se sella al pulsar la E
-- (antes de abrir la ventana de Robux) y se lee en ProcessReceipt, porque el
-- recibo NO trae el objetivo: solo dice quién pagó y qué producto.
-- Se guarda el UserId y no el Player para no retener al objeto si se va.
local pendExplotar = {}   -- [comprador] = {uid = userId del objetivo, t = os.clock()}
local EXPLOTAR_VENTANA = 90   -- seg de validez del encargo (compra lenta, móvil...)
local function otorgarProducto(plr, clave)
	local r, perfil = rt[plr], perfiles[plr]
	if not r or not perfil then return end
	local info = Config.PRODUCTOS[clave]
	if clave == "killall" then
		for _, otro in ipairs(Players:GetPlayers()) do
			if otro ~= plr and rt[otro] and rt[otro].godUntil &lt; os.clock() then
				local hum = otro.Character and otro.Character:FindFirstChildOfClass("Humanoid")
				if hum then hum.Health = 0 end
			end
		end
		-- aviso a TODO el server por FX (el canal RE.Toast del cliente no
	-- conocía la clave "killAll" y el anuncio se perdía en silencio)
	RE.FX:FireAllClients("killAllTodos", plr.DisplayName)
	elseif clave == "explotar" then
		-- 💥 El objetivo lo selló el ProximityPrompt en pendExplotar. Aquí solo
		-- se valida que siga siendo un blanco legítimo y se revienta.
		local enc = pendExplotar[plr]
		pendExplotar[plr] = nil
		local victima = nil
		if enc and os.clock() - enc.t &lt;= EXPLOTAR_VENTANA then
			victima = Players:GetPlayerByUserId(enc.uid)
		end
		if not victima then
			toast(plr, "explotarFallo")
		else
			toast(plr, "explotarArmado", victima.DisplayName, Config.EXPLOTAR_RETARDO)
			-- ⏳ RETARDO DE 4 s (2026-08-04). El task.delay NO es cosmético, es
			-- OBLIGATORIO: esta función la llama ProcessReceipt, que tiene que
			-- devolver PurchaseGranted cuanto antes. Si esperásemos aquí los 4
			-- segundos bloquearíamos el recibo, y Roblox puede darlo por fallido
			-- y no volver a intentarlo → el jugador paga y no recibe nada.
			task.delay(Config.EXPLOTAR_RETARDO, function()
				-- Se revalida TODO aquí y no antes: en 4 segundos a la víctima le
				-- da tiempo a salirse del servidor, a morirse sola por un gusano
				-- o a comprarse el God Mode. Y la POSICIÓN también se lee ahora,
				-- que para eso se ha estado moviendo.
				local vchar = victima.Parent and victima.Character
				local vhum  = vchar and vchar:FindFirstChildOfClass("Humanoid")
				local vroot = vchar and vchar:FindFirstChild("HumanoidRootPart")
				-- god activo = inmune, igual que en killall: si no, el pase de
				-- 25 R$ no valdría nada y matarías a quien pagó por no morir
				local inmune = rt[victima] and rt[victima].godUntil &gt;= os.clock()
				if vhum and vroot and vhum.Health &gt; 0 and not inmune then
					local pos = vroot.Position
					-- 💥 EXPLOSIÓN NATIVA de Roblox (fuego + humo). Se crea en el
					-- SERVIDOR a propósito: un Explosion es UNA instancia que
					-- replica sola a todo el mundo, así que no hace falta ni
					-- FireAllClients ni dibujar nada en cada cliente.
					local ex = Instance.new("Explosion")
					ex.Position = pos
					ex.BlastRadius = Config.EXPLOTAR_RADIO
					-- ⚠️ ESTOS DOS CEROS SON LO QUE HACE QUE ESTO SEA SEGURO.
					-- BlastPressure lanzaría por los aires a los que pasen cerca;
					-- DestroyJointRadiusPercent los descuartizaría. Ninguno de los
					-- dos distingue entre la víctima y un vecino que solo estaba
					-- subiendo. Al que muere lo matamos nosotros, a mano, dos
					-- líneas más abajo, y SOLO a él.
					ex.BlastPressure = Config.EXPLOTAR_FUERZA
					ex.DestroyJointRadiusPercent = 0
					ex.Parent = workspace
					-- sonido posicional anclado en el sitio (el Explosion nativo
					-- no trae sonido propio)
					local anc = Instance.new("Part")
					anc.Anchored, anc.Transparency = true, 1
					anc.CanCollide, anc.CanQuery, anc.CanTouch = false, false, false
					anc.Size = Vector3.new(1, 1, 1)
					anc.CFrame = CFrame.new(pos)
					anc.Parent = workspace
					local snd = Instance.new("Sound")
					snd.SoundId = Config.EXPLOTAR_SND
					snd.Volume = 0.85
					snd.RollOffMaxDistance = 160
					snd.Parent = anc
					snd:Play()
					task.delay(5, function() if anc.Parent then anc:Destroy() end end)
					vhum.Health = 0
					pcall(function() vchar:BreakJoints() end)
					-- 🚀 LAS PIEZAS SALEN VOLANDO. Se hace a mano, parte por parte,
					-- y NO subiendo el BlastPressure de la explosión: esa fuerza no
					-- distingue a la víctima del que pasaba por al lado. Así solo
					-- se despedaza a quien pagaste por reventar.
					pcall(function()
						for _, d in ipairs(vchar:GetDescendants()) do
							if d:IsA("BasePart") and not d.Anchored then
								local dir = d.Position - pos
								-- una pieza justo en el centro daría Unit = NaN y
								-- la mandaría a la nada; para esa, hacia arriba
								dir = dir.Magnitude &gt; 0.1 and dir.Unit or Vector3.yAxis
								d.CanCollide = Config.EXPLOTAR_PIEZAS_CHOCAN
								d.AssemblyLinearVelocity =
									dir * Config.EXPLOTAR_IMPULSO
									+ Vector3.new(0, Config.EXPLOTAR_IMPULSO * 0.55, 0)
								-- giro aleatorio: sin esto las piezas viajan rígidas
								-- y parece que floten en vez de estallar
								d.AssemblyAngularVelocity = Vector3.new(
									math.random(-40, 40), math.random(-40, 40),
									math.random(-40, 40))
							end
						end
					end)
					-- 💨 Y DESAPARECEN. Las piezas vuelan medio segundo y el cuerpo
					-- se borra ENTERO. Esto es lo que mantiene la explosión dentro
					-- de "violencia leve": la definición oficial es "los cuerpos
					-- desaparecen en el momento en que su vida llega a cero", y a
					-- otros devs los han bajado a MODERATE justo por dejar el
					-- cuerpo tirado. Aquí dura menos que una muerte normal.
					task.delay(Config.EXPLOTAR_DESVANECER, function()
						if not vchar or not vchar.Parent then return end
						pcall(function()
							-- invisible PRIMERO: el efecto es inmediato y no
							-- depende de que el Destroy llegue a completarse
							for _, d in ipairs(vchar:GetDescendants()) do
								if d:IsA("BasePart") or d:IsA("Decal") then
									d.Transparency = 1
								end
							end
							vchar:Destroy()
						end)
					end)
					-- el comprador puede haberse ido durante la cuenta atrás
					if plr.Parent then toast(plr, "explotarOk", victima.DisplayName) end
				elseif plr.Parent then
					-- se escapó. Pagó igual: Roblox ya cobró y no hay forma de
					-- devolverlo desde aquí, así que al menos que se entere.
					toast(plr, "explotarFallo")
				end
			end)
		end
	elseif clave == "god60" then
		-- (la clave sigue siendo "god60" a propósito: es el ID del dev product ya
		--  publicado. Lo que dura lo manda Config.GOD_PRODUCTO_SEG = 5 min.)
		r.godUntil = os.clock() + Config.GOD_PRODUCTO_SEG
		if plr.Character then
			forcefield(plr.Character, Config.GOD_PRODUCTO_SEG)
			grupoChar(plr.Character, GRUPO_DIOS)   -- 🛡 nadie lo empuja con el cuerpo
		end
		refrescarGear(plr)   -- 🕊 desbloquea el slot 1 de la hotbar al momento
		toast(plr, "god", duracionTexto(Config.GOD_PRODUCTO_SEG))
	elseif clave == "skipend" then
		local char = plr.Character
		if char then char:PivotTo(cframeEntrada(NP + 1)) end
		toast(plr, "skip")
	elseif clave == "spins5" then
		perfil.spinsExtra = perfil.spinsExtra + info.monto
		toast(plr, "compraOk")
	elseif clave == "speedcoil" then
		perfil.coils.speed = true
		toast(plr, "gearOk")
	elseif clave == "jumpcoil" then
		perfil.coils.jump = true
		toast(plr, "gearOk")
	elseif clave == "crategalactic" then
		-- pagó la caja galáctica con Robux → se abre (sorteo + ruleta)
		for _, c in ipairs(Config.CRATES) do
			if c.id == "galactic" then entregarCaja(plr, c, 2) break end
		end
	elseif clave:sub(1, 4) == "dona" then
		-- 💖 DONACIÓN: no entrega objeto. El registro en la tabla Top Donators
		-- lo hace registrarDonacion (ProcessReceipt); aquí solo el FESTEJO:
		-- aviso a TODO el server + confeti sobre el Floppa
		RE.FX:FireAllClients("donaTodos", plr.DisplayName, info.precio or 0)
		if info.id == 0 then registrarDonacion(plr, info.precio or 0) end
		local fc = workspace:FindFirstChild("Floppa cube", true)
		if fc then RE.FX:FireAllClients("confeti", fc.Position + Vector3.new(0, 3, 0)) end
	elseif info.monto then
		darCash(plr, info.monto)
		toast(plr, "compraOk")
	end
	marcar(plr)
end

-- 💸 PRODUCTOS QUE SE PUEDEN DIFERIR si el perfil del jugador es de rendición.
-- Son exactamente los que PERSISTEN en el perfil: si no se guarda, se pierden.
-- ⚠️ LA LISTA ES BLANCA A PROPÓSITO, NO NEGRA. Diferir los que faltan rompería
-- más de lo que arregla:
--   killall / god60 / skipend → efecto de SESIÓN. El jugador ya recibió lo que
--     pagó en el momento; reentregarlos al entrar de nuevo no tiene sentido
--     (skipend ni siquiera funciona: aún no hay Character) y killall mataría un
--     servidor entero en un instante aleatorio.
--   dona10..dona1000 → no dan objeto y se registran en donadoresStore, que es
--     otro DataStore y NO mira _noGuardar. El Top Donators funciona igual.
local DIFERIBLES = {
	cash1k = true, cash5k = true, cash20k = true,   -- Cash del perfil
	spins5 = true,                                  -- giros del perfil
	speedcoil = true, jumpcoil = true,              -- coils permanentes
	crategalactic = true,                           -- da un gear permanente
}

MarketplaceService.ProcessReceipt = function(recibo)
	local plr = Players:GetPlayerByUserId(recibo.PlayerId)
	if not plr or not perfiles[plr] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local perfil = perfiles[plr]
	if perfil.recibos[recibo.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	for clave, info in pairs(Config.PRODUCTOS) do
		if info.id == recibo.ProductId then
			-- 💸 EL BUG DEL DINERO (encontrado el 1 ago 2026). El comentario de
			-- abajo ya se preocupaba de que el server se cayera antes del autosave
			-- — pero se le escapó el caso en que el guardado NO FALLA, simplemente
			-- NO HACE NADA: guardarPerfil sale en la primera línea (:187) si el
			-- perfil es de rendición. Y aun así aquí se devolvía PurchaseGranted.
			-- Roblox, al recibir eso, consume el PurchaseId, le cobra los Robux y
			-- NO REINTENTA NUNCA MÁS: el jugador pagaba y perdía el objeto para
			-- siempre. Devolviendo NotProcessedYet, Roblox se lo vuelve a ofrecer
			-- en el siguiente join, cuando ya tenga un perfil que sí se guarda.
			if perfil._noGuardar and DIFERIBLES[clave] then
				warn("[RainbowApple] compra DIFERIDA (perfil sin guardado): "
					.. plr.Name .. " -&gt; " .. clave)
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			otorgarProducto(plr, clave)
			perfil.recibos[recibo.PurchaseId] = true
			registrarDonacion(plr, recibo.CurrencySpent or info.precio or 0)
			-- guardar YA y FORZADO (sin bloquear el recibo): si el server se
			-- cayera antes del autosave, el jugador pagó Robux y perdería el
			-- objeto (Roblox ya no reintenta una compra concedida). Forzado =
			-- se salta el freno de 25 s, así dos compras seguidas NUNCA se pierden.
			task.spawn(guardarPerfil, plr, true)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- ═══ 💥 EXPLOTAR JUGADOR (5 Robux) ═════════════════════════
-- Un ProximityPrompt en el torso de cada personaje. Al pulsar E se sella el
-- objetivo en pendExplotar y se abre la ventana de Robux; el estallido ocurre
-- después, en ProcessReceipt → otorgarProducto("explotar").
-- ⚠️ NO está en DIFERIBLES a propósito: es un efecto de SESIÓN, igual que
-- killall. Diferirlo al siguiente join reventaría a alguien al azar minutos
-- después, cuando el objetivo original ya no está.
do
	local infoExp = Config.PRODUCTOS.explotar
	-- con id=0 (dev product sin crear) no se pone nada: más vale ningún botón
	-- que un botón que abre una ventana de compra rota
	if infoExp and (infoExp.id or 0) ~= 0 then
		local function ponerPrompt(char, dueno)
			local root = char:WaitForChild("HumanoidRootPart", 10)
			if not root or root:FindFirstChild("PromptExplotar") then return end
			local pp = Instance.new("ProximityPrompt")
			pp.Name = "PromptExplotar"
			pp.ActionText = "Explode Player"
			pp.ObjectText = dueno.DisplayName
			pp.HoldDuration = 0
			pp.MaxActivationDistance = Config.EXPLOTAR_RANGO
			pp.RequiresLineOfSight = false
			pp.Parent = root
			pp.Triggered:Connect(function(comprador)
				if comprador == dueno then return end        -- nadie se explota solo
				if not limitar(comprador, "explotar", 2) then return end
				local r = rt[comprador]
				if not r then return end
				local ahora = os.clock()
				if r.explotarUntil and r.explotarUntil &gt; ahora then
					toast(comprador, "explotarCd")
					return
				end
				r.explotarUntil = ahora + Config.EXPLOTAR_CD
				pendExplotar[comprador] = {uid = dueno.UserId, t = ahora}
				MarketplaceService:PromptProductPurchase(comprador, infoExp.id)
			end)
		end
		local function engancharJugador(plr)
			if plr.Character then task.spawn(ponerPrompt, plr.Character, plr) end
			plr.CharacterAdded:Connect(function(char)
				task.spawn(ponerPrompt, char, plr)
			end)
		end
		for _, plr in ipairs(Players:GetPlayers()) do engancharJugador(plr) end
		Players.PlayerAdded:Connect(engancharJugador)
		Players.PlayerRemoving:Connect(function(plr) pendExplotar[plr] = nil end)
	end
end

-- pedir compra desde el cliente
-- asignada en el decorador del CofreMeta (más abajo); la llama el botón "Claim"
-- de la ventana del cofre (RE.Prompt "cofre")
local reclamarCofre

-- ─── RE-ARMADO del cofre por DESCENSO (sistema anti-camping): el cofre solo se
-- reclama UNA vez por subida. Al reclamar se desarma; para re-armarlo hay que
-- BAJAR hasta la base (y &lt; ALTURA_LOBBY − 6), sea por escaleras, por fuera con
-- la alfombra, o cayéndose. Así el jugador ACUMULA dinero y copas re-subiendo
-- en la misma sesión, pero quedarse acampando arriba NO reabre el cofre (ni
-- siquiera muriendo: el respawn en un checkpoint alto sigue arriba del umbral).
task.spawn(function()
	local Y_REARME = Config.ALTURA_LOBBY - 6
	while true do
		task.wait(1)
		for plr, r in pairs(rt) do
			-- 📊 PASO 2 DEL EMBUDO: "Started Climbing". Es EL dato que falta —
			-- distingue al que se va del lobby sin intentarlo del que sí sube y
			-- se atora. Se marca al despegarse del suelo del lobby, antes
			-- incluso del piso 1, para no confundir "empezó" con "lo logró".
			if not (r.funnel and r.funnel[2]) then
				local rootF = plr.Character
					and plr.Character:FindFirstChild("HumanoidRootPart")
				if rootF and rootF.Position.Y &gt; Config.ALTURA_LOBBY - 10 then
					funnel(plr, 2)
				end
			end
			if not r.cofreArmado then
				local char = plr.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				-- re-arma SOLO por descenso LEGÍTIMO. Condiciones anti-exploit:
				--  • VIVO y PARADO en el piso (FloorMaterial ≠ Air): tirarse al
				--    vacío es freefall (nunca toca piso) → NO cuenta.
				--  • base ya por debajo del umbral.
				--  • que NO acabe de reaparecer: el respawn lo pone un instante en
				--    la base antes de teletransportarlo al checkpoint alto → se
				--    ignora los primeros 3 s tras spawnear.
				if root and hum and hum.Health &gt; 0
					and hum.FloorMaterial ~= Enum.Material.Air
					and root.Position.Y &lt; Y_REARME
					and (os.clock() - (r.spawnT or 0)) &gt; 3 then
					r.bajoALaBase = true       -- ETAPA 1: ya bajó a la base (vivo, parado).
					                            -- Falta RE-SUBIR vivo para armar (etapa 2).
				end
			end
		end
	end
end)

-- ─── COMUNIDAD (grupo de Roblox): puerta VIP + regalo único ───
-- Config.COMUNIDAD_ID = 0 → modo prueba (todos son "miembros").
-- Consulta FRESCA con GroupService (IsInGroup cachea y no sirve para
-- verificar a quien se une a mitad de sesión).
local function enComunidadFresco(plr)
	if (Config.COMUNIDAD_ID or 0) &lt;= 0 then return true end
	local ok, grupos = pcall(function()
		return game:GetService("GroupService"):GetGroupsAsync(plr.UserId)
	end)
	if not ok or type(grupos) ~= "table" then return false end
	for _, g in ipairs(grupos) do
		if g.Id == Config.COMUNIDAD_ID then return true end
	end
	return false
end

-- ⚖️ ¿ES DEL GRUPO? (1 ago 2026, tras ver "Player:IsInGroup failed because HTTP 429"
-- en el reporte de errores de producción)
--
-- Había DOS fallos encadenados, y el segundo es el que costaba dinero al jugador:
--
--   1. El prompt de la azotea NO estaba limitado. Cada pulsación de la E era UNA
--      petición web a Roblox, así que un jugador machacando el botón se comía la
--      cuota del SERVIDOR ENTERO — y con 70 dentro, eso perjudica a los otros 69.
--
--   2. `dentro = ok and res` metía en el mismo saco dos cosas distintas: "no eres
--      del grupo" y "la llamada falló". Cuando saltaba el 429, a MIEMBROS DE
--      VERDAD se les respondía que no lo eran y se quedaban sin sus 500 de Cash.
--      Peor aún: leían "únete al grupo" estando ya dentro.
--
-- Devuelve TRES estados, no dos:  true = sí · false = no · nil = no se pudo saber.
-- Quien la llame TIENE que distinguir el nil, o vuelve el bug.
local function esDelGrupo(plr)
	if (Config.GRUPO_ID or 0) &lt;= 0 then return ES_STUDIO or nil end
	for i = 1, 2 do
		local ok, res = pcall(function() return plr:IsInGroup(Config.GRUPO_ID) end)
		if ok then return res and true or false end
		if i == 1 then task.wait(1) end   -- un 429 se pasa solo en un segundo
	end
	return nil
end

-- 🍌 BANANA TRAMPA: cooldown 20 s por jugador (llaves débiles = auto-limpieza)
local bananaCd = setmetatable({}, {__mode = "k"})

-- entrega el Tool Banana (clon de la plantilla de ReplicatedStorage) si el
-- jugador la tiene desbloqueada y aún no la trae en mochila/mano
-- 🏏 entrega el BATE al jugador (clona la plantilla de ReplicatedStorage).
-- Se llama al reclamar el FREE BAT y en cada respawn si ya lo tiene.
function darBate(plr)
	local r = rt[plr]
	if not r or not r.pases.bat then return end
	local char = plr.Character
	local bp = plr:FindFirstChild("Backpack")
	if (char and char:FindFirstChild("Bat"))
		or (bp and bp:FindFirstChild("Bat")) then
		return
	end
	local plantilla = ReplicatedStorage:FindFirstChild("Bat")
	if plantilla and bp then
		plantilla:Clone().Parent = bp
	end
end

local function darBanana(plr)
	local r = rt[plr]
	if not r or not r.banana then return end
	local char = plr.Character
	local bp = plr:FindFirstChild("Backpack")
	if (char and char:FindFirstChild("Banana"))
		or (bp and bp:FindFirstChild("Banana")) then
		return
	end
	local plantilla = ReplicatedStorage:FindFirstChild("Banana")
	if plantilla and bp then
		plantilla:Clone().Parent = bp
	end
end

-- 🔫 TOY GUN congeladora: cooldown de disparo (4 s) y entrega del Tool
local toygunCd = setmetatable({}, {__mode = "k"})

local function darToyGun(plr)
	local r = rt[plr]
	if not r or not r.toygun then return end
	local char = plr.Character
	local bp = plr:FindFirstChild("Backpack")
	if (char and char:FindFirstChild("ToyGun"))
		or (bp and bp:FindFirstChild("ToyGun")) then
		return
	end
	local plantilla = ReplicatedStorage:FindFirstChild("ToyGun")
	if plantilla and bp then
		plantilla:Clone().Parent = bp
	end
end

-- ═══ 🖼 CUADRO DEL LOBBY (2026-08-08) ═════════════════════════════
-- Coges el cuadro del lobby con E → aparece en la hotbar → al EQUIPARLO se
-- planta delante de ti con la imagen y suena la canción; al desequiparlo se va.
--
-- ⚠️ TODO SE CONSTRUYE AQUÍ EN LUA, A PROPÓSITO. Lo normal en este proyecto es
-- que las vitrinas y los Tools salgan de build_rbxlx.py, pero eso obliga a
-- regenerar el .rbxlx y a reconstruir el place entero. Con el juego vivo y en
-- ventana de algoritmo, esto se puede publicar como cambio de scripts y ya.
--
-- ⚠️ Nada de SurfaceGui: se usan Decals en las dos caras. Puede haber un cuadro
-- POR JUGADOR a la vez, y los SurfaceGui a ese ritmo cuestan bastante más.
local cuadroPuesto = setmetatable({}, {__mode = "k"})   -- [plr] = Part del cuadro
local cuadroSeq    = 0   -- contador de salida: quién sacó el cuadro antes (ver el
                         -- árbitro del sonido, más abajo)

-- 💪 EL BRAZO LO LEVANTA ROBLOX, NO NOSOTROS (2026-08-17)
--
-- Historia, para que no se vuelva a intentar:
--   · 2026-08-09 se posaba el hombro tocando el C0 del Motor6D. NO SE VE. El
--     usuario lo confirmó probándolo: "el brazo no se levanta al sacar el cuadro".
--   · 2026-08-16 se soldó el cuadro a la mano para que siguiera al brazo. Como el
--     brazo nunca subía, lo único que se consiguió fue que el cuadro bailara con
--     el balanceo de andar. Rechazado también.
--
-- La forma correcta ya estaba EN ESTE MISMO JUEGO, en build_rbxlx.py (tool_coil):
-- un Tool con Handle hace que el Animate de Roblox reproduzca su animación de
-- "llevar objeto" y LEVANTE EL BRAZO SOLO, igual que con el Speed Coil y el
-- Gravity Coil. Es nativo, se replica a todos y no pelea con nada.
--
-- Por eso el Cuadro no levantaba el brazo: se creaba con RequiresHandle = false.
-- Ahora lleva un Handle diminuto e invisible en la mano (ver darCuadro) y el
-- CUADRO EN SÍ vuelve a colgar del HumanoidRootPart, que es lo que lo mantiene
-- quieto delante del pecho en vez de bambolearse.
local cuadroGen  = setmetatable({}, {__mode = "k"})   -- [plr] = testigo anti-carrera

-- conAnim = lo BAJA antes de destruirlo (al guardar el Tool). Sin ella se destruye
-- en el acto, que es lo que hace falta al morir, al reaparecer y al sacar otro
-- cuadro encima.
local function quitarCuadro(plr, conAnim)
	local p = cuadroPuesto[plr]
	cuadroPuesto[plr] = nil            -- fuera del registro YA: el árbitro del
	                                   -- sonido no debe contar uno que se está yendo
	-- ⚠️ TESTIGO CONTRA LA CARRERA de guardar-y-sacar rápido. La bajada deja un
	-- task.delay pendiente; si en esos 0,22 s el jugador vuelve a equiparlo, ese
	-- temporizador se despierta DESPUÉS y se llevaría por delante el cuadro NUEVO.
	-- Con el testigo, el rezagado ve que ya no manda y no toca nada.
	local gen = (cuadroGen[plr] or 0) + 1
	cuadroGen[plr] = gen
	local baja = conAnim and Config.CUADRO_ANIM_BAJAR or 0
	if baja &gt; 0 and p and p.Parent then
		-- solo se levanta la bandera: la bajada la dibuja cada cliente (ver el
		-- bloque "ANIMACIÓN DEL CUADRO" de MainClient). Aquí únicamente se espera
		-- a que termine para destruirlo.
		p:SetAttribute("Guardando", true)
		task.delay(baja, function()
			if p then pcall(function() p:Destroy() end) end
		end)
		return
	end
	if p then pcall(function() p:Destroy() end) end   -- destruir la Part se lleva
end                                                   -- el Sound y los Decals con ella

local function ponerCuadro(plr)
	quitarCuadro(plr)                       -- uno por jugador: nunca dos a la vez
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health &lt;= 0 then return end

	local ancho = Config.CUADRO_ANCHO or 7
	local alto  = Config.CUADRO_ALTO or 7
	local dist  = Config.CUADRO_DIST or 3.2
	local subir = Config.CUADRO_ALTURA or 0.8

	cuadroSeq = cuadroSeq + 1
	local p = Instance.new("Part")
	p.Name = "CuadroPuesto"
	p:SetAttribute("Orden", cuadroSeq)   -- para el árbitro del sonido
	-- ⚠️ 2026-08-09: ANTES IBA ANCLADO AL MUNDO y se quedaba plantado donde lo
	-- sacabas. Luego pasó a ir soldado al HumanoidRootPart.
	-- ✋ 2026-08-16: AHORA CUELGA DE LA MANO. Con el weld al root, los brazos se
	-- levantaban por su cuenta y el cuadro se quedaba fijo delante del pecho: nunca
	-- se tocaban, y por eso se veía flotando. Colgando de la mano el cuadro ES el
	-- brazo — le sigue al andar, al saltar y durante la animación de sacarlo.
	p.Anchored = false
	p.Massless = true        -- que no le añada peso al personaje ni lo frene
	p.CanCollide = false     -- decorativo: que no tape ni empuje a quien escala
	p.CanQuery = false       -- ni lo vean los raycasts del juego
	p.CanTouch = false       -- 2026-08-16: ni genere eventos Touched. Es un adorno
	                         -- de 7×4.5 pegado al pecho, o sea que rozaba TODO lo
	                         -- que pasaba cerca y cada roce es trabajo del motor
	                         -- de físicas por cada jugador que lo lleve.
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Config.CUADRO_COLOR or Color3.fromRGB(235, 235, 235)
	p.Size = Vector3.new(ancho, alto, Config.CUADRO_GROSOR or 0.1)
	p.CFrame = root.CFrame * CFrame.new(0, subir, -dist)

	if (Config.CUADRO_IMG or "") ~= "" then
		-- tabla explícita y no Enum.NormalId[Config.CUADRO_CARA]: indexar un Enum
		-- con un nombre que no existe LANZA ERROR en vez de devolver nil, y una
		-- errata en Config dejaría el cuadro sin poder equiparse.
		local caras = ({
			Front = {Enum.NormalId.Front},
			Back  = {Enum.NormalId.Back},
			Both  = {Enum.NormalId.Front, Enum.NormalId.Back},
		})[Config.CUADRO_CARA or "Front"] or {Enum.NormalId.Front}
		for _, cara in ipairs(caras) do
			local d = Instance.new("Decal")
			d.Texture = Config.CUADRO_IMG
			d.Face = cara
			d.Parent = p
		end
	end
	-- si todavía no hay id, sale el cuadro en blanco: así se puede probar el
	-- mecanismo entero antes de tener la imagen

	local snd
	if (Config.CUADRO_MUSICA or "") ~= "" then
		-- sonido 3D colgado del cuadro: lo oye quien pasa cerca, no solo el dueño.
		-- Lo crea el SERVER a propósito (se replica a todos); los sonidos de
		-- cliente de este juego son los 2D del gui.
		snd = Instance.new("Sound")
		snd.Name = "CuadroSnd"
		snd.SoundId = Config.CUADRO_MUSICA
		snd.Volume = Config.CUADRO_VOL or 0.55
		snd.Looped = Config.CUADRO_SND_LOOP and true or false
		snd.RollOffMaxDistance = Config.CUADRO_ALCANCE or 35
		snd.RollOffMinDistance = Config.CUADRO_ALCANCE_MIN or 20
		snd.Parent = p
		-- ⚠️ NO se toca :Play() aquí: la Part todavía no está en el mundo, y un Sound
		-- fuera del DataModel no suena aunque se lo pidas. Se arranca abajo del todo,
		-- cuando ya está puesta.
	end

	-- ⚠️ 2026-08-16: EL ORDEN IMPORTA. Antes se hacía `p.Parent = char` y DESPUÉS
	-- se creaba el Weld: entre esas dos líneas la Part ya estaba en el mundo,
	-- suelta (Anchored = false), así que el motor de físicas la simulaba uno o dos
	-- frames antes de quedar soldada y se la veía dar un tirón al sacarla. Ahora
	-- el Weld se crea ANTES y la Part entra al mundo ya sujeta.
	--
	-- ✋ Part0 = HumanoidRootPart, NO la mano (probado y descartado el 2026-08-16):
	-- colgándolo de la mano, el cuadro se bamboleaba con el balanceo de andar.
	-- Pegado al torso va quieto delante del pecho; quien levanta el brazo es la
	-- animación nativa del Tool con Handle.
	local w = Instance.new("Weld")
	w.Part0 = root
	w.Part1 = p
	-- 🎬 LA POSE FINAL, no la de arranque. La animación la dibuja cada cliente en
	-- local (bloque "ANIMACIÓN DEL CUADRO" de MainClient) porque un tween de
	-- servidor no manda un valor por frame: manda cambios de propiedad replicados,
	-- y medio segundo llegaba en una docena de escalones — "muy trabado".
	-- Dejarlo aquí ya en su sitio hace que, si un cliente no llega a animarlo
	-- (entra a mitad, llega tarde el evento), el cuadro salga puesto sin más en vez
	-- de quedarse tirado en la pose de arranque para siempre.
	w.C0 = Config.cuadroC0(0)
	-- ⚠️ NOMBRE EXPLÍCITO. El cliente tiene que esperarlo con WaitForChild, y sin
	-- nombre propio tendría que fiarse del que Roblox pone por defecto.
	w.Name = "CuadroWeld"
	w.Parent = p
	p.CFrame = root.CFrame * w.C0
	-- cuelga del personaje: si muere o lo borran, el cuadro se va con él
	p.Parent = char
	cuadroPuesto[plr] = p
	-- 🛟 RED DE SEGURIDAD. La animación la dibuja el cliente; si a alguno no le
	-- llegara a correr, el cuadro se le quedaría tirado abajo y tumbado para
	-- siempre. Pasado el tiempo del gesto, el server fija la pose final de un solo
	-- cambio de propiedad — quien la animó bien ya está ahí y no nota nada.
	-- El guard de "Guardando" evita el caso feo: si lo guarda antes de que termine
	-- de salir, esto le daría un tirón hacia arriba en plena bajada.
	task.delay(Config.CUADRO_ANIM_SEG or 0.5, function()
		if p.Parent and w.Parent and not p:GetAttribute("Guardando") then
			w.C0 = Config.cuadroC0(1)
		end
	end)
	-- 🔊 ARRANCA YA, siempre. Antes, con CUADRO_SND_UNICO puesto, esto esperaba a que
	-- el árbitro decidiera en su siguiente vuelta: hasta 1 segundo de silencio entre
	-- sacar el cuadro y oír la canción, y eso se nota en cada uso. Ahora suena al
	-- instante y, si resulta que hay otro cuadro sonando al lado, el árbitro lo calla
	-- en el siguiente tick. Se cambia un solape raro y corto por quitar un retardo
	-- que se pagaba SIEMPRE.
	if snd then
		snd:Play()
		-- 🌗 DESVANECIDO DEL FINAL. Se baja el volumen a 0 durante los últimos
		-- CUADRO_SND_FADE segundos para que no corte en seco. La duración se lee del
		-- propio audio (TimeLength), así que cambiar de canción no obliga a tocar
		-- números — pero TimeLength solo vale una vez que el asset ha CARGADO, de
		-- ahí la espera de abajo.
		local fade = Config.CUADRO_SND_FADE or 0
		if fade &gt; 0 then
			task.spawn(function()
				-- espera acotada: si el audio no carga (moderado, sin permiso, caído)
				-- esto se rinde en 10 s en vez de dejar una corrutina colgada por cada
				-- vez que alguien saca el cuadro
				local t0 = os.clock()
				while not snd.IsLoaded and snd.Parent and os.clock() - t0 &lt; 10 do
					task.wait(0.2)
				end
				if not (snd.IsLoaded and snd.Parent) then return end
				local dur = snd.TimeLength
				if dur &lt;= fade then return end     -- canción más corta que el fundido
				task.wait(dur - fade)
				-- puede haberlo guardado, muerto o callado el árbitro mientras tanto
				if snd.Parent and snd.IsPlaying then
					TweenService:Create(snd, TweenInfo.new(fade, Enum.EasingStyle.Linear),
						{Volume = 0}):Play()
				end
			end)
		end
	end
end

-- ═══ 🔇 ÁRBITRO DEL SONIDO (2026-08-16, reescrito el 2026-08-18) ══
-- El problema: cada cuadro lleva SU PROPIO Sound y Roblox no fusiona sonidos
-- iguales. Veinte jugadores sacando el cuadro en el mismo piso = veinte copias de
-- la misma canción arrancadas en momentos distintos, desfasadas entre sí.
--
-- La regla: de todos los que se OIGAN ENTRE SÍ suena solo el que salió primero;
-- a los demás se les corta. Barrido greedy sobre la lista ordenada por antigüedad,
-- así que al que ya estaba sonando no se le corta cuando llega otro al lado.
--
-- ⚠️ ESTE ÁRBITRO SOLO CALLA, NUNCA ARRANCA (cambiado el 2026-08-18, al quitar el
-- bucle). Antes hacía `if not IsPlaying then Play() end`, y eso con una canción que
-- NO se repite es una bomba: en cuanto terminara de sonar, el árbitro la vería
-- parada y la relanzaría — bucle infinito por la puerta de atrás, justo lo que se
-- acaba de quitar. Ahora el Play() lo hace solo ponerCuadro, una vez.
-- Por lo mismo solo se miran los que están SONANDO: uno que ya acabó no compite
-- por el hueco ni se le vuelve a tocar.
--
-- Coste: dos vueltas por segundo y solo sobre los que llevan el cuadro EQUIPADO,
-- que son unos pocos, no los 70 del server.
do
	if Config.CUADRO_SND_UNICO and (Config.CUADRO_MUSICA or "") ~= "" then
		local alcance = Config.CUADRO_ALCANCE or 35
		local ALC2 = alcance * alcance
		task.spawn(function()
			while true do
				task.wait(Config.CUADRO_SND_TICK or 0.5)
				-- 1) los que están sonando AHORA, ordenados por ANTIGÜEDAD. El orden
				--    de pairs() sobre una tabla con claves de objeto es arbitrario y
				--    cambia entre vueltas: sin ordenar, el elegido iría saltando de uno
				--    a otro y la canción se cortaría a trompicones.
				local vivos = {}
				for plr, p in pairs(cuadroPuesto) do
					if p.Parent and plr.Parent then
						local s = p:FindFirstChild("CuadroSnd")
						if s and s.IsPlaying then
							vivos[#vivos + 1] = {s = s, pos = p.Position,
								orden = p:GetAttribute("Orden") or 0}
						end
					end
				end
				table.sort(vivos, function(a, b) return a.orden &lt; b.orden end)
				-- 2) barrido greedy: al que tenga otro sonando a su alcance, se le corta
				local sonando = {}
				for _, c in ipairs(vivos) do
					local tapado = false
					for _, otro in ipairs(sonando) do
						local d = c.pos - otro.pos
						if d.X * d.X + d.Y * d.Y + d.Z * d.Z &lt; ALC2 then
							tapado = true
							break
						end
					end
					if tapado then
						c.s:Stop()
					else
						sonando[#sonando + 1] = c
					end
				end
			end
		end)
	end
end

-- entrega el Tool. Se crea a mano (sin plantilla en ReplicatedStorage) para no
-- depender del build. RequiresHandle = false → no hay que modelar nada que
-- cargar en la mano.
local function darCuadro(plr)
	local r = rt[plr]
	if not r or not r.cuadro then return end
	local nombre = Config.CUADRO_NOMBRE or "Cuadro"
	local char = plr.Character
	local bp = plr:FindFirstChild("Backpack")
	if (char and char:FindFirstChild(nombre))
		or (bp and bp:FindFirstChild(nombre)) then
		return
	end
	if not bp then return end
	local tool = Instance.new("Tool")
	tool.Name = nombre
	-- 💪 ESTO ES LO QUE LEVANTA EL BRAZO (2026-08-17). Antes era `false` y por eso
	-- el personaje sujetaba el cuadro con los brazos caídos: sin Handle, el script
	-- Animate de Roblox no reproduce su animación de "llevar objeto".
	-- Con Handle la reproduce SOLA, nativa y replicada a todos, igual que pasa con
	-- el Speed Coil y el Gravity Coil (ver tool_coil en build_rbxlx.py).
	-- El Handle es diminuto e INVISIBLE: solo está para disparar esa animación. Lo
	-- que se ve —el cuadro— cuelga del torso, no de él.
	tool.RequiresHandle = true
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.CastShadow = false
	handle.Massless = true
	handle.Parent = tool
	tool.CanBeDropped = false        -- que no se caiga al suelo y se pierda
	tool.ToolTip = nombre
	tool.TextureId = ((Config.CUADRO_ICONO or "") ~= "" and Config.CUADRO_ICONO)
		or Config.CUADRO_IMG or ""
	-- ⚠️ Tool.Equipped TAMBIÉN se dispara en el server cuando el Tool lo creó el
	-- server, así que no hace falta ni RemoteEvent nuevo ni LocalScript dentro
	-- del Tool (que es como lo hacen los otros Tools del juego, vía build).
	tool.Equipped:Connect(function() ponerCuadro(plr) end)
	-- true = lo BAJA con el brazo antes de desaparecer. Al morir y al salir se
	-- llama sin ella, que ahí lo que hace falta es limpiar en el acto.
	tool.Unequipped:Connect(function() quitarCuadro(plr, true) end)
	tool.Parent = bp
end

-- monta la vitrina del lobby: la que ya exista en el mapa, o una creada aquí
local function montarCuadroVitrina()
	local parte = workspace:FindFirstChild("CuadroVitrina", true)
	if not parte then
		-- 👉 si prefieres colocarla a mano, mete en Studio una Part llamada
		-- "CuadroVitrina" donde quieras y este bloque la usará en vez de crearla
		parte = Instance.new("Part")
		parte.Name = "CuadroVitrina"
		parte.Anchored = true
		-- ⚠️ 2026-08-16: esto era `true` a pelo. Un panel de 12×12 anclado y sólido
		-- plantado en (0, 52, -34) sin comprobar si ahí había algo: o tapaba el
		-- paso del piso 1, o servía de plataforma gratis para saltarse un tramo de
		-- la torre. Sin colisión sigue viéndose y sigue dando la E igual.
		parte.CanCollide = Config.CUADRO_VITRINA_SOLIDA and true or false
		parte.CanTouch = false    -- es un cartel: no necesita eventos Touched
		parte.CastShadow = false
		parte.Material = Enum.Material.SmoothPlastic
		parte.Color = Color3.fromRGB(235, 235, 235)
		parte.Size = Vector3.new(12, 12, 0.5)
		parte.CFrame = CFrame.new(Config.CUADRO_VITRINA_POS or Vector3.new(0, 52, -34))
			* CFrame.Angles(0, math.rad(Config.CUADRO_VITRINA_ROT or 0), 0)
		parte.Parent = workspace
	end
	if (Config.CUADRO_IMG or "") ~= "" and not parte:FindFirstChildOfClass("Decal") then
		for _, cara in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
			local d = Instance.new("Decal")
			d.Texture = Config.CUADRO_IMG
			d.Face = cara
			d.Parent = parte
		end
	end
	if parte:FindFirstChildOfClass("ProximityPrompt") then return end
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Interact"
	pp.ObjectText = Config.CUADRO_NOMBRE or "Cuadro"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.Parent = parte
	pp.Triggered:Connect(function(jug)
		-- freno igual que el del regalo de grupo: un ProximityPrompt sin límite
		-- se puede spamear y aquí cada pulsación crea un Tool
		if not limitar(jug, "cuadro", 2) then return end
		local r = rt[jug]
		if not r then return end
		if r.cuadro then return end   -- ya lo tiene: ni recrear el Tool ni volver a guardar
		r.cuadro = true
		-- 💾 2026-08-16: antes esto vivía SOLO en rt[jug], que es memoria de la
		-- sesión. Al salir del servidor se perdía y había que volver a subir al
		-- piso 1 a por él. Un objeto de presumir que se evapora no engancha.
		local perfil = perfiles[jug]
		if Config.CUADRO_PERSISTE and perfil then
			perfil.cuadro = true
			marcar(jug)
		end
		darCuadro(jug)
	end)
end
task.defer(montarCuadroVitrina)   -- tras el arranque, con el mapa ya cargado

-- congela a la víctima: BLOQUE DE HIELO translúcido cubriéndola + parálisis
-- total 4 s (root anclado = ni el dueño de la física puede moverse)
local function congelarJugador(v)
	local ch = v.Character
	local rootV = ch and ch:FindFirstChild("HumanoidRootPart")
	local humV = ch and ch:FindFirstChildOfClass("Humanoid")
	if not rootV or not humV or humV.Health &lt;= 0 then return end
	if ch:GetAttribute("Congelado") then return end
	ch:SetAttribute("Congelado", true)
	local ws, jp = humV.WalkSpeed, humV.JumpPower
	humV.WalkSpeed, humV.JumpPower = 0, 0
	rootV.Anchored = true
	local hielo = Instance.new("Part")
	hielo.Name = "BloqueHielo"
	hielo.Size = Vector3.new(4.6, 7.4, 3.6)
	hielo.CFrame = rootV.CFrame * CFrame.new(0, 0.2, 0)
	hielo.Anchored = true
	hielo.CanCollide = false
	hielo.Material = Enum.Material.Ice
	hielo.Color = Color3.fromRGB(140, 220, 255)
	hielo.Transparency = 0.45
	hielo.Parent = workspace
	task.delay(4, function()
		if hielo.Parent then hielo:Destroy() end
		if ch.Parent then
			ch:SetAttribute("Congelado", nil)
			if rootV.Parent then rootV.Anchored = false end
			if humV.Parent and humV.Health &gt; 0 then
				humV.WalkSpeed, humV.JumpPower = ws, jp
			end
		end
	end)
end

RE.Prompt.OnServerEvent:Connect(function(plr, tipo, clave)
	if not limitar(plr, "prompt", 3) then return end
	if tipo == "cofre" then
		if reclamarCofre then reclamarCofre(plr) end
		return
	end
	if tipo == "calClaim" then
		-- CALENDARIO DIARIO: reclama la recompensa del día y avanza. El SERVER
		-- es la única autoridad: valida fecha, no confía en el cliente.
		local perfil = perfiles[plr]
		if not perfil then return end
		-- 🏁 SEGUNDA VUELTA SOLO DE CASH (3 ago 2026). El 31 jul esto era un cierre
		-- TOTAL (calVisto7 → return) para no regalar los coils y el pase invisible
		-- una vez por semana a perpetuidad. Eso era correcto para los OBJETOS, pero
		-- de paso mataba los días de DINERO, que no canibalizan ninguna venta — y
		-- dejaba al veterano sin ningún motivo diario justo en la ventana Día 8-28,
		-- que es la de más peso del algoritmo de Roblox.
		-- Ahora calVisto7 significa "ya dio la vuelta": los días de objeto se SALTAN
		-- para siempre y los de cash siguen girando. El cliente hace el mismo salto
		-- (MainClient, función tarjeta) — si tocas uno, toca el otro.
		if (perfil.calFecha or "") == hoyMX() then return end   -- ya reclamó hoy
		local N = #Config.CALENDARIO
		local dia = perfil.calDia or 1
		if dia &lt; 1 or dia &gt; N then dia = 1 end
		local rec = Config.CALENDARIO[dia]
		if perfil.calVisto7 then
			-- red de seguridad para perfiles guardados con el código viejo, que
			-- pueden traer calDia apuntando a un día de objeto (o a 8)
			local saltos = 0
			while rec and rec.tipo ~= "cash" and saltos &lt; N do
				dia = dia + 1
				if dia &gt; N then dia = 1 end
				rec = Config.CALENDARIO[dia]
				saltos = saltos + 1
			end
			if not rec or rec.tipo ~= "cash" then return end   -- ni un día de cash
		end
		if not rec then dia = 1 rec = Config.CALENDARIO[1] end
		if rec.tipo == "cash" then
			darCash(plr, rec.valor)
		elseif rec.tipo == "producto" then
			otorgarProducto(plr, rec.valor)   -- coils: permanentes en perfil.coils
		elseif rec.tipo == "pase" then
			otorgarPase(plr, rec.valor)       -- invisible: pase de sesión
		end
		perfil.calFecha = hoyMX()
		if dia &gt;= N then
			perfil.calVisto7 = true   -- dio la vuelta → a partir de aquí, solo cash
			perfil.calDia = 1
		else
			perfil.calDia = dia + 1
		end
		-- ⚠️ En 2ª vuelta calDia tiene que apuntar SIEMPRE a un día de cash: el
		-- cliente solo pinta el botón CLAIM en la casilla D == calDia, así que si
		-- se quedara en un día de objeto el jugador no vería nada que reclamar.
		if perfil.calVisto7 then
			local saltos = 0
			while saltos &lt; N
				and (Config.CALENDARIO[perfil.calDia] or {}).tipo ~= "cash" do
				perfil.calDia = perfil.calDia + 1
				if perfil.calDia &gt; N then perfil.calDia = 1 end
				saltos = saltos + 1
			end
		end
		marcar(plr)
		RE.FX:FireClient(plr, "confeti",
			plr.Character and plr.Character:GetPivot().Position or Vector3.zero)
		return
	end
	if tipo == "starSalto" then
		-- rebote en la estrella gigante: avisa el CLIENTE (su raycast detecta
		-- CADA rebote sin fallar; el Touched del server se saltaba algunos).
		-- El server valida que de verdad esté en la estrella + tope de ritmo,
		-- y paga SIEMPRE. (enCooldown no existe aún a esta altura → limitar.)
		if not perfiles[plr] then return end
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local dxS = root.Position.X - 146
		local dzS = root.Position.Z
		if dxS * dxS + dzS * dzS &gt; 4900 or root.Position.Y &gt; 95 then return end
		if not limitar(plr, "starCash", 3) then return end
		-- (sin cooldown extra A PROPÓSITO 2026-07-18: la estrella ES el grind
		-- del juego — así se farmea la slap rainbow saltando; el usuario
		-- rechazó el freno anti-farm porque castigaba el ritmo real)
		darCash(plr, 10)
		RE.FX:FireClient(plr, "starCash", 10)
		return
	end
	if tipo == "regaloCoil" then
		-- 🎁 REGALO DE RETENCIÓN: al abrir el menú de salir, el cliente ofrece el
		-- SPEED COIL GRATIS; si lo reclama, se lo otorgamos permanente (una vez;
		-- si ya lo tiene, no hace nada)
		local perfil = perfiles[plr]
		if not perfil or perfil.coils.speed then return end
		perfil.coils.speed = true
		marcar(plr)
		RE.FX:FireClient(plr, "compraOk")
		return
	end
	if tipo == "comuVerificar" then
		-- botón VERIFICAR de la ventana: re-consulta el grupo y sella el
		-- atributo (el cliente abre/cierra la puerta al verlo cambiar)
		if not limitar(plr, "comu", 1) then return end
		local dentro = enComunidadFresco(plr)
		plr:SetAttribute("EnComunidad", dentro)
		toast(plr, dentro and "comuOk" or "comuNo")
		return
	end
	if tipo == "toygunDisparo" then
		-- 🔫 PUNTERÍA v2 (2026-07-17): el cliente manda {v = jugador clickeado
		-- o nil, p = punto del mundo}. Si CLICKEASTE a un jugador, la bala va
		-- DIRECTO a él (aunque estés de espaldas) — solo se valida distancia
		-- ≤85. Si no, raycast hacia el punto por si le pega a alguien. La BALA
		-- BRILLANTE viaja (todos la ven) y congela al llegar.
		local r = rt[plr]
		if not r or not r.toygun then return end
		if typeof(clave) ~= "table" then return end
		local objetivo, punto = clave.v, clave.p
		if typeof(punto) ~= "Vector3" then return end
		local ahora = os.clock()
		if ahora - (toygunCd[plr] or -99) &lt; 4 then
			return                         -- recargando (silencioso, sin toast)
		end
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local origen = root.Position + Vector3.new(0, 1, 0)
		local victima = nil
		if typeof(objetivo) == "Instance" and objetivo:IsA("Player")
			and objetivo ~= plr and objetivo.Character then
			local rv = objetivo.Character:FindFirstChild("HumanoidRootPart")
			if rv and (rv.Position - origen).Magnitude &lt;= 85 then
				victima = objetivo
				punto = rv.Position
			end
		end
		if not victima then
			-- click al aire/piso: raycast hacia el punto por si roza a alguien
			local dif = punto - origen
			if dif.Magnitude &lt; 1 or dif.Magnitude ~= dif.Magnitude then return end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { char }
			params.RespectCanCollide = true
			local rc = workspace:Raycast(origen, dif.Unit * math.min(dif.Magnitude + 6, 85), params)
			if rc then
				punto = rc.Position
				local mch = rc.Instance and rc.Instance.Parent
				local v = mch and Players:GetPlayerFromCharacter(mch)
				if not v and mch and mch.Parent then
					v = Players:GetPlayerFromCharacter(mch.Parent)
				end
				if v and v ~= plr then victima = v end
			end
		end
		if victima and rt[victima] and rt[victima].invisible then
			victima = nil          -- los invisibles no se congelan
		end
		toygunCd[plr] = ahora
		-- BALA BRILLANTE viajera: esfera neón celeste con luz, tween al punto
		local dist = (punto - origen).Magnitude
		local bala = Instance.new("Part")
		bala.Name = "BalaHielo"
		bala.Shape = Enum.PartType.Ball
		bala.Size = Vector3.new(0.9, 0.9, 0.9)
		bala.Anchored = true
		bala.CanCollide = false
		bala.Material = Enum.Material.Neon
		bala.Color = Color3.fromRGB(150, 225, 255)
		bala.CFrame = CFrame.new(origen)
		local luz = Instance.new("PointLight")
		luz.Color = Color3.fromRGB(150, 225, 255)
		luz.Range = 9
		luz.Brightness = 2
		luz.Parent = bala
		-- sonido del DISPARO en 3D desde el tirador: lo oyen todos los
		-- cercanos (cae con la distancia, tope 100 studs)
		local sndD = Instance.new("Sound")
		sndD.SoundId = "rbxassetid://1884211021"
		sndD.Volume = 1
		sndD.RollOffMaxDistance = 100
		sndD.Parent = root
		sndD:Play()
		task.delay(4, function() sndD:Destroy() end)
		bala.Parent = workspace
		local dur = math.max(0.08, dist / 180)   -- vuela a ~180 studs/s
		TweenService:Create(bala, TweenInfo.new(dur, Enum.EasingStyle.Linear),
			{CFrame = CFrame.new(punto)}):Play()
		task.delay(dur, function()
			if bala.Parent then bala:Destroy() end
			if victima then congelarJugador(victima) end
		end)
		return
	end
	if tipo == "bananaSoltar" then
		-- 🍌 suelta una banana-trampa al ras del piso, detrás del jugador.
		-- El que la pise (cualquiera; el dueño tiene 1.5 s de gracia para no
		-- auto-caerse) se RESBALA (FX cliente) y la banana se consume.
		local r = rt[plr]
		if not r or not r.banana then
			toast(plr, "bananaFalta")
			return
		end
		local ahora = os.clock()
		if ahora - (bananaCd[plr] or -99) &lt; 20 then
			toast(plr, "bananaCd")
			return
		end
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		bananaCd[plr] = ahora
		local origen = root.Position   -- justo donde estás parado
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		local rc = workspace:Raycast(origen + Vector3.new(0, 3, 0),
			Vector3.new(0, -14, 0), params)
		local py = rc and (rc.Position.Y + 1.35) or (root.Position.Y - 1.5)   -- +1.35: el mesh cuelga ~1.3 bajo su centro
		local b = Instance.new("Part")
		b.Name = "BananaTrampa"
		b.Size = Vector3.new(2.6, 0.9, 2.6)
		b.Anchored = true
		b.CanCollide = false
		b.Color = Color3.fromRGB(255, 220, 80)
		b.Material = Enum.Material.SmoothPlastic
		b.CFrame = CFrame.new(origen.X, py, origen.Z)
			* CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
		local sm = Instance.new("SpecialMesh")
		sm.MeshType = Enum.MeshType.FileMesh
		sm.MeshId = "rbxassetid://13270142186"
		sm.Scale = Vector3.new(2, 2, 2)
		sm.Parent = b
		local dueno, usada = plr, false
		b.Touched:Connect(function(hit)
			if usada then return end
			-- (jugadorDe se define más abajo en el archivo → detección inline)
			local mch = hit and hit.Parent
			local v = mch and Players:GetPlayerFromCharacter(mch)
			if not v and mch and mch.Parent then
				v = Players:GetPlayerFromCharacter(mch.Parent)
			end
			if not v then return end
			if v == dueno then return end   -- tus bananas JAMÁS te tumban a ti
			usada = true
			-- sonido del RESBALÓN en 3D pegado a la víctima: lo oyen TODOS los
			-- que estén cerca (cae con la distancia, tope ~90 studs)
			local snd = Instance.new("Sound")
			snd.SoundId = "rbxassetid://136774133309136"
			snd.Volume = 1
			snd.RollOffMaxDistance = 90
			snd.Parent = hit
			snd:Play()
			task.delay(4, function() snd:Destroy() end)
			RE.FX:FireClient(v, "resbalon")
			b:Destroy()
		end)
		task.delay(60, function()   -- 60 s sin pisarse → desaparece sola
			if b.Parent then b:Destroy() end
		end)
		b.Parent = workspace
		return
	end
	if tipo == "pase" then
		local info = Config.GAMEPASSES[clave]
		if not info then return end
		if tienePase(plr, clave) then
			-- SOLO los 4 botones de la columna de pases: si ya lo tiene, que el
			-- CLIENTE ejecute la acción (abrir/activar/equipar) en vez de avisar.
			-- El server es la fuente de verdad, así que esto funciona aunque el
			-- S.pases del cliente venga desincronizado.
			if clave == "admin" or clave == "invisible"
					or clave == "giant" or clave == "god" then
				RE.FX:FireClient(plr, "usarPase", clave)
			else
				toast(plr, "yaObjeto")   -- resto (carpet, speed2x): avisar
			end
			return
		end
		if info.id &gt; 0 then
			MarketplaceService:PromptGamePassPurchase(plr, info.id)
		elseif ES_STUDIO then
			otorgarPase(plr, clave)
			toast(plr, "pruebaGratis")
		else
			toast(plr, "sinId")
		end
	elseif tipo == "producto" then
		local info = Config.PRODUCTOS[clave]
		if not info then return end
		-- productos de AZAR: respetan ArePaidRandomItemsRestricted
		if (clave == "crategalactic" or clave == "spins5") and azarBloqueado(plr) then
			toast(plr, "sinAzar")
			return
		end
		-- COILS PERMANENTES (perfil.coils): si ya lo tiene, avisar en vez de
		-- dejar que pague Robux otra vez por algo que no le va a dar nada
		local pfProd = perfiles[plr]
		if pfProd and pfProd.coils
			and ((clave == "speedcoil" and pfProd.coils.speed)
				or (clave == "jumpcoil" and pfProd.coils.jump)) then
			toast(plr, "yaObjeto")
			return
		end
		if info.id &gt; 0 then
			MarketplaceService:PromptProductPurchase(plr, info.id)
		elseif ES_STUDIO then
			otorgarProducto(plr, clave)
			toast(plr, "pruebaGratis")
		else
			toast(plr, "sinId")
		end
	elseif tipo == "freeslap" then
		-- botón FREE BAT (antes daba la slap GIANT; cambiado 2026-07-25): tras la
		-- espera de FREESLAP_CD el BATE se añade al inventario y queda PERMANENTE.
		-- Se guarda en perfil.gears (igual que la comprada con cash) para que
		-- sobreviva a cerrar sesión y NO dependa de r.slapUntil, que los premios
		-- temporales de la ruleta sobrescribían (bug: se perdía a los 10 min y
		-- el juego volvía a pedir Robux).
		local r = rt[plr]
		if not r then return end
		if r.pases.bat then return end                      -- ya lo tiene
		if plr:GetAttribute("SlapGratis") then return end   -- ya lo reclamó
		local listoEn = tonumber(plr:GetAttribute("FreeSlapEn")) or 0
		if workspace:GetServerTimeNow() &lt; listoEn - 1 then   -- 1 s de tolerancia
			return                                            -- aún no toca
		end
		local perfilFS = perfiles[plr]
		if perfilFS then
			perfilFS.gears = perfilFS.gears or {}
			perfilFS.gears.bat = true          -- PERMANENTE en el DataStore
		end
		r.pases.bat = true                     -- activo ya en esta sesión
		darBate(plr)                           -- 🏏 al inventario AHORA MISMO
		plr:SetAttribute("SlapGratis", true)   -- el cliente pinta "¡ACTIVO!"
		RE.FX:FireAllClients("confeti",
			plr.Character and plr.Character:GetPivot().Position or Vector3.zero)
		marcar(plr)
	end
end)

-- ─── RULETA ────────────────────────────────────────────────
local pesoTotal = 0
for _, s in ipairs(Config.RULETA) do pesoTotal = pesoTotal + s.peso end
local impulsoRueda = 0  -- acelerón de la rueda física cuando alguien gira

RE.Girar.OnServerEvent:Connect(function(plr)
	if not limitar(plr, "girar", 1) then return end
	local perfil, r = perfiles[plr], rt[plr]
	if not perfil or not r then return end
	if os.clock() - r.ultimoGiro &lt; 3.5 then return end
	-- pagar el giro
	if perfil.fechaSpin ~= hoyMX() then
		perfil.fechaSpin = hoyMX()
		toast(plr, "spinGratis")
	elseif perfil.spinsExtra &gt; 0 then
		perfil.spinsExtra = perfil.spinsExtra - 1
	elseif not cobrar(plr, Config.SPIN_PRECIO_CASH) then
		toast(plr, "spinSinCash")
		return
	else
		toast(plr, "spinPagado", Config.SPIN_PRECIO_CASH)
	end
	r.ultimoGiro = os.clock()
	-- premio ponderado
	local tiro, idx = math.random() * pesoTotal, 1
	for i, s in ipairs(Config.RULETA) do
		tiro = tiro - s.peso
		if tiro &lt;= 0 then idx = i break end
	end
	local premio = Config.RULETA[idx]
	RE.Ruleta:FireClient(plr, idx)
	RE.FX:FireAllClients("ruleta")
	impulsoRueda = 0.6
	task.delay(3, function()
		if not plr.Parent then return end
		local perfil = perfiles[plr]
		if not perfil then return end
		if premio.tipo == "cash" then
			darCash(plr, premio.valor)
			toast(plr, "premioCash", Config.formatoCash(premio.valor))
		elseif premio.tipo == "speed" then
			-- PERMANENTE (2026-07-23): la ruleta ahora da coils/alfombra/slap para
			-- SIEMPRE (perfil.coils/gears persisten en el DataStore), no 15 min.
			perfil.coils.speed = true
			rt[plr].equip.speed = true
			refrescarGear(plr)
			toast(plr, "premioSpeed")
		elseif premio.tipo == "jump" then
			perfil.coils.jump = true
			rt[plr].equip.jump = true
			refrescarGear(plr)
			toast(plr, "premioJump")
		elseif premio.tipo == "fly" then
			perfil.gears.carpet = true          -- gear PERMANENTE (carga en r.pases al reunirse)
			rt[plr].pases.carpet = true
			rt[plr].equip.carpet = true
			refrescarGear(plr)
			toast(plr, "premioFly")
		elseif premio.tipo == "slap" then
			perfil.gears.giant = true           -- giant slap PERMANENTE
			rt[plr].pases.giant = true
			toast(plr, "premioSlap")
		end
		marcar(plr)
	end)
	marcar(plr)
end)

-- ─── TIENDAS ───────────────────────────────────────────────
-- CRATES v2: cajas con premios por PESO (cash o gears permanentes). El server
-- cobra, sortea y APLICA el premio al instante; el cliente solo ve la ruleta
-- plana (FX "crateGira" con el índice ganador). Gear repetido = reembolso.
RE.ComprarCrate.OnServerEvent:Connect(function(plr, crateId)
	if not limitar(plr, "crate", 2) then return end
	local perfil, r = perfiles[plr], rt[plr]
	if not perfil or not r then return end
	local def
	for _, c in ipairs(Config.CRATES) do
		if c.id == crateId then def = c break end
	end
	if not def then return end
	if def.id == "galactic" then return end
	-- ⚠️ 2026-07-19: las cajas con CASH ya NO consultan la política. El cash se
	-- gana JUGANDO (monedas, estrella, obbys, cofre), así que no son "objetos
	-- aleatorios de pago". La política se sigue respetando ESTRICTAMENTE en lo
	-- que sí se compra con Robux: Galactic Crate y 5 Spins (ver RE.Prompt).
	-- Causa: PolicyService devolvía restringido=true y mataba TODAS las cajas.
	if not cobrar(plr, def.precio) then
			toast(plr, "sinCash")
		return
	end
	entregarCaja(plr, def)
end)

RE.ComprarGear.OnServerEvent:Connect(function(plr, tipo)
	if not limitar(plr, "gear", 2) then return end
	local perfil = perfiles[plr]
	if not perfil then return end
	if tipo == "speed" and not perfil.coils.speed then
		if cobrar(plr, Config.GEAR_SPEED_CASH) then
			perfil.coils.speed = true
			toast(plr, "gearOk")
			RE.FX:FireClient(plr, "compraOk")
		else
			toast(plr, "sinCash")
		end
	elseif tipo == "jump" and not perfil.coils.jump then
		if cobrar(plr, Config.GEAR_JUMP_CASH) then
			perfil.coils.jump = true
			toast(plr, "gearOk")
			RE.FX:FireClient(plr, "compraOk")
		else
			toast(plr, "sinCash")
		end
	elseif Config.GEARS_CASH[tipo] then
		-- elemento PERMANENTE por cash (carpet/giant/god/speed2x/invisible):
		-- se guarda en perfil.gears (DataStore) y se otorga como pase
		local r = rt[plr]
		if r and not r.pases[tipo] then
			if cobrar(plr, Config.GEARS_CASH[tipo]) then
				perfil.gears = perfil.gears or {}
				perfil.gears[tipo] = true
				otorgarPase(plr, tipo)
				RE.FX:FireClient(plr, "compraOk")
			else
				toast(plr, "sinCash")
			end
		end
	end
	marcar(plr)
end)

-- ─── HOTBAR (equipar coils / alfombra) ─────────────────────
RE.Hotbar.OnServerEvent:Connect(function(plr, slot, on)
	if not limitar(plr, "hotbar", 6) then return end
	local r, perfil = rt[plr], perfiles[plr]
	if not r or not perfil then return end
	on = on and true or false
	local ahora = os.clock()
	if slot == 1 then
		-- 🕊 el God Mode presta el vuelo SIN tener el pase (2026-08-05)
		if on and not (r.pases.carpet or r.flyUntil &gt; ahora
				or (Config.GOD_VUELO and r.godUntil &gt; ahora)) then
			desequipar(plr)                  -- no la tienes: fuera de la mano
			promptPase(plr, "carpet")        -- y aviso gris de compra (Robux)
			return
		end
		r.equip.carpet = on
		toast(plr, on and "carpetOn" or "carpetOff")
	elseif slot == 2 then
		if on and not (perfil.coils.speed or r.speedUntil &gt; ahora) then
			desequipar(plr)
			promptProducto(plr, "speedcoil") -- aviso gris de compra con Robux
			return
		end
		r.equip.speed = on
	elseif slot == 3 then
		if on and not (perfil.coils.jump or r.jumpUntil &gt; ahora) then
			desequipar(plr)
			promptProducto(plr, "jumpcoil")  -- aviso gris de compra con Robux
			return
		end
		r.equip.jump = on
	end
	refrescarGear(plr)
	marcar(plr)
end)

-- ─── SLAP (guantes) y PUSH ─────────────────────────────────
local function flingear(victima, dir, fuerza, sinGrito)
	-- 👻 INVISIBLE = intocable: si la víctima está invisible, ni slap ni push
	-- la mueven (ventaja del pase, pedido 2026-07-17)
	local rv = rt[victima]
	if rv and rv.invisible then return end
	-- 🛡 GOD MODE = INTOCABLE (2026-08-05): ni la slap GOD, ni la GIANT, ni el
	-- bate lo mueven. Único punto por el que pasa TODO empujón del juego, así
	-- que con este return se cubren los tres de golpe. (El admin tiene
	-- godUntil = math.huge → también queda cubierto.)
	if Config.GOD_ANTIEMPUJE and rv and rv.godUntil &gt; os.clock() then return end
	local char = victima.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local vel = dir * fuerza + Vector3.new(0, fuerza * 0.45, 0)
	root.AssemblyLinearVelocity = vel            -- intento server (a veces lo pisa el dueño)
	-- FIABLE: el CLIENTE dueño del personaje aplica el impulso, así su propia
	-- física NO lo sobreescribe (el server sigue decidiendo a quién y con qué fuerza)
	RE.FX:FireClient(victima, "fling", dir, fuerza)
	-- sonido del fling (~2 pisos). El SERVER tira el 10% UNA vez para que TODOS
	-- oigan el mismo sonido en esta cachetada (grito 90% / alterno 10%).
	-- sorteo del sonido del fling (2026-07-19): 50% SILENCIO, 40% grito,
	-- 10% "enrique". Si toca silencio, ni se dispara el FX.
	if sinGrito then return end   -- 🏏 bate: su sonido lo pone el FX "batHit"
	local rSnd = math.random()
	if rSnd &gt;= 0.5 then
		RE.FX:FireAllClients("flingSonido", root.Position, rSnd &gt;= 0.9)
	end
end

RE.Slap.OnServerEvent:Connect(function(plr, tipo)
	if not limitar(plr, "slap", 4) then return end
	local r = rt[plr]
	if not r then return end
	local ahora = os.clock()
	-- al EQUIPAR una slap sin haberla comprado: fuera de la mano + aviso gris
	if tipo == "equipar_god" or tipo == "equipar_giant" then
		local esG = (tipo == "equipar_god")
		local tiene = esG and r.pases.god
			or (not esG and (r.pases.giant or r.slapUntil &gt; ahora))
		if not tiene then
			desequipar(plr)
			promptPase(plr, esG and "god" or "giant")
		end
		return
	end
	if tipo == "bat" then
		-- 🏏 BATE (slap LITE, 2026-07-25): GRATIS, sin pase. Solo TUMBA
		-- (el FX "fling" del cliente pone PlatformStand + giro) con empuje casi
		-- nulo (BAT_FUERZA=6; caminar es 16): molesta y da risa, NO tira de la
		-- torre. Cooldown PROPIO (r.ultimoBat): si compartiera r.ultimoSlap,
		-- el bate gratis "descargaría" las manitas de pago.
		if ahora - (r.ultimoBat or 0) &lt; Config.BAT_COOLDOWN then return end
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local victima, distMin = nil, Config.SLAP_RANGO
		for _, otro in ipairs(Players:GetPlayers()) do
			if otro ~= plr then
				local oroot = otro.Character and otro.Character:FindFirstChild("HumanoidRootPart")
				if oroot then
					local d = (oroot.Position - root.Position).Magnitude
					if d &lt; distMin then victima, distMin = otro, d end
				end
			end
		end
		if not victima then return end   -- nadie cerca: no pasa nada
		r.ultimoBat = ahora
		local vroot = victima.Character.HumanoidRootPart
		local dir = (vroot.Position - root.Position) * Vector3.new(1, 0, 1)
		dir = dir.Magnitude &gt; 0.1 and dir.Unit or root.CFrame.LookVector
		flingear(victima, dir, Config.BAT_FUERZA, true)   -- true = sin grito
		toast(victima, "push", plr.DisplayName)
		-- 🎲 30% de probabilidad del sonido "enrique" (el mismo raro que sale al
		-- 10% en las manitas). Se sortea AQUÍ para que TODOS oigan lo mismo.
		RE.FX:FireAllClients("batHit", vroot.Position, plr,
			math.random() &lt; 0.30)
		return
	end
	if ahora - r.ultimoSlap &lt; Config.SLAP_COOLDOWN then return end
	-- dos slaps SEPARADOS: "god" (rainbow, slot 4) vs "giant"/normal (slot 5)
	local esGod = (tipo == "god")
	local puede, fuerza
	if esGod then
		puede = r.pases.god
		fuerza = Config.SLAP_FUERZA_GOD
	else
		puede = r.pases.giant or r.slapUntil &gt; ahora
		fuerza = Config.SLAP_FUERZA
	end
	if not puede then
		promptPase(plr, esGod and "god" or "giant")   -- no lo tienes → abre la compra
		return
	end
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	r.ultimoSlap = ahora
	local victima, distMin = nil, Config.SLAP_RANGO
	for _, otro in ipairs(Players:GetPlayers()) do
		if otro ~= plr then
			local oroot = otro.Character and otro.Character:FindFirstChild("HumanoidRootPart")
			if oroot then
				local d = (oroot.Position - root.Position).Magnitude
				if d &lt; distMin then victima, distMin = otro, d end
			end
		end
	end
	if not victima then return end   -- nadie cerca: sin texto, simplemente no pasa nada
	local vroot = victima.Character.HumanoidRootPart
	local dir = (vroot.Position - root.Position) * Vector3.new(1, 0, 1)
	dir = dir.Magnitude &gt; 0.1 and dir.Unit or root.CFrame.LookVector
	flingear(victima, dir, fuerza)
	toast(victima, "push", plr.DisplayName)
	RE.FX:FireAllClients("slap", vroot.Position, esGod)
end)

-- ─── TOGGLE invisible ──────────────────────────────────────
local function ponerInvisible(char, on)
	for _, d in ipairs(char:GetDescendants()) do
		-- ⚠️ TranspFija = piezas cuya transparencia es parte del efecto y NO se
		-- puede pisar: el emisor de chispas (invisible del todo) y el aura de la
		-- skin. Antes esto las volvía opacas y salía un cubo gris en la cabeza.
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart"
				and not d:GetAttribute("TranspFija") then
			d.Transparency = on and 0.65 or 0
		elseif d:IsA("Decal") then
			d.Transparency = on and 0.65 or 0
		end
	end
end

RE.Toggle.OnServerEvent:Connect(function(plr, que, extra)
	if not limitar(plr, "toggle", 3) then return end
	local r = rt[plr]
	if not r then return end
	if que == "camfija" then
		-- 🔒 CANDADO DE CÁMARA del cliente táctil (2026-07-25). Se fija AQUÍ
		-- porque las propiedades Dev* de cámara son de SERVIDOR: cambiarlas solo
		-- en el LocalScript podía ignorarse (el botón parecía muerto).
		-- extra == true → Classic (quieta) · false → Follow (gira sola al andar).
		local fija = (extra == true)
		local okT = pcall(function()
			plr.DevTouchCameraMovementMode = fija
				and Enum.DevTouchCameraMovementMode.Classic
				or Enum.DevTouchCameraMovementMode.Follow
		end)
		if not okT then   -- respaldo por si esta versión usa el nombre corto
			pcall(function()
				plr.DevTouchCameraMode = fija
					and Enum.DevTouchCameraMovementMode.Classic
					or Enum.DevTouchCameraMovementMode.Follow
			end)
		end
		pcall(function()
			plr.DevComputerCameraMode = fija
				and Enum.DevComputerCameraMovementMode.Classic
				or Enum.DevComputerCameraMovementMode.Follow
		end)
	elseif que == "invisible" then
		if not r.pases.invisible then
			promptPase(plr, "invisible")   -- no lo tienes → abre la compra
			return
		end
		r.invisible = not r.invisible
		if plr.Character then ponerInvisible(plr.Character, r.invisible) end
		toast(plr, r.invisible and "invisibleOn" or "invisibleOff")
		marcar(plr)
	elseif que == "grupo" then
		local perfil = perfiles[plr]
		if perfil.regaloGrupo then
			toast(plr, "grupoYa")
			return
		end
		if not limitar(plr, "grupo", 1) then return end   -- 1 consulta/s por jugador
		local dentro = esDelGrupo(plr)
		if dentro == nil then toast(plr, "grupoError") return end
		if dentro then
			perfil.regaloGrupo = true
			darCash(plr, 500)
			toast(plr, "grupo")
		else
			toast(plr, "grupoNo")
		end
	end
end)

-- ─── ADMIN ─────────────────────────────────────────────────
-- ⚠️ EL CUERPO VA EN UNA FUNCIÓN, no pegado al remote (31 jul 2026). Lo llaman
-- DOS entradas: los botones del panel (RE.Admin) y los comandos de chat (/fly,
-- /cash...). Así los dos pasan por EXACTAMENTE la misma validación y la misma
-- lista blanca: añadir un comando nunca puede abrir un agujero que el panel no
-- tuviera ya.
local function ejecutarAdmin(plr, accion, arg)
	local r = rt[plr]
	local adminLibre = ES_STUDIO and Config.ADMIN_GRATIS_STUDIO
	if not r or not (r.pases.admin or adminLibre) then return end
	if accion == "tp" then
		local f = math.clamp(tonumber(arg) or 0, 0, NP + 1)
		if plr.Character then
			plr.Character:PivotTo(cframeEntrada(f))
		end
	elseif accion == "fly" then
		-- toggle vuelo: da la alfombra Y la equipa (lista para volar)
		local activo = r.flyUntil &gt; os.clock() + 86400
		if activo then
			r.flyUntil = 0
			r.equip.carpet = false
		else
			r.flyUntil = os.clock() + 86400 * 30
			r.equip.carpet = true
		end
		refrescarGear(plr)
		marcar(plr)
		toast(plr, activo and "🕊 Fly OFF" or "🕊 Fly ON — WASD + Space/Shift")
	elseif accion == "inmune" then
		local char = plr.Character
		if r.godUntil == math.huge then
			r.godUntil = 0
			local ff = char and char:FindFirstChildOfClass("ForceField")
			if ff then ff:Destroy() end
			toast(plr, "🛡 Immune OFF")
		else
			r.godUntil = math.huge
			if char and not char:FindFirstChildOfClass("ForceField") then
				local ff = Instance.new("ForceField")
				ff.Parent = char
			end
			toast(plr, "🛡 Immune ON — worms ignore you")
		end
		marcar(plr)
	elseif accion == "vel" then
		r.velAdmin = math.clamp(tonumber(arg) or 1, 1, 3)
		aplicarStats(plr)
		toast(plr, "⚡ Speed x" .. r.velAdmin)
	elseif accion == "salto" then
		r.saltoAdmin = not r.saltoAdmin
		aplicarStats(plr)
		toast(plr, r.saltoAdmin and "🦘 Super Jump ON" or "🦘 Super Jump OFF")
	elseif accion == "cash" then
		darCash(plr, 10000)
		toast(plr, "💵 +$10,000 (admin)")
	elseif accion == "spins" then
		local perfil = perfiles[plr]
		if perfil then
			perfil.spinsExtra = perfil.spinsExtra + 5
			marcar(plr)
			toast(plr, "🎡 +5 spins (admin)")
		end
	elseif accion == "killall" then
		-- COOLDOWN de 2 min: spamear Kill All frustra a los jugadores y los hace
		-- salir. Si lo intenta antes de tiempo → aviso rojo y NO se ejecuta.
		local ahora = os.clock()
		if r.killAllUntil and r.killAllUntil &gt; ahora then
			toast(plr, "killallCd")
			return
		end
		r.killAllUntil = ahora + 120   -- 120 s = 2 minutos
		otorgarProducto(plr, "killall")
	end
end

RE.Admin.OnServerEvent:Connect(function(plr, accion, arg)
	if not limitar(plr, "admin", 4) then return end
	ejecutarAdmin(plr, accion, arg)
end)

-- ─── COMANDOS DE CHAT DEL PANEL ADMIN (31 jul 2026) ────────
-- Escribes /fly en el chat y hace lo MISMO que el botón. Cada comando es un
-- alias hacia una acción de la lista blanca de arriba: el chat nunca ejecuta
-- texto, solo elige una entrada de esta tabla.
--
-- 🚨 POR QUÉ ASÍ Y NO CON UNA BARRA DE COMANDOS. El panel de la Toolbox que se
-- descartó traía `loadstring(value)()`: el cliente mandaba texto y el servidor
-- lo EJECUTABA. Con el pase Admin a la venta, eso significaría que cualquiera
-- que pague 399 Robux puede borrar el DataStore de todos los jugadores. Aquí lo
-- peor que puede pasar escribiendo cualquier cosa es que no pase nada.
local COMANDOS = {
	fly = "fly",
	tp = "tp",          -- /tp 15  → piso 15 (ejecutarAdmin ya lo acota a 0..NP+1)
	speed = "vel",   vel = "vel",
	jump = "salto",  salto = "salto",
	immune = "inmune", inmune = "inmune", god = "inmune",
	cash = "cash",   money = "cash",
	spins = "spins", giros = "spins",
	killall = "killall",
}

local function chatAdmin(plr, msg)
	if type(msg) ~= "string" or msg:sub(1, 1) ~= "/" then return end
	local r = rt[plr]
	local adminLibre = ES_STUDIO and Config.ADMIN_GRATIS_STUDIO
	-- silencio total si no tiene el pase: un jugador normal que escriba /fly no
	-- debe enterarse siquiera de que estos comandos existen
	if not r or not (r.pases.admin or adminLibre) then return end
	if not limitar(plr, "admin", 4) then return end
	-- "/speed 3" → cmd="speed", arg="3". El separador es cualquier espacio; se
	-- acepta "/KillAll" igual que "/killall".
	local cmd, arg = msg:match("^/(%a+)%s*(.*)$")
	if not cmd then return end
	cmd = cmd:lower()
	if cmd == "cmds" or cmd == "help" or cmd == "ayuda" then
		toast(plr, "/fly · /tp 15 · /speed 3 · /jump · /immune · /cash · /spins · /killall")
		return
	end
	local accion = COMANDOS[cmd]
	if not accion then
		-- ⚠️ el texto DEBE llevar espacios: el respaldo del cliente solo pinta lo
		-- que los tiene, para no enseñar claves cortas como "grupoNo"
		toast(plr, "❓ /" .. cmd .. " no existe — escribe /cmds")
		return
	end
	ejecutarAdmin(plr, accion, arg ~= "" and arg or nil)
end

Players.PlayerAdded:Connect(function(plr)
	-- ⚠️ Player.Chatted, no TextChatCommand. Chatted sigue disparándose con
	-- TextChatService y corre EN EL SERVIDOR, que es donde tiene que decidirse
	-- quién es admin. Un TextChatCommand vive en el cliente y habría que
	-- confiar en él para saber si el jugador pagó el pase.
	plr.Chatted:Connect(function(msg)
		pcall(chatAdmin, plr, msg)
	end)
end)
for _, plr in ipairs(Players:GetPlayers()) do
	plr.Chatted:Connect(function(msg) pcall(chatAdmin, plr, msg) end)
end

-- ─── MUNDO: monedas, claims, bonos de piso, cofre, puertas ─
local cooldowns = {} -- [uid.."|"..clave] = os.clock() de expiración
local function enCooldown(plr, clave, seg)
	local k = plr.UserId .. "|" .. clave
	local ahora = os.clock()
	if cooldowns[k] and cooldowns[k] &gt; ahora then
		return math.ceil((cooldowns[k] - ahora))
	end
	cooldowns[k] = ahora + seg
	return nil
end

local function jugadorDe(hit)
	local char = hit and hit.Parent
	if not char then return nil end
	if not char:FindFirstChildOfClass("Humanoid") then
		char = char.Parent
		if not char or not char:FindFirstChildOfClass("Humanoid") then return nil end
	end
	return Players:GetPlayerFromCharacter(char)
end

-- ─── FIN DE OBBY: botón con cuenta atrás que teletransporta en 3 s ───
local tpPend = {}   -- [plr] = token del teletransporte pendiente
local function finObby(plr)
	if not plr or not plr.Character then return end
	if enCooldown(plr, "tpObby", 6) then return end
	local token = os.clock()
	tpPend[plr] = token
	RE.ObbyFin:FireClient(plr)   -- dispara la transición de pantalla blanca (~2 s)
	task.delay(0.9, function()   -- teletransporta cuando el blanco YA tapa la pantalla
		-- 🧹 FUGA ARREGLADA (2026-07-26). Antes la condición era
		--     if tpPend[plr] == token and plr.Parent and plr.Character then
		-- o sea que la limpieza vivía DENTRO del if: si el jugador se iba o
		-- moría en esos 0.9 s, la entrada no se borraba jamás. Y como la clave
		-- es el objeto Player, eso impedía liberarlo. Misma clase de fuga que
		-- se cerró en cubos/cooldowns el 2026-07-25; esta se escapó.
		-- Ahora se limpia SIEMPRE y el teletransporte se hace solo si queda
		-- alguien a quien mover. Salir por token distinto = otro finObby más
		-- nuevo ya tomó el relevo, así que este no debe tocar nada.
		if tpPend[plr] ~= token then return end
		tpPend[plr] = nil
		if plr.Parent and plr.Character then
			plr.Character:PivotTo(cframeEntrada(0))
		end
	end)
end
-- clic en el botón: teletransportar YA (sin esperar los 3 s)
RE.ObbyFin.OnServerEvent:Connect(function(plr)
	if tpPend[plr] and plr.Character then
		tpPend[plr] = nil
		plr.Character:PivotTo(cframeEntrada(0))
	end
end)

local toygunPromptOk = false   -- prompt de la Toy Gun: solo en 1 de sus 34 piezas

-- ─── ESTRELLA GIGANTE: poder de rebote GLOBAL ajustable ───
local estrellaImpulso = 95          -- botones SALTO (50..170)
local estrellaVel = 1               -- botones VEL: multiplicador de velocidad (0.5..3)
local estrellaTxt = nil             -- label del cartel de SALTO
local estrellaVelTxt = nil          -- label del cartel de VEL
local function estrellaCartel()
	-- publica los valores como ATRIBUTOS: el CLIENTE aplica el rebote al
	-- instante leyéndolos (ya no hay viaje al server por cada salto)
	workspace:SetAttribute("EstrellaImpulso", estrellaImpulso)
	workspace:SetAttribute("EstrellaVel", estrellaVel)
	if estrellaTxt then
		estrellaTxt.Text = 'JUMP: &lt;font color="#55EB55"&gt;' .. estrellaImpulso .. "&lt;/font&gt;"
	end
	if estrellaVelTxt then
		estrellaVelTxt.Text = 'SPEED: &lt;font color="#55EB55"&gt;x' .. estrellaVel .. "&lt;/font&gt;"
	end
end
estrellaCartel()

-- lista de TODAS las monedas → el loop de recolección por DISTANCIA de abajo
-- (el d.Touched del server se salta ~90% porque el personaje es del CLIENTE)
local monedas = {}
for _, d in ipairs(Mapa:GetDescendants()) do
	if not d:IsA("BasePart") then continue end
	if d.Name == "MonedaOro" then
		-- clave ÚNICA por moneda (por posición): antes GetFullName daba la
		-- misma clave a todas las monedas y solo la 1ª pagaba
		local pos = d.Position
		local clave = string.format("moneda%d_%d_%d",
			math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z))
		-- guardamos el PISO de cada moneda para el bucle por-piso (abajo):
		-- así un jugador solo revisa las monedas de SU piso, no las 61
		monedas[#monedas + 1] = {part = d, clave = clave,
			piso = Config.pisoDe(d.Position.Y)}
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr or not perfiles[plr] then return end
			if enCooldown(plr, clave, Config.MONEDA_RESPAWN) then return end
			darCash(plr, Config.MONEDA_ORO)
			RE.FX:FireClient(plr, "moneda", d, Config.MONEDA_ORO)
		end)
	elseif d.Name == "ClaimPad" then
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr or not perfiles[plr] then return end
			finObby(plr)   -- llegaste a la meta → teletransporte en 3 s
			-- clave UNICA por placa (por POSICION): los 4 ClaimPad se llaman igual y
			-- viven en el mismo modelo "Parkour", asi que GetFullName() daba la MISMA
			-- cadena a todos -&gt; un solo cooldown compartido y solo el 1o pagaba.
			local pos = d.Position
			local clave = string.format("claim%d_%d_%d",
				math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z))
			local resta = enCooldown(plr, clave, Config.CLAIM_COOLDOWN)
			if resta then
				RE.ClaimCd:FireClient(plr, d, resta)   -- re-sincroniza su cronómetro local
				if not enCooldown(plr, "claimAviso", 5) then
					toast(plr, "claimCd", math.ceil(resta / 60))
				end
				return
			end
			darCash(plr, Config.CLAIM_PREMIO)
			toast(plr, "claim", Config.CLAIM_PREMIO)
			RE.ClaimCd:FireClient(plr, d, Config.CLAIM_COOLDOWN)   -- arranca su cronómetro
			RE.FX:FireAllClients("confeti", d.Position)
			RE.FX:FireClient(plr, "obbyCompletado")   -- sonido de obby completado (solo tú)
			RE.FX:FireClient(plr, "dineroFlota", d.Position, Config.CLAIM_PREMIO)   -- +$X flotante con billetes
		end)
	elseif d.Name:match("^CheckpointBtn_") or d.Name:match("^PisoBono_")
		or d.Name:match("^EscCheckpoint_") then
		-- Tres cosas distintas caen aquí, y las tres hacen LO MISMO:
		--   CheckpointBtn_&lt;n&gt;  el botón visible de la plataforma del piso n
		--   PisoBono_&lt;n&gt;       la losa de la azotea
		--   EscCheckpoint_&lt;n&gt;  disparador invisible dentro de la escalera vertical
		--                      de pared (pisos 1 y 2), para que trepar por ahí dé
		--                      checkpoint y bono igual que subir por la espiral.
		-- ⚠️ EscCheckpoint_ NO puede llamarse CheckpointBtn_: el cliente busca el
		-- botón que tiene que pintar de VERDE con FindFirstChild(nombre, true) y
		-- con el nombre duplicado encontraba la caja invisible de la escalera, así
		-- que el botón real de los pisos 1 y 2 no se iluminaba nunca.
		-- SOLO el botón (o la losa de la azotea) dispara el checkpoint.
		-- Cada piso se activa UNA vez por sesión: así la cabeza/ragdoll que
		-- cae atravesando pisos ya activados no lanza mil notificaciones.
		local f = tonumber(d.Name:match("%d+"))
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr or not perfiles[plr] or not f then return end
			local r, perfil = rt[plr], perfiles[plr]
			if r.pisosActivados[f] then return end
			-- 🔁 YA LO TENÍA → NADA. Ni verde, ni rebote, ni sonido, ni dinero.
			-- La celebración es UNA por subida y por piso: la primera vez que lo
			-- tocas, da igual si fue el botón de la plataforma o el disparador de
			-- la escalera de pared, porque el cliente pinta SIEMPRE el botón real.
			-- Vuelve a estar disponible solo con el pad "Return to obby", que es
			-- lo único que limpia pisosActivados (y repinta los botones).
			--
			-- ⚠️ Del 28 al 29 de julio esto reenviaba el FX con esNuevo=false para
			-- que el botón "se sintiera vivo" al pisarlo después de haber trepado.
			-- Era un parche a otra cosa: el botón no se iluminaba porque el cliente
			-- pintaba la caja invisible de la escalera (mismo nombre, ver arriba).
			-- Arreglado el nombre, el reenvío solo servía para repetir animación y
			-- sonido cada vez que alguien bajaba y volvía a cruzar el botón.
			-- ⏱ VENTANA DE GRACIA tras reiniciar en el pad "Return to obby": al
			-- limpiar pisosActivados el jugador TODAVÍA sigue parado en la azotea
			-- un instante, así que PisoBono_21 se disparaba de nuevo y (1) le
			-- volvía a pagar los 2,100 —a veces dos veces, porque Touched se
			-- repite— y (2) le devolvía el checkpoint 21, por lo que al caer en
			-- el lobby le salía "BACK TO THE ROOF". Con esto no cobra nada hasta
			-- estar lejos; abajo no hay ningún checkpoint a 2 s de distancia.
			if os.clock() - (r.reinicioT or 0) &lt; 2 then return end
			r.pisosActivados[f] = true
			if f &gt; r.checkpointPiso then r.checkpointPiso = f end
			funnelPiso(plr, f)   -- 📊 pasos 3-7 del embudo
			if f &gt; perfil.pisoMax then perfil.pisoMax = f end
			local premio = Config.BONO_POR_PISO * f
			darCash(plr, premio)
			RE.Checkpoint:FireClient(plr, f, premio, true)
			marcar(plr)
		end)
	elseif d.Name == "CofreMeta" then
		-- ACERCARSE al cofre → ABRE la ventana de reclamo SOLO si el cofre está
		-- ARMADO (una vez por subida). Si el jugador acampa arriba tras reclamar,
		-- la ventana NO se reabre: se le avisa que baje a la base y vuelva a subir.
		d.Touched:Connect(function(hit)
			local plr = jugadorDe(hit)
			if not plr or not perfiles[plr] then return end
			local r = rt[plr]
			if not r then return end
			if enCooldown(plr, "cofreAviso", 3) then return end
			if not r.cofreArmado then
				if r.bajoALaBase then
					-- bajó a la base y RE-SUBIÓ VIVO hasta aquí (sin morir) → se arma
					r.cofreArmado = true
					r.bajoALaBase = false
				else
					toast(plr, "cofreBaja")       -- baja a la base y RE-SUBE (vivo) para reabrir
					return
				end
			end
			RE.FX:FireClient(plr, "abrirCofre", Config.COFRE_META)
		end)
		-- el botón "Claim" de la ventana llama a esto (RE.Prompt "cofre"): premio
		-- completo + copa, y el cofre queda DESARMADO hasta bajar a la base.
		reclamarCofre = function(plr)
			local r = rt[plr]
			if not perfiles[plr] or not r then return end
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root or (root.Position - d.Position).Magnitude &gt; 45 then return end  -- debe estar en la cima
			if not r.cofreArmado then return end   -- anti doble-claim / camping
			r.cofreArmado = false
			local perfil = perfiles[plr]
			darCash(plr, Config.COFRE_META)
			perfil.trofeos = perfil.trofeos + 1
			perfil.victorias = perfil.victorias + 1
			if plr:FindFirstChild("leaderstats") then
				plr.leaderstats.Trophies.Value = perfil.trofeos
			end
			toast(plr, "cofre", Config.formatoCash(Config.COFRE_META))
			toastTodos("victoria", plr.DisplayName)
			RE.FX:FireAllClients("fuegos", d.Position)
			RE.FX:FireClient(plr, "sonidoGanar")   -- sonido de ganar (ruleta de cajas)
			RE.FX:FireClient(plr, "trofeo", d.Position, 1)   -- animación +1 trofeo
			if Config.BADGE_CIMA &gt; 0 then
				pcall(function() BadgeService:AwardBadge(plr.UserId, Config.BADGE_CIMA) end)
			end
			marcar(plr)
		end
	elseif d.Name == "ToyGunVitrina" and not toygunPromptOk then
		-- 🔫 tomar la pistola (el modelo son 34 piezas con el mismo nombre:
		-- el prompt va SOLO en la primera que aparezca)
		toygunPromptOk = true
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Take"
		pp.ObjectText = "Toy Gun"
		pp.HoldDuration = 0
		pp.MaxActivationDistance = 12
		pp.RequiresLineOfSight = false
		pp.Parent = d
		pp.Triggered:Connect(function(jug)
			local r = rt[jug]
			if not r then return end
			if r.toygun then
				toast(jug, "toygunYa")
				return
			end
			r.toygun = true
			darToyGun(jug)   -- sin toast: el slot 7 apareciendo ya lo anuncia
		end)
	elseif d.Name == "BananaVitrina" then
		-- 🍌 tomar la banana de la vitrina → desbloquea la banana-trampa (slot 6)
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Take"
		pp.ObjectText = "Banana"
		pp.HoldDuration = 0
		pp.MaxActivationDistance = 10
