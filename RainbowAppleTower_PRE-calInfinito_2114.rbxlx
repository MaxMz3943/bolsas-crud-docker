local marcadores = {} -- [userId] = {frame, avatar, tri}
-- curva de progreso: RÁPIDO al inicio, LENTO al final (raíz), completa
-- exactamente al llegar a la cima — sensación equivalente a la torre
local function barFrac(prog)
	return math.clamp(prog, 0, 1) ^ 0.55
end
local function barX(prog) return 0.02 + barFrac(prog) * 0.9 end

local function marcadorDe(jugador)
	local m = marcadores[jugador.UserId]
	if m then return m end
	local f = nuevo("Frame", {
		Size = UDim2.new(0, 26, 0, 44), BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.02, 0, 0, 2),
	}, barra)
	-- estela (trail) detrás del avatar: crece y brilla cuando avanzas rápido
	local trail = nuevo("Frame", {
		Size = UDim2.new(0, 4, 0, 18), Position = UDim2.new(0.5, -13, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Color3.fromRGB(130, 225, 255),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
	}, f)
	esquinas(trail, 8)
	nuevo("UIGradient", {Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})}, trail)
	local av = nuevo("ImageLabel", {
		Size = UDim2.new(0, 26, 0, 26), Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(40, 40, 55),
		BackgroundTransparency = 0.25, BorderSizePixel = 0, Image = "", ZIndex = 2,
	}, f)
	esquinas(av, 5)
	if jugador == plr then borde(av, 2, Color3.new(1, 1, 1)) end
	local tri = nuevo("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, 28),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, Text = "▲",
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4,
		TextSize = 14, ZIndex = 2,
	}, f)
	m = {frame = f, avatar = av, tri = tri, trail = trail,
		actual = 0.02, objetivo = 0.02}
	marcadores[jugador.UserId] = m
	task.spawn(function()
		local img
		for _ = 1, 4 do                       -- reintenta: la foto a veces falla la 1ª vez
			local ok, res = pcall(function()
				return Players:GetUserThumbnailAsync(jugador.UserId,
					Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)
			if ok and res and res ~= "" then img = res break end
			task.wait(0.6)
		end
		if not f.Parent then return end
		if img then
			av.Image = img
		else
			-- respaldo (p.ej. jugadores SIMULADOS de Studio con UserId falso):
			-- la inicial del nombre en vez de una caja vacía
			local ini = (jugador.DisplayName or jugador.Name or "?"):sub(1, 1):upper()
			nuevo("TextLabel", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
				Font = Enum.Font.FredokaOne, Text = ini,
				TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 3,
			}, av)
		end
	end)
	return m
end

-- fija el OBJETIVO de cada marcador (con la curva) cada poco
task.spawn(function()
	while true do
		task.wait(0.25)
		local vivos = {}
		for _, jug in ipairs(Players:GetPlayers()) do
			local root = jug.Character and jug.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local prog = math.clamp(root.Position.Y / topY, 0, 1)
				marcadorDe(jug).objetivo = barX(prog)
				vivos[jug.UserId] = true
			end
		end
		for uid, m in pairs(marcadores) do
			if not vivos[uid] then
				m.frame:Destroy()
				marcadores[uid] = nil
			end
		end
	end
end)

-- suavizado por frame + efecto de "avance veloz" (estira + estela + brillo)
RunService.RenderStepped:Connect(function(dt)
	for _, m in pairs(marcadores) do
		if m.frame and m.frame.Parent then
			local antes = m.actual
			m.actual = m.actual + (m.objetivo - m.actual) * math.min(1, dt * 5)
			-- ⚡ SNAP + ESCRITURA CONDICIONAL (2026-07-26)
			-- El suavizado de arriba recorre una FRACCIÓN de lo que falta, así que
			-- matemáticamente NUNCA llega: a ~1,5 s la diferencia ya es de
			-- millonésimas de píxel, pero seguía escribiendo 4 propiedades por
			-- jugador y por frame ETERNAMENTE (con 20 jugadores, 4.800/s de las
			-- cuales casi ninguna cambiaba nada). Cerrando el hueco a mano el
			-- marcador queda QUIETO de verdad y el bucle deja de tocar la UI.
			-- 1e-4 de escala = 0,1 px en una barra de 1000: invisible.
			if math.abs(m.objetivo - m.actual) &lt; 1e-4 then
				m.actual = m.objetivo
			end
			-- velocidad (fracción de barra por segundo) → intensidad 0..1
			local vel = (m.actual - antes) / math.max(dt, 1 / 120)
			local intens = math.clamp(vel * 3.5, 0, 1)
			local iAntes = m.intens or 0
			m.intens = iAntes + (intens - iAntes) * 0.3
			if m.intens &lt; 1e-3 then m.intens = 0 end   -- misma razón: 0,01 px
			if m.actual ~= antes then
				m.frame.Position = UDim2.new(m.actual, 0, 0, 2)
			end
			if m.intens ~= iAntes then
				local iv = m.intens
				-- avatar se estira en horizontal (motion blur) al ir rápido
				m.avatar.Size = UDim2.new(0, 26 + iv * 12, 0, 26 - iv * 3)
				-- estela detrás, más larga y brillante cuanto más rápido
				m.trail.Size = UDim2.new(0, 5 + iv * 46, 0, 16)
				m.trail.BackgroundTransparency = 1 - iv * 0.85
			end
		end
	end
end)

