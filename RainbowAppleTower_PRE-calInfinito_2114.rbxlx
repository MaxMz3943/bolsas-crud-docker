local labelAmigos = nuevo("TextLabel", {
	Size = UDim2.new(0, 190, 1, 0), BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne, Text = "Friend Boost: +0%",
	TextColor3 = Color3.new(1, 1, 1), TextSize = 24,
	TextStrokeTransparency = 0, TextXAlignment = Enum.TextXAlignment.Left,
}, filaBoost)
local botonInvitar = nuevo("TextButton", {
	Size = UDim2.new(0, 26, 0, 26), Position = UDim2.new(0, 196, 0, 4),
	BackgroundColor3 = Color3.fromRGB(70, 200, 60), Font = Enum.Font.FredokaOne,
	Text = "", BorderSizePixel = 0,
}, filaBoost)
esquinas(botonInvitar, 6)
borde(botonInvitar, 2.5)
-- sin sonido de HOVER (2026-07-25): en Android la palanca izquierda queda justo
-- encima de este "+" y lo hacía sonar sin parar al mover al personaje. El CLICK
-- directo sí sigue sonando (mismo mecanismo que los 4 botones de pases).
botonInvitar:SetAttribute("NoHoverSound", true)
-- signo "+" dibujado con 2 barras blancas = centrado PERFECTO y chiquito
-- (el glifo "+" de la fuente quedaba corrido hacia arriba y grande)
for _, dim in ipairs({{10, 3}, {3, 10}}) do
	nuevo("Frame", {
		Size = UDim2.new(0, dim[1], 0, dim[2]),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 6,
	}, botonInvitar)
end
-- (el click de "+" se conecta abajo a abrirBoosts, junto con botonBoost)

-- ═══ HOTBAR GRANDE (abajo centro): muestra los 4 Tools con sus imágenes en
-- GRANDE y al pulsar equipa/desequipa el Tool REAL (humanoid:EquipTool). Los 3
-- primeros disparan su EquipLogic → RE.Hotbar → efecto pasivo del server.
-- El 4º es la SLAP GOD arcoíris: un Tool con MODELO de mano que el personaje
-- CARGA; al hacer click (Tool.Activated) hace la animación de golpe y su
-- SlapLogic dispara RE.Slap → el server manda a volar (x300 GOD) a quien esté
-- en rango. Su icono es IMG_GOD (guante arcoíris). ═══
local HB_TOOLS = {
	{nombre = "Flying Carpet", img = IMG_CARPET},
	{nombre = "Speed Coil", img = Config.IMG_COIL},
	{nombre = "Gravity Coil", img = Config.IMG_JUMPCOIL},
	{nombre = "Slap", img = Config.IMG_GOD},          -- 4: slap GOD arcoíris
	{nombre = "SlapGiant", img = Config.IMG_GIANT},   -- 5: slap GIANT/normal blanca
	{nombre = "Bat", img = Config.IMG_BAT,            -- 6: BATE (regalo del FREE BAT)
		ocultable = true,                              -- solo aparece al reclamarlo
		escalaImg = 1.6},                              -- su imagen trae margen: x1.6
	{nombre = "Banana",                                -- 7: banana trampa 🍌
		img = "rbxassetid://89129631312840", ocultable = true},
	{nombre = "ToyGun", ocultable = true,              -- 7: congeladora
		img = "rbxassetid://80015551317992"},
	-- 🖼 9: CUADRO del lobby (2026-08-08). Igual que la banana y la toygun:
	-- 'ocultable' = el slot solo aparece cuando el server te entrega el Tool, y
	-- slotDesbloqueado() devuelve true por defecto para los nombres que no lista.
	-- El icono es la propia imagen del cuadro salvo que pongas CUADRO_ICONO.
	{nombre = Config.CUADRO_NOMBRE or "Cuadro", ocultable = true,
		img = ((Config.CUADRO_ICONO or "") ~= "" and Config.CUADRO_ICONO)
			or Config.CUADRO_IMG or ""},
}
local HB_SZ = 77                       -- tamaño de cada cuadro (−20% del 96 inicial)
local hotbar = nuevo("Frame", {
	Size = UDim2.new(0, #HB_TOOLS * HB_SZ + (#HB_TOOLS - 1) * 12, 0, HB_SZ),
	Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1),
	BackgroundTransparency = 1,
}, gui)
nuevo("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal,
	Padding = UDim.new(0, 12),
	HorizontalAlignment = Enum.HorizontalAlignment.Center}, hotbar)

local function buscarTool(nombre)
	local char = plr.Character
	local bp = plr:FindFirstChild("Backpack")
	return (char and char:FindFirstChild(nombre))
		or (bp and bp:FindFirstChild(nombre))
end

local hbSlots = {}

-- ⏳ RECARGA DE LAS MANITAS (2026-07-24): el Tool ya se bloquea solo (SlapLogic)
-- y el server valida Config.SLAP_COOLDOWN, pero el jugador no veía NADA al
-- picarle durante la espera y parecía descompuesto. Esto es solo lo que VE:
-- el cuadro se oscurece, una barra azul sube de abajo hacia arriba y un número
-- cuenta los segundos; al terminar da un destello blanco de "¡lista!".
local cdSlapHasta = {}          -- [nombre del Tool] = os.clock() en que estará lista
-- cada herramienta con su tiempo: manitas = SLAP_COOLDOWN, bate = BAT_COOLDOWN
local function durCd(nombre)
	return nombre == "Bat" and (Config.BAT_COOLDOWN or 2) or Config.SLAP_COOLDOWN
end
local function iniciarCdSlap(nombre)
	local ahora = os.clock()
	if (cdSlapHasta[nombre] or 0) &gt; ahora then return end   -- ya estaba recargando
	cdSlapHasta[nombre] = ahora + durCd(nombre)
end
-- engancha el Tool.Activated de las manitas. El Tool CAMBIA al reaparecer o
-- cuando la ruleta te regala una, por eso se revisa cada frame; el atributo
-- evita conectarse dos veces al mismo Tool.
local function engancharSlaps()
	for _, n in ipairs({"Slap", "SlapGiant", "Bat"}) do
		local t = buscarTool(n)
		if t and not t:GetAttribute("CdEnganchado") then
			t:SetAttribute("CdEnganchado", true)
			t.Activated:Connect(function() iniciarCdSlap(n) end)
		end
	end
end

-- ¿este slot está DESBLOQUEADO? (S = estado autoritativo del server; los
-- *Left son los premios TEMPORALES de la ruleta)
local function slotDesbloqueado(nombre)
	if nombre == "Flying Carpet" then
		-- 🕊 el God Mode presta el vuelo aunque no tengas el pase (2026-08-05).
		-- El server manda igual (Hotbar slot 1 revalida godUntil allí).
		return (S.pases and S.pases.carpet) or (S.flyLeft or 0) &gt; 0
			or (Config.GOD_VUELO and (S.godLeft or 0) &gt; 0)
	elseif nombre == "Speed Coil" then
		return (S.coils and S.coils.speed) or (S.speedLeft or 0) &gt; 0
	elseif nombre == "Gravity Coil" then
		return (S.coils and S.coils.jump) or (S.jumpLeft or 0) &gt; 0
	elseif nombre == "Slap" then
		return S.pases and S.pases.god
	elseif nombre == "SlapGiant" then
		return (S.pases and S.pases.giant) or (S.slapLeft or 0) &gt; 0
	end
	return true            -- banana/toygun: se muestran solo si ya los tienes
end

-- lo que se pide al server cuando tocas un slot bloqueado (abre la ventana gris)
local COMPRA_SLOT = {
	["Flying Carpet"] = {"pase", "carpet"},
	["Speed Coil"] = {"producto", "speedcoil"},
	["Gravity Coil"] = {"producto", "jumpcoil"},
	["Slap"] = {"pase", "god"},
	["SlapGiant"] = {"pase", "giant"},
}

local function pintarHotbar()
	local char = plr.Character
	engancharSlaps()
	local ahora = os.clock()
	for _, s in ipairs(hbSlots) do
		local equipado = char and char:FindFirstChild(s.nombre) ~= nil
		s.stroke.Color = equipado and Color3.new(1, 1, 1)
			or Color3.fromRGB(90, 90, 110)
		s.stroke.Thickness = equipado and 4.5 or 3
		if s.cd then                       -- ⏳ manitas: pintar la recarga
			local resta = (cdSlapHasta[s.nombre] or 0) - ahora
			if resta &gt; 0 then
				s.cd.capa.Visible = true
				s.cd.fill.Size = UDim2.new(1, 0,
					1 - resta / durCd(s.nombre), 0)
				s.cd.num.Text = tostring(math.ceil(resta))
			elseif s.cd.capa.Visible then
				s.cd.capa.Visible = false
				s.cd.destello()            -- ¡lista!
			end
		end
		if s.ocultable then
			-- 🍌 el slot de la banana solo existe si YA la tomaste de la
			-- vitrina (el Tool aparece cuando el server te la entrega)
			s.frame.Visible = buscarTool(s.nombre) ~= nil
		end
	end
end

local function equipToggle(nombre)
	-- si NO lo tienes: no se equipa y se pide al server la ventana de compra
	-- (aquí adentro para que valga igual con el clic del slot y con la tecla)
	if not slotDesbloqueado(nombre) then
		local co = COMPRA_SLOT[nombre]
		if co then RE.Prompt:FireServer(co[1], co[2]) end
		return
	end
	local tool = buscarTool(nombre)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if not tool or not hum then return end
	if tool.Parent == plr.Character then hum:UnequipTools()
	else hum:EquipTool(tool) end
	pintarHotbar()
end

for i, def in ipairs(HB_TOOLS) do
	local f = nuevo("TextButton", {
		Size = UDim2.new(0, HB_SZ, 0, HB_SZ),
		BackgroundColor3 = Color3.fromRGB(28, 28, 40),
		BackgroundTransparency = 0.2, Text = "", BorderSizePixel = 0,
	}, hotbar)
	esquinas(f, 14)
	local st = nuevo("UIStroke", {Thickness = 3,
		Color = Color3.fromRGB(90, 90, 110)}, f)
	nuevo("TextLabel", {   -- número de slot
		Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0, 6, 0, 4),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBlack,
		Text = tostring(i), TextColor3 = Color3.new(1, 1, 1), TextSize = 17,
		TextStrokeTransparency = 0, ZIndex = 3,
	}, f)
	if hayImg(def.img) then   -- imagen GRANDE (llena casi toda la caja)
		-- escalaImg: multiplicador OPCIONAL del icono. La imagen del BATE trae
		-- mucho margen transparente alrededor, así que a tamaño normal se veía
		-- diminuta comparada con las manitas o los coils (2026-07-25).
		local _e = (HB_SZ - 12) * (def.escalaImg or 1)
		nuevo("ImageLabel", {
			Size = UDim2.new(0, _e, 0, _e),
			Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1, Image = def.img,
			ScaleType = Enum.ScaleType.Fit, ZIndex = 2,
		}, f)
	elseif def.emoji then   -- sin imagen: emoji grandote (p.ej. la ToyGun)
		nuevo("TextLabel", {
			Size = UDim2.new(0, HB_SZ - 20, 0, HB_SZ - 20),
			Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1, Text = def.emoji, TextScaled = true,
			ZIndex = 2,
		}, f)
	end
	f:SetAttribute("Mute", true)   -- los slots del inventario no suenan
	if def.ocultable then
		f.Visible = false          -- oculto hasta tomarlo de su vitrina
	end
	-- ⏳ capa de RECARGA: SOLO las dos manitas (las demás no tienen espera)
	local cd = nil
	if def.nombre == "Slap" or def.nombre == "SlapGiant"
			or def.nombre == "Bat" then
		local capa = nuevo("Frame", {
			Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(8, 8, 16),
			BackgroundTransparency = 0.45, Visible = false,
			ClipsDescendants = true, ZIndex = 4,
		}, f)
		esquinas(capa, 14)
		local fill = nuevo("Frame", {   -- sube de abajo hacia arriba
			Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 0),
			AnchorPoint = Vector2.new(0, 1), BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(90, 220, 255),
			BackgroundTransparency = 0.55, ZIndex = 5,
		}, capa)
		local num = nuevo("TextLabel", {   -- segundos que faltan
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack, Text = "", TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0,
			ZIndex = 6,
		}, capa)
		nuevo("UITextSizeConstraint", {MaxTextSize = 34}, num)
		local flash = nuevo("Frame", {   -- destello blanco de "¡ya está lista!"
			Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1, ZIndex = 7,
		}, f)
		esquinas(flash, 14)
		cd = {capa = capa, fill = fill, num = num, destello = function()
			flash.BackgroundTransparency = 0.25
			TweenService:Create(flash, TweenInfo.new(0.35),
				{BackgroundTransparency = 1}):Play()
		end}
	end
	hbSlots[i] = {frame = f, stroke = st, nombre = def.nombre,
		ocultable = def.ocultable, cd = cd}
	f.MouseButton1Click:Connect(function() equipToggle(def.nombre) end)
end
RunService.Heartbeat:Connect(pintarHotbar)   -- el borde resalta el equipado

-- ═══ BOTÓN "BACK TO FLOOR": la red de seguridad del que se cae ═══════════════
-- Si te empujan (o te caes) dentro de la torre y quedas MÁS ABAJO de tu último
-- checkpoint, salen 13 s un botón verde con barra para regresar. Sin esto, al
-- niño que sube 15 pisos y lo tiran le parece que perdió TODO y cierra el juego.
-- Aparece SOLO cuando volver le conviene (está debajo de su checkpoint) y una
-- vez por caída: para que vuelva a salir hay que re-subir y volver a caer.
-- El server revalida todo; esto es nada más lo que se ve.
local cancelarVolver = nil   -- lo rellena el bloque de abajo; lo usa el FX
                             -- "reiniciarCheckpoints" para apagarlo al instante
do
	local VOLVER_SEG = 13
	local VOLVER_RETRASO = 0.4   -- espera 0.4 s tras la caída antes de asomarse
	local MARGEN_PISOS = 1     -- solo si bajó MÁS de 1 piso de su checkpoint (o sea, 2+)
	-- 🎪 FRONTERA DE LA TORRE EN EL PLANO (31 jul 2026). La torre con muros llega
	-- a |x|,|z| = 45, las alcobas seguras cuelgan por fuera hasta ~59,5 y la
	-- escalera de la pared va a ~46: 66 lo abarca todo con margen. El trampolín
	-- está en (146, 0) — a 80 studs de esta raya.
	local FRONTERA_XZ = 66
	local VERDE = Color3.fromRGB(45, 200, 80)
	local hasta = 0            -- os.clock() en que se esconde solo
	local pendiente = 0        -- os.clock() en que debe SALIR (0 = nada pendiente)
	local arriba = true        -- ARMADO: ya se ofreció esta caída o no (evita repetir)

	-- todo el bloque va al 80% del original (2026-07-24): 300x78 → 240x62, y con
	-- él bajan esquinas, borde, textos, barra y el tile de los cuadritos, para
	-- que se vea IGUAL, nada más chico.
	local btn = nuevo("TextButton", {
		Size = UDim2.new(0, 240, 0, 62),
		Position = UDim2.new(0.5, 0, 1, -128),   -- encima de la stamina (-102) y la hotbar
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = VERDE, Text = "", BorderSizePixel = 0,
		AutoButtonColor = false, Visible = false, ZIndex = 50,
	}, gui)
	esquinas(btn, 13)
	borde(btn, 2.5, Color3.new(1, 1, 1))
	studsVivo(btn, VERDE, VERDE, 136)   -- cuadritos de Roblox con MUCHO zoom
	btn:SetAttribute("Mute", true)      -- el sonido lo tiro yo al hacer click
	local txt = nuevo("TextLabel", {
		Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack, Text = "BACK TO MY FLOOR", TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, ZIndex = 52,
	}, btn)
	local marco = nuevo("Frame", {   -- barra que se vacía en los 13 s
		Size = UDim2.new(1, -21, 0, 9), Position = UDim2.new(0.5, 0, 1, -9),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.fromRGB(16, 62, 28),
		BorderSizePixel = 0, ZIndex = 52,
	}, btn)
	esquinas(marco, 4)
	local fill = nuevo("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 53,
	}, marco)
	esquinas(fill, 4)

	local function mostrar(piso)
		txt.Text = (piso &gt; Config.N_PISOS) and "BACK TO THE ROOF"
			or ("BACK TO FLOOR " .. piso)
		hasta = os.clock() + VOLVER_SEG
		fill.Size = UDim2.new(1, 0, 1, 0)
		if not btn.Visible then
			btn.Visible = true
			-- el MISMO pop + sonido que las ventanas de la ruleta y las tiendas.
			-- ⚠️ popIn crea un UIScale NUEVO en cada llamada, así que hay que
			-- tirar el anterior o se van apilando cada vez que el jugador se cae.
			local viejo = btn:FindFirstChildOfClass("UIScale")
			if viejo then viejo:Destroy() end
			popIn(btn, 0.35)
		end
	end

	-- apagado INSTANTÁNEO desde fuera. Lo llama el FX "reiniciarCheckpoints": el
	-- checkpoint tarda hasta 0.4 s en sincronizarse y el botón ya sale a los
	-- 0.4 s, así que sin esto podía asomarse un parpadeo justo al caer al lobby.
	cancelarVolver = function()
		pendiente = 0
		arriba = true
		if btn.Visible then btn.Visible = false end
	end

	btn.MouseButton1Click:Connect(function()
		if not btn.Visible then return end
		btn.Visible = false
		hasta = 0
		sonar("rbxassetid://127105730240202", 0.55)
		-- el DUEÑO del personaje es este cliente: si no corto yo la velocidad,
		-- llega arriba cayéndose y se vuelve a ir para abajo
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if root then root.AssemblyLinearVelocity = Vector3.zero end
		RE.Volver:FireServer()
	end)

	RunService.Heartbeat:Connect(function()
		local ahora = os.clock()
		if btn.Visible then
			local resta = hasta - ahora
			if resta &lt;= 0 then btn.Visible = false
			else fill.Size = UDim2.new(resta / VOLVER_SEG, 0, 1, 0) end
		end
		local cp = S.checkpoint or 0
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		-- 💀 EXCLUSIÓN POR MUERTE: si un gusano te mata NO sale el botón, porque
		-- morir ya te devuelve solo a tu checkpoint. Sin esto salía mientras el
		-- cuerpo iba cayendo — justo cuando no sirve para nada — y encima el
		-- server lo habría rechazado por estar muerto.
		if hum and hum.Health &lt;= 0 then
			pendiente = 0
			if btn.Visible then btn.Visible = false end
			arriba = true          -- reaparecerá en su checkpoint: estado limpio
			return
		end
		-- sin checkpoint (recién entrado, o pisó el pad verde "Return to obby" que
		-- REINICIA la subida) no hay a dónde volver: se cancela y se esconde. El
		-- esconder importa: si el reinicio llegara con retraso, el botón podría
		-- alcanzar a salir y quedarse ahí sin servir, porque el server lo rechaza.
		if cp &lt; 1 or not root then
			arriba = true
			pendiente = 0
			if btn.Visible then btn.Visible = false end
			return
		end
		-- 📏 Solo si bajó MÁS DE 1 PISO de su checkpoint: bajar un escalón a
		-- propósito NO es caerse. Son DOS umbrales distintos a propósito
		-- (histéresis): asoma 2 pisos abajo, pero solo se re-arma cuando vuelve a
		-- la ALTURA de su checkpoint. Con un umbral único, quedarse parado justo
		-- en la raya lo haría aparecer y desaparecer sin parar.
		local piso = Config.pisoDe(root.Position.Y)
		-- piso 0 = LOBBY. Caer hasta abajo del todo SIEMPRE ofrece volver, tengas
		-- el checkpoint donde lo tengas: con la regla de "2 pisos" el que tenía el
		-- checkpoint en el 1 nunca veía el botón (no existe el piso -1), y caerse
		-- desde el primer piso es justo cuando un niño nuevo se desanima y se sale.
		local muyAbajo = piso &lt; cp - MARGEN_PISOS   -- 2+ pisos abajo → ofrecer volver
			or piso == 0                            -- o se cayó hasta el lobby
		-- 🎪 RE-ARMARSE SOLO CUENTA DENTRO DE LA TORRE (31 jul 2026). El bug del
		-- trampolín: pisoDe() solo mira la ALTURA, así que rebotar en el trampolín
		-- del parkour (x=146) te subía "al piso 3", eso re-armaba el botón, y al
		-- caer del rebote salía "BACK TO FLOOR" — en cada bote. Ahora recuperar tu
		-- altura solo re-arma si estás en el plano de la torre (|x|,|z| ≤ 66):
		-- rebotar fuera ya no re-arma y el botón no vuelve a asomarse.
		-- ⚠️ LA OFERTA (muyAbajo) NO LLEVA ESTE FILTRO, a propósito: al tirarte del
		-- techo caes por FUERA del muro, y con el filtro en la oferta el botón no
		-- saldría justo en el caso estrella. La oferta se dispara donde sea; lo que
		-- se restringe es únicamente dónde se recarga.
		local enTorre = math.abs(root.Position.X) &lt;= FRONTERA_XZ
			and math.abs(root.Position.Z) &lt;= FRONTERA_XZ
		local recuperado = piso &gt;= cp and enTorre   -- a su altura Y dentro de la torre
		if muyAbajo and arriba then
			pendiente = ahora + VOLVER_RETRASO      -- se cayó de verdad: sale 1 s después
			arriba = false                          -- ya se ofreció; no repetir hasta que suba
		elseif recuperado then
			arriba = true                           -- volvió a su altura: re-armado
			pendiente = 0                           -- se recuperó dentro del 1 s: ya no sale
			if btn.Visible then btn.Visible = false end
		end
		if pendiente &gt; 0 and ahora &gt;= pendiente then
			pendiente = 0
			mostrar(cp)
		end
	end)
end

-- 🍌 BANANA: con la banana EQUIPADA, click/tap/R2 (Tool.Activated) → pedir al
-- server soltar la trampa (él valida pickup + cooldown de 20 s)
do
	local function conectarBanana(tool)
		if not tool:IsA("Tool") or tool:GetAttribute("KTConectada") then return end
		if tool.Name == "Banana" then
			tool:SetAttribute("KTConectada", true)
			tool.Activated:Connect(function()
				RE.Prompt:FireServer("bananaSoltar")
			end)
		elseif tool.Name == "ToyGun" then
			tool:SetAttribute("KTConectada", true)
			tool.Activated:Connect(function()
				-- PUNTERÍA v2: dispara a lo que CLICKEAS/TAPEAS (Mouse.Hit
				-- funciona igual con touch: el tap mueve el "mouse"). Si el
				-- click cayó sobre un jugador, se manda DIRECTO ese jugador →
				-- imposible fallar, aunque estés volteado o de espaldas.
				local mouse = plr:GetMouse()
				local objetivo = nil
				local tgt = mouse.Target
				if tgt then
					local mch = tgt.Parent
					local v = mch and Players:GetPlayerFromCharacter(mch)
					if not v and mch and mch.Parent then
						v = Players:GetPlayerFromCharacter(mch.Parent)
					end
					if v and v ~= plr then objetivo = v end
				end
				RE.Prompt:FireServer("toygunDisparo",
					{v = objetivo, p = mouse.Hit.Position})
			end)
		end
	end
	local function revisarMochila(bp)
		if not bp then return end
		for _, tl in ipairs(bp:GetChildren()) do conectarBanana(tl) end
		bp.ChildAdded:Connect(conectarBanana)
	end
	revisarMochila(plr:FindFirstChild("Backpack"))
	plr.ChildAdded:Connect(function(ch)
		if ch.Name == "Backpack" then task.defer(revisarMochila, ch) end
	end)
end

-- ═══ BOOST? + Daily ═══
-- 📱 EN TÁCTILES VAN ARRIBA-DERECHA (2026-07-25). Abajo a la derecha es donde
-- Roblox pone el BOTÓN DE SALTO en celular/tablet, así que se encimaban y el
-- niño pulsaba Daily queriendo saltar (o al revés). Arriba-derecha está libre:
-- la barra de progreso ocupa solo el 44% central, y FREE SLAP / 2x Speed están
-- a media altura. En PC y consola se quedan abajo como siempre.
local esTactil = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
-- ancla y posiciones: {AnchorPoint, Y del Boost, Y del Daily}
local BOOST_ANCLA = esTactil and Vector2.new(1, 0) or Vector2.new(1, 1)
local BOOST_Y     = esTactil and UDim.new(0, 12) or UDim.new(1, -16)

local botonBoost = nuevo("TextButton", {
	Size = UDim2.new(0, 92, 0, 78),
	Position = UDim2.new(1, -16, BOOST_Y.Scale, BOOST_Y.Offset),
	AnchorPoint = BOOST_ANCLA, BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne, Text = "Boost?",
	TextColor3 = Color3.new(1, 1, 1), TextSize = 20,
	TextStrokeTransparency = 0, TextYAlignment = Enum.TextYAlignment.Bottom,
}, gui)
local iconoBoost = nuevo("ImageLabel", {
	Size = UDim2.new(0, 54, 0, 54), Position = UDim2.new(0.5, 0, 0, 20),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
	Image = "rbxassetid://121913964197827", ScaleType = Enum.ScaleType.Fit,
}, botonBoost)

-- ═══ CORRER: Shift (PC) / L3 o X (Xbox) / botón 🏃 (celular), con STAMINA ═══
-- El server aplica la velocidad (anti-hack); aquí va la stamina local (misma
-- matemática), la barra, el botón táctil y la ANIMACIÓN de correr.
local CORRER_MAX = Config.CORRER_MAX or 7
local CORRER_REGEN = Config.CORRER_REGEN or 0.7
local stamina = CORRER_MAX
local corriendo = false
local pistaCorrer = nil          -- AnimationTrack de Config.CORRER_ANIM
local cintura = nil              -- Motor6D "Waist" (R15) para inclinar el torso
local cinturaBase = nil          -- su C0 original (sin inclinar)
local ladeoActual = 0            -- inclinación actual (lerp suave)
local FOV_NORMAL = 70            -- FOV por defecto de Roblox
local FOV_CORRER = 58            -- ZOOM al correr, DOBLE (70→58 = 12 de FOV, antes 6)
-- 🔍 el zoom de fondo al abrir un panel vive en Config.FOV_PANEL.
-- ⚠️ NO lo pases a un local de aquí arriba: este archivo va al borde del límite de
-- 200 locales por función de Lua y añadir uno más lo revienta (pasó al escribir
-- esto mismo, 2026-08-18). Leerlo de Config cuesta lo mismo y no gasta cupo.
-- ⚠️ `panelAbierto` se DECLARA aquí, aunque su sitio natural sea el bloque de
-- paneles (unas 500 líneas más abajo), porque el bucle del FOV está por encima y
-- necesita leerlo. Allí abajo se le asigna sin `local`, para que sea esta misma
-- variable y no una nueva que dejaría este bucle mirando siempre a nil.
local panelAbierto = nil

-- barra de stamina ARRIBA de la hotbar grande (SIEMPRE visible)
local marcoStamina = nuevo("Frame", {
	Size = UDim2.new(0, 210, 0, 14), Position = UDim2.new(0.5, 0, 1, -102),
	AnchorPoint = Vector2.new(0.5, 1),
	BackgroundColor3 = Color3.fromRGB(20, 20, 32),
	BackgroundTransparency = 0.25, BorderSizePixel = 0,
}, gui)
esquinas(marcoStamina, 7)
borde(marcoStamina, 2)
local fillStamina = nuevo("Frame", {
	Size = UDim2.new(1, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2),
	BackgroundColor3 = Color3.fromRGB(90, 220, 255), BorderSizePixel = 0,
}, marcoStamina)
esquinas(fillStamina, 5)

-- animación de correr: se carga en cada personaje (se reproduce en el
-- cliente; Roblox la replica sola al resto de jugadores)
local function cargarAnimCorrer(char)
	-- ⚡ suelta la pista anterior antes de cargar otra: si esta función corre 2
	-- veces sobre el mismo personaje, las pistas se acumulaban hacia el límite de 64
	if pistaCorrer then
		pcall(function() pistaCorrer:Stop(0) pistaCorrer:Destroy() end)
	end
	pistaCorrer = nil
	cintura, cinturaBase, ladeoActual = nil, nil, 0
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = Config.CORRER_ANIM or ""
	local ok, pista = pcall(function() return animator:LoadAnimation(anim) end)
	if ok and pista then
		pista.Priority = Enum.AnimationPriority.Action  -- gana al Animate default
		pista.Looped = true
		pistaCorrer = pista
	end
	-- LADEO al correr: la cintura (Waist) de los avatares R15. Inclinar su C0
	-- ladea el torso al frente sin afectar la física (el root sigue derecho).
	local ut = char:FindFirstChild("UpperTorso")
	if ut then
		cintura = ut:FindFirstChild("Waist")
		if cintura then cinturaBase = cintura.C0 end
	end
end
if plr.Character then task.spawn(cargarAnimCorrer, plr.Character) end
plr.CharacterAdded:Connect(function(char)
	corriendo = false
	stamina = CORRER_MAX
	task.spawn(cargarAnimCorrer, char)
end)

-- 💥 El prompt "Explode Player" NO debe verse sobre uno mismo. El servidor ya
-- rechaza el auto-disparo, pero enseñar un botón que no hace nada confunde.
-- Enabled=false puesto desde el CLIENTE es local: lo oculta solo para mí, los
-- demás siguen viendo el prompt sobre mi personaje, que es lo que queremos.
-- ⚠️ EL do...end NO SOBRA. Este archivo estaba a UNA variable local del tope de
-- Lua (200 por función) y declarar `ocultarMiPromptExplotar` arriba lo reventaba:
-- "too many local variables in main function". Dentro del bloque, la local vive
-- en su propio ámbito y no gasta hueco del principal. Si añades más funciones
-- sueltas a este archivo, envuélvelas igual o volverá a petar.
do
	local function ocultarMiPrompt(char)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not root then return end
		local pp = root:WaitForChild("PromptExplotar", 10)
		if pp then pp.Enabled = false end
	end
	if plr.Character then task.spawn(ocultarMiPrompt, plr.Character) end
	plr.CharacterAdded:Connect(function(char)
		task.spawn(ocultarMiPrompt, char)
	end)
end


local botonCorrerM   -- botón táctil (existe solo en pantallas touch)
local function pintarCorrer()
	if botonCorrerM then
		botonCorrerM.BackgroundColor3 = corriendo
			and Color3.fromRGB(90, 220, 255) or Color3.fromRGB(30, 30, 42)
	end
end

local function setCorrer(on)
	-- volando en alfombra NO se corre (Shift ahí es bajar) ni sin stamina
	if on and (S.equip.carpet or stamina &lt;= 0.2) then on = false end
	if corriendo == on then return end
	corriendo = on
	RE.Correr:FireServer(on)
	pintarCorrer()
end

UserInputService.InputBegan:Connect(function(input, procesado)
	if procesado then return end
	if input.KeyCode == Enum.KeyCode.LeftShift then
		setCorrer(true)                        -- PC: MANTENER Shift
	elseif input.KeyCode == Enum.KeyCode.ButtonL3
		or input.KeyCode == Enum.KeyCode.ButtonX then
		setCorrer(not corriendo)               -- Xbox: L3 o X alternan
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then setCorrer(false) end
end)

-- 🏃🖼 CORRER Y CUADRO NO CONVIVEN (2026-08-18). Al esprintar el brazo se mueve
-- mucho más y el cuadro estorba, así que se guarda solo. Y si lo intentas sacar
-- mientras corres, sale y se vuelve a guardar en el acto: ese parpadeo ES el
-- aviso de "esto no se usa corriendo", y se pidió así expresamente.
--
-- ⚠️ Va en un Heartbeat y no dentro de setCorrer(true) A PROPÓSITO. Hacen falta
-- los DOS casos —empezar a correr con el cuadro fuera, y sacarlo estando ya
-- corriendo— y una comprobación continua los cubre con una sola regla. Cuesta
-- nada: si no estás corriendo, se sale en la primera línea.
--
-- Sirve para Shift, para el L3/X del mando y para el botón 🏃 del móvil sin
-- tocarlos, porque los tres acaban pasando por `corriendo`.
do
	local NOMBRE_CUADRO = Config.CUADRO_NOMBRE or "Cuadro"
	RunService.Heartbeat:Connect(function()
		if not corriendo then return end
		local char = plr.Character
		-- en Roblox solo hay un Tool equipado a la vez: si es el cuadro, fuera.
		-- Se comprueba el NOMBRE y no se llama a UnequipTools a secas porque eso
		-- también le quitaría la manita o el bate a quien corra con ellos.
		local tool = char and char:FindFirstChildOfClass("Tool")
		if tool and tool.Name == NOMBRE_CUADRO then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:UnequipTools()
				pintarHotbar()   -- que el slot 9 no se quede iluminado
			end
		end
	end)
end

if UserInputService.TouchEnabled then          -- celular/tablet: botón 🏃 (toggle)
	-- v2 (2026-07-17): REDONDO de verdad (UICorner circular — esquinas() del
	-- juego fuerza cuadrado, por eso salía una caja) y A LA IZQUIERDA del botón
	-- de SALTO nativo (antes ocupaba su mismo espacio abajo-derecha). Va en un
	-- ScreenGui PROPIO sin la UIScale responsiva → coordenadas REALES de
	-- pantalla, siempre alineado con el salto en cualquier dispositivo.
	local guiTouch = Instance.new("ScreenGui")
	guiTouch.Name = "RainbowAppleTouch"
	guiTouch.ResetOnSpawn = false
	guiTouch.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	guiTouch.AutoLocalize = false   -- 🌐 sin traducción automática (ver el HUD)
	guiTouch.Parent = plr:WaitForChild("PlayerGui")
	-- ⚠️ 2026-07-25: la TABLET usaba una disposición propia (sprint ARRIBA del
	-- salto). Al añadir el candado eso se rompía: el candado caía justo encima
	-- del botón de salto, que en tablet es enorme. Ahora tablet y teléfono usan
	-- la MISMA estructura —sprint a la IZQUIERDA del salto y candado encima del
	-- sprint— solo que a mayor escala.
	-- 📐 Los offsets de tablet NO son a ojo (mi 1er intento sí lo fue y el candado
	-- caía ENCIMA del salto): el botón de salto de Roblox mide 70 px en pantallas
	-- chicas y 120 en grandes (TouchJump corta en viewport.Y &lt;= 500), o sea ×1.71.
	-- Los offsets del teléfono —que quedaron bien— se escalan por ese factor:
	-- sprint 112→192 y candado 102→175.
	-- 2026-07-25: sprint más chico que el original (74→52 tel, 92→64 tablet) y 10 px más
	-- pegado al salto, para que los tres botones formen un grupo compacto en vez
	-- de ocupar media pantalla.
	-- (el tamaño/posición REALES los pone aplicarLayoutTouch, más abajo)
	botonCorrerM = nuevo("TextButton", {
		Size = UDim2.new(0, 52, 0, 52),
		Position = UDim2.new(1, -112, 1, -28),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = Color3.fromRGB(30, 30, 42),
		BackgroundTransparency = 0.5, Font = Enum.Font.FredokaOne,
		Text = "🏃", TextSize = 21, BorderSizePixel = 0,
	}, guiTouch)
	nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, botonCorrerM)
	nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(1, 1, 1),
		Transparency = 0.35}, botonCorrerM)
	botonCorrerM.MouseButton1Click:Connect(function()
		setCorrer(not corriendo)
	end)

	-- ═══ 🔒 CANDADO DE CÁMARA (2026-07-25, SOLO TÁCTILES) ═══════════════════
	-- En celular, Roblox por defecto gira la cámara SOLO al caminar (modo
	-- "Follow"): el niño avanza y la vista se le va sola, que es horrible para
	-- una torre donde hay que mirar arriba y calcular saltos. Con el candado
	-- CERRADO se pasa a "Classic": la cámara se queda quieta y solo se mueve
	-- cuando el jugador la arrastra con el pulgar derecho.
	-- Va en guiTouch (coordenadas REALES de pantalla) justo encima del sprint.
	local camFija = false
	-- 2026-07-25: botón CHIQUITO (era 64/80 → 40/50 → 34/42). Es un ajuste que se
	-- toca una vez y se olvida, así que no debe competir con salto ni sprint.
	-- 📍 TELÉFONO: justo ENCIMA del sprint y ladeado hacia el salto, formando un
	-- grupo compacto de tres. Solo 8 px de separación con el sprint (antes ~16).
	-- No puede bajar más ni centrarse del todo entre salto y sprint: el botón de
	-- salto de Roblox empieza en X≈-95 y se lo comería.
	-- 📍 TABLET: misma estructura escalada ×1.71 (ver aplicarLayoutTouch).
	local btnCam = nuevo("TextButton", {
		Size = UDim2.new(0, 34, 0, 34),
		Position = UDim2.new(1, -102, 1, -88),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = Color3.fromRGB(30, 30, 42),
		BackgroundTransparency = 0.5, Font = Enum.Font.FredokaOne,
		Text = "🔓", TextSize = 17, BorderSizePixel = 0,
	}, guiTouch)
	nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, btnCam)
	local strokeCam = nuevo("UIStroke", {Thickness = 2,
		Color = Color3.new(1, 1, 1), Transparency = 0.35}, btnCam)
	btnCam:SetAttribute("Mute", true)   -- sin sonido de hover (es un botón fijo)

	-- ⚠️ ARREGLO iPad (2026-07-25): antes "esTablet" se calculaba UNA sola vez al
	-- arrancar el script, cuando CurrentCamera.ViewportSize muchas veces AÚN no
	-- está listo → el iPad quedaba clasificado como TELÉFONO y el sprint y el
	-- candado caían con medidas chicas encima del botón de salto gigante (por eso
	-- unas veces se veía bien y otras horrible: era una carrera). Ahora el layout
	-- lee el viewport ACTUAL y se RE-aplica si cambia (cámara recién lista,
	-- rotación de pantalla, cambio de ventana).
	local function aplicarLayoutTouch()
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(800, 400)
		local esTab = math.min(v.X, v.Y) &gt;= 600
		botonCorrerM.Size = esTab and UDim2.new(0, 78, 0, 78)
			or UDim2.new(0, 52, 0, 52)
		botonCorrerM.Position = esTab and UDim2.new(1, -192, 1, -70)
			or UDim2.new(1, -112, 1, -28)
		botonCorrerM.TextSize = esTab and 36 or 21
		btnCam.Size = esTab and UDim2.new(0, 52, 0, 52)
			or UDim2.new(0, 34, 0, 34)
		btnCam.Position = esTab and UDim2.new(1, -175, 1, -156)
			or UDim2.new(1, -102, 1, -88)
		btnCam.TextSize = esTab and 26 or 17
	end
	aplicarLayoutTouch()
	local function engancharViewport()
		local cam = workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(aplicarLayoutTouch)
		end
	end
	engancharViewport()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		engancharViewport()
		aplicarLayoutTouch()
	end)

	local function setCamFija(on)
		camFija = on
		-- 🔒 El cambio REAL lo hace el SERVER (RE.Toggle "camfija"):
		--   🔓 desbloqueado → Follow  (la cámara gira sola al caminar)
		--   🔒 bloqueado    → Classic (quieta; solo la mueve el pulgar)
		-- ⚠️ NO se tocan aquí las propiedades Dev*CameraMode (2026-07-25):
		-- son de SERVIDOR y el cliente no tiene permiso. Aunque el pcall
		-- atrapaba el error, el motor igual lo escribía en consola
		-- ("Insufficient permissions to set DevComputerCameraMode") en CADA
		-- clic. El server ya lo aplica bien, así que el intento local sobraba.
		RE.Toggle:FireServer("camfija", on)   -- el server la fija con autoridad
		btnCam.Text = on and "🔒" or "🔓"
		btnCam.BackgroundColor3 = on and Color3.fromRGB(70, 200, 255)
			or Color3.fromRGB(30, 30, 42)
		btnCam.BackgroundTransparency = on and 0.15 or 0.5
		strokeCam.Transparency = on and 0 or 0.35
	end
	btnCam.MouseButton1Click:Connect(function() setCamFija(not camFija) end)
	setCamFija(false)   -- arranca desbloqueado: no cambiamos nada sin que lo pida
end

-- stamina local (misma matemática que el server) + animación + barra
RunService.Heartbeat:Connect(function(dt)
	if corriendo and S.equip.carpet then setCorrer(false) end
	if corriendo then
		stamina = math.max(0, stamina - dt)
		if stamina &lt;= 0 then setCorrer(false) end
	else
		stamina = math.min(CORRER_MAX, stamina + dt * CORRER_REGEN)
	end
	-- la animación de correr solo se ve si corres, te mueves Y estás EN EL SUELO.
	-- Al saltar/caer (FloorMaterial = Air) se detiene → así se ve la anim de salto
	-- (antes seguía corriendo en el aire y tapaba el salto).
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local enSuelo = hum and hum.FloorMaterial ~= Enum.Material.Air
	local moviendo = hum and hum.Health &gt; 0
		and hum.MoveDirection.Magnitude &gt; 0.1
	if pistaCorrer then
		if corriendo and moviendo and enSuelo then
			if not pistaCorrer.IsPlaying then
					pistaCorrer:Play(0.15)
					pistaCorrer:AdjustSpeed(Config.CORRER_ANIM_VEL or 1)  -- super rápida
				end
		elseif pistaCorrer.IsPlaying then
			pistaCorrer:Stop(0.12)                 -- rápido: cede el paso al salto
		end
	end
	local frac = stamina / CORRER_MAX
	fillStamina.Size = UDim2.new(frac, -4, 1, -4)
	fillStamina.BackgroundColor3 = (frac &lt; 0.25 and Color3.fromRGB(255, 85, 85))
		or (frac &lt; 0.5 and Color3.fromRGB(255, 205, 70))
		or Color3.fromRGB(90, 220, 255)
	-- ZOOM de cámara al correr: el FOV baja un poco (acerca) de forma suave al
	-- correr y regresa al normal al dejar de correr.
	-- 🔍 Y con un panel abierto manda ESE zoom, más fuerte, por encima del de
	-- correr: si no, al abrir una tienda mientras corres el fondo se quedaría en
	-- el FOV de sprint. Se reaprovecha este mismo bucle a propósito — dos sitios
	-- escribiendo FieldOfView se pisarían y daría tirones.
	local cam = workspace.CurrentCamera
	if cam then
		-- La RULETA no pasa por `panelAbierto`: se gestiona con su propia tabla
		-- `rueda`, que además se declara más abajo que este bucle. Por eso avisa con
		-- una bandera en el propio gui, que sí está en ámbito desde arriba del todo
		-- y no gasta cupo del límite de 200 locales.
		local conPanel = (panelAbierto and panelAbierto.Parent
				and not panelAbierto:GetAttribute("SinZoom"))
			or gui:GetAttribute("ZoomFondo")
		local objetivo = (conPanel and (Config.FOV_PANEL or 50))
			or (corriendo and FOV_CORRER)
			or FOV_NORMAL
		cam.FieldOfView = cam.FieldOfView
			+ (objetivo - cam.FieldOfView) * math.min(1, dt * 8)
	end
	-- LADEO del torso al correr: inclina la cintura al frente (suave) al correr y
	-- la endereza al parar. −rad = hacia adelante (C0 de la Waist R15 sin rotar).
	if cintura and cinturaBase then
		local objetivo = (corriendo and moviendo)
			and math.rad(Config.CORRER_LADEO or 0) or 0
		ladeoActual = ladeoActual + (objetivo - ladeoActual) * math.min(1, dt * 8)
		-- en algunos rigs la Waist.C0 es de SOLO LECTURA: si falla, desactivamos
		-- el ladeo (cintura=nil) para NO spamear "Property is read only" cada frame
		local ok = pcall(function()
			cintura.C0 = cinturaBase * CFrame.Angles(-ladeoActual, 0, 0)
		end)
		if not ok then cintura = nil end
	end
end)

-- ═══ WORM SEES YOU! + viñeta roja ══════════════════════════
local vineta = nuevo("Frame", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 0, 0),
	BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
}, gui)
local labelVisto = nuevo("TextLabel", {
	Size = UDim2.new(0, 600, 0, 60), Position = UDim2.new(0.5, 0, 0.86, 0),
	AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne, Text = txt("teVio"),
	TextColor3 = Color3.fromRGB(220, 20, 20), TextSize = 46,
	TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(60, 0, 0),
	Visible = false, ZIndex = 6,
}, gui)

local detectado = false
task.spawn(function()
	while true do
		if detectado then
			labelVisto.TextSize = 46 + math.sin(os.clock() * 7) * 5
			vineta.BackgroundTransparency = 0.86 + math.sin(os.clock() * 7) * 0.05
		end
		task.wait(0.05)
	end
end)

-- sonido de PERSECUCIÓN del gusano: 2D/LOCAL (parented al gui, sin posición 3D)
-- → SOLO lo oye la víctima, que es la única a la que le llega RE.Detectado. En
-- LOOP mientras te sigue; se detiene al soltarte o al reaparecer.
local sndCaza = Instance.new("Sound")
sndCaza.SoundId = "rbxassetid://117960405302487"
sndCaza.Looped = true
sndCaza.Volume = 0.9
sndCaza.Parent = gui

RE.Detectado.OnClientEvent:Connect(function(visto)
	detectado = visto
	labelVisto.Visible = visto
	vineta.BackgroundTransparency = visto and 0.88 or 1
	if visto then
		if not sndCaza.IsPlaying then sndCaza:Play() end
	else
		sndCaza:Stop()
	end
end)
plr.CharacterAdded:Connect(function() sndCaza:Stop() end)   -- corta al reaparecer

-- ═══ TOASTS ════════════════════════════════════════════════
local pilaToasts = nuevo("Frame", {
	Size = UDim2.new(0, 460, 0, 200), Position = UDim2.new(0.5, 0, 0, 148),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, ZIndex = 200,
}, gui)   -- ZIndex alto: las notificaciones SIEMPRE por delante (tiendas, cajas, etc.)
nuevo("UIListLayout", {Padding = UDim.new(0, 6),
	HorizontalAlignment = Enum.HorizontalAlignment.Center}, pilaToasts)

-- rojo = estilo ERROR: fondo vino, marco rojo vivo, barra de acento a la
-- izquierda y texto blanco (mucho mejor contraste que rojo sobre azul oscuro)
local function mostrarToast(mensaje, color, dur, rojo)
	local t = nuevo("TextLabel", {
		Size = UDim2.new(1, 0, 0, rojo and 38 or 34),
		BackgroundColor3 = rojo and Color3.fromRGB(66, 15, 24)
			or Color3.fromRGB(25, 25, 38),
		BackgroundTransparency = rojo and 0.08 or 0.2,
		Font = Enum.Font.FredokaOne,
		Text = mensaje,
		TextColor3 = color or Color3.new(1, 1, 1),
		TextSize = rojo and 21 or 20,
		BorderSizePixel = 0, ZIndex = 10, TextTruncate = Enum.TextTruncate.AtEnd,
	}, pilaToasts)
	esquinas(t, 8)
	borde(t, rojo and 2.5 or 2, rojo and Color3.fromRGB(255, 80, 92) or nil)
	-- (sin icono ni barra de acento: el texto va CENTRADO en el marco rojo)
	local marco = t:FindFirstChildOfClass("UIStroke")
	task.delay(dur or 3.2, function()
		if not t.Parent then return end
		local info = TweenInfo.new(0.4)
		-- TODO se desvanece A LA VEZ. Antes el UIStroke no se animaba y el
		-- marco se quedaba solo un instante después de vaciarse el interior.
		local tw = TweenService:Create(t, info,
			{TextTransparency = 1, BackgroundTransparency = 1})
		if marco then
			TweenService:Create(marco, info, {Transparency = 1}):Play()
		end
		tw:Play()
		tw.Completed:Wait()
		t:Destroy()
	end)
end

-- (notificaciones/toasts DESACTIVADAS a pedido del usuario: entrar al juego,
--  terminar obby, seleccionar objeto, etc. Ya no se muestra ninguna.)
-- (los toasts genéricos siguen silenciados; SOLO se muestra el aviso del cofre
--  al intentar abrirlo sin haber bajado — el re-arme al bajar es silencioso)
RE.Toast.OnClientEvent:Connect(function(clave)
	if clave == "cofreBaja" then
		mostrarToast("🔒 Chest already claimed — go down to the base and climb back up to open it again")
	elseif clave == "sinCash" or clave == "spinSinCash" then
		-- no le alcanza el dinero (tienda o ruleta) → texto rojo ~2 segundos
		-- + sonido de error (pedido del usuario)
		sonar("rbxassetid://128187340772806", 0.7)
		mostrarToast("Not enough money!", Color3.new(1, 1, 1), 2.4, true)
	elseif clave == "yaObjeto" then
		-- intenta comprar con Robux algo que YA tiene → mismo sonido de error
		-- que "sin dinero". SIN emoji (pedido del usuario).
		sonar("rbxassetid://128187340772806", 0.7)
		mostrarToast(esES and "Ya tienes este objeto"
			or "You already own this item", Color3.new(1, 1, 1), 2.4, true)
	elseif clave == "killallCd" then
		-- Kill All en cooldown (2 min) → aviso rojo + sonido de error
		sonar("rbxassetid://128187340772806", 0.7)
		mostrarToast(esES and "Solo puedes usar Kill All cada 2 minutos"
			or "You can only use Kill All once every 2 minutes",
			Color3.new(1, 1, 1), 2.6, true)
	elseif clave == "regalo" then
		-- 🎁 le tocaba un regalo por UserId (Config.REGALOS). Sale una sola vez:
		-- la próxima que entre ya lo tiene en el perfil y no se vuelve a avisar.
		sonar("rbxassetid://127039883737564", 0.8)
		mostrarToast(esES and "🎁 ¡Regalo desbloqueado para siempre!"
			or "🎁 Gift unlocked forever!", Color3.fromRGB(255, 214, 90), 4)
	elseif clave == "skinBloq" then
		-- pediste una skin que aún no es tuya. Es casi inalcanzable —el botón del
		-- menú está desactivado y el único pad con requisito está en la azotea,
		-- donde ya la tienes— así que el aviso es genérico a propósito y manda al
		-- menú, que sí dice el requisito exacto de cada una.
		-- ⚠️ Sin datos: este handler recibe SOLO la clave (el segundo argumento de
		-- RE.Toast se descarta), así que un toast con texto variable no llegaría.
		sonar("rbxassetid://128187340772806", 0.7)
		mostrarToast(esES and "🔒 Aún no has desbloqueado esa manzana — mírala en SKINS"
			or "🔒 You haven't unlocked that apple yet — check SKINS",
			Color3.fromRGB(255, 190, 90), 2.8)
	elseif clave == "comuNo" then
		mostrarToast(esES and "❌ Aún no estás en la comunidad — únete y pica VERIFICAR"
			or "❌ You're not in the community yet — join, then press VERIFY",
			Color3.fromRGB(255, 90, 90), 3)
	elseif clave == "comuOk" then
		mostrarToast(esES and "✅ ¡Bienvenido a la comunidad! Puerta abierta 🎁"
			or "✅ Welcome to the community! Door open 🎁",
			Color3.fromRGB(120, 255, 120), 3)
	elseif clave == "comuYa" then
		mostrarToast(esES and "🎁 Ya reclamaste el regalo de la comunidad"
			or "🎁 Community gift already claimed", nil, 2)
	elseif clave == "bananaOk" then
		mostrarToast(esES and "🍌 ¡Banana obtenida! Equípala (slot 6) y CLICK para dejar la trampa"
			or "🍌 Banana unlocked! Equip it (slot 6) and CLICK to drop the trap",
			Color3.fromRGB(255, 230, 120), 4)
	elseif clave == "bananaYa" then
		mostrarToast(esES and "🍌 Ya tienes la banana"
			or "🍌 You already have the banana", nil, 2)
	elseif clave == "bananaCd" then
		mostrarToast("🍌 Wait a bit (1 banana every 20s)",
			Color3.fromRGB(255, 90, 90), 2)
	elseif clave == "bananaFalta" then
		mostrarToast(esES and "🍌 Primero toma la banana de la vitrina del obby trasero"
			or "🍌 First grab the banana from the back obby display",
			Color3.fromRGB(255, 90, 90), 3)
	elseif clave == "toygunOk" then
		mostrarToast(esES and "🔫 ¡Toy Gun obtenida! Equípala (slot 7) y dispara para CONGELAR"
			or "🔫 Toy Gun unlocked! Equip it (slot 7) and shoot to FREEZE",
			Color3.fromRGB(150, 225, 255), 4)
	elseif clave == "toygunYa" then
		mostrarToast(esES and "🔫 Ya tienes la Toy Gun"
			or "🔫 You already have the Toy Gun", nil, 2)
	elseif clave == "toygunCd" then
		mostrarToast(esES and "🔫 Recargando... (1 disparo cada 8 s)"
			or "🔫 Reloading... (1 shot every 8s)",
			Color3.fromRGB(255, 90, 90), 2)
	elseif type(clave) == "string" and clave:find(" ") then
		-- 📨 RESPALDO PARA TEXTO YA ESCRITO (31 jul 2026). Este manejador es una
		-- cadena de claves cortas y NO tenía `else`, así que todo lo que no
		-- estuviera en la lista se descartaba en silencio. Los avisos del panel
		-- admin —"🛡 Immune ON", "💵 +$10,000", "🎡 +5 spins"— llevaban meses sin
		-- verse nunca: el servidor los mandaba y aquí morían.
		-- ⚠️ El filtro es que TENGA UN ESPACIO. Las claves son identificadores
		-- pegados (grupoNo, premioFly, misterioCd...) y hay 23 que a propósito no
		-- pintan nada; sin el filtro, un jugador vería "grupoNo" en pantalla.
		-- Un mensaje de verdad siempre lleva espacios.
		mostrarToast(clave, nil, 2.4)
	end
end)

-- ═══ PANELES (modal genérico) ══════════════════════════════
-- (sin `local`: la variable se declara arriba, junto a FOV_PANEL, porque el bucle
--  del zoom de cámara está antes que esto y tiene que poder leerla)
panelAbierto = nil
local function cerrarPanel()
	if panelAbierto then panelAbierto:Destroy() panelAbierto = nil end
end

-- ventana de regalo del FREE BAT (definida AQUÍ y no junto al botón
-- porque necesita cerrarPanel/panelAbierto, que se declaran arriba)
-- auto-apertura: no interrumpe si el jugador tiene otro panel abierto
-- (reintenta en el siguiente tick del temporizador)
function autoAbrirSlap()
	if panelAbierto then return false end
	abrirRegaloSlap()
	-- 🔍 sin zoom de cámara: esta ventana salta sola, y un tirón de cámara que el
	-- jugador no ha pedido marea. (abrirRegaloSlap SÍ hace zoom cuando la abre él
	-- desde el botón; el marcado va aquí, en el camino automático, no dentro.)
	if panelAbierto then panelAbierto:SetAttribute("SinZoom", true) end
	return true
end

function abrirRegaloSlap()
	cerrarPanel()
	local AZUL = Color3.fromRGB(80, 185, 255)
	local FONDO = Color3.fromRGB(24, 48, 86)
	local pS = nuevo("Frame", {
		Size = UDim2.new(0, 500, 0, 540),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = FONDO, BorderSizePixel = 0, ZIndex = 130,
	}, gui)
	esquinas(pS, 20)
	borde(pS, 5)
	studsVivo(pS, FONDO, FONDO, 250, nil, true)
	popIn(pS)
	local vivoS = true
	pS.Destroying:Connect(function() vivoS = false end)
	sonar("rbxassetid://8486683243", 0.7)
	-- encabezado
	local h1 = nuevo("TextLabel", {
		Size = UDim2.new(1, -30, 0, 54), Position = UDim2.new(0.5, 0, 0, 22),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy,
		Text = esES and "¡REGALO LISTO! 🎁" or "GIFT READY! 🎁",
		TextColor3 = Color3.fromRGB(255, 225, 90), TextScaled = true, ZIndex = 132,
	}, pS)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, h1)
	local h2 = nuevo("TextLabel", {
		Size = UDim2.new(1, -40, 0, 30), Position = UDim2.new(0.5, 0, 0, 80),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = esES and "Tu BATE gratis te espera:"
			or "Your free BAT is waiting:",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 132,
	}, pS)
	nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, h2)
	-- escenario
	local escS = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, 280), Position = UDim2.new(0, 0, 0, 120),
		BackgroundTransparency = 1, ZIndex = 132,
	}, pS)
	local glowS = nuevo("Frame", {
		Size = UDim2.new(0, 250, 0, 250), Position = UDim2.new(0.5, 0, 0.42, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = AZUL,
		BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 132,
	}, escS)
	nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, glowS)
	do
		local gs = Instance.new("UIScale")
		gs.Scale = 0.7
		gs.Parent = glowS
		TweenService:Create(gs, TweenInfo.new(1.0, Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut, -1, true), {Scale = 1.08}):Play()
	end
	local raysS = nuevo("Frame", {
		Size = UDim2.new(0, 460, 0, 460), Position = UDim2.new(0.5, 0, 0.42, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 131,
	}, escS)
	for i = 1, 12 do
		local ray = nuevo("Frame", {
			Size = UDim2.new(0, 36, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), Rotation = i * 15,
			BackgroundColor3 = Color3.fromRGB(150, 215, 255),
			BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = 131,
		}, raysS)
		nuevo("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35),
			NumberSequenceKeypoint.new(1, 1)})}, ray)
	end
	local giroS
	giroS = RunService.RenderStepped:Connect(function(dt)
		if not vivoS then giroS:Disconnect() return end
		raysS.Rotation = (raysS.Rotation + dt * 20) % 360
	end)
	for i = 1, 6 do
		local ang = math.rad(i * 60 + math.random(-14, 14))
		local rr = math.random(105, 150)
		local sp = nuevo("TextLabel", {
			Size = UDim2.new(0, 38, 0, 38),
			Position = UDim2.new(0.5, math.cos(ang) * rr, 0.42, math.sin(ang) * rr),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Text = "✦", Font = Enum.Font.LuckiestGuy, TextScaled = true,
			TextColor3 = Color3.fromRGB(215, 240, 255), ZIndex = 133,
		}, escS)
		nuevo("UIStroke", {Thickness = 2, Color = Color3.fromRGB(20, 60, 110)}, sp)
		local ss = Instance.new("UIScale")
		ss.Scale = 0.2
		ss.Parent = sp
		TweenService:Create(ss, TweenInfo.new(0.5 + math.random() * 0.5,
			Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true,
			math.random() * 0.4), {Scale = 1.15}):Play()
	end
	local icoS = nuevo("ImageLabel", {
		Size = UDim2.new(0, 390, 0, 390), Position = UDim2.new(0.5, 0, 0.42, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		-- 🏏 el regalo ahora es el BATE (antes IMG_GIANT)
		Image = Config.IMG_BAT, ScaleType = Enum.ScaleType.Fit, ZIndex = 134,
	}, escS)
	do
		local tf0 = os.clock()
		local flS
		flS = RunService.RenderStepped:Connect(function()
			if not vivoS then flS:Disconnect() return end
			local tf = os.clock() - tf0
			icoS.Position = UDim2.new(0.5, 0, 0.42, math.sin(tf * 2.2) * 7)
			icoS.Rotation = math.sin(tf * 1.5) * 6
		end)
	end
	local nomS = nuevo("TextLabel", {
		Size = UDim2.new(1, -50, 0, 40), Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy, Text = "BAT",   -- 🏏 el regalo cambió (era GIANT SLAP)
		TextColor3 = Color3.fromRGB(150, 215, 255), TextScaled = true, ZIndex = 134,
	}, escS)
	nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, nomS)
	local function cerrarRegaloSlap()
		if panelAbierto == pS then panelAbierto = nil end
		local sc = pS:FindFirstChildOfClass("UIScale")
		if sc then
			TweenService:Create(sc, TweenInfo.new(0.55, Enum.EasingStyle.Quad,
				Enum.EasingDirection.In), {Scale = 0.88}):Play()
		end
		desvanecer(pS, 0.55)
	end
	-- botón RECLAMAR (aquí SÍ se pide al server)
	local btnS = nuevo("TextButton", {
		Size = UDim2.new(0, 300, 0, 62), Position = UDim2.new(0.5, 0, 1, -20),
		AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Color3.fromRGB(70, 210, 70),
		Text = "", BorderSizePixel = 0, ZIndex = 132,
	}, pS)
	esquinas(btnS, 14)
	borde(btnS, 3)
	studsVivo(btnS, Color3.fromRGB(70, 210, 70), Color3.fromRGB(70, 210, 70), 130, nil, true)
	local blS = nuevo("TextLabel", {
		Size = UDim2.new(1, -14, 1, -12), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy,
		Text = esES and "¡RECLAMAR!" or "CLAIM!",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 133,
	}, btnS)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, blS)
	do
		local bs = Instance.new("UIScale")
		bs.Scale = 1
		bs.Parent = btnS
		TweenService:Create(bs, TweenInfo.new(0.6, Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut, -1, true), {Scale = 1.06}):Play()
	end
	btnS.MouseButton1Click:Connect(function()
		sndPop.TimePosition = 0
		sndPop:Play()                      -- pop de palomita al RECLAMAR
		RE.Prompt:FireServer("freeslap")
		cerrarRegaloSlap()
	end)
	local xS = nuevo("TextButton", {
		Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(1, -12, 0, 12),
		AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Color3.fromRGB(200, 70, 70),
		Text = "X", Font = Enum.Font.LuckiestGuy, TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1), ZIndex = 134,
	}, pS)
	esquinas(xS, 8)
	nuevo("UIStroke", {Thickness = 2, Color = Color3.new(0, 0, 0)}, xS)
	xS.MouseButton1Click:Connect(cerrarRegaloSlap)
	panelAbierto = pS
end

local function abrirPanel(titulo, alto)
	cerrarPanel()
	local p = nuevo("Frame", {
		Size = UDim2.new(0, 480, 0, alto or 340),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(32, 30, 52), BorderSizePixel = 0,
		ZIndex = 20,
	}, gui)
	esquinas(p, 14)
	borde(p, 4)
	nuevo("TextLabel", {
		Size = UDim2.new(1, -60, 0, 44), Position = UDim2.new(0, 16, 0, 6),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = titulo,
		TextColor3 = Color3.new(1, 1, 1), TextSize = 28, ZIndex = 21,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, p)
	local cerrar = nuevo("TextButton", {
		Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(1, -44, 0, 8),
		BackgroundColor3 = Color3.fromRGB(220, 60, 60), Font = Enum.Font.FredokaOne,
		Text = "X", TextColor3 = Color3.new(1, 1, 1), TextSize = 22,
		BorderSizePixel = 0, ZIndex = 21,
	}, p)
	esquinas(cerrar, 8)
	cerrar:SetAttribute("Mute", true)
	cerrar.MouseButton1Click:Connect(cerrarPanel)
	panelAbierto = p
	popIn(p)
	return p
end

-- ═══ PANEL DE TIENDA estilo referencia: fondo con textura de STUDS, header con
-- degradado + icono grande sobresaliendo + título blanco grueso + X roja ═══
local function panelTienda(titulo, icono, colHeader, colFondo, ancho, alto, radio)
	cerrarPanel()
	local p = nuevo("Frame", {
		Size = UDim2.new(0, ancho, 0, alto),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = colFondo, BorderSizePixel = 0, ZIndex = 20,
	}, gui)
	esquinas(p, 12)
	if radio then redondear(p, radio) end
	borde(p, 4)
	-- fondo del panel: BLANCO TRANSLÚCIDO (se ve el juego detrás) con un relieve
	-- suave de studs, en vez del color sólido que envolvía los apartados
	p.BackgroundColor3 = Color3.fromRGB(250, 251, 255)
	p.BackgroundTransparency = 0.55   -- más transparente (se ve más el juego detrás)
	local pimg = nuevo("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Image = Config.IMG_STUDS, ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.new(0, 210, 0, 210),
		ImageColor3 = Color3.new(1, 1, 1), ImageTransparency = 0.88,
		ZIndex = p.ZIndex,
	}, p)
	nuevo("UICorner", {CornerRadius = UDim.new(0, 0)}, pimg)
	if radio then redondear(pimg, radio) end
	local hd = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 21,
	}, p)
	esquinas(hd, 12)
	if radio then redondear(hd, radio) end
	borde(hd, 3)
	studsVivo(hd, vivo(colHeader, 1.2, 1.0), colHeader, 190, 0)
	if icono and tostring(icono):sub(1, 3) == "rbx" then
		nuevo("ImageLabel", {
			Size = UDim2.new(0, 96, 0, 96), Position = UDim2.new(0, 0, 0, -14),
			BackgroundTransparency = 1, Image = icono,
			ScaleType = Enum.ScaleType.Fit, Rotation = -10, ZIndex = 24,
		}, p)
	elseif icono then
		nuevo("TextLabel", {
			Size = UDim2.new(0, 88, 0, 88), Position = UDim2.new(0, 6, 0, -12),
			BackgroundTransparency = 1, Text = icono, TextScaled = true,
			Font = Enum.Font.FredokaOne, Rotation = -10, ZIndex = 24,
			TextColor3 = Color3.new(1, 1, 1),
		}, p)
	end
	local tl = nuevo("TextLabel", {
		Size = UDim2.new(1, -260, 0, 46), Position = UDim2.new(0, 108, 0, 9),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = titulo,
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 23,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, p)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tl)
	local cerrar = nuevo("TextButton", {
		Size = UDim2.new(0, 52, 0, 52), Position = UDim2.new(1, -62, 0, 6),
		BackgroundColor3 = Color3.fromRGB(238, 42, 78), Font = Enum.Font.FredokaOne,
		Text = "X", TextColor3 = Color3.new(1, 1, 1), TextSize = 30,
		BorderSizePixel = 0, ZIndex = 23,
	}, p)
	esquinas(cerrar, 8)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.fromRGB(255, 150, 170)}, cerrar)
	cerrar:SetAttribute("Mute", true)
	cerrar.MouseButton1Click:Connect(cerrarPanel)
	panelAbierto = p
	popIn(p)
	return p
end

-- botón de tienda con textura de studs; el texto va en un LABEL hijo (encima
-- del overlay). Devuelve botón, label y su contorno (para pintar OWNED rojo).
local function botonTienda(padre, size, pos, col, colBorde, z)
	local b = nuevo("TextButton", {
		Size = size, Position = pos, BackgroundColor3 = col, Text = "",
		BorderSizePixel = 0, ZIndex = z,
	}, padre)
	b:SetAttribute("NoZoom", true)   -- sin animación de zoom (feedback instantáneo)
	esquinas(b, 8)
	local st = Instance.new("UIStroke")
	st.Thickness = 4
	st.Color = Color3.new(0, 0, 0)         -- borde NEGRO
	st.LineJoinMode = Enum.LineJoinMode.Miter
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border   -- contorno alrededor del botón (sí se ve)
	st.Parent = b
	local img = studsVivo(b, col, col, 135)
	local lbl = nuevo("TextLabel", {
		Size = UDim2.new(1, -10, 1, -10), Position = UDim2.new(0, 5, 0, 5),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = "",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = z + 2,
	}, b)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, lbl)
	-- repinta la superficie (p.ej. verde→rojo OWNED) sin perder los studs,
	-- con la MISMA fórmula que studsVivo (ya no hay UIGradient que buscar)
	local function pintar(c2, cb2)
		b.BackgroundColor3 = vivo(c2, 1.2, 2.2)
		img.ImageColor3 = vivo(c2, 2.0, 0.5)
		-- el borde se queda NEGRO siempre
	end
	return b, lbl, pintar
end

-- ═══ RULETA GIRATORIA (paleta del juego: morados/rosas pastel) ═══
local FONDO_R = Color3.fromRGB(36, 24, 70)       -- morado profundo
local FONDO_DISC = Color3.fromRGB(52, 36, 96)    -- morado del disco
local MAGENTA = Color3.fromRGB(255, 92, 210)
local LAVANDA = Color3.fromRGB(178, 148, 255)
local ICONO_RULETA = {cash = "💵", speed = "🌀", jump = "🦘", slap = "🖐", fly = "🪂"}
-- chip pastel por tipo de premio
local PASTEL_CHIP = {
	cash = Color3.fromRGB(178, 244, 198),  -- verde menta
	speed = Color3.fromRGB(255, 178, 178), -- coral suave
	jump = Color3.fromRGB(178, 210, 255),  -- azul cielo (Gravity Coil)
	slap = Color3.fromRGB(206, 226, 255),  -- azul bebé
	fly = Color3.fromRGB(255, 226, 158),   -- durazno dorado
}
-- TICK de rebanada de la ruleta: POOL de 4 instancias rotando. Con UNA sola,
-- al girar rápido el Stop()+Play() en frames seguidos la dejaba MUDA (el Sound
-- nunca alcanzaba a emitir audio y solo se oía al frenar). Con el pool, cada
-- tick arranca LIMPIO en otra instancia y CANCELA la del tick anterior aunque
-- no haya terminado → el "brrrt" satisfactorio a alta velocidad.
local ticksRuleta = {}
for i = 1, 8 do
	local t = Instance.new("Sound")
	t.SoundId = "rbxassetid://127105730240202"
	t.Volume = 0.55
	t.Parent = gui
	ticksRuleta[i] = t
end
-- ⚠️ el audio trae SILENCIO al inicio: si dura más que el paso de una rebanada,
-- el tick se cancelaba antes de llegar a la parte audible (mudo a alta
-- velocidad). TICK_SKIP salta ese vacío; se AUTO-CALIBRA al entrar midiendo con
-- PlaybackLoudness cuándo empieza a sonar de verdad (sonda casi inaudible).
local TICK_SKIP = 0.15                   -- respaldo si la calibración falla
task.spawn(function()
	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync(ticksRuleta)
	end)
	local sonda = Instance.new("Sound")
	sonda.SoundId = "rbxassetid://127105730240202"
	sonda.Volume = 0.04                  -- casi inaudible: solo para medir
	sonda.Parent = gui
	sonda:Play()
	local t0 = os.clock()
	while os.clock() - t0 &lt; 2 do
		RunService.Heartbeat:Wait()
		if sonda.PlaybackLoudness &gt; 1 then
			TICK_SKIP = math.max(0, sonda.TimePosition - 0.02)
			break
		end
	end
	sonda:Destroy()
end)
local tickIdx = 0
local function tocarTick()
	-- round-robin SIN cancelar el anterior: a alta velocidad los ticks se
	-- traslapan (el "brrrt" lleno) en vez de cortarse antes de ser audibles.
	-- El pool de 8 evita reusar un sonido que todavía suena.
	tickIdx = tickIdx % #ticksRuleta + 1
	local t = ticksRuleta[tickIdx]
	t.TimePosition = TICK_SKIP
	t:Play()                             -- arranca YA en la parte audible
	t.TimePosition = TICK_SKIP           -- (reafirma tras Play, como el sonido de error)
end

local rueda = nil -- {panel, disc, aro, boton, info, conts, girando, conex}

local function cerrarRueda()
	gui:SetAttribute("ZoomFondo", false)   -- 🔍 fuera el zoom de fondo
	if rueda then
		if rueda.conex then rueda.conex:Disconnect() end
		desvanecer(rueda.panel, 0.3)
		rueda = nil
	end
end

local function actualizarRuedaUI()
	if not rueda then return end
	local n = (S.spinGratis and 1 or 0) + (S.spinsExtra or 0)
	if n &gt; 0 then
		rueda.boton.Text = esES and ("Girar  (" .. n .. " gratis)")
			or ("Spin  (" .. n .. " free)")
	else
		rueda.boton.Text = esES and ("Girar  ($" .. Config.SPIN_PRECIO_CASH .. ")")
			or ("Spin  ($" .. Config.SPIN_PRECIO_CASH .. ")")
	end
	if S.spinGratis then
		rueda.info.Text = esES and "🎁 ¡Tienes un giro GRATIS!"
			or "🎁 You have a FREE spin!"
	else
		local falta = 86400 - (os.time() % 86400)
		rueda.info.Text = string.format(
			esES and "Giro gratis en %dh %dm" or "Free spin in %dh %dm",
			math.floor(falta / 3600), math.floor(falta % 3600 / 60))
	end
end

-- endereza los textos/iconos de cada gajo (quedan SIEMPRE derechos)
local function enderezar(r, animado)
	local rot = r.disc.Rotation % 360
	for _, c in ipairs(r.conts) do
		for _, e in ipairs(c.els) do
			-- ICONO (chip): SIEMPRE derecho → contrarrestar el giro del disco
			-- (destino = -rot, con off = 0).
			-- ETIQUETA y % : van "pintados" sobre el disco a su ángulo FIJO
			-- (off = baseRot); giran con la rueda y quedan SIEMPRE tangentes al
			-- círculo en cualquier rotación. ⚠️ NO restarles rot: su posición ya
			-- orbitó con el disco, así que reorientarlas al ángulo original las
			-- dejaba chuecas justo por el ángulo final del disco (el bug).
			local destino = e.tangente and e.off or (e.off - rot)
			if animado then
				TweenService:Create(e.el, TweenInfo.new(0.3, Enum.EasingStyle.Back,
					Enum.EasingDirection.Out), {Rotation = destino}):Play()
			else
				e.el.Rotation = destino
			end
		end
	end
end

local function abrirRuleta()
	if rueda then return rueda end
	cerrarPanel()
	gui:SetAttribute("ZoomFondo", true)    -- 🔍 zoom de fondo (la abre el jugador
	                                       -- con la E de la rueda, nunca sola)
	-- panel CONTENEDOR con FONDO TRANSPARENTE (sin caja oscura, sin borde) y SIN
	-- título "RULETA KLOZZ": queda flotando solo la rueda + el botón sobre el juego
	local panel = nuevo("Frame", {
		Size = UDim2.new(0, 600, 0, 640),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20,
	}, gui)
	-- halo pastel + disco GRANDE con aro degradado giratorio
	local CYW = 298   -- centro Y de la rueda dentro del panel
	local ARO_D = 464 -- diámetro del aro dorado
	-- ❌ LA X VA PEGADA AL ARO, no a la esquina del panel (2026-08-18).
	-- El panel mide 600×640 y es TRANSPARENTE, así que una X en su esquina
	-- superior derecha quedaba flotando en el vacío, a unos 145 px del borde de la
	-- rueda: se leía como un botón suelto sin relación con nada. En móvil era peor
	-- todavía, porque con la pantalla estrecha esa esquina queda lejísimos.
	-- Ahora se calcula sobre la DIAGONAL de las 45° a la distancia justa para
	-- morder el borde dorado. Al salir de la geometría de la rueda y no de la
	-- esquina del panel, queda igual de pegada en cualquier pantalla.
	-- ⚠️ 2026-08-18, 2º intento: el primero se solapaba con el aro. El error fue
	-- medir hasta el CENTRO del botón, cuando lo que roza la rueda es su ESQUINA
	-- interior. Al ir en diagonal, esa esquina está media diagonal más adentro
	-- (48 × 0.7071 ≈ 34 px), y por eso se metía dentro del dorado.
	local CERRAR_SZ = 48
	local HUECO = 14                    -- aire entre la esquina de la X y el aro
	local DCEN = ARO_D / 2 + HUECO + CERRAR_SZ * 0.7071   -- centro X ↔ centro rueda
	local DIAG = DCEN * 0.7071          -- mismo desplazamiento en X y en Y
	local cerrar = nuevo("TextButton", {
		Size = UDim2.new(0, CERRAR_SZ, 0, CERRAR_SZ),
		Position = UDim2.new(0.5, DIAG, 0, CYW - DIAG),
		AnchorPoint = Vector2.new(0.5, 0.5),   -- posicionar por el CENTRO simplifica
		                                       -- la trigonometría de arriba
		BackgroundColor3 = Color3.fromRGB(235, 70, 90), Font = Enum.Font.FredokaOne,
		Text = "X", TextColor3 = Color3.new(1, 1, 1), TextSize = 28,
		BorderSizePixel = 0, ZIndex = 25,
	}, panel)
	esquinas(cerrar, 10)
	borde(cerrar, 2.5)
	cerrar:SetAttribute("Mute", true)
	cerrar.MouseButton1Click:Connect(cerrarRueda)
	-- ARO DORADO grueso (como la ruleta física)
	local aro = nuevo("Frame", {
		Size = UDim2.new(0, ARO_D, 0, ARO_D), Position = UDim2.new(0.5, 0, 0, CYW),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 190, 50),
		BorderSizePixel = 0, ZIndex = 20,
	}, panel)
	nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, aro)
	-- cara BLANCA (como la física: los huecos entre gajos se ven blancos)
	local disc = nuevo("Frame", {
		Size = UDim2.new(0, 432, 0, 432), Position = UDim2.new(0.5, 0, 0, CYW),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(246, 248, 252),
		BorderSizePixel = 0, ZIndex = 21, Rotation = 0,
	}, panel)
	nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, disc)
	nuevo("UIStroke", {Thickness = 8, Color = Color3.new(1, 1, 1)}, disc)
	-- REBANADAS de color (como la física: azul claro alternado + FLY naranja).
	-- Cada rebanada es una cuña de 45°: círculo ∩ media derecha ∩ medio plano girado.
	-- ⚠️ CanvasGroup (NO ClipsDescendants): ClipsDescendants NO recorta hijos ROTADOS
	--    (bug de Roblox) → salían los rectángulos gigantes en TODOS los gráficos.
	--    CanvasGroup sí recorta lo rotado; su único límite es gráficos MÍNIMOS.
	local function rebanada(anguloIni, color)
		local w = Instance.new("CanvasGroup")
		w.Size = UDim2.new(1, 0, 1, 0)
		w.Position = UDim2.new(0.5, 0, 0.5, 0)
		w.AnchorPoint = Vector2.new(0.5, 0.5)
		w.BackgroundTransparency = 1
		w.Rotation = anguloIni
		w.ZIndex = 21
		nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, w)   -- recorta al círculo
		local mitad = Instance.new("CanvasGroup")   -- media derecha (x ≥ centro)
		mitad.Size = UDim2.new(0.5, 0, 1, 0)
		mitad.Position = UDim2.new(0.5, 0, 0, 0)
		mitad.BackgroundTransparency = 1
		mitad.ZIndex = 21
		mitad.Parent = w
		-- envoltorio CENTRADO en el centro del disco: Rotation gira sobre el
		-- CENTRO del elemento (no sobre el AnchorPoint), así que el corte del
		-- medio plano debe hacerse con un wrapper cuyo centro = centro del disco
		local fw = Instance.new("Frame")
		fw.Size = UDim2.new(0, 700, 0, 700)
		fw.Position = UDim2.new(0, 0, 0.5, 0)       -- centro del disco (borde izq de mitad)
		fw.AnchorPoint = Vector2.new(0.5, 0.5)      -- centrado AHÍ (pivote correcto)
		fw.Rotation = 135
		fw.BackgroundTransparency = 1
		fw.ZIndex = 21
		fw.Parent = mitad
		local f = Instance.new("Frame")             -- mitad inferior del wrapper
		f.Size = UDim2.new(1, 0, 0.5, 0)            -- = medio plano por el centro
		f.Position = UDim2.new(0, 0, 0.5, 0)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.ZIndex = 21
		f.Parent = fw
		w.Parent = disc
	end
	-- los MISMOS colores vivos que los gajos de la ruleta física (GAJO_COLOR,
	-- en el orden de Config.RULETA)
	local GAJO_COLOR_UI = {
		Color3.fromRGB(70, 175, 255),    -- $100   azul
		Color3.fromRGB(150, 100, 255),   -- $500   morado
		Color3.fromRGB(255, 75, 85),     -- SPEED  rojo
		Color3.fromRGB(80, 225, 130),    -- $1,000 verde
		Color3.fromRGB(255, 120, 200),   -- SLAP   rosa
		Color3.fromRGB(60, 160, 255),    -- JUMP   azul
		Color3.fromRGB(255, 205, 65),    -- FLY    dorado
		Color3.fromRGB(255, 85, 155),    -- $10,000 magenta
	}
	for i = 1, #Config.RULETA do
		local ini = (i - 1) * 45 - 22.5             -- el gajo i abarca baseRot±22.5
		rebanada(ini, GAJO_COLOR_UI[i] or LAVANDA)
	end
	-- separadores BLANCOS entre gajos (como la cara blanca de la física)
	for i = 1, 8 do
		local w = nuevo("Frame", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Rotation = (i - 1) * 45 + 22.5, ZIndex = 22,
		}, disc)
		nuevo("Frame", {
			Size = UDim2.new(0, 5, 0.5, -8), Position = UDim2.new(0.5, -2.5, 0, 4),
			BackgroundColor3 = Color3.fromRGB(246, 248, 252),
			BorderSizePixel = 0, ZIndex = 22,
		}, w)
	end
	-- contenido de cada gajo: chip pastel GRANDE + premio + % (siempre derechos)
	local pesoTotal = 0
	for _, s in ipairs(Config.RULETA) do pesoTotal = pesoTotal + s.peso end
	-- icono, etiqueta y % de cada gajo, CADA UNO a su propio radio UNIFORME
	-- (cos/sin desde el centro) → todos parejos y alineados al eje del gajo:
	-- ETIQUETA arriba (hacia el borde) · ICONO en medio · % abajo
	local conts = {}
	local R_IC, R_LB, R_PC = 118, 176, 74
	for i, s in ipairs(Config.RULETA) do
		local baseRot = (i - 1) * 45
		local rad = math.rad(baseRot)
		local sn, cs = math.sin(rad), math.cos(rad)
		local function posR(R)
			return UDim2.new(0.5, sn * R, 0.5, -cs * R)
		end
		local chip = nuevo("TextLabel", {
			Size = UDim2.new(0, 64, 0, 64), Position = posR(R_IC),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = PASTEL_CHIP[s.tipo] or LAVANDA,
			Font = Enum.Font.FredokaOne, Text = ICONO_RULETA[s.tipo] or "🎁",
			TextSize = 34, BorderSizePixel = 0, ZIndex = 23,
		}, disc)
		chip.Rotation = 0
		nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, chip)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.new(1, 1, 1)}, chip)
		local imgChip = (s.tipo == "fly" and hayImgCarpet() and IMG_CARPET)
			or (s.tipo == "slap" and hayImg(Config.IMG_GIANT) and Config.IMG_GIANT)
			or (s.tipo == "cash" and hayImg(Config.IMG_CASH) and Config.IMG_CASH)
			or (s.tipo == "speed" and hayImg(Config.IMG_COIL) and Config.IMG_COIL)
			or (s.tipo == "jump" and hayImg(Config.IMG_JUMPCOIL) and Config.IMG_JUMPCOIL)
		if imgChip then
			chip.Text = ""
			-- SOLO la alfombra (fly) y los resortes (speed/jump) van grandes
			-- (se veían chicos); dinero y mano quedan a su tamaño normal
			local grande = s.tipo == "fly" or s.tipo == "speed" or s.tipo == "jump"
			local tam = grande and UDim2.new(1.4, 0, 1.4, 0) or UDim2.new(1, 2, 1, 2)
			nuevo("ImageLabel", {
				Size = tam, Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Image = imgChip, ScaleType = Enum.ScaleType.Fit, ZIndex = 24,
			}, chip)
		end
		local et = nuevo("TextLabel", {
			Size = UDim2.new(0, 116, 0, 26), Position = posR(R_LB),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Rotation = baseRot, Font = Enum.Font.LuckiestGuy, Text = s.etiqueta,
			TextColor3 = Color3.new(1, 1, 1), TextSize = 22, ZIndex = 23,
		}, disc)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.fromRGB(50, 22, 70)}, et)
		local pct = nuevo("TextLabel", {
			Size = UDim2.new(0, 90, 0, 18), Position = posR(R_PC),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Rotation = baseRot, Font = Enum.Font.GothamBlack,
			Text = string.format("%.1f%%", s.peso / pesoTotal * 100)
				:gsub("%.0%%", "%%"),
			TextColor3 = Color3.new(1, 1, 1), TextSize = 16, ZIndex = 23,
		}, disc)
		nuevo("UIStroke", {Thickness = 2.6, Color = Color3.fromRGB(30, 60, 110)}, pct)
		conts[i] = {els = {{el = chip, off = 0},
			{el = et, off = baseRot, tangente = true},
			{el = pct, off = baseRot, tangente = true}},
			chip = chip, baseRot = baseRot}
	end
	-- centro + puntero
	local hub = nuevo("Frame", {
		Size = UDim2.new(0, 62, 0, 62), Position = UDim2.new(0.5, 0, 0, CYW),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 24,
	}, panel)
	nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, hub)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.fromRGB(255, 190, 50)}, hub)
	-- circulito amarillo CENTRADO (antes era una estrella ★)
	local hubDot = nuevo("Frame", {
		Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 190, 50),
		BorderSizePixel = 0, ZIndex = 25,
	}, hub)
	nuevo("UICorner", {CornerRadius = UDim.new(0.5, 0)}, hubDot)
	local puntero = nuevo("TextLabel", {
		Size = UDim2.new(0, 70, 0, 54), Position = UDim2.new(0.5, -35, 0, CYW - 252),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = "▼",
		TextColor3 = Color3.fromRGB(235, 55, 45), TextSize = 52,
		TextStrokeTransparency = 0, TextStrokeColor3 = Color3.new(1, 1, 1),
		ZIndex = 25,
	}, panel)
	-- info + botón de girar (gradiente rosa→morado)
	local info = nuevo("TextLabel", {
		Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -104),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "",
		TextColor3 = Color3.fromRGB(226, 205, 255), TextSize = 16, ZIndex = 21,
	}, panel)
	local boton = nuevo("TextButton", {
		Size = UDim2.new(0, 300, 0, 58), Position = UDim2.new(0.5, -150, 1, -78),
		BackgroundColor3 = Color3.fromRGB(70, 175, 255),   -- azul de los gajos
		Font = Enum.Font.LuckiestGuy,
		Text = "", TextColor3 = Color3.new(1, 1, 1), TextSize = 27,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		BorderSizePixel = 0, ZIndex = 21,
	}, panel)
	esquinas(boton, 16)
	borde(boton, 3)
	-- contorno NEGRO del TEXTO (Contextual = delinea las letras, no el marco)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual}, boton)
	boton.MouseButton1Click:Connect(function()
		if rueda and not rueda.girando then RE.Girar:FireServer() end
	end)
	rueda = {panel = panel, disc = disc, aro = aro, boton = boton, info = info,
		conts = conts, puntero = puntero, girando = false}
	enderezar(rueda, false)
	popIn(panel)
	actualizarRuedaUI()
	task.spawn(function()
		local mia = rueda
		while rueda == mia do
			actualizarRuedaUI()
			task.wait(1)
		end
	end)
	return rueda
end

-- confeti de UI que explota desde el centro de la rueda
local function confetiUI(panel, cy)
	for i = 1, 34 do
		local c = nuevo("Frame", {
			Size = UDim2.new(0, math.random(8, 15), 0, math.random(8, 15)),
			Position = UDim2.new(0.5, 0, 0, cy), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.fromHSV(math.random(), 0.55, 1),
			BorderSizePixel = 0, Rotation = math.random(0, 360), ZIndex = 30,
		}, panel)
		esquinas(c, 3)
		local ang = math.random() * math.pi * 2
		local dist = math.random(120, 280)
		TweenService:Create(c, TweenInfo.new(math.random(7, 11) / 10,
			Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, math.cos(ang) * dist, 0,
				cy + math.sin(ang) * dist + 60),
			Rotation = math.random(-360, 360),
			BackgroundTransparency = 1,
		}):Play()
		task.delay(1.2, function() c:Destroy() end)
	end
end

-- audio del GIRO de la ruleta: arranca con el giro, desde el SEGUNDO 4 del
-- audio, completo y SIN repetir (Looped=false). Local: solo lo oye quien gira.
local sndGiro = Instance.new("Sound")
sndGiro.SoundId = "rbxassetid://71197035645816"
sndGiro.Looped = false
sndGiro.Volume = 0.6
sndGiro.Parent = gui

RE.Ruleta.OnClientEvent:Connect(function(idx)
	local r = abrirRuleta()
	if r.girando then return end
	r.girando = true
	r.boton.Text = "..."
	sndGiro:Stop()                 -- por si un giro anterior lo dejó sonando
	sndGiro.TimePosition = 4.7     -- inicia desde los 4.7 segundos del audio
	sndGiro:Play()
	sndGiro.TimePosition = 4.7     -- reafirma tras Play (mismo truco que los otros)
	-- GIRO manual RÁPIDO (perfil trapezoidal: acelera → crucero → frena)
	local base = r.disc.Rotation % 360
	r.disc.Rotation = base
	local total = 6 * 360 + ((360 - (idx - 1) * 45 - base) % 360)
		+ math.random(-10, 10)
	local Vmax = 1100         -- °/s: giro veloz y emocionante
	local tAcc, tDec = 0.35, 1.4
	local dAcc = Vmax * tAcc / 2
	local dDec = Vmax * tDec / 2
	local dCru = total - dAcc - dDec
	if dCru &lt; 0 then          -- recorrido corto: reescala rampas
		local f = total / (dAcc + dDec)
		tAcc, tDec = tAcc * f, tDec * f
		dAcc, dDec, dCru = dAcc * f, dDec * f, 0
	end
	local tCru = dCru / Vmax
	local aAcc, aDec = Vmax / tAcc, Vmax / tDec
	local elapsed, ultimo, ok = 0, math.floor(base / 45), true
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		elapsed = elapsed + dt
		local ang
		if elapsed &lt;= tAcc then
			ang = 0.5 * aAcc * elapsed * elapsed
		elseif elapsed &lt;= tAcc + tCru then
			ang = dAcc + Vmax * (elapsed - tAcc)
		elseif elapsed &lt;= tAcc + tCru + tDec then
			local td = elapsed - tAcc - tCru
			ang = dAcc + dCru + Vmax * td - 0.5 * aDec * td * td
		else
			ang = total
			conn:Disconnect()
			ok = false
		end
		if rueda ~= r then conn:Disconnect() return end
		r.disc.Rotation = base + ang
		-- (tick por gajo ELIMINADO: no funcionaba en la ruleta rápida; queda solo
		--  el audio del giro. El tick sigue en la ruleta PLANA de las cajas.)
	end)
	repeat task.wait() until not ok or rueda ~= r
	if rueda ~= r then return end
	r.disc.Rotation = (base + total) % 360  -- normalizar (mismo ángulo visual)
	-- 3) VICTORIA: enderezar textos + pop del gajo ganador + confeti + chime
	enderezar(r, true)
	local ganador = r.conts[idx]
	if ganador then
		local esc = Instance.new("UIScale")
		esc.Scale = 1
		esc.Parent = ganador.chip
		TweenService:Create(esc, TweenInfo.new(0.35, Enum.EasingStyle.Back,
			Enum.EasingDirection.Out), {Scale = 1.5}):Play()
		local brillo = Instance.new("UIStroke")
		brillo.Thickness = 0
		brillo.Color = Color3.fromRGB(255, 240, 130)
		brillo.Parent = ganador.chip
		TweenService:Create(brillo, TweenInfo.new(0.3), {Thickness = 6}):Play()
		task.delay(1.6, function()
			if esc.Parent then
				TweenService:Create(esc, TweenInfo.new(0.3), {Scale = 1}):Play()
			end
			if brillo.Parent then
				TweenService:Create(brillo, TweenInfo.new(0.3),
					{Thickness = 0}):Play()
			end
		end)
	end
	confetiUI(r.panel, 298)
	do   -- sonido de GANAR en la ruleta (ID del usuario; sustituye los 3 pings)
		sonar("rbxassetid://127039883737564", 0.6)
	end
	-- banner "¡GANASTE!" con el premio
	local premio = Config.RULETA[idx]
	local banner = nuevo("TextLabel", {
		Size = UDim2.new(1, 0, 0, 58), Position = UDim2.new(0, 0, 0, 66),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
		Text = (esES and "🎉 ¡GANASTE " or "🎉 YOU WON ")
			.. (premio and premio.etiqueta or "") .. "!",
		TextColor3 = Color3.fromRGB(255, 240, 140), TextSize = 40, ZIndex = 31,
	}, r.panel)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.fromRGB(120, 60, 20)}, banner)
	popIn(banner, 0.2, true)   -- sin sonido de click al terminar la ruleta
	task.delay(2.2, function()
		if banner.Parent then desvanecer(banner, 0.3) end
	end)
	task.wait(2.4)
	if rueda == r then
		r.girando = false
		actualizarRuedaUI()
	end
end)


-- ═══ CRATES / GEARS / BOOST panels ═════════════════════════
local function filaCompra(padre, y, texto, precioTexto, colorPrecio, alClick)
	local f = nuevo("Frame", {
		Size = UDim2.new(1, -32, 0, 52), Position = UDim2.new(0, 16, 0, y),
		BackgroundColor3 = Color3.fromRGB(48, 46, 74), BorderSizePixel = 0, ZIndex = 21,
	}, padre)
	esquinas(f, 10)
	nuevo("TextLabel", {
		Size = UDim2.new(1, -150, 1, 0), Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = texto,
		TextColor3 = Color3.new(1, 1, 1), TextSize = 20, ZIndex = 21,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	local b = nuevo("TextButton", {
		Size = UDim2.new(0, 120, 0, 38), Position = UDim2.new(1, -132, 0, 7),
		BackgroundColor3 = colorPrecio, Font = Enum.Font.FredokaOne,
		Text = precioTexto, TextColor3 = Color3.new(1, 1, 1), TextSize = 19,
		BorderSizePixel = 0, ZIndex = 21,
	}, f)
	esquinas(b, 8)
	borde(b, 2)
	b.MouseButton1Click:Connect(alClick)
	return f
end

local VERDE = Color3.fromRGB(72, 236, 20)
local AZULR = Color3.fromRGB(60, 140, 255)

-- ═══ CRATES v2 (estilo referencia): tienda con un BANNER por caja (título,
-- icono, CHIPS de premios con % y color de rareza, botón verde con el precio)
-- y RULETA PLANA horizontal al comprar: tira de premios que frena en el
-- ganador con los ticks de la ruleta. El server ya aplicó el premio. ═══
local CRATE_EMOJI = {basic = "📦", ice = "🧊", candy = "🍬", galactic = "🌌"}
local GEAR_IMG = {speed = Config.IMG_COIL, jump = Config.IMG_JUMPCOIL,
	speed2x = Config.IMG_COIL, invisible = Config.IMG_INVISIBLE,
	giant = Config.IMG_GIANT, carpet = Config.IMG_CARPET, god = Config.IMG_GOD}
local GEAR_NOM = {speed = "Speed", jump = "Gravity", speed2x = "2x Speed",
	invisible = "Invisible", giant = "Giant", carpet = "Carpet", god = "God!"}

local function colorRareza(peso)
	if peso &gt;= 30 then return Color3.fromRGB(64, 240, 24) end     -- común (verde)
	if peso &gt;= 10 then return Color3.fromRGB(255, 210, 8) end    -- raro (dorado)
	if peso &gt;= 2 then return Color3.fromRGB(196, 40, 255) end     -- épico (morado)
	return Color3.fromRGB(255, 28, 32)                             -- legendario (rojo)
end

-- chip de premio (para la tienda y para la tira de la ruleta): cash = billetes
-- + monto · gear = nombre + icono; abajo el % si conPct
local function chipPremio(padre, x, y, tam, pr, z, conPct)
	local c = nuevo("Frame", {
		Size = UDim2.new(0, tam, 0, tam), Position = UDim2.new(0, x, 0, y),
		BackgroundColor3 = colorRareza(pr.peso), BorderSizePixel = 0, ZIndex = z,
	}, padre)
	esquinas(c, 8)
	borde(c, 2)
	studsVivo(c, vivo(colorRareza(pr.peso), 1.22, 0.95),
		vivo(colorRareza(pr.peso), 0.82, 1.08), 105)
	if pr.tipo == "cash" then
		nuevo("ImageLabel", {
			Size = UDim2.new(0.66, 0, 0.66, 0), Position = UDim2.new(0.5, 0, 0.08, 0),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Image = Config.IMG_CASH, ScaleType = Enum.ScaleType.Fit, ZIndex = z + 1,
		}, c)
		local t = nuevo("TextLabel", {
			Size = UDim2.new(1, -6, 0.30, 0), Position = UDim2.new(0, 3, 0.42, 0),
			BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
			Text = "$" .. Config.formatoCash(pr.valor),
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = z + 2,
		}, c)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, t)
	else
		local t = nuevo("TextLabel", {
			Size = UDim2.new(1, -4, 0.24, 0), Position = UDim2.new(0, 2, 0, 2),
			BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
			Text = GEAR_NOM[pr.clave] or pr.clave,
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = z + 2,
		}, c)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, t)
		nuevo("ImageLabel", {
			Size = UDim2.new(0.88, 0, 0.7, 0), Position = UDim2.new(0.5, 0, 0.19, 0),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Image = GEAR_IMG[pr.clave] or "", ScaleType = Enum.ScaleType.Fit,
			ZIndex = z + 1,
		}, c)
	end
	if conPct then
		local pct = nuevo("TextLabel", {
			Size = UDim2.new(1, 0, 0.2, 0), Position = UDim2.new(0, 0, 0.8, 0),
			BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
			Text = pr.peso .. "%", TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true, ZIndex = z + 2,
		}, c)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, pct)
	end
	return c
end

local function abrirCrates()
	local p = panelTienda("Crates", "📦",
		Color3.fromRGB(191, 55, 176), Color3.fromRGB(120, 196, 252), 740, 560)   -- header #BF37B0
		-- 740 (antes 700): el icono de la caja creció al DOBLE y necesita aire
	local sc = nuevo("ScrollingFrame", {
		Position = UDim2.new(0, 12, 0, 74), Size = UDim2.new(1, -24, 1, -86),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 21,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, #Config.CRATES * 236 + 24),
	}, p)
	-- margen interior: aleja los banners del borde de recorte del scroll para que
	-- sus esquinas redondeadas NUNCA se corten (el scroll recorta en rectángulo)
	nuevo("UIPadding", {
		PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
	}, sc)
	for ci, def in ipairs(Config.CRATES) do
		local col = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
		local ban = nuevo("Frame", {
			Size = UDim2.new(1, -10, 0, 224),
			Position = UDim2.new(0, 0, 0, (ci - 1) * 236 + 4),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 21,
		}, sc)
		esquinas(ban, 12)
		nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0), LineJoinMode = Enum.LineJoinMode.Miter}, ban)
		studsVivo(ban, vivo(col, 1.3, 0.92), vivo(col, 0.85, 1.1), 195)
		local tit = nuevo("TextLabel", {
			Size = UDim2.new(1, 0, 0, 42), Position = UDim2.new(0, 0, 0, 4),
			BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
			Text = def.nombre, TextScaled = true, ZIndex = 23,
			TextColor3 = vivo(col, 1.55, 0.7),
		}, ban)
		nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tit)
		local ic = nuevo("Frame", {
			Size = UDim2.new(0, 152, 0, 152), Position = UDim2.new(0, 14, 0, 50),
			BackgroundColor3 = vivo(col, 0.68, 1.1),
			BorderSizePixel = 0, ZIndex = 22,
		}, ban)
		esquinas(ic, 10)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0), LineJoinMode = Enum.LineJoinMode.Miter}, ic)
		studsVivo(ic, vivo(col, 0.8, 1.05), vivo(col, 0.6, 1.1), 210)
		local imgCaja = (Config.CRATE_IMG or {})[def.id]
		if hayImg(imgCaja) then          -- icono personalizado de la caja
			nuevo("ImageLabel", {
				-- 1.22x el cuadro: la caja lo llena de orilla a orilla (el arte
				-- trae aire propio, así que "Fit" a este tamaño lo aprovecha)
				Size = UDim2.new(1.22, 0, 1.22, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Image = imgCaja, ScaleType = Enum.ScaleType.Fit, ZIndex = 24,
			}, ic)
		else                              -- respaldo: emoji
			nuevo("TextLabel", {
				Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0, 6, 0, 6),
				BackgroundTransparency = 1, Text = CRATE_EMOJI[def.id] or "📦",
				TextScaled = true, ZIndex = 24, Font = Enum.Font.FredokaOne,
				TextColor3 = Color3.new(1, 1, 1),
			}, ic)
		end
		for pi, pr in ipairs(def.premios) do
			chipPremio(ban, 176 + (pi - 1) * 104, 56, 96, pr, 23, true)
		end
		local esRobux = (def.id == "galactic")   -- la galáctica se paga con Robux
		local b, lbl = botonTienda(ban, UDim2.new(0, 240, 0, 46),
			UDim2.new(0, 288, 0, 166), esRobux and AZULR or VERDE,
			Color3.fromRGB(16, 88, 20), 23)
		if esRobux then
			lbl.Text = Config.PRODUCTOS.crategalactic.precio .. " " .. ROBUX
			b.MouseButton1Click:Connect(function()
				RE.Prompt:FireServer("producto", "crategalactic")
			end)
		else
			lbl.Text = "$" .. Config.formatoCash(def.precio)
			b.MouseButton1Click:Connect(function()
				RE.ComprarCrate:FireServer(def.id)
			end)
		end
	end
end

-- ruleta PLANA de la caja (case-opening): tira horizontal que frena en el
-- premio ganador (idx del server), con tick por casilla y resultado al final
local crateOverlay
-- ═══ CELEBRACIÓN de premio (ruleta de cajas): rayos giratorios + aura pulsante +
-- tarjeta del premio con pop elástico + confetti con gravedad + destellos +
-- título "¡GANASTE!". El color de TODO sale de la rareza del premio. ═══
local function celebrarPremio(def, pr, info)
	local rare = colorRareza(pr.peso)
	local rarezaNom = "COMMON"
	if pr.peso &lt; 2 then rarezaNom = "LEGENDARY"
	elseif pr.peso &lt; 10 then rarezaNom = "EPIC"
	elseif pr.peso &lt; 30 then rarezaNom = "RARE" end
	-- el ícono SIEMPRE es acorde a lo que cayó: cash → billete; gear/coil → SU
	-- ícono (aunque sea repetido) para que se vea que ganaste ESE objeto y no "dinero"
	local iconoImg = (pr.tipo == "cash") and Config.IMG_CASH or (GEAR_IMG[pr.clave] or "")
	local txtPremio, tituloTxt
	if pr.tipo == "cash" then
		txtPremio = "+$" .. Config.formatoCash(pr.valor)   -- ganaste dinero
		tituloTxt = "YOU WON!"
	elseif info.dupe then
		txtPremio = "+$" .. Config.formatoCash(def.precio) -- repetido → reembolso del precio
		tituloTxt = "DUPLICATE!"
	else
		txtPremio = GEAR_NOM[pr.clave] or pr.clave         -- coil/gear NUEVO
		tituloTxt = "NEW!"
	end

	local conns = {}
	local cel = nuevo("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 60,
	}, gui)
	crateOverlay = cel
	TweenService:Create(cel, TweenInfo.new(0.35), {BackgroundTransparency = 0.4}):Play()

	do   -- sonido de GANAR (ID del usuario)
		sonar("rbxassetid://127039883737564", 0.65)
	end

	-- ══ RAYOS giratorios ══
	local rays = nuevo("Frame", {
		Size = UDim2.new(0, 780, 0, 780), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 61,
	}, cel)
	for i = 1, 12 do
		local ray = nuevo("Frame", {
			Size = UDim2.new(0, 48, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), Rotation = i * 15,
			BackgroundColor3 = rare, BackgroundTransparency = 0.78,
			BorderSizePixel = 0, ZIndex = 61,
		}, rays)
		nuevo("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35),
			NumberSequenceKeypoint.new(1, 1)})}, ray)
	end
	do
		local rsc = Instance.new("UIScale")
		rsc.Scale = 0.2
		rsc.Parent = rays
		TweenService:Create(rsc, TweenInfo.new(0.5, Enum.EasingStyle.Back,
			Enum.EasingDirection.Out), {Scale = 1}):Play()
	end
	conns[#conns + 1] = RunService.RenderStepped:Connect(function(dt)
		if not rays.Parent then return end
		rays.Rotation = (rays.Rotation + dt * 22) % 360
	end)

	-- ══ AURA circular pulsante detrás de la tarjeta ══
	local glow = nuevo("Frame", {
		Size = UDim2.new(0, 380, 0, 380), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = rare,
		BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 61,
	}, cel)
	nuevo("UICorner", {CornerRadius = UDim.new(1, 0)}, glow)   -- círculo (aura)
	do
		local gsc = Instance.new("UIScale")
		gsc.Scale = 0.6
		gsc.Parent = glow
		TweenService:Create(gsc, TweenInfo.new(1.0, Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut, -1, true), {Scale = 1.1}):Play()
	end

	-- ══ DESTELLOS (twinkles) alrededor ══
	for i = 1, 7 do
		local ang = math.rad(i * (360 / 7) + math.random(-12, 12))
		local rr = math.random(150, 215)
		local sp = nuevo("TextLabel", {
			Size = UDim2.new(0, 42, 0, 42),
			Position = UDim2.new(0.5, math.cos(ang) * rr, 0.5, math.sin(ang) * rr),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Text = "✦", Font = Enum.Font.LuckiestGuy, TextScaled = true,
			TextColor3 = Color3.fromRGB(255, 255, 205), ZIndex = 63,
		}, cel)
		nuevo("UIStroke", {Thickness = 2, Color = Color3.fromRGB(120, 90, 0)}, sp)
		local ssc = Instance.new("UIScale")
		ssc.Scale = 0.2
		ssc.Parent = sp
		TweenService:Create(ssc, TweenInfo.new(0.5 + math.random() * 0.5,
			Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true,
			math.random() * 0.4), {Scale = 1.15}):Play()
	end

	-- ══ TARJETA del premio ══
	local card = nuevo("Frame", {
		Size = UDim2.new(0, 250, 0, 300), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = rare,
		BorderSizePixel = 0, ZIndex = 62,
	}, cel)
	esquinas(card, 0)
	borde(card, 4)
	studsVivo(card, vivo(rare, 1.2, 1.0), vivo(rare, 0.8, 1.05), 120)
	local lblRare = nuevo("TextLabel", {
		Size = UDim2.new(1, -14, 0, 34), Position = UDim2.new(0, 7, 0, 10),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = rarezaNom,
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 64,
	}, card)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, lblRare)
	nuevo("ImageLabel", {
		Size = UDim2.new(0, 152, 0, 152), Position = UDim2.new(0.5, 0, 0, 54),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Image = iconoImg, ScaleType = Enum.ScaleType.Fit, ZIndex = 63,
	}, card)
	local lblTxt = nuevo("TextLabel", {
		Size = UDim2.new(1, -14, 0, 46), Position = UDim2.new(0, 7, 1, -54),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = txtPremio,
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 64,
	}, card)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, lblTxt)
	do
		local csc = Instance.new("UIScale")
		csc.Scale = 0
		csc.Parent = card
		TweenService:Create(csc, TweenInfo.new(0.55, Enum.EasingStyle.Back,
			Enum.EasingDirection.Out), {Scale = 1}):Play()
	end

	-- ══ TÍTULO ¡GANASTE! ══
	local titulo = nuevo("TextLabel", {
		Size = UDim2.new(0, 470, 0, 74), Position = UDim2.new(0.5, 0, 0.5, -222),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy, Text = tituloTxt,
		TextColor3 = Color3.fromRGB(255, 240, 120), TextScaled = true, ZIndex = 64,
	}, cel)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, titulo)
	popIn(titulo, 0.2, true)

	-- ══ CONFETTI (con gravedad) ══
	local COLS = {Color3.fromRGB(255, 80, 120), Color3.fromRGB(255, 205, 60),
		Color3.fromRGB(90, 225, 120), Color3.fromRGB(80, 175, 255),
		Color3.fromRGB(195, 110, 255), Color3.fromRGB(255, 255, 255)}
	local parts = {}
	for i = 1, 48 do
		local tam = math.random(9, 20)
		local pcf = nuevo("Frame", {
			Size = UDim2.new(0, tam, 0, tam * (math.random() &lt; 0.5 and 1 or 0.6)),
			Position = UDim2.new(0.5, math.random(-40, 40), 0.5, math.random(-30, 30)),
			AnchorPoint = Vector2.new(0.5, 0.5), Rotation = math.random(0, 360),
			BackgroundColor3 = COLS[math.random(#COLS)], BorderSizePixel = 0, ZIndex = 65,
		}, cel)
		parts[i] = {f = pcf, vx = math.random(-400, 400),
			vy = math.random(-760, -400), vr = math.random(-300, 300), px = 0, py = 0}
	end
	conns[#conns + 1] = RunService.RenderStepped:Connect(function(dt)
		if not cel.Parent then return end
		for _, p in ipairs(parts) do
			if p.f.Parent then
				p.vy = p.vy + 1500 * dt
				p.px = p.px + p.vx * dt
				p.py = p.py + p.vy * dt
				p.f.Position = UDim2.new(0.5, p.px, 0.5, p.py)
				p.f.Rotation = p.f.Rotation + p.vr * dt
			end
		end
	end)
	task.delay(1.2, function()
		for _, p in ipairs(parts) do
			if p.f.Parent then
				TweenService:Create(p.f, TweenInfo.new(0.6),
					{BackgroundTransparency = 1}):Play()
			end
		end
	end)

	-- ══ cierre tras ~2.6 s ══
	task.delay(2.6, function()
		for _, c in ipairs(conns) do c:Disconnect() end
		if cel == crateOverlay then crateOverlay = nil end
		if cel.Parent then desvanecer(cel, 0.45) end
	end)
end

local function animarCrate(info)
	local def
	for _, c in ipairs(Config.CRATES) do
		if c.id == info.id then def = c break end
	end
	if not def then return end
	cerrarPanel()
	if crateOverlay then crateOverlay:Destroy() crateOverlay = nil end
	local col = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
	local ov = nuevo("Frame", {
		Size = UDim2.new(0, 900, 0, 300), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 40,
	}, gui)
	crateOverlay = ov
	local tb = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 41,
	}, ov)
	esquinas(tb, 10)
	borde(tb, 3)
	studsVivo(tb, vivo(col, 1.25, 0.92), vivo(col, 0.72, 1.1), 180, 0)
	local tt = nuevo("TextLabel", {
		Size = UDim2.new(1, 0, 1, -8), Position = UDim2.new(0, 0, 0, 4),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, Text = def.nombre,
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 42,
	}, tb)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tt)
	local clip = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, 170), Position = UDim2.new(0, 0, 0, 60),
		BackgroundColor3 = Color3.fromRGB(28, 26, 48), BackgroundTransparency = 0.2,
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 40,
	}, ov)
	esquinas(clip, 10)
	borde(clip, 3)
	ladrillos(clip, nil, nil, 200)
	local TILE, N, WIN = 150, 34, 28
	local tira = nuevo("Frame", {
		Size = UDim2.new(0, N * TILE, 1, 0), BackgroundTransparency = 1, ZIndex = 41,
	}, clip)
	local totalPeso = 0
	for _, pr in ipairs(def.premios) do totalPeso = totalPeso + pr.peso end
	local tiles = {}
	for k = 1, N do
		local pr
		if k == WIN then
			pr = def.premios[info.idx]           -- el ganador REAL del server
		else
			local rr = math.random() * totalPeso -- relleno visual (misma pinta)
			for _, pp in ipairs(def.premios) do
				rr = rr - pp.peso
				if rr &lt;= 0 then pr = pp break end
			end
			pr = pr or def.premios[1]
		end
		tiles[k] = chipPremio(tira, (k - 1) * TILE + 8, 18, 134, pr, 41, false)
	end
	nuevo("Frame", {                             -- marcador central
		Size = UDim2.new(0, 4, 1, 8), Position = UDim2.new(0.5, -2, 0, -4),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 43,
	}, clip)
	local clipW = 900
	local destino = (WIN - 0.5) * TILE - clipW / 2 + math.random(-40, 40)
	local dur = 4.2
	local t0 = os.clock()
	local ultimoIdx = -1
	local con
	con = RunService.RenderStepped:Connect(function()
		if not tira.Parent then con:Disconnect() return end
		local pl = math.clamp((os.clock() - t0) / dur, 0, 1)
		local e = 1 - (1 - pl) ^ 4               -- arranca veloz, frena suave
		local off = destino * e
		tira.Position = UDim2.new(0, -off, 0, 0)
		local idx = math.floor((off + clipW / 2) / TILE)
		if idx ~= ultimoIdx then
			ultimoIdx = idx
			tocarTick()                          -- mismo tick satisfactorio de la ruleta
		end
		if pl &gt;= 1 then
			con:Disconnect()
			if tiles[WIN] then
				nuevo("UIStroke", {Thickness = 5, Color = Color3.new(1, 1, 1),
					LineJoinMode = Enum.LineJoinMode.Round}, tiles[WIN])
			end
			task.delay(0.5, function()
				if ov.Parent then
					if ov == crateOverlay then crateOverlay = nil end
					desvanecer(ov, 0.3)
				end
				celebrarPremio(def, def.premios[info.idx], info)
			end)
		end
	end)
end

-- ═══ TIENDA GEARS estilo referencia: cuadrícula de TARJETAS (título de color +
-- icono + botón verde con el precio en CASH / rojo OWNED). TODOS los elementos
-- del juego se compran con dinero y quedan PERMANENTES (perfil.gears). ═══
local function abrirGears()
	local p = panelTienda("Gears", Config.IMG_JUMPCOIL,
		Color3.fromRGB(38, 165, 252), Color3.fromRGB(26, 118, 238), 640, 560)
	local items = {
		{clave = "speed", nombre = "Speed", color = Color3.fromRGB(255, 120, 40),
		 img = Config.IMG_COIL, precio = Config.GEAR_SPEED_CASH, coil = true},
		{clave = "jump", nombre = "Gravity", color = Color3.fromRGB(120, 190, 255),
		 img = Config.IMG_JUMPCOIL, precio = Config.GEAR_JUMP_CASH, coil = true},
		{clave = "speed2x", nombre = "2x Speed", color = Color3.fromRGB(255, 225, 70),
		 img = Config.IMG_COIL, precio = Config.GEARS_CASH.speed2x},
		{clave = "invisible", nombre = "Invisible", color = Color3.fromRGB(215, 225, 240),
		 img = Config.IMG_INVISIBLE, precio = Config.GEARS_CASH.invisible},
		{clave = "giant", nombre = "Giant", color = Color3.fromRGB(160, 225, 255),
		 img = Config.IMG_GIANT, precio = Config.GEARS_CASH.giant},
		{clave = "carpet", nombre = "Carpet", color = Color3.fromRGB(125, 235, 145),
		 img = Config.IMG_CARPET, precio = Config.GEARS_CASH.carpet},
		{clave = "god", nombre = "God!", color = Color3.fromRGB(255, 115, 225),
		 img = Config.IMG_GOD, precio = Config.GEARS_CASH.god},
	}
	local refrescos = {}
	local function refrescar()
		for _, fn in ipairs(refrescos) do fn() end
	end
	for i, it in ipairs(items) do
		local colG = (i - 1) % 4
		local fila = math.floor((i - 1) / 4)
		local x = 18 + colG * 154
		local y = 76 + fila * 238
		local tit = nuevo("TextLabel", {
			Size = UDim2.new(0, 140, 0, 34), Position = UDim2.new(0, x, 0, y),
			BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
			Text = it.nombre, TextColor3 = it.color, TextScaled = true, ZIndex = 22,
		}, p)
		nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tit)
		local f = nuevo("Frame", {
			Size = UDim2.new(0, 140, 0, 190), Position = UDim2.new(0, x, 0, y + 36),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0, ZIndex = 21,
		}, p)
		esquinas(f, 10)
		nuevo("UIStroke", {Thickness = 3, Color = Color3.fromRGB(12, 48, 105)}, f)
		studsVivo(f, Color3.fromRGB(96, 196, 255), Color3.fromRGB(26, 106, 230), 165)
		nuevo("ImageLabel", {
			Size = UDim2.new(0, 100, 0, 100), Position = UDim2.new(0.5, 0, 0, 14),
			AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
			Image = it.img, ScaleType = Enum.ScaleType.Fit, ZIndex = 23,
		}, f)
		local b, lbl, pintar = botonTienda(f, UDim2.new(1, -16, 0, 42),
			UDim2.new(0, 8, 1, -50), VERDE, Color3.fromRGB(16, 88, 20), 22)
		local function ref()
			local owned
			if it.coil then owned = S.coils and S.coils[it.clave]
			else owned = S.pases and S.pases[it.clave] end
			if owned then
				lbl.Text = "OWNED"
				pintar(Color3.fromRGB(240, 45, 58), Color3.fromRGB(112, 14, 24))
			else
				lbl.Text = "$" .. Config.formatoCash(it.precio)
				pintar(VERDE, Color3.fromRGB(16, 88, 20))
			end
		end
		ref()
		table.insert(refrescos, ref)
		b.MouseButton1Click:Connect(function()
			RE.ComprarGear:FireServer(it.clave)
			-- feedback INSTANTÁNEO: se pone rojo (OWNED) al momento si alcanza y no
			-- lo tiene; los 0.7s de después solo reconcilian con el server por si falló
			local owned
			if it.coil then owned = S.coils and S.coils[it.clave]
			else owned = S.pases and S.pases[it.clave] end
			if not owned and S.cash and S.cash &gt;= it.precio then
				lbl.Text = "OWNED"
				pintar(Color3.fromRGB(240, 45, 58), Color3.fromRGB(112, 14, 24))
			end
			task.delay(0.7, function()
				if p.Parent then refrescar() end
			end)
		end)
	end
end

-- ═══ VENTANA DE RECLAMO DEL COFRE (cima): cofre grande + pastilla dorada con
-- billete y monto + botón CLAIM verde + X. La abre el server al acercarse
-- (RE.FX "abrirCofre", monto); CLAIM → RE.Prompt "cofre" (el server valida). ═══
local cofrePanel, cofreUltimoCierre = nil, 0
local function abrirCofre(monto)
	if cofrePanel and cofrePanel.Parent then return end        -- ya está abierta
	if os.clock() - cofreUltimoCierre &lt; 5 then return end        -- recién cerrada → no reabrir de golpe
	cerrarPanel()
	local p = nuevo("Frame", {
		Size = UDim2.new(0, 460, 0, 470),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(58, 40, 96), BorderSizePixel = 0, ZIndex = 20,
	}, gui)
	esquinas(p, 18)
	borde(p, 5)
	studsVivo(p, Color3.fromRGB(58, 40, 96), Color3.fromRGB(58, 40, 96), 240, nil, true)
	local function cerrarCofre()
		cofreUltimoCierre = os.clock()
		cofrePanel = nil
		cerrarPanel()
	end
	local cerrar = nuevo("TextButton", {
		Size = UDim2.new(0, 58, 0, 58), Position = UDim2.new(1, -70, 0, 12),
		BackgroundColor3 = Color3.fromRGB(235, 70, 95), Font = Enum.Font.LuckiestGuy,
		Text = "", TextColor3 = Color3.new(1, 1, 1), TextSize = 34,
		BorderSizePixel = 0, ZIndex = 22,
	}, p)
	esquinas(cerrar, 12)
	borde(cerrar, 3)
	studsVivo(cerrar, Color3.fromRGB(235, 70, 95), Color3.fromRGB(235, 70, 95), 110, nil, true)
	local xlbl = nuevo("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy, Text = "X", TextColor3 = Color3.new(1, 1, 1),
		TextSize = 34, ZIndex = 24,
	}, cerrar)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, xlbl)
	cerrar:SetAttribute("Mute", true)
	cerrar.MouseButton1Click:Connect(cerrarCofre)
	nuevo("ImageLabel", {                                   -- cofre grande
		Size = UDim2.new(0, 300, 0, 240), Position = UDim2.new(0.5, 0, 0, 28),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		Image = Config.IMG_COFRE, ScaleType = Enum.ScaleType.Fit, ZIndex = 21,
	}, p)
	local pill = nuevo("Frame", {                           -- pastilla dorada
		Size = UDim2.new(0, 320, 0, 78), Position = UDim2.new(0.5, 0, 0, 278),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 190, 55),
		BorderSizePixel = 0, ZIndex = 21,
	}, p)
	esquinas(pill, 16)
	borde(pill, 3)
	studsVivo(pill, Color3.fromRGB(255, 190, 55), Color3.fromRGB(255, 190, 55), 140, nil, true)
	nuevo("ImageLabel", {                                   -- billete
		Size = UDim2.new(0, 62, 0, 62), Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
		Image = Config.IMG_CASH, ScaleType = Enum.ScaleType.Fit, ZIndex = 22,
	}, pill)
	local lbl = nuevo("TextLabel", {                        -- monto
		Size = UDim2.new(1, -88, 0.7, 0), Position = UDim2.new(0, 80, 0.15, 0),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
		Text = "$" .. (Config.formatoCash and Config.formatoCash(monto) or tostring(monto)),
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 22,
	}, pill)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.fromRGB(70, 45, 10)}, lbl)
	-- ══ BOTON CLAIM RE-HECHO DESDE CERO (2026-07-15) ══ el viejo usaba studsVivo/
	-- Crop, que dejaban 2 filas de studs con una FRANJA plana en medio (la "barra
	-- verde"). Este NO los usa: verde vivo + borde negro + cuadritos como OVERLAY
	-- BLANCO muy transparente (0.8) tile 140 = MISMO zoom que la barra dorada, y como
	-- el overlay es tan sutil los studs son un relieve parejo (sin banda dura).
	local claim = nuevo("TextButton", {
		Size = UDim2.new(0, 320, 0, 80), Position = UDim2.new(0.5, 0, 0, 372),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(84, 222, 84),
		AutoButtonColor = false, Text = "", BorderSizePixel = 0,
		ClipsDescendants = true, ZIndex = 22,
	}, p)
	nuevo("UIStroke", {Thickness = 4, Color = Color3.new(0, 0, 0),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter}, claim)
	nuevo("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Image = Config.IMG_STUDS, ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.new(0, 140, 0, 140),
		ImageColor3 = Color3.new(1, 1, 1), ImageTransparency = 0.8, ZIndex = 22,
	}, claim)
	local claimLbl = nuevo("TextLabel", {
		Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy, Text = "Claim", TextColor3 = Color3.new(1, 1, 1),
		TextSize = 42, ZIndex = 24,
	}, claim)
	nuevo("UIStroke", {Thickness = 3.5, Color = Color3.fromRGB(24, 90, 24),
		LineJoinMode = Enum.LineJoinMode.Round}, claimLbl)
	claim.MouseButton1Click:Connect(function()
		RE.Prompt:FireServer("cofre")
		cerrarCofre()
	end)
	cofrePanel = p
	panelAbierto = p
	popIn(p)
	return p
end

-- ═══ BOOSTS v2 (2026-08-18): mismo lenguaje visual que Crates y Gears ═══
-- Antes usaba abrirPanel + filaCompra, que son el modal GENÉRICO: caja gris
-- opaca y filas azul marino planas. Chocaba con el resto del juego.
-- Ahora va con panelTienda (fondo blanco translúcido al 0.55 → se ve el juego
-- detrás, textura de studs encima, cabecera con degradado y X roja grande) y cada
-- fila lleva su propio color vivo con studs, como los items de Gears.
-- ⚠️ filaBoost va DENTRO de abrirBoosts, no suelta aquí arriba: este archivo está
-- pegado al límite de 200 locales por función de Lua y sacarla fuera lo revienta
-- (comprobado). Como local de la función no cuenta para ese cupo.
local function abrirBoosts()
local function filaBoost(padre, y, texto, precioTexto, col, colBoton, alClick)
	local f = nuevo("Frame", {
		Size = UDim2.new(1, -36, 0, 64), Position = UDim2.new(0, 18, 0, y),
		BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 22,
	}, padre)
	esquinas(f, 12)
	borde(f, 3)
	studsVivo(f, col, col, 120, 0)
	-- 🧹 SIN EMOJIS. Los nombres vienen de Config ya con el suyo ("⚡ 2x Speed",
	-- "💵 5,500 Cash"…), así que al añadir yo otro icono salían DOBLES. Se quita
	-- el de Config borrando todo lo que no sea ASCII: los nombres reales son
	-- "2x Speed", "5,500 Cash", "5 Spins", "Flying Carpet" — puro ASCII — así que
	-- solo cae el emoji. ⚠️ Si algún día un nombre lleva tilde o ñ, este filtro se
	-- la comería: habría que pasar a quitar solo el primer carácter.
	local limpio = texto:gsub("[\128-\255]", ""):gsub("^%s+", ""):gsub("%s+$", "")
	local tl = nuevo("TextLabel", {
		Size = UDim2.new(1, -172, 0, 34), Position = UDim2.new(0, 18, 0, 15),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = limpio,
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 25,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tl)
	-- ⚠️ el precio va con botonTienda y no con un TextButton normal: studsVivo
	-- mete una imagen y un brillo DENTRO del botón, y el Text nativo quedaría
	-- debajo. botonTienda ya resuelve eso poniendo el texto en un label hijo.
	local b, lbl = botonTienda(f, UDim2.new(0, 132, 0, 44),
		UDim2.new(1, -144, 0, 10), colBoton, nil, 24)
	lbl.Text = precioTexto
	b.MouseButton1Click:Connect(alClick)
	return f
end
	-- el icono es el MISMO del botón "Boost?" de la esquina (los dos muñecos), no
	-- un emoji: así la ventana se reconoce como "la que abrí con ese botón".
	-- panelTienda ya distingue imagen de emoji mirando si empieza por "rbx".
	local p = panelTienda("Boosts", iconoBoost.Image,
		Color3.fromRGB(168, 74, 255), Color3.fromRGB(112, 40, 200), 620, 470)
	filaBoost(p, 84, (esES and "Invita amigos: +10% Cash c/u"
		or "Invite friends: +10% Cash each"), "INVITE",
		Color3.fromRGB(90, 210, 255), VERDE, function()
			pcall(function() SocialService:PromptGameInvite(plr) end)
		end)
	filaBoost(p, 158, Config.GAMEPASSES.speed2x.nombre,
		Config.GAMEPASSES.speed2x.precio .. " " .. ROBUX,
		Color3.fromRGB(255, 225, 70), AZULR, function()
			RE.Prompt:FireServer("pase", "speed2x")
		end)
	filaBoost(p, 232, Config.PRODUCTOS.cash5k.nombre,
		Config.PRODUCTOS.cash5k.precio .. " " .. ROBUX,
		Color3.fromRGB(90, 230, 120), AZULR, function()
			RE.Prompt:FireServer("producto", "cash5k")
		end)
	filaBoost(p, 306, Config.PRODUCTOS.spins5.nombre,
		Config.PRODUCTOS.spins5.precio .. " " .. ROBUX,
		Color3.fromRGB(255, 140, 200), AZULR, function()
			RE.Prompt:FireServer("producto", "spins5")
		end)
	filaBoost(p, 380, Config.GAMEPASSES.carpet.nombre,
		Config.GAMEPASSES.carpet.precio .. " " .. ROBUX,
		Color3.fromRGB(255, 130, 60), AZULR, function()
			RE.Prompt:FireServer("pase", "carpet")
		end)
end
botonBoost.MouseButton1Click:Connect(abrirBoosts)
botonInvitar.MouseButton1Click:Connect(abrirBoosts)

-- ═══ MENÚ DE SKINS 🍎 ══════════════════════════════════════
-- Rejilla de manzanas: las que tienes se pueden equipar y quitar, las que no
-- salen en gris con candado y con la frase de cómo se consiguen.
--
-- ⚠️ Este cálculo del desbloqueo es SOLO PARA PINTAR. Quien decide de verdad es
-- skinDesbloqueada() en MainServer; aquí no hay nada que valga la pena trucar,
-- porque pedir una skin bloqueada al server simplemente no hace nada.
-- (Otro do...end por el límite de 200 locales del chunk: ver la nota del botón.)
do
-- 🧪 el mismo atajo de Studio que aplica el servidor: sin esto los candados y la
-- barra de progreso seguirían diciendo "bloqueada" mientras el servidor sí deja
-- equiparla, y la interfaz estaría mintiendo. En el juego publicado es false.
local ES_STUDIO = game:GetService("RunService"):IsStudio()
local function skinLibre(s)
	if ES_STUDIO and Config.SKINS_LIBRES_STUDIO then return true end
	if s.req == "comunidad" then
		return plr:GetAttribute("EnComunidad") == true
	elseif s.req == "pase" then
		-- S.pases llega en el Sync tal cual la tiene el servidor
		return (S.pases and S.pases[s.pase]) == true
	elseif s.req == "torre" then
		-- MISMA regla que el server (vecesCompletadas): pisar la azotea ya cuenta
		-- como una vuelta aunque todavía no hayas reclamado el cofre.
		local n = math.max(S.trofeos or 0,
			((S.pisoMax or 0) &gt; Config.N_PISOS) and 1 or 0)
		return n &gt;= (s.veces or 1)
	end
	return true
end

function refrescarSkins() end   -- se re-define al abrir; no-op si está cerrado

function SkinsUI.abrir()
	cerrarPanel()
	-- 📜 REJILLA CON SCROLL, 3 POR FILA (2026-07-30). Antes eran las 6 en una fila
	-- de tarjetas chiquitas; con los mundos nuevos van a entrar muchas más skins y
	-- eso no escala. Ahora van de 3 en 3 y se baja con la rueda.
	--
	-- 🍎 LA MANZANA MANDA (30 jul 2026). El tamaño con el que se ve es
	--       2,4 studs / (2 · dist · tan(FOV/2))  ·  alto_del_viewport
	-- o sea que depende del ALTO del viewport y de la distancia de la cámara, y de
	-- nada más. A la distancia de la tarjeta (1,9) la manzana ocupa el 90% de ese
	-- alto: 152 px sobre un viewport de 168. Consecuencias para el layout:
	--   · el ALTO de la tarjeta NO puede bajar sin encoger la manzana: ya va llena.
	--   · el ANCHO sí sobra. La manzana mide 152 px de ancho y el viewport tenía
	--     256, o sea 52 px de aire por lado.
	-- 📐 PANEL MÁS COMPACTO (30 jul 2026): todo el recorte sale de ese aire lateral
	-- y del cromo (cabecera, márgenes, botón), NUNCA de la manzana.
	--     tarjeta  272x210 -&gt; 224x210      (el alto intacto: lo pide la manzana)
	--     panel        900 -&gt; 752 de ancho  ·  cabecera 64 -&gt; 54
	--     rejilla      300 -&gt; 280           ·  botón 280x60 -&gt; 240x54
	local ANCHO = 752
	local VP_Y, VP_H = 4, 168               -- ⚠️ tocar VP_H = cambiar la manzana
	-- ⚪ grosor del filo blanco de la skin de misterio, en proporción al viewport.
	-- 1.10 sobre una manzana de 111 px = un aro de 5,5 px por todos lados. Es el
	-- mismo número que usa el filo negro del botón del HUD, y por el mismo motivo:
	-- el filo se hace con un viewport MÁS GRANDE detrás, no escalando el mesh.
	local FILO_MIST = 1.10
	local CARD_W, CARD_H = 224, 210
	-- radio de las esquinas de la tarjeta. Estaba en 16, que sobre 272x210 casi
	-- no se notaba; 26 ya se lee como tarjeta redondeada de verdad.
	local CARD_R = 26
	local HD_H = 54                         -- cabecera
	local HD_SEP = 12                       -- separación cabecera ↔ primera fila
	local TXT_W = 430                       -- columna de texto de la ficha
	local REJ_VIS = 280    -- banda VISIBLE de la rejilla: una fila entera (210+16)
	                       -- y un asomo de la siguiente, para que se vea que hay más
	-- 🔴 QUE CORTE EL ROJO, NO UNA LÍNEA INVISIBLE. Un ScrollingFrame recorta
	-- SIEMPRE a su propio borde, y ese borde caía 12 px por debajo de la cabecera:
	-- al bajar, las tarjetas se partían en el aire y quedaba una franja translúcida
	-- entre el rojo y el corte. Ahora la rejilla se mete 10 px POR DETRÁS de la
	-- cabecera (y otros 10 por detrás de la ficha de abajo), así que el corte queda
	-- dentro de una zona opaca y lo que parte las tarjetas es el propio recuadro.
	-- ⚠️ Esto solo funciona porque gui.ZIndexBehavior es Sibling: la cabecera
	-- (ZIndex 22) y la ficha (21, creada DESPUÉS) son HERMANAS de la rejilla (21), y
	-- en ese modo el subárbol ENTERO de la hermana de encima tapa el subárbol ENTERO
	-- de la de abajo — da igual que las tarjetas lleven ZIndex 27 por dentro. Con
	-- ZIndexBehavior.Global el anillo y el nombre asomarían sobre el rojo.
	local SOLAPE = 10
	local REJ_Y = HD_H - SOLAPE                    -- 44: el recorte ya empieza bajo el rojo
	local INFO_Y = HD_H + HD_SEP + REJ_VIS + 12    -- 358: la ficha no se mueve
	local REJ_H = INFO_Y + SOLAPE - REJ_Y          -- 324: acaba por detrás de la ficha
	-- ⚠️ ALTURA DE REFERENCIA, NO la real. La ficha de abajo mide lo que necesita
	-- (de 84 a ~215 según la descripción y si hay barra), así que el panel cambia
	-- de alto al elegir una skin u otra. Esta constante es la del caso MÁS ALTO y
	-- sirve para dos cosas: centrar el panel siempre en el mismo sitio (centrarlo
	-- por el alto REAL haría bailar la ventana entera al cambiar de tarjeta) y
	-- calcular el encaje en pantallas cortas.
	local INFO_REF = 215
	local ALTO_REF = INFO_Y + INFO_REF + 14
	local VERDE = Color3.fromRGB(56, 190, 120)
	local LIMA = Color3.fromRGB(146, 255, 62)   -- marco de "puesta": bien vivo
	local ROJO = Color3.fromRGB(226, 70, 78)
	local GRIS = Color3.fromRGB(92, 92, 112)

	-- solo las visibles (la morada está marcada oculta: se sigue consiguiendo
	-- pisando el pad de su maniquí, pero no es parte del catálogo)
	local lista = {}
	for _, s in ipairs(Config.SKINS) do
		if not s.oculta then lista[#lista + 1] = s end
	end
	table.sort(lista, function(a, b) return (a.orden or 99) &lt; (b.orden or 99) end)
	if #lista == 0 then return end

	local puesta = S and S.skin or nil
	local sel = (puesta and Config.SKIN_POR_ID[puesta]
		and not Config.SKIN_POR_ID[puesta].oculta) and puesta or lista[1].id

	-- ⚠️ ANCLADO POR ARRIBA (0.5, 0) y no por el centro. La ficha de abajo cambia
	-- de alto según lo que tenga que enseñar (con barra de progreso o sin ella),
	-- así que el panel cambia de alto con ella. Centrado, cada cambio movería
	-- también la cabecera y la rejilla; anclado arriba solo se mueve el borde
	-- inferior y todo lo demás se queda quieto.
	local p = nuevo("Frame", {
		Size = UDim2.new(0, ANCHO, 0, ALTO_REF),
		Position = UDim2.new(0.5, 0, 0.5, -ALTO_REF / 2), AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(28, 27, 50), BorderSizePixel = 0, ZIndex = 20,
	}, gui)
	-- 📱 ENCAJE EN PANTALLAS CORTAS. El panel NO ha crecido, pero desde que la
	-- ficha de abajo mide lo que necesita puede llegar a 598 px (skin bloqueada:
	-- descripción de 4 líneas + barra), y el lienzo virtual no siempre da para
	-- tanto: en Xbox son 609 y en un teléfono chico 582. Sin esto la cabecera —y
	-- con ella la X de cerrar— se saldría por arriba en esos dos casos.
	-- Nunca AGRANDA: la escala está topada en 1, así que en PC no hace nada.
	-- El UIScale de la raíz adapta TODA la interfaz al viewport, así que aquí solo
	-- hay que medir el lienzo que ESE deja y encoger el panel lo justo si no cabe.
	-- Devuelve la escala para que la entrada con rebote termine en ella y no en 1.
	local escPanel = 1
	local function encajar()
		local cam = workspace.CurrentCamera
		local raiz = gui:FindFirstChildOfClass("UIScale")
		local lienzo = (cam and cam.ViewportSize.Y or 700)
			/ ((raiz and raiz.Scale) or 1)
		escPanel = math.clamp((lienzo - 16) / ALTO_REF, 0.5, 1)
		return escPanel
	end
	-- ⚠️ SE CENTRA POR EL ALTO REAL, NO POR ALTO_REF (corregido 30 jul 2026).
	-- El panel se ancla por ARRIBA, así que la posición tiene que subir la mitad
	-- del alto YA ESCALADO. Antes esa mitad se sacaba de ALTO_REF (587), que es el
	-- caso MÁS ALTO: con una skin de descripción corta la ventana mide 456 y
	-- quedaba (587-456)/2 = 65 px demasiado arriba, que es justo lo que se veía.
	-- `suave` = animar el recolocado. Al abrir se coloca en seco (no habría nada
	-- que animar); al cambiar de skin sí se anima, porque si no la ventana pegaría
	-- un salto seco de hasta 49 px cada vez que se pulsa otra tarjeta.
	local function centrar(alto, suave)
		local destino = UDim2.new(0.5, 0, 0.5, -math.round(alto * escPanel / 2))
		if suave then
			TweenService:Create(p, TweenInfo.new(0.18, Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out), {Position = destino}):Play()
		else
			p.Position = destino
		end
	end
	esquinas(p, 16)
	borde(p, 4)
	-- 🪟 FONDO TRANSLÚCIDO, igual que el calendario y la tienda de la ruleta:
	-- blanco casi puro al 55% de transparencia (se ve el juego detrás) con un
	-- relieve MUY tenue de studs encima. Es exactamente lo que hacen panelTienda
	-- y abrirCalendario, copiado a propósito para que las tres ventanas se sientan
	-- de la misma familia.
	p.BackgroundColor3 = Color3.fromRGB(250, 251, 255)
	p.BackgroundTransparency = 0.55
	local pimg = nuevo("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Image = Config.IMG_STUDS, ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.new(0, 210, 0, 210),
		ImageColor3 = Color3.new(1, 1, 1), ImageTransparency = 0.88,
		ZIndex = p.ZIndex,
	}, p)
	nuevo("UICorner", {CornerRadius = UDim.new(0, 16)}, pimg)

	-- ── cabecera ──
	-- misma banda de color con studs brillantes que usan las otras ventanas
	local COL_HD = Color3.fromRGB(214, 72, 104)
	local hd = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, HD_H), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 22,
	}, p)
	esquinas(hd, 16)
	borde(hd, 3)
	studsVivo(hd, vivo(COL_HD, 1.2, 1.0), COL_HD, 190, 0)
	local tl = nuevo("TextLabel", {
		Size = UDim2.new(1, -120, 0, 30), Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne, Text = esES and "Skins de manzana" or "Apple skins",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, hd)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tl)
	local cerrar = nuevo("TextButton", {
		Size = UDim2.new(0, 40, 0, 40), Position = UDim2.new(1, -50, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.fromRGB(232, 52, 68),
		Font = Enum.Font.FredokaOne, Text = "X", TextColor3 = Color3.new(1, 1, 1),
		TextSize = 26, BorderSizePixel = 0, ZIndex = 24,
	}, hd)
	esquinas(cerrar, 10)
	borde(cerrar, 3)
	-- ⚠️ EL CLICK ESTÁNDAR DEL JUEGO, no uno propio. nuevo() le pone animarBoton
	-- a todo botón, y animarBoton marca Mute=true cuando sonidoHUD ya es false
	-- (o sea en todo lo que nazca dentro de un panel). Quitando el Mute suena
	-- sndClick, exactamente el mismo que los botones del HUD.
	cerrar:SetAttribute("Mute", false)
	cerrar.MouseButton1Click:Connect(cerrarPanel)

	-- ── rejilla de tarjetas, con scroll vertical ──
	-- ⚠️ ANCHO -12, no -28. Un ScrollingFrame SIEMPRE recorta a sus bordes, así que
	-- el margen que le sobre a la rejilla es el sitio que tiene la tarjeta para
	-- crecer con el zoom del cursor. Con -12 el interior es 733 (740 menos los 7 de
	-- la barra), las 3 tarjetas ocupan 704 y quedan 14,5 px por lado: más que los
	-- 9 que necesita el zoom.
	local rejilla = nuevo("ScrollingFrame", {
		Size = UDim2.new(1, -12, 0, REJ_H), Position = UDim2.new(0.5, 0, 0, REJ_Y),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 21,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		-- el lienzo lo calcula Roblox a partir del UIGridLayout: así no hay que
		-- recalcular nada al añadir skins nuevas cuando lleguen los mundos
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarThickness = 7,
		ScrollBarImageColor3 = COL_HD,
		ScrollBarImageTransparency = 0.25,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
	}, p)
	nuevo("UIGridLayout", {
		CellSize = UDim2.new(0, CARD_W, 0, CARD_H),
		CellPadding = UDim2.new(0, 16, 0, 16),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, rejilla)
	-- El padding de arriba compensa lo que la cabecera tapa (SOLAPE) más la
	-- separación de siempre (HD_SEP) más 12 de aire para el zoom, de modo que la
	-- primera fila sigue descansando EXACTAMENTE donde estaba (y = 78).
	-- El de abajo (24) es lo que hace falta para que, con la rejilla bajada del
	-- todo, la última fila quede 14 px por encima de la ficha y el zoom le quepa.
	nuevo("UIPadding", {
		PaddingTop = UDim.new(0, SOLAPE + HD_SEP + 12),
		PaddingBottom = UDim.new(0, 24),
	}, rejilla)

	-- ── zona de abajo: nombre, descripción y botón ──
	local info = nuevo("Frame", {
		Size = UDim2.new(1, -28, 0, 150), Position = UDim2.new(0.5, 0, 0, INFO_Y),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 38),
		BorderSizePixel = 0, ZIndex = 21,
	}, p)
	esquinas(info, 12)
	borde(info, 3)
	-- El texto va a la IZQUIERDA y el botón a la DERECHA, en vez del botón
	-- cruzando toda la ventana de lado a lado.
	-- Cuentas del ancho: 14 + TXT_W(430) + 240 del botón + 14 = 698 sobre los
	-- 724 de interior (752-28), o sea 26 px de aire entre el texto y el botón.
	local lblNom = nuevo("TextLabel", {
		Size = UDim2.new(0, TXT_W, 0, 30), Position = UDim2.new(0, 14, 0, 12),
		BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = "",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 23,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, info)
	nuevo("UIStroke", {Thickness = 2.6, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, lblNom)
	local lblDesc = nuevo("TextLabel", {
		Size = UDim2.new(0, TXT_W, 0, 62), Position = UDim2.new(0, 14, 0, 48),
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = "",
		TextColor3 = Color3.fromRGB(206, 206, 226), TextSize = 18, ZIndex = 23,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	}, info)
	-- ── BARRA DE PROGRESO (solo para las skins que piden completar la torre) ──
	-- Sustituye al texto "Llevas 3 de 10": se ve de un vistazo cuánto falta, que
	-- es justo lo que hace que la meta enganche. Vale para la AZUL (1 vuelta) y
	-- para la DORADA (10); sale de Config.veces, no de números escritos aquí.
	local barMarco = nuevo("Frame", {
		Size = UDim2.new(0, TXT_W, 0, 26), Position = UDim2.new(0, 14, 0, 116),
		BackgroundColor3 = Color3.fromRGB(14, 14, 26), BorderSizePixel = 0,
		ZIndex = 23, Visible = false,
	}, info)
	esquinas(barMarco, 14)
	borde(barMarco, 2)
	barMarco.ClipsDescendants = true   -- que el relleno no se salga por las esquinas
	local barRell = nuevo("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = VERDE,
		BorderSizePixel = 0, ZIndex = 24,
	}, barMarco)
	local barTxt = nuevo("TextLabel", {
		Size = UDim2.new(1, -16, 1, -6), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne, Text = "", TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true, ZIndex = 25,
	}, barMarco)
	nuevo("UIStroke", {Thickness = 2.6, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, barTxt)
	local barUlt = -1   -- última fracción pintada: sin esto se lanzaría un tween
	                    -- nuevo en cada Sync (cada 0,4 s) aunque no cambiara nada
	local altoUlt = -1  -- mismo motivo para el alto del panel: refrescarSkins corre
	                    -- en cada Sync y solo hay que recolocar cuando CAMBIA
	local btn = nuevo("TextButton", {
		Size = UDim2.new(0, 240, 0, 54), Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = VERDE, Text = "",
		BorderSizePixel = 0, AutoButtonColor = true, ZIndex = 23,
	}, info)
	esquinas(btn, 10)
	borde(btn, 3)
	btn:SetAttribute("Mute", false)
	local lblBtn = nuevo("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.LuckiestGuy, Text = "", TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true, ZIndex = 24,
	}, btn)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, lblBtn)

	-- ── una tarjeta por skin ──
	local tarjetas = {}
	for i, s in ipairs(lista) do
		-- 🎨 cada tarjeta toma el COLOR DE SU PROPIA SKIN, vivo y con el mismo
		-- relieve de studs que la cabecera. Antes eran todas del mismo gris azulado
		-- (44,43,74) y la rejilla quedaba apagada.
		local colCard = vivo(Color3.fromRGB(s.color[1], s.color[2], s.color[3]),
			0.72, 1.25)
		-- 🔍 CELDA + TARJETA, y no la tarjeta suelta en la rejilla.
		-- Parece redundante pero arregla el recorte del zoom: animarBoton agranda un
		-- 8% al pasar el cursor con un UIScale, y un UIScale crece DESDE EL
		-- AnchorPoint. Colgando la tarjeta directamente de la rejilla su AnchorPoint
		-- es (0,0), así que los 18 px de más se iban ENTEROS hacia la derecha y los
		-- 17 ENTEROS hacia abajo: la columna de la derecha chocaba con el borde del
		-- ScrollingFrame —que sí recorta— y la fila de abajo con el final de la
		-- rejilla. De ahí el "se corta por algo invisible".
		-- La celda ocupa el hueco de la rejilla y la tarjeta va dentro CENTRADA:
		-- ahora los 18 px se reparten, 9 por lado, y caben en los márgenes.
		local celda = nuevo("Frame", {
			LayoutOrder = i, BackgroundTransparency = 1, ZIndex = 21,
		}, rejilla)
		local c = nuevo("TextButton", {
			Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Text = "", BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 21,
		}, celda)
		-- ⚠️ UICorner DIRECTO, no esquinas(). El helper esquinas() del juego IGNORA
		-- el radio que se le pasa y pone siempre 0: toda la interfaz es cuadrada a
		-- propósito. Por eso la tarjeta salía con esquinas rectas mientras el
		-- anillo sí era redondo, y el fondo asomaba por las puntas.
		-- Se pone antes de studsVivo porque este lee el UICorner de la tarjeta
		-- para redondear los cuadritos con el mismo radio.
		nuevo("UICorner", {CornerRadius = UDim.new(0, CARD_R)}, c)
		-- ⚠️ sinBrillo=true Y ClipsDescendants=false. studsVivo activa el recorte
		-- para redondear su franja de brillo, y ese recorte se comía el UIStroke
		-- del borde: por eso el marco verde de "puesta" no se veía (30 jul 2026).
		-- Los cuadritos ya llevan su propio UICorner, así que no necesitan el
		-- recorte; lo único que lo pedía era la franja de brillo, y esa se
		-- sustituye por un degradado sobre la propia tarjeta, que no se recorta.
		studsVivo(c, vivo(colCard, 1.18, 1.0), colCard, 150, 0, true)
		c.ClipsDescendants = false
		nuevo("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(196, 196, 210)),
		}, c)
		c:SetAttribute("Mute", false)          -- click normal del juego
		c:SetAttribute("NoHoverSound", true)   -- ...pero sin el de pasar por encima:
		                                       -- son 5 tarjetas juntas y el ratón las
		                                       -- barre de una pasada
		-- 🟩 MARCO INTERNO, no un contorno de la tarjeta.
		-- Un UIStroke sobre la tarjeta se dibuja HACIA FUERA de sus límites, y al
		-- pasar el cursor animarBoton la agranda un 8%: entre las dos cosas el
		-- marco invadía las tarjetas vecinas. Aquí el contorno va sobre un Frame
		-- metido hacia dentro justo su propio grosor, así que el anillo queda
		-- SIEMPRE dentro de la tarjeta y el zoom no lo saca.
		-- ⚠️ ApplyStrokeMode.Border sigue siendo obligatorio: por defecto es
		-- Contextual, que en un TextButton contornea el TEXTO (vacío) y no el
		-- borde — ese era el motivo de que no se viera nada.
		local anillo = nuevo("Frame", {
			BackgroundTransparency = 1, ZIndex = 27,
		}, c)
		local bordeC = nuevo("UIStroke", {
			Thickness = 3, Color = Color3.fromRGB(96, 96, 126),
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			LineJoinMode = Enum.LineJoinMode.Round,
		}, anillo)
		local anilloEsq = nuevo("UICorner", {CornerRadius = UDim.new(0, CARD_R - 3)}, anillo)
		-- coloca el anillo metido hacia dentro `t` píxeles: su contorno crece esos
		-- mismos `t` hacia fuera y acaba justo en el borde de la tarjeta
		local function pintarAnillo(t, col)
			anillo.Size = UDim2.new(1, -2 * t, 1, -2 * t)
			anillo.Position = UDim2.new(0, t, 0, t)
			-- el anillo va metido `t` px, así que su radio es el de la tarjeta
			-- MENOS `t`: así las dos curvas quedan concéntricas y no asoma
			-- el fondo por las esquinas
			anilloEsq.CornerRadius = UDim.new(0, math.max(0, CARD_R - t))
			bordeC.Thickness = t
			bordeC.Color = col
		end
		pintarAnillo(3, Color3.fromRGB(96, 96, 126))
		local vp = SkinsUI.vista(c, s, 22, false, SkinsUI.DIST_CARTA)
		vp.Size = UDim2.new(1, -16, 0, VP_H)
		vp.Position = UDim2.new(0.5, 0, 0, VP_Y)
		vp.AnchorPoint = Vector2.new(0.5, 0)
		-- 🖤 SKIN DE MISTERIO: se construyen las DOS vistas (la real y la silueta)
		-- y refrescarSkins enseña una u otra. Construir solo la que toca sería más
		-- barato, pero entonces desbloquearla con el menú abierto no revelaría nada
		-- hasta cerrarlo y volver a abrirlo.
		local vpFilo, vpMist, interro
		if s.misterio then
			-- ⚪ FILO BLANCO: la MISMA silueta, en un viewport un 10% MÁS ALTO y
			-- concéntrico. Lo que asoma por fuera de la negra es el contorno.
			-- ⚠️ SOLO SE TOCA EL ALTO, no el ancho. En un ViewportFrame el FOV es
			-- VERTICAL, así que el tamaño en píxeles de la manzana sale solo del
			-- alto del marco (288/dist sobre 168) y el ancho únicamente decide
			-- cuánto aire sobra a los lados. Dejando el ancho igual la manzana
			-- crece el 10% en las dos direcciones —el filo queda uniforme— y de
			-- paso el marco no se sale de la tarjeta (229 px no caben en 224).
			-- Centrado por el CENTRO, no por arriba: así el filo es igual de
			-- grueso arriba que abajo sin depender del redondeo del alto.
			vpFilo = SkinsUI.vista(c, s, 23, "filo", SkinsUI.DIST_CARTA)
			vpFilo.Size = UDim2.new(1, -16, 0, math.round(VP_H * FILO_MIST))
			vpFilo.Position = UDim2.new(0.5, 0, 0, VP_Y + VP_H / 2)
			vpFilo.AnchorPoint = Vector2.new(0.5, 0.5)
			vpMist = SkinsUI.vista(c, s, 24, "silueta", SkinsUI.DIST_CARTA)
			vpMist.Size, vpMist.Position = vp.Size, vp.Position
			vpMist.AnchorPoint = vp.AnchorPoint
			-- 69% del alto de la silueta, que ahora son 145 px reales -&gt; 100.
			-- (Estuvo en 104 calculado sobre los 152 px que yo creía que medía la
			-- manzana cuando en realidad medía 75: sobre la silueta de verdad se
			-- veía enorme. Ahora coincide por otro camino, con la manzana de verdad.)
			interro = nuevo("TextLabel", {
				Size = UDim2.new(0, 76, 0, 76),
				Position = UDim2.new(0.5, 0, 0, VP_Y + VP_H / 2 - 38),
				AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
				Font = Enum.Font.FredokaOne, Text = "?", TextScaled = true,
				-- ZIndex 26: por encima de la silueta, que al meter el viewport del
				-- filo pasó de 23 a 24 — con el 24 de antes quedaban empatados y el
				-- "?" se podía perder por detrás.
				TextColor3 = Color3.new(1, 1, 1), TextTransparency = 0.15, ZIndex = 26,
			}, c)
			nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
				LineJoinMode = Enum.LineJoinMode.Round}, interro)
			-- latido lento: un tween en bucle, NO un RenderStepped por tarjeta
			local isc = nuevo("UIScale", {Scale = 1}, interro)
			TweenService:Create(isc, TweenInfo.new(1.1, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1, true), {Scale = 1.18}):Play()
		end
		-- pegado al borde de abajo (-4 en vez de -10) y 32 de alto en vez de 34: son
		-- 8 px que se le regalan al viewport sin que el nombre pierda legibilidad
		local nom = nuevo("TextLabel", {
			Size = UDim2.new(1, -16, 0, 32), Position = UDim2.new(0.5, 0, 1, -4),
			AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1,
			Font = Enum.Font.LuckiestGuy, Text = s.nombre,
			TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 25,
		}, c)
		nuevo("UIStroke", {Thickness = 2.6, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, nom)
		-- 🔒 BLOQUEADA: chapita en la esquina, NADA de tapar la manzana.
		-- Antes era un velo oscuro sobre toda la tarjeta con un candado grande en
		-- medio, que escondía justo lo que tiene que dar ganas de conseguirla.
		-- Ahora la manzana se ve entera y lo único que dice "aún no es tuya" es
		-- esta chapita y el borde, más apagado.
		-- ⚠️ Va anclada al pie del VIEWPORT, no al de la tarjeta: abajo del todo
		-- está el nombre, y "Arcoíris" a 24 px mide ~90 px, así que en la esquina
		-- de la tarjeta la chapita se le montaría encima.
		local candado = nuevo("Frame", {
			Size = UDim2.new(0, 42, 0, 42),
			Position = UDim2.new(1, -14, 0, VP_Y + VP_H - 2),
			AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = Color3.fromRGB(16, 16, 28),
			BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 26,
			Visible = false,
		}, c)
		esquinas(candado, 9)
		nuevo("UIStroke", {Thickness = 2.4, Color = Color3.fromRGB(255, 206, 84)}, candado)
		nuevo("TextLabel", {
			Size = UDim2.new(1, -8, 1, -8), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne, Text = "🔒", TextScaled = true, ZIndex = 27,
		}, candado)
		c.MouseButton1Click:Connect(function()
			sel = s.id
			refrescarSkins()
		end)
		tarjetas[s.id] = {marco = c, borde = bordeC, pintarAnillo = pintarAnillo,
			candado = candado, nom = nom, vp = vp, vpMist = vpMist,
			vpFilo = vpFilo, interro = interro}
	end

	-- ── repintado completo: se llama al abrir, al elegir tarjeta y en cada Sync ──
	function refrescarSkins()
		if not p.Parent then return end
		local ahora = S and S.skin or nil
		for _, s in ipairs(lista) do
			local t = tarjetas[s.id]
			local libre = skinLibre(s)
			t.candado.Visible = not libre
			-- 🖤 el misterio SOLO dura mientras esté bloqueada: al conseguirla se
			-- revela la manzana de verdad y su nombre. Ese es el premio.
			if t.vpMist then
				local tapada = not libre
				t.vpMist.Visible = tapada
				t.vpFilo.Visible = tapada     -- el filo se enciende y se apaga CON la silueta
				t.vp.Visible = not tapada
				t.interro.Visible = tapada
				t.nom.Text = tapada and "???" or s.nombre
			end
			-- 🟢 LA QUE LLEVAS PUESTA se marca con un BORDE VERDE GRUESO, no con
			-- una etiqueta. El contorno sigue el redondeo de la tarjeta (16 px),
			-- así que queda un marco verde redondeado alrededor de la manzana.
			-- Antes había además un cartelito "PUESTA"/"WEARING" arriba; sobraba.
			if ahora == s.id then
				t.pintarAnillo(6, LIMA)
			elseif sel == s.id then
				t.pintarAnillo(4, Color3.fromRGB(255, 214, 90))   -- la que miras
			else
				t.pintarAnillo(3, libre and Color3.fromRGB(96, 96, 126) or GRIS)
			end
		end
		local s = Config.SKIN_POR_ID[sel]
		if not s then return end
		local libre = skinLibre(s)
		-- barra de victorias: solo tiene sentido en los requisitos de tipo "torre"
		if s.req == "torre" then
			local meta = s.veces or 1
			-- MISMO recuento que skinLibre y que vecesCompletadas del server: si la
			-- barra usara otro número podría salir llena con la skin aún bloqueada
			local n = math.max(S.trofeos or 0,
				((S.pisoMax or 0) &gt; Config.N_PISOS) and 1 or 0)
			local frac = math.clamp(n / meta, 0, 1)
			barMarco.Visible = true
			barTxt.Text = math.min(n, meta) .. " / " .. meta
			barRell.BackgroundColor3 = libre and VERDE or Color3.fromRGB(255, 196, 64)
			if frac ~= barUlt then
				barUlt = frac
				TweenService:Create(barRell, TweenInfo.new(0.4, Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out), {Size = UDim2.new(frac, 0, 1, 0)}):Play()
			end
		else
			barMarco.Visible = false
			barUlt = -1
		end
		-- 📏 LA FICHA MIDE LO QUE HAGA FALTA Y NADA MÁS. Antes eran 168 px fijos,
		-- que con una skin sin barra y una descripción de una línea dejaba media
		-- caja vacía. Se mide el texto de verdad con TextService y se suma solo lo
		-- que se enseña; el panel se encoge con ella.
		local oculta = s.misterio and not libre
		lblNom.Text = oculta and "???" or s.nombre
		lblDesc.Text = esES and (s.desc or "")
			or (Config.SKIN_DESC_EN[s.id] or s.desc or "")
		if not libre then
			lblNom.TextColor3 = Color3.fromRGB(210, 210, 225)
			btn.BackgroundColor3 = GRIS
			-- ⚠️ El REQUISITO va en la descripción, no en el botón. Antes el botón
			-- lo llevaba dentro ("🔒 Completa la torre 10 veces") y con el botón
			-- ahora estrecho (280 px en vez de cruzar la ventana entera) el
			-- TextScaled lo habría encogido hasta no leerse.
			lblBtn.Text = esES and "🔒 BLOQUEADA" or "🔒 LOCKED"
			lblDesc.Text = lblDesc.Text .. "\n\n🔒 " .. Config.skinRequisito(s, esES)
		elseif ahora == sel then
			lblNom.TextColor3 = Color3.new(1, 1, 1)
			btn.BackgroundColor3 = ROJO
			lblBtn.Text = esES and "QUITAR" or "UNEQUIP"
		else
			lblNom.TextColor3 = Color3.new(1, 1, 1)
			btn.BackgroundColor3 = VERDE
			lblBtn.Text = esES and "EQUIPAR" or "EQUIP"
		end
		-- alto real del texto de la descripción con el ancho que tiene (TXT_W)
		local okT, med = pcall(function()
			return game:GetService("TextService"):GetTextSize(
				lblDesc.Text, lblDesc.TextSize, lblDesc.Font,
				Vector2.new(lblDesc.AbsoluteSize.X &gt; 0 and lblDesc.AbsoluteSize.X or TXT_W,
					math.huge))
		end)
		local altoDesc = (okT and med) and math.ceil(med.Y) or 62
		lblDesc.Size = UDim2.new(0, TXT_W, 0, altoDesc)
		local y = 12 + 30 + 6 + altoDesc          -- borde + nombre + hueco + desc
		if barMarco.Visible then
			barMarco.Position = UDim2.new(0, 14, 0, y + 6)
			y = y + 6 + 26
		end
		-- el botón mide 54 y va centrado: la ficha nunca puede ser más baja
		local altoInfo = math.max(y + 14, 54 + 26)
		info.Size = UDim2.new(1, -28, 0, altoInfo)
		local altoPanel = INFO_Y + altoInfo + 14
		if altoPanel ~= altoUlt then
			p.Size = UDim2.new(0, ANCHO, 0, altoPanel)
			centrar(altoPanel, altoUlt &gt;= 0)   -- en seco la primera vez, animado después
			altoUlt = altoPanel
		end
	end

	btn.MouseButton1Click:Connect(function()
		local s = Config.SKIN_POR_ID[sel]
		if not s or not skinLibre(s) then
			sonar("rbxassetid://128187340772806", 0.6)   -- bloqueada: sonido de error
			return
		end
		-- se manda nil para quitársela; el server confirma por Sync y el
		-- repintado real ocurre cuando llega, no aquí, para que la interfaz
		-- nunca enseñe algo que el server no haya aceptado
		RE.Skin:FireServer((S and S.skin == sel) and nil or sel)
		-- sin sonido propio al equipar: el server contesta con el FX "morphOn",
		-- que es el sonido de ponerse una manzana que ya existía en el juego
	end)

	-- misma entrada con rebote (y mismo sonido) que las demás ventanas, solo que
	-- el rebote termina en la escala de ENCAJE en vez de en 1.
	local escFin = encajar()
	popIn(p)
	if escFin &lt; 1 then
		local escP = p:FindFirstChildOfClass("UIScale")   -- el que acaba de crear popIn
		if escP then
			-- lanzar un tween nuevo sobre la MISMA propiedad cancela el de popIn,
			-- así que no hay dos peleándose por la escala
			escP.Scale = 0.35 * escFin
			TweenService:Create(escP, TweenInfo.new(0.34, Enum.EasingStyle.Back,
				Enum.EasingDirection.Out), {Scale = escFin}):Play()
		end
	end
	panelAbierto = p
	refrescarSkins()
end

end   -- fin del do...end del menu de skins
-- ═══ ADMIN PANEL ═══════════════════════════════════════════
local function abrirAdmin()
	cerrarPanel()
	local ANCHO, ALTO = 580, 600
	local AZUL = Color3.fromRGB(74, 124, 236)
	local VERDE = Color3.fromRGB(56, 190, 120)
	local LIMA = Color3.fromRGB(146, 255, 62)   -- marco de "puesta": bien vivo
	local NARANJA = Color3.fromRGB(236, 162, 44)
	local MORADO = Color3.fromRGB(150, 92, 240)
	local ROJO = Color3.fromRGB(226, 70, 78)
	-- overlay de BLOQUES: studs blancos MUY transparentes con tile chico (muchas
	-- filas) =&gt; textura pareja SIN banda. Copia el radio de esquina del objeto.
	local function bloques(o, tile, transp, col)
		o.ClipsDescendants = true
		local uc = o:FindFirstChildOfClass("UICorner")
		local img = nuevo("ImageLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Image = Config.IMG_STUDS, ScaleType = Enum.ScaleType.Tile,
			TileSize = UDim2.new(0, tile, 0, tile),
			ImageColor3 = col or Color3.new(1, 1, 1), ImageTransparency = transp,
			ZIndex = o.ZIndex,
		}, o)
		nuevo("UICorner", {CornerRadius = uc and uc.CornerRadius or UDim.new(0, 0)}, img)
		return img
	end
	-- ═══ PANEL con textura de bloques ═══
	-- ⚠️ ANCLADO POR ARRIBA (0.5, 0) y no por el centro. La ficha de abajo cambia
	-- de alto según lo que tenga que enseñar (con barra de progreso o sin ella),
	-- así que el panel cambia de alto con ella. Centrado, cada cambio movería
	-- también la cabecera y la rejilla; anclado arriba solo se mueve el borde
	-- inferior y todo lo demás se queda quieto.
	local p = nuevo("Frame", {
		Size = UDim2.new(0, ANCHO, 0, ALTO),
		Position = UDim2.new(0.5, 0, 0.5, -ALTO / 2), AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(28, 27, 50), BorderSizePixel = 0, ZIndex = 20,
	}, gui)
	esquinas(p, 16)
	borde(p, 4)
	bloques(p, 300, 0.85, Color3.fromRGB(150, 158, 225))
	-- ═══ HEADER ═══
	local hd = nuevo("Frame", {
		Size = UDim2.new(1, 0, 0, 66), BackgroundColor3 = AZUL,
		BorderSizePixel = 0, ZIndex = 22,
	}, p)
	esquinas(hd, 16)
	borde(hd, 3)
	bloques(hd, 180, 0.82)
	local tl = nuevo("TextLabel", {
		Size = UDim2.new(1, -150, 0, 38), Position = UDim2.new(0, 20, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne, Text = "Admin — Testing",
		TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, hd)
	nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, tl)
	local cerrar = nuevo("TextButton", {
		Size = UDim2.new(0, 48, 0, 48), Position = UDim2.new(1, -58, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.fromRGB(232, 52, 68),
		Font = Enum.Font.FredokaOne, Text = "X", TextColor3 = Color3.new(1, 1, 1),
		TextSize = 28, BorderSizePixel = 0, ZIndex = 25,
	}, hd)
	esquinas(cerrar, 8)
	borde(cerrar, 3)
	cerrar:SetAttribute("Mute", true)
	cerrar.MouseButton1Click:Connect(cerrarPanel)
	-- ═══ CUERPO con SCROLL (barrita) ═══
	local scroll = nuevo("ScrollingFrame", {
		Size = UDim2.new(1, -16, 1, -78), Position = UDim2.new(0, 8, 0, 72),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 22,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Color3.fromRGB(120, 135, 235),
		ScrollBarImageTransparency = 0.1,
	}, p)
	nuevo("UIListLayout", {Padding = UDim.new(0, 14),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder}, scroll)
	nuevo("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 8)}, scroll)
	local orden = 0
	local function seccion(titulo, colAcc, altoCont)
		orden = orden + 1
		local card = nuevo("Frame", {
			Size = UDim2.new(1, -6, 0, 46 + altoCont + 12),
			BackgroundColor3 = Color3.fromRGB(40, 39, 68), BorderSizePixel = 0,
			LayoutOrder = orden, ZIndex = 23,
		}, scroll)
		esquinas(card, 12)
		borde(card, 3)
		bloques(card, 220, 0.9, Color3.fromRGB(150, 158, 225))
		local tb = nuevo("Frame", {
			Size = UDim2.new(1, -14, 0, 36), Position = UDim2.new(0, 7, 0, 7),
			BackgroundColor3 = colAcc, BorderSizePixel = 0, ZIndex = 24,
		}, card)
		esquinas(tb, 8)
		borde(tb, 2)
		bloques(tb, 160, 0.85)
		local tlbl = nuevo("TextLabel", {
			Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 14, 0, 0),
			BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, Text = titulo,
			TextColor3 = Color3.new(1, 1, 1), TextSize = 21, ZIndex = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, tb)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tlbl)
		local cont = nuevo("Frame", {
			Size = UDim2.new(1, -16, 0, altoCont), Position = UDim2.new(0, 8, 0, 46),
			BackgroundTransparency = 1, ZIndex = 24,
		}, card)
		return cont
	end
	local function botonAdmin(padre, texto, col)
		local b = nuevo("TextButton", {
			BackgroundColor3 = col, Text = "", BorderSizePixel = 0, ZIndex = 24,
		}, padre)
		esquinas(b, 8)
		borde(b, 2)
		bloques(b, 132, 0.8)
		local lbl = nuevo("TextLabel", {
			Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne, Text = texto, TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true, ZIndex = 26,
		}, b)
		nuevo("UITextSizeConstraint", {MaxTextSize = 20}, lbl)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, lbl)
		return b
	end
	-- ── Teleport ──
	local cols = 6
	local nb = Config.N_PISOS + 2
	local filas = math.ceil(nb / cols)
	local celda = 42
	local altoTP = filas * celda + (filas - 1) * 6
	local contTP = seccion("Teleport", AZUL, altoTP)
	nuevo("UIGridLayout", {
		CellSize = UDim2.new(1 / cols, -6, 0, celda),
		CellPadding = UDim2.new(0, 6, 0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder}, contTP)
	for f = 0, Config.N_PISOS + 1 do
		local esCima = f &gt; Config.N_PISOS
		local nombre = f == 0 and "Lobby" or (esCima and "" or "P" .. f)
		local col = (f == 0 and VERDE) or (esCima and ROJO) or AZUL
		local b = botonAdmin(contTP, nombre, col)
		if esCima then
			-- último piso (azotea): la IMAGEN del cofre en vez de emoji
			nuevo("ImageLabel", {
				Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(0.5, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
				Image = Config.IMG_COFRE, ScaleType = Enum.ScaleType.Fit,
				ZIndex = 26,
			}, b)
		end
		b.LayoutOrder = f
		b.MouseButton1Click:Connect(function() RE.Admin:FireServer("tp", f) end)
	end
	-- ── Poderes ──
	local defs = {
		{"Fly", "fly", nil, VERDE},
		{"Immune", "inmune", nil, VERDE},
		{"Super Jump", "salto", nil, VERDE},
		{"Speed x1", "vel", 1, NARANJA},
		{"Speed x2", "vel", 2, NARANJA},
		{"Speed x3", "vel", 3, NARANJA},
		{"+$10,000", "cash", nil, AZUL},
		{"+5 Spins", "spins", nil, AZUL},
		{"Kill All", "killall", nil, ROJO},
	}
	local colsP = 3
	local filasP = math.ceil(#defs / colsP)
	local celdaP = 54
	local altoPod = filasP * celdaP + (filasP - 1) * 8
	local contPod = seccion("Testing Powers", MORADO, altoPod)
	nuevo("UIGridLayout", {
		CellSize = UDim2.new(1 / colsP, -8, 0, celdaP),
		CellPadding = UDim2.new(0, 8, 0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder}, contPod)
	for i, d in ipairs(defs) do
		local b = botonAdmin(contPod, d[1], d[4])
		b.LayoutOrder = i
		b.MouseButton1Click:Connect(function() RE.Admin:FireServer(d[2], d[3]) end)
	end
	panelAbierto = p
	popIn(p)
end

