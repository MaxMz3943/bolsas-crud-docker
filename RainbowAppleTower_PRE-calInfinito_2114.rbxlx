-- manotazo, no equiparla: por eso el botón "no hacía nada visible")
accionesPase.giant = function()
	if S.pases.giant or S.slapLeft &gt; 0 then equipToggle("SlapGiant")
	else RE.Prompt:FireServer("pase", "giant") end
end
accionesPase.god = function()
	if S.pases.god then equipToggle("Slap")
	else RE.Prompt:FireServer("pase", "god") end
end

-- teclas 1-9 = equipar/guardar Tool; F = agarrar la manita slap rápido.
-- (el comentario decía "1-4" desde que solo había cuatro slots; hoy son nueve)
-- El GOLPE en sí se hace con CLICK mientras cargas la manita (Tool.Activated).
-- 🎮 CONSOLA (Xbox/PS): el Backpack nativo está desactivado, así que el DPad
-- y el botón Y equipan los slots (el golpe del slap sale con R2 = Activated).
UserInputService.InputBegan:Connect(function(input, procesado)
	if procesado then return end
	if input.KeyCode == Enum.KeyCode.One
		or input.KeyCode == Enum.KeyCode.DPadLeft then
		equipToggle("Flying Carpet")
	elseif input.KeyCode == Enum.KeyCode.Two
		or input.KeyCode == Enum.KeyCode.DPadUp then
		equipToggle("Speed Coil")
	elseif input.KeyCode == Enum.KeyCode.Three
		or input.KeyCode == Enum.KeyCode.DPadRight then
		equipToggle("Gravity Coil")
	elseif input.KeyCode == Enum.KeyCode.Four
		or input.KeyCode == Enum.KeyCode.DPadDown then
		equipToggle("Slap")
	elseif input.KeyCode == Enum.KeyCode.Five
		or input.KeyCode == Enum.KeyCode.ButtonY then
		equipToggle("SlapGiant")
	elseif input.KeyCode == Enum.KeyCode.Six then
		equipToggle("Bat")
	elseif input.KeyCode == Enum.KeyCode.Seven then
		equipToggle("Banana")
	elseif input.KeyCode == Enum.KeyCode.Eight then
		equipToggle("ToyGun")
	elseif input.KeyCode == Enum.KeyCode.Nine then
		-- 🖼 el cuadro del lobby. Va por Config y no con "Cuadro" a pelo porque el
		-- nombre del Tool sale de CUADRO_NOMBRE: si algún día se renombra ahí, la
		-- tecla lo seguiría sin tocar nada.
		equipToggle(Config.CUADRO_NOMBRE or "Cuadro")
	elseif input.KeyCode == Enum.KeyCode.F then equipToggle("Slap")
	end
end)

