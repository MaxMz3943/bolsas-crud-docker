-- ═══ SKINS DE MANZANA: BOTÓN Y VISTA PREVIA ════════════════
-- ⚠️ TODO ESTE BLOQUE VA DENTRO DE UN do...end Y CUELGA DE LA TABLA GLOBAL
-- SkinsUI. No es manía de estilo: el chunk principal de este archivo ya roza el
-- límite de Lua de 200 variables locales simultáneas, y declarar aquí sueltas la
-- vista previa, el marco, el botón y su etiqueta lo reventaba
-- ("too many local variables"). Dentro del do...end esas locales liberan su
-- registro al cerrar el bloque, y lo único que sobrevive es SkinsUI, que es
-- global (igual que refrescarCalendario y compañía).
SkinsUI = {}
do

-- ViewportFrame con el MISMO mesh y la MISMA textura que el juego le suelda a
-- la cabeza. La vista previa ES la skin, no un dibujo aparte que haya que
-- volver a exportar cada vez que se retoca una textura.
-- ⚠️ La carita mira hacia -Z (por eso los maniquíes de la azotea se colocan con
-- mira = (0,0,-1)), así que la cámara va en -Z para verla de frente.
-- Distancia de la cámara a la manzana. MENOS = la manzana se ve MÁS GRANDE,
-- porque el ViewportFrame no cambia de tamaño: se acerca el punto de vista.
-- El encuadre que ve la cámara mide 2·dist·tan(FOV/2) = 1,4·dist studs de alto, y
-- la manzana mide 2,4, así que ocupa 2,4/(1,4·dist) del alto del viewport:
-- En píxeles sale redondo: manzana = 288 / dist, sobre el viewport de 168.
--   3.9  -&gt; 44%  (74 px)   ← lo que salía por el bug de abajo: demasiado chica
--   2.0  -&gt; 86%  (144 px)  ← el que le gustó al dueño; punto de referencia
--   2.25 -&gt; 76%  (128 px)
--   2.6  -&gt; 66%  (111 px)  ← LA TARJETA
--
-- ⚠️⚠️ ESTAS DOS CONSTANTES VAN EN LA TABLA GLOBAL SkinsUI, **NUNCA** COMO
-- LOCALES. Fue un bug real y caro de encontrar (30 jul 2026): SKIN_DIST_CARTA era
-- un `local` de este do...end, y el menú de skins —que está 3.000 líneas más
-- abajo, dentro de OTRO do...end— lo leía como global sin definir, o sea **nil**.
-- Como skinCam hace `d or DIST_BOTON`, las tarjetas se dibujaban a 3,9 en vez de
-- a su propia distancia. Se cambió el número cuatro veces (2.6 → 1.9 → 1.19 →
-- 0.98) y no pasaba absolutamente nada, porque el valor no llegaba nunca.
-- Nada avisa de esto: leer un global inexistente en Lua es legal y da nil, así que
-- ni luac -p ni el juego se quejan. Si algún día hace falta otra constante aquí
-- que se use desde el menú, va en SkinsUI también.
-- 🍎 Historial: 3.9 (51 px, cuando iba dentro del círculo gris) → 2.2 (72 px, al
-- quitar el círculo) → 2.5 (63 px, "un poco más pequeña").
-- Fórmula, con el viewport de 92 del botón:  manzana_px = 221 / dist
SkinsUI.DIST_BOTON = 2.5   -- botón de skins del HUD (su viewport SÍ recorta)
-- Para tocarlo: MENOS = más grande. El tope ya no lo marca la skin de misterio
-- (su filo dejó de ser una copia del mesh y pasó a ser un viewport más alto, ver
-- SkinsUI.vista), así que el límite es simplemente que la manzana no se salga:
-- 288/dist tiene que caber en los 168 px de la tarjeta, o sea dist ≥ 1.72.
SkinsUI.DIST_CARTA = 2.6
local function skinCam(d)
	return CFrame.new(Vector3.new(0, 0.18, -(d or SkinsUI.DIST_BOTON)),
		Vector3.new(0, 0, 0))
end
-- misterio -&gt; dibuja UNA silueta plana de la manzana, sin textura y sin ojos:
--   "silueta" = negra (la que va delante)
--   "filo"    = blanca (la que va detrás, en un viewport MÁS ALTO, y de la que
--               solo asoma el borde)
-- ⚠️ Va en material NEON. Neon ignora la iluminación del ViewportFrame, así que
-- sale PLANA —negro puro o blanco puro— en vez de sombreada, que es lo que hace
-- que se lea como silueta y no como una manzana oscura.
--
-- ⚠️⚠️ AQUÍ HABÍA DOS COPIAS DEL MESH EN EL MISMO VIEWPORT (una blanca al 1.27
-- empujada 0,4 hacia atrás y la negra al 1.00 encima). SE QUITÓ el 31 jul 2026
-- porque SALÍAN AROS BLANCOS ALREDEDOR DE LOS OJOS.
-- El motivo: la manzana NO es convexa —los ojos sobresalen de la cara— y al
-- escalar el mesh un 27% desde su origen los ojos de la copia blanca se van
-- HACIA ADELANTE más de lo que los echa atrás el zoff, así que atraviesan la
-- cara de la silueta negra y asoman como dos anillos. Subir el zoff no lo
-- arregla: aleja la copia y la perspectiva se la come entera (ese fue justo el
-- bug del 1.13 que hubo que subir a 1.27).
-- La solución es la MISMA que ya se usó para el filo negro del botón del HUD:
-- dos ViewportFrames superpuestos, el de atrás más grande EN PÍXELES. Al estar
-- en viewports distintos no hay profundidad compartida, así que ninguna parte de
-- la copia blanca puede atravesar nada: el blanco solo puede asomar por fuera
-- del contorno real. Y como el tamaño lo fija el marco, no hay cuentas de
-- perspectiva que se rompan al cambiar la distancia de la cámara.
-- `negro` = dibuja SOLO una silueta negra plana de la manzana, sin textura y sin
-- aura. Sirve para hacerle el filo negro al botón del HUD: se pone una vista así
-- DETRÁS y MÁS GRANDE en píxeles, y lo que asoma por los bordes es el contorno.
-- ⚠️ Por qué en píxeles y no agrandando el mesh: dentro del viewport hay
-- PERSPECTIVA. Una copia más grande pero empujada hacia atrás con `zoff` puede
-- verse MÁS PEQUEÑA que el original —2,4·1,10/3,4 = 0,78 contra 2,4/2,5 = 0,96—
-- y desaparecer detrás. Con dos viewports el tamaño en pantalla es exactamente el
-- del marco, sin cuentas de perspectiva que se rompan al cambiar la distancia.
-- `sinAura` = no dibujar el halo aunque la skin lo lleve. Lo usa el botón del HUD:
-- ahí el filo negro tiene que medir lo mismo con las siete skins, y el aura lo
-- descuadraba (ver la nota del filo en pintarBotonSkins).
function SkinsUI.vista(padre, s, z, misterio, dist, negro, sinAura)
	local vp = nuevo("ViewportFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(196, 196, 206),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.35, -0.7, 0.6),
		ZIndex = z or 2,
	}, padre)
	local function manzana(escala, color, tex, zoff, neon, transp)
		local p = Instance.new("Part")
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = CFrame.new(0, 0, zoff or 0)
		p.Color = color
		p.Transparency = transp or 0
		if neon then p.Material = Enum.Material.Neon end
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.FileMesh
		m.MeshId = Config.GUSANO_MESH_ID
		if tex then m.TextureId = tex end
		local e = (2.4 / 50) * escala        -- el mismo tamaño que en la cabeza
		m.Scale = Vector3.new(e, e, e)
		m.Parent = p
		p.Parent = vp
		return p
	end
	if misterio then
		-- UNA sola copia, al 1.00 y sin desplazar: el grosor del filo lo da el
		-- tamaño del MARCO del viewport de atrás, no la escala del mesh.
		manzana(1.00, misterio == "filo" and Color3.new(1, 1, 1)
			or Color3.fromRGB(9, 9, 13), nil, 0, true)
	else
		-- ✨ AURA EN LA VISTA PREVIA. Si la skin lleva `brillo`, se dibuja el MISMO
		-- halo que le pone el servidor en la cabeza: otra copia del mesh, más
		-- grande, en Neon y semitransparente. Va DETRÁS (zoff +0.4, igual que el
		-- contorno de la de misterio) para que asome por los bordes.
		-- No se copian las chispas porque un ViewportFrame no dibuja partículas;
		-- esas solo se ven con la skin puesta.
		-- ⚠️ `b.color` puede no existir: una skin puede llevar solo chispas y ninguna
		-- aura (la negra). Sin esta comprobación se leería b.color[1] de un nil.
		local b = s.brillo
		if b and b.color and not negro and not sinAura then
			manzana(b.escala or 1.12,
				Color3.fromRGB(b.color[1], b.color[2], b.color[3]),
				nil, 0.4, true, b.halo or 0.75)
		end
		-- 🌗 el CONTORNO se imita, no se copia: un Highlight es un efecto del mundo
		-- 3D y NO se dibuja dentro de un ViewportFrame. Aquí se hace con el mismo
		-- truco que la silueta de misterio —una copia Neon un 6% mayor DETRÁS— que
		-- asoma solo por los bordes y deja la manzana entera a la vista.
		if b and b.contorno and not negro then
			local ct = b.contorno
			manzana(1.06, Color3.fromRGB(ct.color[1], ct.color[2], ct.color[3]),
				nil, 0.4, true, ct.transp or 0)
		end
		if negro then
			-- silueta plana: Neon para que no la sombree la luz del viewport
			manzana(1.00, Color3.new(0, 0, 0), nil, 0, true)
		else
			local tex = s.textura or ""
			manzana(1.00, Color3.fromRGB(s.color[1], s.color[2], s.color[3]),
				(tex ~= "" and not tex:match("//0$")) and tex or nil, 0, false)
		end
	end
	local cam = Instance.new("Camera")
	cam.CFrame = skinCam(dist)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp
end

-- ═══ BOTÓN DE SKINS 🍎 (encima de Admin) ══════════════════
-- Va DENTRO de colIzq con LayoutOrder -1 en vez de flotar por su cuenta: así
-- hereda el UIScale de consola y el UIListLayout lo coloca solo, sin tener que
-- recalcular posiciones si algún día cambia la lista de pases.
-- 🍎 SIN CÍRCULO (31 jul 2026). Antes la manzana iba dentro de un botón redondo
-- gris con borde, como los pases. Ahora es LA CABEZA A SECAS: el ImageButton
-- sigue existiendo —hace falta para el click y para el zoom del cursor— pero es
-- totalmente transparente y sin contorno, así que solo se ve la manzana.
-- Alto 84 (antes 112): al no haber círculo del que sobresalir, la manzana ya no
-- necesita reservar 27 px por debajo, y el texto sube a pegarse a ella.
-- ⚠️ ESTE ALTO VA ATADO AL TAMAÑO DE LA MANZANA. La etiqueta se ancla al PIE del
-- marco, así que si se achica la manzana y no se achica el marco, vuelve a
-- abrirse el hueco entre las dos. Al bajar la manzana de 72 a 63 px el marco pasó
-- de 88 a 84 para que el hueco siguiera siendo de ~3 px.
local marcoSkins = nuevo("Frame", {
	Size = UDim2.new(0, 62, 0, 84), LayoutOrder = -1, BackgroundTransparency = 1,
}, colIzq)
-- ⚠️ Y SUBIR LA COLUMNA lo que ocupa el botón nuevo. El UIListLayout apila desde
-- arriba, así que meter la manzana empujó ADMIN/INVISIBLE/SLAP/GOD hacia abajo:
-- 80 px del marco + 12 de separación = 92. Se compensa moviendo la columna
-- entera esa misma cantidad hacia arriba, de modo que los cuatro pases quedan
-- EXACTAMENTE donde estaban antes y la manzana ocupa el hueco de encima.
-- Se calcula del tamaño real del marco, no a mano, para que siga cuadrando solo
-- si algún día se cambia el tamaño del botón redondo.
-- ⚠️ Y SE MULTIPLICA POR EL UIScale DE LA COLUMNA. El UIScale encoge el
-- CONTENIDO pero no la posición del marco, así que en consola (0.75) el empujón
-- real es de 69 px, no de 92: compensando 92 a secas la columna se iría 23 px
-- demasiado arriba. Se lee del propio UIScale en vez de repetir el 0.75 aquí,
-- para que no se puedan desincronizar.
colIzq.Position = UDim2.new(0, 16, 0.33,
	-math.round((marcoSkins.Size.Y.Offset + COLIZQ_SEP)
		* (colIzq:FindFirstChildOfClass("UIScale") or {Scale = 1}).Scale))
-- el botón es INVISIBLE: solo es la zona de click y el que se lleva el zoom del
-- cursor (animarBoton le pone un UIScale, y la manzana cuelga de él, así que
-- crecen juntas). Sin fondo, sin UICorner y sin UIStroke = no hay círculo.
-- AutoButtonColor a false porque no hay fondo que teñir al pulsar.
local botonSkins = nuevo("ImageButton", {
	Size = UDim2.new(0, 62, 0, 62), BackgroundTransparency = 1,
	BorderSizePixel = 0, Image = "", AutoButtonColor = false,
}, marcoSkins)
botonSkins:SetAttribute("NoHoverSound", true)
-- 📏 PEGADA A LA MANZANA. La etiqueta se ancla al pie del marco (-18) y la
-- manzana acaba en y=67, así que quedan 3 px entre una y otra. Antes el texto
-- caía en y=94 con la manzana acabando en 56: 38 px de aire en medio.
local lblSkins = nuevo("TextLabel", {
	Size = UDim2.new(1, 14, 0, 18), Position = UDim2.new(0.5, 0, 1, -18),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1,
	Font = Enum.Font.LuckiestGuy, Text = "SKINS",
	TextColor3 = Color3.new(1, 1, 1), TextScaled = true, ZIndex = 3,
}, marcoSkins)
nuevo("UIStroke", {Thickness = 3, Color = Color3.new(0, 0, 0),
	LineJoinMode = Enum.LineJoinMode.Round}, lblSkins)
-- el icono del botón es la manzana que llevas puesta; si no llevas ninguna,
-- enseña la verde para que se entienda de qué va el botón
local vistaBoton, vistaFilo
local VB = 92                      -- lado del viewport de la manzana, en píxeles
function pintarBotonSkins()
	local id = (S and S.skin) or "verde"
	local s = Config.SKIN_POR_ID[id] or Config.SKIN_POR_ID.verde
	if not s or botonSkins:GetAttribute("SkinPintada") == s.id then return end
	botonSkins:SetAttribute("SkinPintada", s.id)
	if vistaBoton then vistaBoton:Destroy() end
	if vistaFilo then vistaFilo:Destroy() end
	-- 🖤 FILO NEGRO, a juego con el UIStroke de 3 px de las letras "SKINS".
	-- Es una segunda vista, en negro, DETRÁS (ZIndex 2) y un 10% más grande: lo que
	-- asoma por los bordes es el contorno, 3,1 px por lado.
	-- ⚠️ FACTOR FIJO Y SIN AURA EN EL BOTÓN (corregido 31 jul 2026). Antes el filo
	-- se dimensionaba POR FUERA del aura de cada skin (dorada 1.10 -&gt; filo 1.20).
	-- La idea era que asomara lo mismo por fuera de todo... pero al bajarle dos
	-- veces la luz a la dorada su aura quedó al 20% de opacidad, o sea invisible, y
	-- entonces el filo se leía desde la manzana: 6,2 px en vez de 3,1. Se veía el
	-- DOBLE de grueso que las demás.
	-- La solución no es recalcular el aura, es no dibujarla aquí: en un botón de
	-- 63 px un halo al 20% no aporta nada, y así las siete skins salen idénticas.
	-- (El aura sigue estando en el personaje y en las tarjetas del menú.)
	local FILO = 1.10
	vistaFilo = SkinsUI.vista(botonSkins, s, 2, false, nil, true)
	vistaFilo.Size = UDim2.new(0, math.round(VB * FILO), 0, math.round(VB * FILO))
	vistaFilo.Position = UDim2.new(0.5, 0, 0.5, 0)
	vistaFilo.AnchorPoint = Vector2.new(0.5, 0.5)
	vistaBoton = SkinsUI.vista(botonSkins, s, 3, false, nil, false, true)
	-- 92 en vez de 116. El viewport se achica pero la manzana SALE MÁS GRANDE,
	-- porque lo que manda es la distancia de la cámara (ver SkinsUI.DIST_BOTON):
	-- pasa de 51 px a 72. Antes el viewport tenía que ser enorme para que la
	-- manzana desbordara el círculo; sin círculo, ese truco ya no hace falta.
	vistaBoton.Size = UDim2.new(0, VB, 0, VB)
	vistaBoton.Position = UDim2.new(0.5, 0, 0.5, 0)
	vistaBoton.AnchorPoint = Vector2.new(0.5, 0.5)
end
pintarBotonSkins()
botonSkins.MouseButton1Click:Connect(function()
	if SkinsUI.abrir then SkinsUI.abrir() end
end)

end   -- fin del do...end de SkinsUI (ver la nota del límite de locales arriba)

local defsPases = {
	{clave = "admin", icono = "📺", texto = "Admin", tag = "OP!",
		color = Color3.fromRGB(38, 52, 130), rainbow = false,
		img = Config.IMG_ADMIN, offY = -6},
	{clave = "invisible", icono = "🧥", texto = "Invisible", tag = "",
		color = Color3.fromRGB(155, 35, 255), rainbow = false,
		img = Config.IMG_INVISIBLE, escIcon = 1.5, offX = -16, offY = 3},
	{clave = "giant", icono = "🖐", texto = "SLAP", tag = "",
		color = Color3.fromRGB(80, 185, 255), rainbow = false,
		img = Config.IMG_GIANT},
	{clave = "god", icono = "🖐", texto = "GOD!", tag = "x300!",
		color = Color3.new(1, 1, 1), rainbow = true, img = Config.IMG_GOD},
}
local function hayImg(id) return id and id ~= "" and not id:match("//0$") end
local accionesPase = {}
for _, d in ipairs(defsPases) do
	local b = nuevo("TextButton", {
		Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = d.color,
		Text = "", BorderSizePixel = 0, AutoButtonColor = true,
		ClipsDescendants = false,
	}, colIzq)
	b:SetAttribute("NoHoverSound", true)   -- sin sonido de hover (la palanca de Android pasa encima); el CLICK sí suena
	esquinas(b, 6)
	if d.rainbow then gradRGB(b) end   -- GOD!: arcoíris ANIMADO
	borde(b, 3.5)
	ladrillos(b, d.color, d.rainbow)
	-- ícono GRANDE que sobresale del botón (como la referencia)
	local sz = math.floor(74 * (d.escIcon or 1))
	if hayImg(d.img) then
		nuevo("ImageLabel", {
			Size = UDim2.new(0, sz, 0, sz),
			Position = UDim2.new(0, -8 + (d.offX or 0), 0.5, -sz / 2 + (d.offY or 0)),
			BackgroundTransparency = 1, Image = d.img,
			ScaleType = Enum.ScaleType.Fit, ZIndex = 3,
		}, b)
	else
		nuevo("TextLabel", {
			Size = UDim2.new(0, 68, 0, 68), Position = UDim2.new(0, -4, 0.5, -34),
			BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
			Text = d.icono, TextSize = 46, ZIndex = 3,
		}, b)
	end
	local lblPase = nuevo("TextLabel", {
		Size = UDim2.new(1, -68, 1, 0), Position = UDim2.new(0, 68, 0, 0),
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
		Text = d.texto, TextColor3 = Color3.new(1, 1, 1), TextSize = 25,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2,
	}, b)
	nuevo("UIStroke", {Thickness = 3.5, Color = Color3.new(0, 0, 0),
		LineJoinMode = Enum.LineJoinMode.Round}, lblPase)
	if d.tag ~= "" then
		local tag = nuevo("TextLabel", {
			-- pegado a la ESQUINA superior derecha (anclado en su centro para
			-- que el pulso crezca/encoja desde el centro)
			Size = UDim2.new(0, 64, 0, 26), Position = UDim2.new(1, -8, 0, -6),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy,
			Text = d.tag, TextColor3 = Color3.fromRGB(120, 255, 90),
			TextSize = 22, Rotation = -8, ZIndex = 4,
		}, b)
		nuevo("UIStroke", {Thickness = 2.5, Color = Color3.new(0, 0, 0),
			LineJoinMode = Enum.LineJoinMode.Round}, tag)
		-- animación PULSO: crece y encoge sin parar
		local sc = nuevo("UIScale", {Scale = 1}, tag)
		TweenService:Create(sc, TweenInfo.new(0.5, Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut, -1, true), {Scale = 1.3}):Play()
	end
	b.MouseButton1Click:Connect(function()
		local fn = accionesPase[d.clave]
		if fn then fn() end
	end)
end

-- ═══ BOTÓN 2x SPEED (derecha) ══════════════════════════════
local marcoSpeed = nuevo("Frame", {
