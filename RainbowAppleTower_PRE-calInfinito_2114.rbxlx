ame="Name">Handle</string><Vector3 name="size"><X>2.0664</X><Y>2.73504</Y><Z>0.76944</Z></Vector3></Properties></Item><Item class="Part" referent="RBX6313"><Properties><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="Massless">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4278979598</Color3uint8><token name="Material">272</token><string name="Name">Palo</string><Vector3 name="size"><X>0.32172</X><Y>0.2436</Y><Z>1.39188</Z></Vector3><token name="shape">1</token></Properties></Item><Item class="Weld" referent="RBX6314"><Properties><string name="Name">ManoWeld</string><Ref name="Part0">RBX6312</Ref><Ref name="Part1">RBX6313</Ref><CoordinateFrame name="C0"><X>-0.10752</X><Y>1.92192</Y><Z>0.01344</Z><R00>0.000000</R00><R01>1.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>0.000000</R11><R12>1.000000</R12><R20>1.000000</R20><R21>0.000000</R21><R22>0.000000</R22></CoordinateFrame><CoordinateFrame name="C1"><X>0</X><Y>0</Y><Z>0</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame></Properties></Item><Item class="LocalScript" referent="RBX6316"><Properties><string name="Name">SlapLogic</string><ProtectedString name="Source">local Tool = script.Parent
local RS = game:GetService("RunService")
local RE = game:GetService("ReplicatedStorage"):WaitForChild("Remotos"):WaitForChild("Slap")
local baseGrip = Tool.Grip
local busy = false
-- sonido del cachetazo PRECARGADO y reutilizado: suena AL INSTANTE en
-- cada golpe (antes creaba+cargaba uno nuevo por click = ~ms de retraso)
local golpe = Instance.new("Sound")
golpe.SoundId = "rbxassetid://126619107266979"
golpe.Volume = 0.5
golpe.RollOffMaxDistance = 120
golpe.Parent = Tool:FindFirstChild("Handle") or Tool
task.spawn(function() pcall(function()
	game:GetService("ContentProvider"):PreloadAsync({golpe}) end) end)
Tool.Equipped:Connect(function()
	baseGrip = Tool.Grip
	RE:FireServer("equipar_god")   -- el server valida la compra
end)
Tool.Activated:Connect(function()
	if busy then return end
	busy = true
	RE:FireServer("god")
	golpe.TimePosition = 0.05   -- salta el arranque del audio: entra un pelín antes
	golpe:Play()   -- precargado → suena JUNTO con el swing, sin retraso
	local dur, t0 = 0.34, os.clock()
	local conn
	conn = RS.RenderStepped:Connect(function()
		local a = (os.clock() - t0) / dur
		if a &gt;= 1 then Tool.Grip = baseGrip conn:Disconnect() return end
		local ang
		if a &lt; 0.28 then ang = -(a / 0.28) * 0.6
		elseif a &lt; 0.6 then ang = -0.6 + ((a - 0.28) / 0.32) * 2.4
		else ang = 1.8 - ((a - 0.6) / 0.4) * 1.8 end
		Tool.Grip = baseGrip * CFrame.Angles(0, -ang, 0)
	end)
	-- COOLDOWN de 2 s: sin spam (ni animación, ni sonido, ni golpe).
	-- ⚠️ ESPEJO de Config.SLAP_COOLDOWN en el server: si cambias uno,
	-- cambia el otro, o el jugador ve el golpe y el server lo ignora.
	-- La barra de recarga del inventario la pinta MainClient.
	task.delay(2, function() busy = false end)
end)
