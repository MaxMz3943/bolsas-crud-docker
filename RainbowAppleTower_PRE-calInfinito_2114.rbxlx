-- ReplicatedStorage/Config  (ModuleScript)
-- KLOZZ WORM TOWER — "Climb the Brainrot Rainbow Apple Tower"
-- ÚNICA FUENTE DE VERDAD: todo lo temático y la geometría viven AQUÍ.
-- ⚠️ build_rbxlx.py PARSEA este archivo: no cambies el FORMATO de las
--    líneas marcadas con [BUILD] (sí puedes cambiar sus VALORES).
-- ═══════════════════════════════════════════════════════════════════════
local Config = {}

-- ─── IDENTIDAD ───────────────────────────────────────────── [BUILD]
Config.NOMBRE_JUEGO = "Rainbow Apple Tower"
Config.TEMA = "Brainrot Worms"
Config.MONEDA = "Cash"

-- ─── GEOMETRÍA DE LA TORRE (compartida con el mapa) ──────── [BUILD]
Config.TAM_INTERIOR = 84         -- lado interior (20% más angosta)
Config.GROSOR_MURO = 3
Config.ALTURA_LOBBY = 46         -- piso 0 = lobby
Config.ALTURA_PISO = 40          -- pisos de gusano
Config.N_PISOS = 25              -- 2026-07-25: 20 → 25 pisos. ~8.8 min caminando /
                                 -- 5.4 corriendo (base 1-7 + Turbo 8-14 +
                                 -- Omega 15-21 + Ultra 22-25)
Config.ANCHO_ESCALERA = 12
Config.PASOS_POR_TRAMO = 13      -- 4 tramos por piso (espiral perimetral)
Config.LARGO_PASO = 4
Config.GROSOR_PASO = 2.4

-- ─── PALETA deco (4 colores) ─────────────────────────────── [BUILD]
Config.PALETA = {
	{255, 90, 160},
	{140, 110, 250},
	{90, 210, 255},
	{255, 210, 60},
}

-- ─── PISOS: color + gusano de cada nivel ─────────────────── [BUILD]
-- radio = distancia de detección · patrulla/caza = velocidades del gusano
--
-- ⚠️ El radio SOLO importa en los pisos donde VIVE un gusano (GUSANO_TRAMOS:
-- 1, 4, 7, 10, 12, 14, 16, 18, 20, 22, 24). En los demás el valor está ahí
-- pero no lo lee nadie, porque el server hace cfg = Config.PISOS[piso_del_gusano].
--
-- Rampa de dificultad por radio (2026-07-26): 20 → 35 → 40 → 50 → 60 → 70 y
-- de ahí en adelante 70 fijo. Antes eran 63-81 desde el primero, o sea que el
-- jugador nuevo se comía un gusano que lo veía desde media torre.
Config.PISOS = {
	-- ciclo 1: base (1-7)
	-- ⚠️ GUSANO 1 (vive en el piso 1 y patrulla del 1 al 3): a propósito TONTO
	-- (2026-07-26). Es el primero que ve un jugador nuevo: tiene que enseñar la
	-- mecánica sin matar a nadie.
	--   radio 63 → 20 : tienes que ponerte casi encima para que te vea.
	--   caza  17 → 12 : ×GUSANO_CAZA_MULT(1.18) = 14,2. El número que manda aquí
	--                   es VEL_BASE (16): mientras la caza real quede por debajo,
	--                   el novato se escapa ANDANDO, sin necesitar saber que
	--                   existe el sprint. Con caza=14 ya daría 16,5 y le
	--                   obligaría a correr — ahí deja de ser el gusano tutorial.
	--                   Y 14,2 &gt; patrulla 10, así que ahora sí ACELERA al
	--                   detectarte; con caza=8 perseguía más lento de lo que
	--                   paseaba y quedaba roto.
	{nombre="Nivel Skibidi", color={76, 126, 255}, gusano="Skibidi Worm", cuerpo={235, 238, 248}, radio=20, patrulla=10, caza=12},
	{nombre="Nivel Tralalero", color={255, 76, 166}, gusano="Tralalero Worm", cuerpo={95, 165, 255}, radio=63, patrulla=10, caza=17},
	{nombre="Nivel Tung Tung", color={174, 76, 255}, gusano="Tung Tung Worm", cuerpo={175, 125, 75}, radio=64, patrulla=10, caza=17},
	{nombre="Nivel Cappuccina", color={145, 76, 241}, gusano="Cappuccina Worm", cuerpo={248, 242, 230}, radio=35, patrulla=10, caza=17},
	{nombre="Nivel SCP", color={244, 76, 210}, gusano="SCP-173 Worm", cuerpo={205, 195, 175}, radio=66, patrulla=10, caza=18},
	{nombre="Nivel Bombardiro", color={255, 90, 98}, gusano="Bombardiro Worm", cuerpo={120, 205, 95}, radio=66, patrulla=11, caza=18},
	{nombre="Nivel KPop Diva", color={255, 196, 76}, gusano="KPop Diva Worm", cuerpo={255, 218, 180}, radio=40, patrulla=11, caza=18},
	-- ciclo 2: Turbo (8-14)
	{nombre="Skibidi Turbo", color={76, 121, 240}, gusano="Skibidi Worm Turbo", cuerpo={235, 238, 248}, radio=68, patrulla=11, caza=19},
	{nombre="Tralalero Turbo", color={240, 76, 158}, gusano="Tralalero Worm Turbo", cuerpo={95, 165, 255}, radio=69, patrulla=11, caza=19},
	{nombre="Tung Tung Turbo", color={166, 76, 240}, gusano="Tung Tung Worm Turbo", cuerpo={175, 125, 75}, radio=50, patrulla=12, caza=19},
	{nombre="Cappuccina Turbo", color={140, 76, 228}, gusano="Cappuccina Worm Turbo", cuerpo={248, 242, 230}, radio=70, patrulla=12, caza=20},
	{nombre="SCP Turbo", color={230, 76, 198}, gusano="SCP-173 Worm Turbo", cuerpo={205, 195, 175}, radio=60, patrulla=12, caza=20},
	{nombre="Bombardiro Turbo", color={240, 89, 95}, gusano="Bombardiro Worm Turbo", cuerpo={120, 205, 95}, radio=72, patrulla=12, caza=20},
	{nombre="KPop Diva Turbo", color={240, 186, 76}, gusano="KPop Diva Worm Turbo", cuerpo={255, 218, 180}, radio=70, patrulla=13, caza=21},
	-- ciclo 3: Omega (15-20) — último ciclo (torre de 20 pisos)
	{nombre="Skibidi Omega", color={76, 117, 226}, gusano="Skibidi Worm Omega", cuerpo={235, 238, 248}, radio=73, patrulla=13, caza=21},
	{nombre="Tralalero Omega", color={226, 76, 151}, gusano="Tralalero Worm Omega", cuerpo={95, 165, 255}, radio=70, patrulla=13, caza=21},
	{nombre="Tung Tung Omega", color={158, 76, 226}, gusano="Tung Tung Worm Omega", cuerpo={175, 125, 75}, radio=75, patrulla=13, caza=21},
	{nombre="Cappuccina Omega", color={134, 76, 214}, gusano="Cappuccina Worm Omega", cuerpo={248, 242, 230}, radio=70, patrulla=14, caza=22},
	{nombre="SCP Omega", color={217, 76, 188}, gusano="SCP-173 Worm Omega", cuerpo={205, 195, 175}, radio=77, patrulla=14, caza=22},
	{nombre="Bombardiro Omega", color={226, 88, 94}, gusano="Bombardiro Worm Omega", cuerpo={120, 205, 95}, radio=70, patrulla=14, caza=22},
	-- ciclo 3 completado + ciclo 4: ULTRA (21-25, añadidos 2026-07-25)
	-- ⚠️ LA VELOCIDAD DE CAZA SE QUEDA EN 22 A PROPÓSITO. El gusano cazando va a
	-- caza × GUSANO_CAZA_MULT(1.18); con caza=22 eso da 25.96, justo por debajo
	-- del sprint del jugador (VEL_BASE 16 + CORRER_PLUS 10 = 26). Si subiera a 23
	-- el gusano correría a 27.1 y sería IMPOSIBLE escapar aunque corras: el piso
	-- dejaría de ser difícil para pasar a ser injusto. La dificultad de estos
	-- pisos sube por RADIO (te ve antes) y PATRULLA (te encuentra más rápido).
	{nombre="KPop Diva Omega", color={226, 176, 76}, gusano="KPop Diva Worm Omega", cuerpo={255, 218, 180}, radio=78, patrulla=14, caza=22},
	{nombre="Skibidi Ultra", color={60, 104, 210}, gusano="Skibidi Worm Ultra", cuerpo={235, 238, 248}, radio=70, patrulla=15, caza=22},
	{nombre="Tralalero Ultra", color={210, 62, 140}, gusano="Tralalero Worm Ultra", cuerpo={95, 165, 255}, radio=80, patrulla=15, caza=22},
	{nombre="Tung Tung Ultra", color={145, 62, 210}, gusano="Tung Tung Worm Ultra", cuerpo={175, 125, 75}, radio=70, patrulla=15, caza=22},
	{nombre="Cappuccina Ultra", color={122, 62, 198}, gusano="Cappuccina Worm Ultra", cuerpo={248, 242, 230}, radio=82, patrulla=16, caza=22},
}

