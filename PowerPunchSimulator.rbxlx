<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX4"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX3"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Config.luau
-- Every tunable number in the game lives here: balance, zones, gear, monetization.
-- Change values here and the whole game (map, shop, formulas, UI) follows.

local Config = {}

Config.GameName = "Power Punch Simulator"

Config.Training = {
	BasePowerPerPunch = 1,
	PunchCooldown = 0.15, -- seconds between punches, enforced server-side
	CoinsPerPowerGained = 0.5, -- every punch also pays out coins at this ratio
	AutoTrainInterval = 0.6, -- punch rate for the Auto Train gamepass
}

Config.Rebirth = {
	BaseCost = 10_000, -- power needed for the first rebirth
	CostGrowth = 3, -- each rebirth costs 3x the previous one
	BonusPerRebirth = 0.5, -- +50% power per punch, permanently, per rebirth
}

-- Gear must be bought in order; your multiplier is the last gear you bought.
Config.Gear = {
	{ name = "Foam Gloves", cost = 100, multiplier = 2, color = Color3.fromRGB(240, 200, 80) },
	{ name = "Leather Gloves", cost = 1_000, multiplier = 5, color = Color3.fromRGB(160, 100, 50) },
	{ name = "Iron Gauntlets", cost = 10_000, multiplier = 12, color = Color3.fromRGB(180, 180, 190) },
	{ name = "Golden Fists", cost = 100_000, multiplier = 30, color = Color3.fromRGB(255, 200, 40) },
	{ name = "Diamond Crushers", cost = 1_000_000, multiplier = 75, color = Color3.fromRGB(120, 220, 255) },
	{ name = "Void Knuckles", cost = 10_000_000, multiplier = 200, color = Color3.fromRGB(140, 60, 220) },
}

-- Zones are laid out west-to-east by MapBuilder. Standing on a zone's training
-- pads multiplies your punches, but only if you meet the power requirement
-- (validated on the server -- walking through a gate exploit gains nothing).
Config.Zones = {
	{
		name = "Beach",
		powerRequired = 0,
		multiplier = 1,
		floorColor = Color3.fromRGB(238, 214, 160),
		accentColor = Color3.fromRGB(60, 170, 90),
		floorMaterial = Enum.Material.Sand,
	},
	{
		name = "City",
		powerRequired = 5_000,
		multiplier = 3,
		floorColor = Color3.fromRGB(112, 112, 118),
		accentColor = Color3.fromRGB(80, 140, 210),
		floorMaterial = Enum.Material.Concrete,
	},
	{
		name = "Volcano",
		powerRequired = 50_000,
		multiplier = 8,
		floorColor = Color3.fromRGB(62, 48, 46),
		accentColor = Color3.fromRGB(255, 100, 30),
		floorMaterial = Enum.Material.Basalt,
	},
	{
		name = "Space",
		powerRequired = 500_000,
		multiplier = 20,
		floorColor = Color3.fromRGB(42, 38, 62),
		accentColor = Color3.fromRGB(90, 220, 255),
		floorMaterial = Enum.Material.Slate,
	},
}

-- The VIP island hangs off the Beach and requires the VIP gamepass instead of power.
Config.VipZone = {
	name = "VIP Island",
	multiplier = 50,
	floorColor = Color3.fromRGB(235, 225, 180),
	accentColor = Color3.fromRGB(255, 215, 0),
	floorMaterial = Enum.Material.Marble,
}

-- ============================== MONETIZATION ==============================
-- Fill these IDs in from the Creator Dashboard after publishing the game
-- (Creator Dashboard -&gt; your experience -&gt; Monetization -&gt; Passes / Developer Products).
-- With an ID of 0 the item is hidden from the shop and the game runs fine without it.

Config.GamePasses = {
	DoublePower = 0, -- suggested price: 199 R$
	DoubleCoins = 0, -- suggested price: 199 R$
	AutoTrain = 0, -- suggested price: 349 R$
	VIP = 0, -- suggested price: 499 R$
}

Config.GamePassInfo = {
	DoublePower = { title = "2x Power", desc = "Every punch gives double power, forever." },
	DoubleCoins = { title = "2x Coins", desc = "Every punch pays out double coins, forever." },
	AutoTrain = { title = "Auto Train", desc = "Hands-free training: punch automatically while you chill." },
	VIP = { title = "VIP Island", desc = "Unlock the exclusive x50 VIP training island." },
}

Config.DevProducts = {
	{ key = "SmallCoins", id = 0, coins = 25_000, label = "25K Coins" }, -- suggested: 49 R$
	{ key = "MediumCoins", id = 0, coins = 150_000, label = "150K Coins" }, -- suggested: 199 R$
	{ key = "LargeCoins", id = 0, coins = 1_000_000, label = "1M Coins" }, -- suggested: 799 R$
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Formulas</string><ProtectedString name="Source">-- Formulas.luau
-- Pure functions shared by the server (authoritative math) and the client
-- (UI display and prediction). No state, no side effects.

local Config = require(script.Parent.Config)

local Formulas = {}

function Formulas.gearMultiplier(gearLevel: number): number
	if gearLevel &lt;= 0 then
		return 1
	end
	local gear = Config.Gear[math.min(gearLevel, #Config.Gear)]
	return gear.multiplier
end

function Formulas.rebirthMultiplier(rebirths: number): number
	return 1 + rebirths * Config.Rebirth.BonusPerRebirth
end

-- state: { gearLevel: number, rebirths: number, zoneMultiplier: number?, hasDoublePower: boolean? }
function Formulas.powerPerPunch(state): number
	local amount = Config.Training.BasePowerPerPunch
		* Formulas.gearMultiplier(state.gearLevel)
		* Formulas.rebirthMultiplier(state.rebirths)
		* (state.zoneMultiplier or 1)
	if state.hasDoublePower then
		amount *= 2
	end
	return math.max(1, math.floor(amount + 0.5))
end

function Formulas.coinsForPower(powerGained: number, hasDoubleCoins: boolean?): number
	local coins = powerGained * Config.Training.CoinsPerPowerGained
	if hasDoubleCoins then
		coins *= 2
	end
	return math.floor(coins + 0.5)
end

function Formulas.rebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths)
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234567 -&gt; "1.23M", 950 -&gt; "950"
function Formulas.abbreviate(n: number): string
	n = math.floor(n)
	if n &lt; 1000 then
		return tostring(n)
	end
	local index = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 1000 ^ index
	local formatted
	if scaled &gt;= 100 then
		formatted = string.format("%.0f", scaled)
	elseif scaled &gt;= 10 then
		formatted = string.format("%.1f", scaled)
	else
		formatted = string.format("%.2f", scaled)
	end
	return formatted .. SUFFIXES[index + 1]
end

return Formulas
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX12"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX11"><Properties><string name="Name">Server</string><ProtectedString name="Source">-- Server entry point. Creates the remotes, then wires services together in
-- dependency order. Services receive their dependencies explicitly instead of
-- requiring each other, which keeps the graph flat and easy to follow.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in { "Punch", "BuyGear", "Rebirth", "Notify", "ToggleAutoTrain" } do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
end
remotes.Parent = ReplicatedStorage

local Data = require(script.Data)
local Monetization = require(script.Monetization)
local Training = require(script.Training)
local Shop = require(script.Shop)
local MapBuilder = require(script.MapBuilder)
local GlobalLeaderboard = require(script.GlobalLeaderboard)

local mapHandles = MapBuilder.build()

Data.start()
Monetization.start(Data)
Training.start(Data, Monetization, MapBuilder)
Shop.start(Data)
GlobalLeaderboard.start(Data, mapHandles.leaderboardPart)

print("[Server] Power Punch Simulator ready 💪")
</ProtectedString></Properties><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Data</string><ProtectedString name="Source">-- Data.luau
-- Player data: loading with retries, session cache, leaderstats, autosave,
-- and graceful fallback to in-memory data when DataStores are unavailable
-- (which is normal in unpublished Studio playtests).

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local DATASTORE_NAME = "PlayerData_v1"
local AUTOSAVE_INTERVAL = 60
local LOAD_RETRIES = 3

local DEFAULT_DATA = {
	version = 1,
	power = 0,
	coins = 0,
	rebirths = 0,
	gearLevel = 0,
}

local Data = {}

local profiles = {} -- [Player] = profile table
local store = nil -- nil when DataStores are unavailable

local function deepCopy(source)
	local copy = {}
	for key, value in source do
		copy[key] = if type(value) == "table" then deepCopy(value) else value
	end
	return copy
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Push the profile into leaderstats (auto-replicates to everyone's player list)
-- and attributes (used by the client UI).
local function sync(player: Player)
	local profile = profiles[player]
	local stats = player:FindFirstChild("leaderstats")
	if not profile or not stats then
		return
	end
	stats.Power.Value = profile.power
	stats.Coins.Value = profile.coins
	stats.Rebirths.Value = profile.rebirths
	player:SetAttribute("GearLevel", profile.gearLevel)
end

local function loadProfile(player: Player)
	local data
	if store then
		for attempt = 1, LOAD_RETRIES do
			local ok, result = pcall(function()
				return store:GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				break
			end
			warn(`[Data] Load attempt {attempt} failed for {player.Name}: {result}`)
			task.wait(2 ^ attempt)
		end
	end
	data = data or deepCopy(DEFAULT_DATA)
	-- Fill in any fields added since this profile was saved.
	for key, value in DEFAULT_DATA do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function saveProfile(player: Player)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function()
			return profile
		end)
	end)
	if not ok then
		warn(`[Data] Save failed for {player.Name}: {err}`)
	end
end

local function onPlayerAdded(player: Player)
	local profile = loadProfile(player)
	if not player.Parent then
		return -- left while loading
	end
	profiles[player] = profile

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, statName in { "Power", "Coins", "Rebirths" } do
		local value = Instance.new("IntValue")
		value.Name = statName
		value.Parent = stats
	end
	stats.Parent = player

	sync(player)
end

-- ============================== PUBLIC API ==============================

function Data.get(player: Player)
	return profiles[player]
end

function Data.addPower(player: Player, amount: number)
	local profile = profiles[player]
	if profile then
		profile.power += amount
		sync(player)
	end
end

function Data.addCoins(player: Player, amount: number)
	local profile = profiles[player]
	if profile then
		profile.coins += amount
		sync(player)
	end
end

function Data.trySpendCoins(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or profile.coins &lt; amount then
		return false
	end
	profile.coins -= amount
	sync(player)
	return true
end

function Data.setGearLevel(player: Player, level: number)
	local profile = profiles[player]
	if profile then
		profile.gearLevel = level
		sync(player)
	end
end

-- Reset progress in exchange for a permanent rebirth multiplier.
function Data.applyRebirth(player: Player)
	local profile = profiles[player]
	if profile then
		profile.power = 0
		profile.coins = 0
		profile.gearLevel = 0
		profile.rebirths += 1
		sync(player)
	end
end

function Data.start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStores unavailable — using in-memory data. "
			.. "This is expected in unpublished Studio playtests.")
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		saveProfile(player)
		profiles[player] = nil
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			saveProfile(player)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for _, player in Players:GetPlayers() do
				saveProfile(player)
			end
		end
	end)
end

return Data
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">GlobalLeaderboard</string><ProtectedString name="Source">-- GlobalLeaderboard.luau
-- Cross-server top-10 power leaderboard on a physical board near spawn,
-- backed by an OrderedDataStore. Degrades gracefully in unpublished Studio
-- playtests where DataStores are unavailable.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)

local STORE_NAME = "GlobalPower_v1"
local UPDATE_INTERVAL = 120
local TOP_N = 10

local GlobalLeaderboard = {}

local nameCache = {} -- [userId] = username

local function usernameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or "Unknown"
	return nameCache[userId]
end

local function buildBoardGui(board: BasePart): { TextLabel }
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(520, 280)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 44)
	title.BackgroundTransparency = 1
	title.Text = "🏆 GLOBAL TOP POWER 🏆"
	title.TextColor3 = Color3.fromRGB(255, 200, 60)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Parent = gui

	local list = Instance.new("Frame")
	list.Position = UDim2.new(0, 16, 0, 48)
	list.Size = UDim2.new(1, -32, 1, -56)
	list.BackgroundTransparency = 1
	list.Parent = gui

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, 2)
	layout.Parent = list

	local rows = {}
	for i = 1, TOP_N do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0, 20)
		row.BackgroundTransparency = 1
		row.Text = ""
		row.TextColor3 = Color3.fromRGB(240, 243, 250)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Parent = list
		rows[i] = row
	end

	gui.Parent = board
	return rows
end

function GlobalLeaderboard.start(Data, boardPart: BasePart)
	local rows = buildBoardGui(boardPart)

	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(STORE_NAME)
	end)
	if not ok or not store then
		rows[1].Text = "Publish the game to enable the global leaderboard"
		return
	end

	task.spawn(function()
		task.wait(5) -- let first players load in before the first refresh
		while true do
			-- Push current players' power, then pull the global top 10.
			for _, player in Players:GetPlayers() do
				local profile = Data.get(player)
				if profile and profile.power &gt; 0 then
					pcall(function()
						store:SetAsync(tostring(player.UserId), profile.power)
					end)
				end
			end

			local pagesOk, pages = pcall(function()
				return store:GetSortedAsync(false, TOP_N)
			end)
			if pagesOk then
				local top = pages:GetCurrentPage()
				for i = 1, TOP_N do
					local entry = top[i]
					if entry then
						local name = usernameFor(tonumber(entry.key) or 0)
						rows[i].Text = `#{i}  {name} — {Formulas.abbreviate(entry.value)}`
						rows[i].TextColor3 = if i == 1
							then Color3.fromRGB(255, 200, 60)
							elseif i == 2 then Color3.fromRGB(200, 200, 210)
							elseif i == 3 then Color3.fromRGB(205, 130, 70)
							else Color3.fromRGB(240, 243, 250)
					else
						rows[i].Text = ""
					end
				end
			end

			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return GlobalLeaderboard
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source">-- MapBuilder.luau
-- Builds the entire map from code at server start: zone platforms, training
-- pads, gates, decorations, spawn, and the leaderboard board. No manual Studio
-- editing needed -- tweak Config.Zones and the world rebuilds to match.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)

local ZONE_SIZE = 140 -- each main zone is a ZONE_SIZE x ZONE_SIZE platform
local WALL_HEIGHT = 24
local PAD_OFFSETS = {
	Vector3.new(-38, 0, 28),
	Vector3.new(0, 0, -38),
	Vector3.new(38, 0, 28),
}

local MapBuilder = {}

-- Axis-aligned regions used by Training to validate zone bonuses server-side.
-- Each entry: { minX, maxX, minZ, maxZ, info = {name, powerRequired, multiplier, vipOnly?} }
local zoneRegions = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function billboard(adornee: BasePart, text: string, color: Color3, offsetY: number, size: UDim2)
	local gui = Instance.new("BillboardGui")
	gui.Adornee = adornee
	gui.Size = size
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 400

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextStrokeTransparency = 0.4
	label.Parent = gui

	gui.Parent = adornee
	return gui, label
end

local function buildTrainingPads(parent: Folder, center: Vector3, offsets: { Vector3 }, accent: Color3, multiplier: number)
	for _, offset in offsets do
		local pad = part({
			Name = "TrainingPad",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1, 14, 14),
			CFrame = CFrame.new(center + offset + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = accent,
			Material = Enum.Material.Neon,
			Parent = parent,
		})
		billboard(pad, `x{multiplier} 💪`, accent, 6, UDim2.fromScale(8, 2.4))
	end
end

local function buildDecorations(parent: Folder, center: Vector3, accent: Color3, seed: number)
	local rng = Random.new(seed)
	for _ = 1, 8 do
		-- Ring placement near the zone edges so pillars never block the pads.
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(46, 62)
		local width = rng:NextNumber(4, 8)
		local height = rng:NextNumber(8, 32)
		local position = center + Vector3.new(math.cos(angle) * radius, height / 2, math.sin(angle) * radius)

		local pillar = part({
			Name = "Pillar",
			Size = Vector3.new(width, height, width),
			CFrame = CFrame.new(position) * CFrame.Angles(0, angle, 0),
			Color = accent,
			Material = Enum.Material.SmoothPlastic,
			Parent = parent,
		})
		part({
			Name = "PillarCap",
			Size = Vector3.new(width + 1, 1.5, width + 1),
			CFrame = pillar.CFrame * CFrame.new(0, height / 2 + 0.75, 0),
			Color = accent,
			Material = Enum.Material.Neon,
			Parent = parent,
		})
	end
end

function MapBuilder.getZoneAt(position: Vector3)
	for _, region in zoneRegions do
		if
			position.X &gt;= region.minX
			and position.X &lt;= region.maxX
			and position.Z &gt;= region.minZ
			and position.Z &lt;= region.maxZ
		then
			return region.info
		end
	end
	return nil
end

function MapBuilder.build()
	local map = Instance.new("Folder")
	map.Name = "Map"
	local gates = Instance.new("Folder")
	gates.Name = "ZoneGates"

	-- ============================== MAIN ZONES ==============================
	for index, zone in Config.Zones do
		local centerX = (index - 1) * ZONE_SIZE
		local center = Vector3.new(centerX, 0, 0)
		local zoneFolder = Instance.new("Folder")
		zoneFolder.Name = zone.name
		zoneFolder.Parent = map

		part({
			Name = "Floor",
			Size = Vector3.new(ZONE_SIZE, 4, ZONE_SIZE),
			CFrame = CFrame.new(centerX, -2, 0),
			Color = zone.floorColor,
			Material = zone.floorMaterial,
			Parent = zoneFolder,
		})

		buildTrainingPads(zoneFolder, center, PAD_OFFSETS, zone.accentColor, zone.multiplier)
		buildDecorations(zoneFolder, center, zone.accentColor, index * 7919)

		table.insert(zoneRegions, {
			minX = centerX - ZONE_SIZE / 2,
			maxX = centerX + ZONE_SIZE / 2,
			minZ = -ZONE_SIZE / 2,
			maxZ = ZONE_SIZE / 2,
			info = {
				name = zone.name,
				powerRequired = zone.powerRequired,
				multiplier = zone.multiplier,
			},
		})

		-- Gate wall on the western edge of every zone after the first.
		if index &gt; 1 then
			local gate = part({
				Name = zone.name .. "Gate",
				Size = Vector3.new(2, WALL_HEIGHT, ZONE_SIZE),
				CFrame = CFrame.new(centerX - ZONE_SIZE / 2, WALL_HEIGHT / 2, 0),
				Color = Color3.fromRGB(235, 87, 87),
				Material = Enum.Material.ForceField,
				Transparency = 0.2,
				Parent = gates,
			})
			gate:SetAttribute("PowerRequired", zone.powerRequired)
			gate:SetAttribute("ZoneName", zone.name)
			gate:SetAttribute("VipOnly", false)
			billboard(
				gate,
				`{zone.name} — {Formulas.abbreviate(zone.powerRequired)} Power`,
				Color3.fromRGB(255, 255, 255),
				WALL_HEIGHT / 2 + 4,
				UDim2.fromScale(24, 4)
			)
		end
	end

	-- ============================== VIP ISLAND ==============================
	local vip = Config.VipZone
	local vipFolder = Instance.new("Folder")
	vipFolder.Name = "VipIsland"
	vipFolder.Parent = map

	part({
		Name = "Floor",
		Size = Vector3.new(100, 4, 100),
		CFrame = CFrame.new(0, -2, -170),
		Color = vip.floorColor,
		Material = vip.floorMaterial,
		Parent = vipFolder,
	})
	part({
		Name = "Bridge",
		Size = Vector3.new(14, 4, 50),
		CFrame = CFrame.new(0, -2, -95),
		Color = vip.floorColor,
		Material = Enum.Material.WoodPlanks,
		Parent = vipFolder,
	})

	local vipPadOffsets = {
		Vector3.new(-28, 0, 20),
		Vector3.new(0, 0, -28),
		Vector3.new(28, 0, 20),
	}
	buildTrainingPads(vipFolder, Vector3.new(0, 0, -170), vipPadOffsets, vip.accentColor, vip.multiplier)
	buildDecorations(vipFolder, Vector3.new(0, 0, -170), vip.accentColor, 424242)

	table.insert(zoneRegions, {
		minX = -50,
		maxX = 50,
		minZ = -220,
		maxZ = -120,
		info = {
			name = vip.name,
			powerRequired = 0,
			multiplier = vip.multiplier,
			vipOnly = true,
		},
	})

	local vipGate = part({
		Name = "VipGate",
		Size = Vector3.new(14, WALL_HEIGHT, 2),
		CFrame = CFrame.new(0, WALL_HEIGHT / 2, -95),
		Color = Color3.fromRGB(255, 215, 0),
		Material = Enum.Material.ForceField,
		Transparency = 0.2,
		Parent = gates,
	})
	vipGate:SetAttribute("PowerRequired", 0)
	vipGate:SetAttribute("ZoneName", vip.name)
	vipGate:SetAttribute("VipOnly", true)
	billboard(vipGate, "👑 VIP Island — Gamepass", vip.accentColor, WALL_HEIGHT / 2 + 4, UDim2.fromScale(24, 4))

	-- ============================== SPAWN &amp; EXTRAS ==============================
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, 52)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(250, 250, 250)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	local board = part({
		Name = "LeaderboardBoard",
		Size = Vector3.new(26, 14, 2),
		CFrame = CFrame.new(0, 9, 66),
		Color = Color3.fromRGB(34, 39, 54),
		Material = Enum.Material.SmoothPlastic,
		Parent = map,
	})

	-- Fell off the map? Fast respawn instead of a long fall to the void.
	local killPlane = part({
		Name = "KillPlane",
		Size = Vector3.new(4000, 1, 4000),
		CFrame = CFrame.new(200, -45, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = map,
	})
	killPlane.Touched:Connect(function(hit)
		local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
		end
	end)

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.2
	bloom.Parent = Lighting

	map.Parent = workspace
	gates.Parent = workspace

	return { leaderboardPart = board }
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Monetization</string><ProtectedString name="Source">-- Monetization.luau
-- Gamepass ownership (cached per player, exposed as attributes for the UI)
-- and developer product receipt processing. All grants happen server-side.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Monetization = {}

local ownership = {} -- [Player] = { [passKey] = boolean }
local handledReceipts = {} -- [PurchaseId] = true, session-level dedupe
local Data

local function refreshPasses(player: Player)
	local owned = {}
	for key, passId in Config.GamePasses do
		local owns = false
		if passId ~= 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
			end)
			owns = ok and result == true
		end
		owned[key] = owns
		player:SetAttribute("Owns" .. key, owns)
	end
	ownership[player] = owned
end

local function processReceipt(receiptInfo)
	if handledReceipts[receiptInfo.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player or not Data.get(player) then
		-- Player left or their data hasn't loaded; Roblox will retry later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	for _, product in Config.DevProducts do
		if product.id == receiptInfo.ProductId then
			Data.addCoins(player, product.coins)
			handledReceipts[receiptInfo.PurchaseId] = true
			local notify = ReplicatedStorage.Remotes:FindFirstChild("Notify")
			if notify then
				notify:FireClient(player, "success", `Purchased {product.label}!`)
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	warn(`[Monetization] Receipt for unknown product id {receiptInfo.ProductId}`)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- ============================== PUBLIC API ==============================

function Monetization.ownsPass(player: Player, passKey: string): boolean
	local owned = ownership[player]
	return owned ~= nil and owned[passKey] == true
end

function Monetization.start(dataService)
	Data = dataService

	Players.PlayerAdded:Connect(function(player)
		task.spawn(refreshPasses, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(refreshPasses, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		ownership[player] = nil
	end)

	-- Update the cache instantly when a pass is bought in-game.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, id in Config.GamePasses do
			if id == passId then
				local owned = ownership[player]
				if owned then
					owned[key] = true
				end
				player:SetAttribute("Owns" .. key, true)
				local notify = ReplicatedStorage.Remotes:FindFirstChild("Notify")
				if notify then
					notify:FireClient(player, "success", `{Config.GamePassInfo[key].title} unlocked!`)
				end
			end
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt
end

return Monetization
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Shop</string><ProtectedString name="Source">-- Shop.luau
-- Gear purchases and rebirths. All costs and prerequisites are validated
-- server-side; the client UI is just a pretty way to fire these remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)

local Shop = {}

function Shop.start(Data)
	local remotes = ReplicatedStorage.Remotes
	local notify = remotes.Notify

	remotes.BuyGear.OnServerEvent:Connect(function(player, level)
		local profile = Data.get(player)
		if not profile or type(level) ~= "number" or level % 1 ~= 0 then
			return
		end
		-- Gear is bought strictly in order.
		if level ~= profile.gearLevel + 1 then
			return
		end
		local gear = Config.Gear[level]
		if not gear then
			return
		end
		if not Data.trySpendCoins(player, gear.cost) then
			notify:FireClient(player, "error", "Not enough coins!")
			return
		end
		Data.setGearLevel(player, level)
		notify:FireClient(player, "success", `Bought {gear.name} (x{gear.multiplier} power)!`)
	end)

	remotes.Rebirth.OnServerEvent:Connect(function(player)
		local profile = Data.get(player)
		if not profile then
			return
		end
		local cost = Formulas.rebirthCost(profile.rebirths)
		if profile.power &lt; cost then
			notify:FireClient(player, "error", `You need {Formulas.abbreviate(cost)} power to rebirth!`)
			return
		end
		Data.applyRebirth(player)
		local bonus = profile.rebirths * Config.Rebirth.BonusPerRebirth * 100
		notify:FireClient(player, "success", `Rebirth {profile.rebirths}! Permanent +{bonus}% power.`)
		-- Zones re-lock when power resets; respawn so nobody is trapped behind a gate.
		task.defer(function()
			player:LoadCharacter()
		end)
	end)
end

return Shop
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Training</string><ProtectedString name="Source">-- Training.luau
-- The core loop: punch -&gt; gain power + coins. The server is authoritative:
-- it rate-limits the remote, recomputes every multiplier itself, and validates
-- zone bonuses against the player's actual position and power. A client that
-- fires the remote faster or lies about its zone gains nothing.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)

local Training = {}

local lastPunch = {} -- [Player] = os.clock() of last accepted punch
local Data, Monetization, MapBuilder

-- Which multiplier does this player actually earn, standing where they are?
local function zoneMultiplierFor(player: Player, profile): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return 1
	end

	local zone = MapBuilder.getZoneAt(root.Position)
	if not zone then
		return 1
	end
	if zone.vipOnly then
		return Monetization.ownsPass(player, "VIP") and zone.multiplier or 1
	end
	if profile.power &gt;= zone.powerRequired then
		return zone.multiplier
	end
	return 1
end

local function punch(player: Player, bypassCooldown: boolean?)
	local profile = Data.get(player)
	if not profile then
		return
	end

	if not bypassCooldown then
		local now = os.clock()
		-- 0.9 factor gives honest clients a little network-jitter tolerance.
		if now - (lastPunch[player] or 0) &lt; Config.Training.PunchCooldown * 0.9 then
			return
		end
		lastPunch[player] = now
	end

	local powerGain = Formulas.powerPerPunch({
		gearLevel = profile.gearLevel,
		rebirths = profile.rebirths,
		zoneMultiplier = zoneMultiplierFor(player, profile),
		hasDoublePower = Monetization.ownsPass(player, "DoublePower"),
	})
	local coinsGain = Formulas.coinsForPower(powerGain, Monetization.ownsPass(player, "DoubleCoins"))

	Data.addPower(player, powerGain)
	Data.addCoins(player, coinsGain)

	-- Tell the client what it actually earned so the popup matches reality.
	ReplicatedStorage.Remotes.Punch:FireClient(player, powerGain, coinsGain)
end

function Training.start(dataService, monetizationService, mapBuilder)
	Data = dataService
	Monetization = monetizationService
	MapBuilder = mapBuilder

	local remotes = ReplicatedStorage.Remotes
	remotes.Punch.OnServerEvent:Connect(function(player)
		punch(player)
	end)

	remotes.ToggleAutoTrain.OnServerEvent:Connect(function(player, enabled)
		if Monetization.ownsPass(player, "AutoTrain") then
			player:SetAttribute("AutoTrainOn", enabled == true)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastPunch[player] = nil
	end)

	-- Auto Train gamepass: server-driven punches, no client input needed.
	task.spawn(function()
		while true do
			task.wait(Config.Training.AutoTrainInterval)
			for _, player in Players:GetPlayers() do
				if player:GetAttribute("AutoTrainOn") and Monetization.ownsPass(player, "AutoTrain") then
					punch(player, true)
				end
			end
		end
	end)
end

return Training
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX21"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX20"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX19"><Properties><string name="Name">Client</string><ProtectedString name="Source">-- Client entry point: waits for the server's remotes, then boots every
-- controller. Windows (Shop, Rebirth) register themselves with the UI window
-- manager; the HUD's buttons toggle them by name.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Remotes")
ReplicatedStorage:WaitForChild("Shared")

local Effects = require(script.Effects)
local ShopUi = require(script.ShopUi)
local RebirthUi = require(script.RebirthUi)
local Hud = require(script.Hud)
local ZoneGates = require(script.ZoneGates)

Effects.start()
ShopUi.build()
RebirthUi.build()
Hud.start()
ZoneGates.start()
</ProtectedString></Properties><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Effects</string><ProtectedString name="Source">-- Effects.luau
-- Juice: floating "+power" popups on every punch, toast notifications from
-- the server, and lightweight sounds (built-in rbxasset sounds, no uploads).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local UI = require(script.Parent.UI)

local Effects = {}

local gui: ScreenGui
local toastContainer: Frame
local rng = Random.new()

local function makeSound(id: string, volume: number): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.Parent = SoundService
	return sound
end

local punchSound = makeSound("rbxasset://sounds/swoosh.wav", 0.35)
local successSound = makeSound("rbxasset://sounds/electronicpingshort.wav", 0.5)
local errorSound = makeSound("rbxasset://sounds/snap.mp3", 0.5)

function Effects.punchPopup(power: number, coins: number)
	punchSound.PlaybackSpeed = rng:NextNumber(0.9, 1.15)
	punchSound:Play()

	local popup = UI.create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, rng:NextInteger(-120, 120), 0.62, rng:NextInteger(-20, 20)),
		Size = UDim2.fromOffset(220, 40),
		BackgroundTransparency = 1,
		Text = `+{Formulas.abbreviate(power)} 💪  +{Formulas.abbreviate(coins)} 🪙`,
		TextColor3 = UI.Palette.accent,
		Font = Enum.Font.FredokaOne,
		TextSize = 26,
		TextStrokeTransparency = 0.3,
		Parent = gui,
	})

	local tween = TweenService:Create(popup, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = popup.Position + UDim2.fromOffset(0, -90),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	tween.Completed:Connect(function()
		popup:Destroy()
	end)
	tween:Play()
end

function Effects.toast(kind: string, message: string)
	local isError = kind == "error"
	if isError then
		errorSound:Play()
	else
		successSound:Play()
	end

	local toast = UI.create("Frame", {
		Size = UDim2.fromOffset(340, 44),
		BackgroundColor3 = isError and UI.Palette.bad or UI.Palette.good,
		BackgroundTransparency = 0.1,
		Parent = toastContainer,
	}, {
		UI.corner(12),
		UI.create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = message,
			TextColor3 = Color3.fromRGB(25, 25, 25),
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			Parent = nil,
		}, {
			UI.create("UITextSizeConstraint", { MaxTextSize = 18 }),
			UI.padding(8),
		}),
	})

	task.delay(2.5, function()
		local fade = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
		local label = toast:FindFirstChildOfClass("TextLabel")
		if label then
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		end
		fade.Completed:Connect(function()
			toast:Destroy()
		end)
		fade:Play()
	end)
end

function Effects.start()
	gui = UI.create("ScreenGui", {
		Name = "Effects",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})

	toastContainer = UI.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.fromOffset(340, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
	})

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes:WaitForChild("Notify").OnClientEvent:Connect(Effects.toast)
	remotes:WaitForChild("Punch").OnClientEvent:Connect(Effects.punchPopup)
end

return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Hud</string><ProtectedString name="Source">-- Hud.luau
-- The always-visible interface: stat pills (Power / Coins / Rebirths), the big
-- TRAIN button (click or press E), menu buttons, and the Auto Train toggle
-- that appears when the gamepass is owned.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local UI = require(script.Parent.UI)

local Hud = {}

local player = Players.LocalPlayer

local function statPill(parent: Frame, order: number, emoji: string, statName: string)
	local label = UI.create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = emoji .. " 0",
		TextColor3 = UI.Palette.text,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
	}, {
		UI.create("UITextSizeConstraint", { MaxTextSize = 22 }),
	})

	UI.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(158, 44),
		BackgroundColor3 = UI.Palette.panel,
		BackgroundTransparency = 0.15,
		Parent = parent,
	}, {
		UI.corner(22),
		UI.stroke(UI.Palette.panelLight, 2),
		label,
	})

	-- leaderstats can arrive after the HUD; bind whenever it shows up.
	task.spawn(function()
		local value = player:WaitForChild("leaderstats"):WaitForChild(statName)
		local function update()
			label.Text = `{emoji} {Formulas.abbreviate(value.Value)}`
		end
		value.Changed:Connect(update)
		update()
	end)
end

function Hud.start()
	local gui = UI.create("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- ============================== STAT BAR ==============================
	local bar = UI.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(510, 44),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
	})
	statPill(bar, 1, "💪", "Power")
	statPill(bar, 2, "🪙", "Coins")
	statPill(bar, 3, "🔄", "Rebirths")

	-- ============================== TRAIN BUTTON ==============================
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local punchRemote = remotes:WaitForChild("Punch")

	local trainButton = UI.button({
		Text = "👊 TRAIN",
		Size = UDim2.fromOffset(200, 68),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Color = UI.Palette.accent,
		MaxTextSize = 30,
		CornerRadius = 18,
		Parent = gui,
	})
	UI.create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -2),
		Size = UDim2.fromOffset(200, 16),
		BackgroundTransparency = 1,
		Text = "or press E",
		TextColor3 = UI.Palette.subtext,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		Parent = gui,
	})

	local lastPunch = 0
	local function punch()
		local now = os.clock()
		if now - lastPunch &lt; Config.Training.PunchCooldown then
			return
		end
		lastPunch = now
		punchRemote:FireServer()
	end

	trainButton.Activated:Connect(punch)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
			punch()
		end
	end)

	-- ============================== MENU BUTTONS ==============================
	local menu = UI.create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(120, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
	})

	UI.button({
		Text = "🛒 Shop",
		Size = UDim2.fromOffset(120, 46),
		LayoutOrder = 1,
		Color = UI.Palette.panelLight,
		TextColor = UI.Palette.text,
		Parent = menu,
	}).Activated:Connect(function()
		UI.toggleWindow("Shop")
	end)

	UI.button({
		Text = "🔄 Rebirth",
		Size = UDim2.fromOffset(120, 46),
		LayoutOrder = 2,
		Color = UI.Palette.panelLight,
		TextColor = UI.Palette.text,
		Parent = menu,
	}).Activated:Connect(function()
		UI.toggleWindow("Rebirth")
	end)

	-- Auto Train toggle: only visible once the gamepass is owned.
	local autoOn = false
	local autoButton = UI.button({
		Text = "⚡ Auto: OFF",
		Size = UDim2.fromOffset(120, 46),
		LayoutOrder = 3,
		Color = UI.Palette.panelLight,
		TextColor = UI.Palette.text,
		Parent = menu,
	})
	local function refreshAutoVisibility()
		autoButton.Visible = player:GetAttribute("OwnsAutoTrain") == true
	end
	autoButton.Activated:Connect(function()
		autoOn = not autoOn
		autoButton.Text = autoOn and "⚡ Auto: ON" or "⚡ Auto: OFF"
		autoButton.BackgroundColor3 = autoOn and UI.Palette.good or UI.Palette.panelLight
		remotes:WaitForChild("ToggleAutoTrain"):FireServer(autoOn)
	end)
	player:GetAttributeChangedSignal("OwnsAutoTrain"):Connect(refreshAutoVisibility)
	refreshAutoVisibility()
end

return Hud
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">RebirthUi</string><ProtectedString name="Source">-- RebirthUi.luau
-- Rebirth window: shows the trade (reset progress for a permanent multiplier)
-- and fires the Rebirth remote. The server re-validates the cost.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local UI = require(script.Parent.UI)

local RebirthUi = {}

local player = Players.LocalPlayer

local function infoLabel(parent: Frame, order: number, size: number, color: Color3): TextLabel
	return UI.create("TextLabel", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, size + 8),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = color,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		Parent = parent,
	}, {
		UI.create("UITextSizeConstraint", { MaxTextSize = size }),
	})
end

function RebirthUi.build()
	local content = UI.window("Rebirth", "🔄 Rebirth", UDim2.fromOffset(380, 330))

	UI.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = content,
	})

	local explainer = infoLabel(content, 1, 15, UI.Palette.subtext)
	explainer.Text = "Reset your power, coins and gear\nfor a PERMANENT power boost!"

	local bonusLabel = infoLabel(content, 2, 20, UI.Palette.good)
	local costLabel = infoLabel(content, 3, 18, UI.Palette.text)
	local powerLabel = infoLabel(content, 4, 16, UI.Palette.subtext)

	local rebirthButton = UI.button({
		Text = "🔄 REBIRTH",
		Size = UDim2.fromOffset(220, 56),
		LayoutOrder = 5,
		MaxTextSize = 26,
		Parent = content,
	})
	rebirthButton.Activated:Connect(function()
		ReplicatedStorage.Remotes.Rebirth:FireServer()
	end)

	task.spawn(function()
		local stats = player:WaitForChild("leaderstats")
		local power = stats:WaitForChild("Power")
		local rebirths = stats:WaitForChild("Rebirths")

		local function refresh()
			local cost = Formulas.rebirthCost(rebirths.Value)
			local nextBonus = (rebirths.Value + 1) * Config.Rebirth.BonusPerRebirth * 100
			bonusLabel.Text = `Rebirths: {rebirths.Value}  →  next: +{nextBonus}% power`
			costLabel.Text = `Cost: {Formulas.abbreviate(cost)} 💪`
			powerLabel.Text = `Your power: {Formulas.abbreviate(power.Value)}`
			local canAfford = power.Value &gt;= cost
			rebirthButton.BackgroundColor3 = canAfford and UI.Palette.good or UI.Palette.locked
		end
		power.Changed:Connect(refresh)
		rebirths.Changed:Connect(refresh)
		refresh()
	end)
end

return RebirthUi
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">ShopUi</string><ProtectedString name="Source">-- ShopUi.luau
-- Shop window with two tabs: Gear (coins) and Robux (gamepasses + coin packs).
-- Gear state comes from the replicated GearLevel attribute; all purchases are
-- validated server-side, this UI just fires remotes / purchase prompts.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local UI = require(script.Parent.UI)

local ShopUi = {}

local player = Players.LocalPlayer

local function scrollList(parent: Frame): ScrollingFrame
	return UI.create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, {
		UI.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function row(parent: ScrollingFrame, order: number, height: number): Frame
	return UI.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = UI.Palette.panelLight,
		Parent = parent,
	}, {
		UI.corner(10),
	})
end

-- ============================== GEAR TAB ==============================

local function buildGearTab(parent: Frame)
	local list = scrollList(parent)
	local buttons = {}

	for level, gear in Config.Gear do
		local container = row(list, level, 64)

		UI.create("Frame", {
			Position = UDim2.fromOffset(10, 12),
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = gear.color,
			Parent = container,
		}, { UI.corner(8) })

		UI.create("TextLabel", {
			Position = UDim2.fromOffset(60, 8),
			Size = UDim2.new(1, -180, 0, 26),
			BackgroundTransparency = 1,
			Text = gear.name,
			TextColor3 = UI.Palette.text,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = container,
		}, { UI.create("UITextSizeConstraint", { MaxTextSize = 20 }) })

		UI.create("TextLabel", {
			Position = UDim2.fromOffset(60, 36),
			Size = UDim2.new(1, -180, 0, 20),
			BackgroundTransparency = 1,
			Text = `x{gear.multiplier} Power  •  🪙 {Formulas.abbreviate(gear.cost)}`,
			TextColor3 = UI.Palette.subtext,
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = container,
		}, { UI.create("UITextSizeConstraint", { MaxTextSize = 15 }) })

		local buyButton = UI.button({
			Text = "BUY",
			Size = UDim2.fromOffset(96, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Parent = container,
		})
		buyButton.Activated:Connect(function()
			ReplicatedStorage.Remotes.BuyGear:FireServer(level)
		end)
		buttons[level] = buyButton
	end

	local function refresh()
		local owned = player:GetAttribute("GearLevel") or 0
		for level, button in buttons do
			if level &lt;= owned then
				button.Text = "OWNED"
				button.BackgroundColor3 = UI.Palette.good
				button.Active = false
			elseif level == owned + 1 then
				button.Text = "BUY"
				button.BackgroundColor3 = UI.Palette.accent
				button.Active = true
			else
				button.Text = "LOCKED"
				button.BackgroundColor3 = UI.Palette.locked
				button.Active = false
			end
		end
	end
	player:GetAttributeChangedSignal("GearLevel"):Connect(refresh)
	refresh()
end

-- ============================== ROBUX TAB ==============================

local function buildRobuxTab(parent: Frame)
	local list = scrollList(parent)
	local order = 0
	local anyVisible = false

	local passOrder = { "DoublePower", "DoubleCoins", "AutoTrain", "VIP" }
	for _, key in passOrder do
		local passId = Config.GamePasses[key]
		if passId == 0 then
			continue
		end
		anyVisible = true
		order += 1
		local info = Config.GamePassInfo[key]
		local container = row(list, order, 64)

		UI.create("TextLabel", {
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.new(1, -130, 0, 26),
			BackgroundTransparency = 1,
			Text = "👑 " .. info.title,
			TextColor3 = UI.Palette.accent,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = container,
		}, { UI.create("UITextSizeConstraint", { MaxTextSize = 20 }) })

		UI.create("TextLabel", {
			Position = UDim2.fromOffset(12, 36),
			Size = UDim2.new(1, -130, 0, 20),
			BackgroundTransparency = 1,
			Text = info.desc,
			TextColor3 = UI.Palette.subtext,
			Font = Enum.Font.Gotham,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = container,
		}, { UI.create("UITextSizeConstraint", { MaxTextSize = 13 }) })

		local buyButton = UI.button({
			Text = "BUY",
			Size = UDim2.fromOffset(96, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Color = UI.Palette.good,
			Parent = container,
		})
		local function refreshOwned()
			if player:GetAttribute("Owns" .. key) == true then
				buyButton.Text = "OWNED"
				buyButton.BackgroundColor3 = UI.Palette.locked
				buyButton.Active = false
			end
		end
		buyButton.Activated:Connect(function()
			MarketplaceService:PromptGamePassPurchase(player, passId)
		end)
		player:GetAttributeChangedSignal("Owns" .. key):Connect(refreshOwned)
		refreshOwned()
	end

	for _, product in Config.DevProducts do
		if product.id == 0 then
			continue
		end
		anyVisible = true
		order += 1
		local container = row(list, order, 56)

		UI.create("TextLabel", {
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -130, 1, 0),
			BackgroundTransparency = 1,
			Text = "🪙 " .. product.label,
			TextColor3 = UI.Palette.text,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = container,
		}, { UI.create("UITextSizeConstraint", { MaxTextSize = 20 }) })

		UI.button({
			Text = "BUY",
			Size = UDim2.fromOffset(96, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Color = UI.Palette.good,
			Parent = container,
		}).Activated:Connect(function()
			MarketplaceService:PromptProductPurchase(player, product.id)
		end)
	end

	if not anyVisible then
		UI.create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 80),
			BackgroundTransparency = 1,
			Text = "Robux shop coming soon! 👀",
			TextColor3 = UI.Palette.subtext,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			Parent = list,
		}, { UI.create("UITextSizeConstraint", { MaxTextSize = 22 }) })
	end
end

-- ============================== WINDOW ==============================

function ShopUi.build()
	local content = UI.window("Shop", "🛒 Shop", UDim2.fromOffset(470, 430))

	local tabBar = UI.create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		UI.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
		}),
	})

	local pages = UI.create("Frame", {
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		Parent = content,
	})

	local gearPage = UI.create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = pages })
	local robuxPage = UI.create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = pages })
	buildGearTab(gearPage)
	buildRobuxTab(robuxPage)

	local gearTab, robuxTab
	local function selectTab(showGear: boolean)
		gearPage.Visible = showGear
		robuxPage.Visible = not showGear
		gearTab.BackgroundColor3 = showGear and UI.Palette.accent or UI.Palette.panelLight
		gearTab.TextColor3 = showGear and Color3.fromRGB(30, 30, 30) or UI.Palette.text
		robuxTab.BackgroundColor3 = showGear and UI.Palette.panelLight or UI.Palette.accent
		robuxTab.TextColor3 = showGear and UI.Palette.text or Color3.fromRGB(30, 30, 30)
	end

	gearTab = UI.button({ Text = "🥊 Gear", Size = UDim2.fromOffset(120, 40), LayoutOrder = 1, Parent = tabBar })
	robuxTab = UI.button({
		Text = "💎 Robux",
		Size = UDim2.fromOffset(120, 40),
		LayoutOrder = 2,
		Color = UI.Palette.panelLight,
		TextColor = UI.Palette.text,
		Parent = tabBar,
	})
	gearTab.Activated:Connect(function()
		selectTab(true)
	end)
	robuxTab.Activated:Connect(function()
		selectTab(false)
	end)
end

return ShopUi
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">UI</string><ProtectedString name="Source">-- UI.luau
-- Tiny declarative UI toolkit: an Instance factory, shared palette, styled
-- button factory, and a window manager (one window open at a time).
-- The whole interface is built from code -- no Studio-made GUIs.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Palette = {
	bg = Color3.fromRGB(34, 39, 54),
	panel = Color3.fromRGB(44, 51, 70),
	panelLight = Color3.fromRGB(58, 66, 89),
	accent = Color3.fromRGB(255, 176, 32),
	good = Color3.fromRGB(90, 210, 120),
	bad = Color3.fromRGB(235, 87, 87),
	locked = Color3.fromRGB(90, 97, 115),
	text = Color3.fromRGB(240, 243, 250),
	subtext = Color3.fromRGB(172, 180, 197),
}

function UI.create(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UI.corner(radius: number): UICorner
	return UI.create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function UI.stroke(color: Color3, thickness: number?): UIStroke
	return UI.create("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number): UIPadding
	local pad = UDim.new(0, px)
	return UI.create("UIPadding", {
		PaddingTop = pad,
		PaddingBottom = pad,
		PaddingLeft = pad,
		PaddingRight = pad,
	})
end

-- Styled TextButton with a press-scale animation.
function UI.button(props: { [string]: any }): TextButton
	local color = props.Color or UI.Palette.accent
	local button = UI.create("TextButton", {
		Text = props.Text or "Button",
		Size = props.Size or UDim2.fromOffset(120, 44),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		BackgroundColor3 = color,
		TextColor3 = props.TextColor or Color3.fromRGB(30, 30, 30),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		AutoButtonColor = true,
		Parent = props.Parent,
	}, {
		UI.corner(props.CornerRadius or 12),
		UI.stroke(Color3.new(0, 0, 0), 2),
		UI.create("UIScale", {}),
		UI.create("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 22 }),
	})

	local scale = button:FindFirstChildOfClass("UIScale")
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)

	return button
end

-- ============================== WINDOW MANAGER ==============================

local windowsGui: ScreenGui? = nil
local windows: { [string]: Frame } = {}

local function getWindowsGui(): ScreenGui
	if not windowsGui then
		windowsGui = UI.create("ScreenGui", {
			Name = "Windows",
			ResetOnSpawn = false,
			DisplayOrder = 10,
			Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
		})
	end
	return windowsGui
end

-- Creates a hidden, centered window and returns its content frame.
function UI.window(name: string, title: string, size: UDim2): Frame
	local frame = UI.create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = UI.Palette.panel,
		Visible = false,
		Parent = getWindowsGui(),
	}, {
		UI.corner(16),
		UI.stroke(UI.Palette.accent, 3),
		UI.create("TextLabel", {
			Name = "Title",
			Size = UDim2.new(1, -56, 0, 44),
			Position = UDim2.fromOffset(16, 4),
			BackgroundTransparency = 1,
			Text = title,
			TextColor3 = UI.Palette.text,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, {
			UI.create("UITextSizeConstraint", { MaxTextSize = 28 }),
		}),
	})

	local closeButton = UI.button({
		Text = "✕",
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(1, -44, 0, 8),
		Color = UI.Palette.bad,
		TextColor = UI.Palette.text,
		Parent = frame,
	})
	closeButton.Activated:Connect(function()
		frame.Visible = false
	end)

	local content = UI.create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -64),
		BackgroundTransparency = 1,
		Parent = frame,
	})

	windows[name] = frame
	return content
end

function UI.toggleWindow(name: string)
	local target = windows[name]
	if not target then
		return
	end
	local wasVisible = target.Visible
	for _, frame in windows do
		frame.Visible = false
	end
	target.Visible = not wasVisible
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">ZoneGates</string><ProtectedString name="Source">-- ZoneGates.luau
-- Gate walls are real (collidable) parts from the server. Unlocking is purely
-- client-side and cosmetic: your character's physics runs locally, so setting
-- CanCollide locally lets only YOU walk through. The actual zone bonus is
-- validated on the server, so sneaking past a gate gains nothing.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local ZoneGates = {}

local player = Players.LocalPlayer

local UNLOCKED_COLOR = Color3.fromRGB(90, 210, 120)
local LOCKED_COLOR = Color3.fromRGB(235, 87, 87)
local VIP_COLOR = Color3.fromRGB(255, 215, 0)

local function setGateState(gate: BasePart, unlocked: boolean)
	gate.CanCollide = not unlocked
	local isVip = gate:GetAttribute("VipOnly") == true
	local goalColor = if unlocked then UNLOCKED_COLOR elseif isVip then VIP_COLOR else LOCKED_COLOR
	TweenService:Create(gate, TweenInfo.new(0.5), {
		Transparency = unlocked and 0.9 or 0.2,
		Color = goalColor,
	}):Play()

	local gui = gate:FindFirstChildWhichIsA("BillboardGui")
	local label = gui and gui:FindFirstChildWhichIsA("TextLabel")
	if label and unlocked then
		label.Text = `✅ {gate:GetAttribute("ZoneName")}`
	end
end

function ZoneGates.start()
	local gatesFolder = workspace:WaitForChild("ZoneGates")
	local power = player:WaitForChild("leaderstats"):WaitForChild("Power")

	local gateStates = {} -- [gate] = currently unlocked?

	local function evaluate()
		for _, gate in gatesFolder:GetChildren() do
			local unlocked
			if gate:GetAttribute("VipOnly") == true then
				unlocked = player:GetAttribute("OwnsVIP") == true
			else
				unlocked = power.Value &gt;= (gate:GetAttribute("PowerRequired") or 0)
			end
			if gateStates[gate] ~= unlocked then
				gateStates[gate] = unlocked
				setGateState(gate, unlocked)
			end
		end
	end

	power.Changed:Connect(evaluate)
	player:GetAttributeChangedSignal("OwnsVIP"):Connect(evaluate)
	gatesFolder.ChildAdded:Connect(function()
		task.defer(evaluate)
	end)
	evaluate()
end

return ZoneGates
</ProtectedString></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX22"><Properties><string name="Name">Lighting</string><float name="Brightness">2</float><float name="ClockTime">14</float></Properties></Item><Item class="Workspace" referent="RBX23"><Properties><string name="Name">Workspace</string></Properties></Item></roblox>